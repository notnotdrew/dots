#!/usr/bin/env bash
set -euo pipefail

# Keep macOS from idle-sleeping so a long task can keep running.
# Usage: stay-awake enable|disable|status
#
# caffeinate runs under launchd rather than as a child of this script: a
# backgrounded child is killed when the calling shell or agent session goes
# away, which silently ended stay-awake after a few seconds.

readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/stay-awake"
readonly PLIST="${STATE_DIR}/stay-awake.plist"
readonly LABEL="local.stay-awake"
SCRIPT_NAME="$(basename "$0")"
DOMAIN="gui/$(id -u)"
readonly SCRIPT_NAME DOMAIN

die() {
  echo "${SCRIPT_NAME}: error: $*" >&2
  exit 1
}

usage() {
  cat <<EOF
Usage: ${SCRIPT_NAME} enable|disable|status

  enable   Start caffeinate so the Mac will not idle-sleep
  disable  Stop caffeinate and restore normal sleep
  status   Print whether stay-awake is active
EOF
}

is_loaded() {
  launchctl print "${DOMAIN}/${LABEL}" >/dev/null 2>&1
}

# Empty when the job is not loaded; launchctl's not-found status must not
# escape through pipefail into a caller's command substitution.
job_pid() {
  launchctl print "${DOMAIN}/${LABEL}" 2>/dev/null |
    awk '/^[[:space:]]*pid = /{print $3; exit}' || true
}

write_plist() {
  mkdir -p "${STATE_DIR}"
  # -d display, -i idle, -m disk, -s system (AC power)
  cat >"${PLIST}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>${LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-dims</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
EOF
}

# launchd leaves the job loaded but pidless for ~10s while it throttles a
# KeepAlive relaunch.
describe_job() {
  local pid
  pid="$(job_pid)"
  if [[ -n "${pid}" ]]; then
    echo "caffeinate pid ${pid}"
  else
    echo "caffeinate restarting"
  fi
}

cmd_status() {
  if ! is_loaded; then
    echo "stay-awake: off"
    return 1
  fi
  echo "stay-awake: on ($(describe_job))"
}

cmd_enable() {
  if is_loaded; then
    echo "stay-awake: already on ($(describe_job))"
    return 0
  fi
  write_plist
  launchctl bootstrap "${DOMAIN}" "${PLIST}" ||
    die "failed to load ${LABEL}"
  local pid
  pid="$(job_pid)"
  [[ -n "${pid}" ]] || die "loaded ${LABEL} but caffeinate is not running"
  echo "stay-awake: on (caffeinate pid ${pid})"
}

cmd_disable() {
  if ! is_loaded; then
    rm -f "${PLIST}"
    echo "stay-awake: already off"
    return 0
  fi
  launchctl bootout "${DOMAIN}/${LABEL}" || die "failed to unload ${LABEL}"
  rm -f "${PLIST}"
  echo "stay-awake: off"
}

main() {
  case "${1:-}" in
    enable) cmd_enable ;;
    disable) cmd_disable ;;
    status) cmd_status ;;
    -h | --help | help) usage ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
