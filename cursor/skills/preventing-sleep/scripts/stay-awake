#!/usr/bin/env bash
set -euo pipefail

# Keep macOS from idle-sleeping so a long task can keep running.
# Usage: stay-awake enable|disable|status

readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/stay-awake"
readonly PID_FILE="${STATE_DIR}/caffeinate.pid"
readonly SCRIPT_NAME="$(basename "$0")"

die() {
  echo "${SCRIPT_NAME}: error: $*" >&2
  exit 1
}

usage() {
  cat <<EOF
Usage: ${SCRIPT_NAME} enable|disable|status

  enable   Start caffeinate so the Mac will not idle-sleep
  disable  Stop caffeinate and restore normal sleep
  status   Print whether stay-awake is active
EOF
}

pid_is_caffeinate() {
  local pid="$1"
  [[ -n "${pid}" ]] || return 1
  kill -0 "${pid}" 2>/dev/null || return 1
  ps -p "${pid}" -o comm= 2>/dev/null | grep -q '^caffeinate$'
}

read_pid() {
  if [[ -f "${PID_FILE}" ]]; then
    tr -d '[:space:]' <"${PID_FILE}"
  fi
}

cmd_status() {
  local pid
  pid="$(read_pid)"
  if pid_is_caffeinate "${pid}"; then
    echo "stay-awake: on (caffeinate pid ${pid})"
    return 0
  fi
  echo "stay-awake: off"
  return 1
}

cmd_enable() {
  mkdir -p "${STATE_DIR}"
  local pid
  pid="$(read_pid)"
  if pid_is_caffeinate "${pid}"; then
    echo "stay-awake: already on (caffeinate pid ${pid})"
    return 0
  fi
  rm -f "${PID_FILE}"
  # -d display, -i idle, -m disk, -s system (AC power), -u user activity
  caffeinate -dimsu >/dev/null 2>&1 &
  pid="$!"
  echo "${pid}" >"${PID_FILE}"
  if ! pid_is_caffeinate "${pid}"; then
    rm -f "${PID_FILE}"
    die "failed to start caffeinate"
  fi
  echo "stay-awake: on (caffeinate pid ${pid})"
}

cmd_disable() {
  local pid
  pid="$(read_pid)"
  if pid_is_caffeinate "${pid}"; then
    kill "${pid}"
    wait "${pid}" 2>/dev/null || true
    rm -f "${PID_FILE}"
    echo "stay-awake: off"
    return 0
  fi
  rm -f "${PID_FILE}"
  echo "stay-awake: already off"
}

main() {
  case "${1:-}" in
    enable) cmd_enable ;;
    disable) cmd_disable ;;
    status) cmd_status ;;
    -h | --help | help) usage ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
