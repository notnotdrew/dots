#!/bin/sh

# Record one unpublished pending review in the project Context.
# The file is <context-dir>/action-items.md. A repeated URL stays one line.

set -eu

die() {
    printf 'error: %s\n' "$1" >&2
    exit 1
}

[ $# -eq 2 ] || die "usage: record-pending-review <context-dir> <pr-url>"

context=$1
url=$2

case "$context" in
    /*) ;;
    *) die "context directory must be absolute" ;;
esac
[ -d "$context" ] || die "context directory does not exist: $context"
case "$context" in
    */pr-reviews|*/pr-reviews/*)
        die "action items do not go in the review series"
        ;;
esac

case "$url" in
    https://github.com/*/*/pull/*) ;;
    *) die "not a pull request URL: $url" ;;
esac

remainder=${url#https://github.com/}
owner=${remainder%%/*}
remainder=${remainder#*/}
repo=${remainder%%/*}
number=${remainder#*/pull/}
case "$number" in
    ''|*[!0-9]*|0|0*)
        die "not a pull request URL: $url"
        ;;
esac
case "$owner" in
    ''|*[!A-Za-z0-9_.-]*)
        die "not a pull request URL: $url"
        ;;
esac
case "$repo" in
    ''|*[!A-Za-z0-9_.-]*)
        die "not a pull request URL: $url"
        ;;
esac

file=$context/action-items.md
line="- $url"

if [ -e "$file" ] && [ ! -f "$file" ]; then
    die "action items path is not a file: $file"
fi

if [ -f "$file" ] && grep -Fxq -- "$line" "$file"; then
    exit 0
fi

if [ ! -f "$file" ]; then
    printf '# Action items\n\n%s\n' "$line" >"$file"
else
    printf '%s\n' "$line" >>"$file"
fi
