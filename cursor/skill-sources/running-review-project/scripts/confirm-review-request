#!/bin/sh

# Exit 0 when the event pull request is an exact line in the GitHub MCP
# search for review-requested:@me. The number is the first argument. The
# search result is one pull request number per line on stdin.

set -eu

die() {
    printf 'error: %s\n' "$1" >&2
    exit 1
}

[ $# -eq 1 ] || die "usage: confirm-review-request <pr-number>"

pr=$1
case "$pr" in
    ''|*[!0-9]*|0|0*)
        die "pull request number must be a positive integer"
        ;;
esac

while IFS= read -r line || [ -n "$line" ]; do
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    [ "$line" = "$pr" ] && exit 0
done

exit 1
