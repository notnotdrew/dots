#!/bin/sh

# Check that a review series is a usable handoff for the next review agent:
# the three canonical files exist and agree on identity, observed head, and
# readiness; ledger finding IDs are well formed, unique, and linked to existing
# records; and the final review lists exactly the verified ledger findings.
# The templates define the format. This script does not police it further.

set -eu

export LC_ALL=C

script_name=${0##*/}

fail() {
    printf '%s\n' "$script_name: $*" >&2
    exit 1
}

if [ "$#" -ne 1 ]; then
    fail "usage: $script_name <review-series-directory>"
fi

review_dir=$1
[ -d "$review_dir" ] || fail "review-series directory not found: $review_dir"

for artifact_name in context-brief.md findings-ledger.md perfect-review.md; do
    [ -f "$review_dir/$artifact_name" ] ||
        fail "missing canonical artifact: $artifact_name"
done

context_file=$review_dir/context-brief.md
ledger_file=$review_dir/findings-ledger.md
review_file=$review_dir/perfect-review.md

field_value() {
    field_file=$1
    field_name=$2
    awk -v prefix="- $field_name: " '
        /^## Coverage[[:space:]]*$/ {
            exit
        }
        index($0, prefix) == 1 {
            print substr($0, length(prefix) + 1)
            exit
        }
    ' "$field_file"
}

for field_name in Owner Repository PRNumber ObservedHead Readiness; do
    expected_value=$(field_value "$context_file" "$field_name")
    [ -n "$expected_value" ] ||
        fail "missing required field: context-brief.md: $field_name"
    for artifact_file in "$ledger_file" "$review_file"; do
        actual_value=$(field_value "$artifact_file" "$field_name")
        [ -n "$actual_value" ] ||
            fail "missing required field: ${artifact_file##*/}: $field_name"
        [ "$actual_value" = "$expected_value" ] ||
            fail "artifact field mismatch: ${artifact_file##*/}: $field_name"
    done
done

case "$(field_value "$context_file" Readiness)" in
    ready|'UNABLE TO REVIEW') ;;
    *) fail "invalid readiness value: $(field_value "$context_file" Readiness)" ;;
esac

awk -v ledger_file="$ledger_file" -v review_file="$review_file" '
    function artifact_error(message) {
        print "validate-review-artifacts: " message > "/dev/stderr"
        invalid = 1
    }
    function valid_finding_id(finding_id) {
        return finding_id ~ /^F[0-9][0-9][0-9]*$/ &&
               finding_id ~ /^F0*[1-9][0-9]*$/
    }
    function finding_number(finding_id,    digits) {
        digits = finding_id
        sub(/^F0*/, "", digits)
        return digits + 0
    }
    function check_link(field_name, linked_id) {
        if (linked_id == "" || linked_id == "none") {
            return
        }
        if (!valid_finding_id(linked_id)) {
            artifact_error("malformed finding ID: " linked_id)
        } else if (!(linked_id in finding_ids)) {
            artifact_error(field_name " references unknown finding ID: " linked_id)
        }
    }
    function finish_finding() {
        if (!in_finding) {
            return
        }
        if (current_id == "") {
            artifact_error("finding record lacks an ID: " header_id)
        } else {
            if (disposition != "candidate" &&
                disposition != "verified" &&
                disposition != "dismissed" &&
                disposition != "superseded") {
                artifact_error("invalid finding disposition: " current_id ": " disposition)
            }
            dispositions[current_id] = disposition
            duplicate_links[current_id] = duplicate_of
            supersession_links[current_id] = supersedes
        }
        in_finding = 0
        current_id = disposition = duplicate_of = supersedes = ""
    }
    FILENAME == ledger_file && /^### Finding / {
        finish_finding()
        header_id = substr($0, 13)
        if (!valid_finding_id(header_id)) {
            artifact_error("malformed finding ID: " header_id)
        }
        in_finding = 1
        next
    }
    FILENAME == ledger_file && in_finding && /^(## |### )/ {
        finish_finding()
    }
    FILENAME == ledger_file && in_finding && /^- ID: / {
        current_id = substr($0, 7)
        if (!valid_finding_id(current_id)) {
            artifact_error("malformed finding ID: " current_id)
        } else if (current_id in finding_ids ||
                   finding_number(current_id) in finding_numbers) {
            artifact_error("duplicate finding ID: " current_id)
        } else {
            finding_ids[current_id] = 1
            finding_numbers[finding_number(current_id)] = 1
        }
        if (header_id != current_id) {
            artifact_error("finding header and ID differ: " header_id)
        }
        next
    }
    FILENAME == ledger_file && in_finding && /^- Disposition: / {
        disposition = substr($0, 16)
        next
    }
    FILENAME == ledger_file && in_finding && /^- DuplicateOf: / {
        duplicate_of = substr($0, 16)
        next
    }
    FILENAME == ledger_file && in_finding && /^- Supersedes: / {
        supersedes = substr($0, 15)
        next
    }
    FILENAME == review_file && FNR == 1 {
        finish_finding()
    }
    FILENAME == review_file && /^## Findings[[:space:]]*$/ {
        in_final_findings = 1
        next
    }
    FILENAME == review_file && in_final_findings && /^## / {
        in_final_findings = 0
    }
    FILENAME == review_file && in_final_findings && /^- Finding: / {
        final_id = substr($0, 12)
        if (!valid_finding_id(final_id)) {
            artifact_error("malformed finding ID: " final_id)
        } else {
            final_findings[final_id]++
        }
    }
    END {
        finish_finding()
        for (finding_id in duplicate_links) {
            check_link("duplicate link", duplicate_links[finding_id])
        }
        for (finding_id in supersession_links) {
            check_link("supersession link", supersession_links[finding_id])
        }
        for (finding_id in final_findings) {
            if (!(finding_id in finding_ids)) {
                artifact_error("final finding references unknown ledger ID: " finding_id)
            } else if (dispositions[finding_id] != "verified") {
                artifact_error("final finding is not verified: " finding_id)
            }
            if (final_findings[finding_id] != 1) {
                artifact_error("final finding must appear exactly once: " finding_id)
            }
        }
        for (finding_id in dispositions) {
            if (dispositions[finding_id] == "verified" &&
                !(finding_id in final_findings)) {
                artifact_error("verified finding is missing from final review: " finding_id)
            }
        }
        exit invalid ? 1 : 0
    }
' "$ledger_file" "$review_file" || exit 1

printf '%s\n' "review artifacts valid: $review_dir"
