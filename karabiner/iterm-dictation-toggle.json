{
  "title": "iTerm Dictation + Secure Keyboard Entry",
  "rules": [
    {
      "description": "Left Option double-tap: toggle Dictation around iTerm Secure Keyboard Entry",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "left_option_pressed",
              "value": 1
            }
          ],
          "from": {
            "key_code": "left_option",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "shell_command": "$HOME/bin/iterm-dictation-toggle"
            },
            {
              "set_variable": {
                "name": "left_option_pressed",
                "value": 0
              }
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "left_option",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "left_option_pressed",
                "value": 1
              }
            },
            {
              "key_code": "left_option",
              "lazy": true
            }
          ],
          "to_delayed_action": {
            "to_if_invoked": [
              {
                "set_variable": {
                  "name": "left_option_pressed",
                  "value": 0
                }
              }
            ],
            "to_if_canceled": [
              {
                "set_variable": {
                  "name": "left_option_pressed",
                  "value": 0
                }
              }
            ]
          },
          "parameters": {
            "basic.to_delayed_action_delay_milliseconds": 350
          }
        }
      ]
    }
  ]
}
