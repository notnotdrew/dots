#!/bin/sh

set -u

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
VALIDATOR="$SCRIPT_DIR/validate-review-artifacts"
TEST_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/test-review-artifacts.XXXXXX") || exit 1

trap 'rm -rf "$TEST_ROOT"' EXIT HUP INT TERM

if [ ! -x "$VALIDATOR" ]; then
    printf '%s\n' "not ok - validator is missing or not executable: $VALIDATOR" >&2
    exit 1
fi

tests_run=0
tests_failed=0

head_sha=2222222222222222222222222222222222222222

write_context_brief() {
    fixture_dir=$1
    readiness=${2:-ready}
    observed_head=${3:-$head_sha}

    cat >"$fixture_dir/context-brief.md" <<EOF
# Context Brief

## Identity

- Owner: example
- Repository: repository
- PRNumber: 42
- PRURL: https://github.com/example/repository/pull/42
- Mode: Standard
- ModeSelection: default
- ObservedBase: 1111111111111111111111111111111111111111
- ObservedHead: $observed_head
- CurrentEpoch: R1

## Readiness

- Readiness: $readiness
- ReadinessHistory: initial readiness assessment recorded

## Coverage

### application behavior

- Owner: general-reviewer
- Principles: Reliability
- Evidence: src/example.c and tests/example-test.c
- State: reviewed
- Material: yes
EOF
}

write_ledger_header() {
    fixture_dir=$1
    readiness=${2:-ready}

    cat >"$fixture_dir/findings-ledger.md" <<EOF
# Findings Ledger

## Identity

- Owner: example
- Repository: repository
- PRNumber: 42
- Mode: Standard
- ModeSelection: default
- ObservedHead: $head_sha
- CurrentEpoch: R1
- Readiness: $readiness
- UnresolvedMaterialDecisions: none

## Coverage

### application behavior

- Owner: general-reviewer
- Principles: Reliability
- Evidence: src/example.c and tests/example-test.c
- State: reviewed
- Material: yes

## Findings
EOF
}

write_empty_ledger() {
    fixture_dir=$1
    readiness=${2:-ready}

    write_ledger_header "$fixture_dir" "$readiness"
    cat >>"$fixture_dir/findings-ledger.md" <<'EOF'

No findings.
EOF
}

append_finding() {
    fixture_dir=$1
    header_id=$2
    finding_id=${3:-$header_id}
    disposition=${4:-verified}
    duplicate_of=${5:-none}
    supersedes=${6:-none}

    cat >>"$fixture_dir/findings-ledger.md" <<EOF

### Finding $header_id

- ID: $finding_id
- Claim: The changed error path returns success.
- Impact: Callers can accept an incomplete operation.
- Principle: Reliability
- Class: blocking
- AffectedBehavior: error handling
- Scope: src/example.c
- SourceReviewers: general-reviewer
- Evidence: src/example.c:27 and tests/example-test.c:41
- Disposition: $disposition
- DispositionHistory: candidate -> $disposition; verified against the changed branch
- DuplicateOf: $duplicate_of
- Supersedes: $supersedes
- RawOutput: none
- PriorArt: none
- PriorArtDelta: none
EOF
}

write_review() {
    fixture_dir=$1
    recommendation=$2
    readiness=$3
    shift 3

    cat >"$fixture_dir/perfect-review.md" <<EOF
# PERFECT Review: PR #42 — Example

## Identity

- Owner: example
- Repository: repository
- PRNumber: 42
- PRURL: https://github.com/example/repository/pull/42
- Mode: Standard
- ModeSelection: default
- ObservedHead: $head_sha
- CurrentEpoch: R1
- Readiness: $readiness
- ContextArtifact: context-brief.md
- LedgerArtifact: findings-ledger.md

## Coverage

### application behavior

- Owner: general-reviewer
- Principles: Reliability
- Evidence: src/example.c and tests/example-test.c
- State: reviewed
- Material: yes

## PERFECT Verdicts

- Purpose: PASS
- EdgeCases: PASS
- Reliability: PASS
- Form: PASS
- Evidence: PASS
- Clarity: PASS
- Taste: N/A
EOF

    if [ "$#" -gt 0 ]; then
        cat >>"$fixture_dir/perfect-review.md" <<'EOF'

## Findings

### Reliability
EOF
        for final_id in "$@"; do
            cat >>"$fixture_dir/perfect-review.md" <<EOF

- Finding: $final_id
  - Scenario: Callers treat a failed operation as success.
  - Why: The changed error path returns success.
  - Fix: Return the original error to callers.
  - Anchor: src/example.c:27
  - PriorArt: none
EOF
        done
    fi

    cat >>"$fixture_dir/perfect-review.md" <<EOF

## Verification Gaps

None.

## Outcome

- Recommendation: $recommendation
EOF
}

make_empty_fixture() {
    fixture_dir=$1
    mkdir "$fixture_dir" || return 1
    write_context_brief "$fixture_dir"
    write_empty_ledger "$fixture_dir"
    write_review "$fixture_dir" APPROVE ready
}

make_finding_fixture() {
    fixture_dir=$1
    mkdir "$fixture_dir" || return 1
    write_context_brief "$fixture_dir"
    write_ledger_header "$fixture_dir"
    append_finding "$fixture_dir" F01
    write_review "$fixture_dir" "REQUEST CHANGES" ready F01
}

assert_validation() {
    test_name=$1
    expected_status=$2
    expected_diagnostic=$3
    fixture_dir=$4
    output_file="$TEST_ROOT/output"

    tests_run=$((tests_run + 1))
    "$VALIDATOR" "$fixture_dir" >"$output_file" 2>&1
    actual_status=$?

    if [ "$actual_status" -ne "$expected_status" ]; then
        printf '%s\n' "not ok - $test_name: expected status $expected_status, got $actual_status"
        cat "$output_file"
        tests_failed=$((tests_failed + 1))
        return
    fi

    if ! grep -F "$expected_diagnostic" "$output_file" >/dev/null 2>&1; then
        printf '%s\n' "not ok - $test_name: missing diagnostic: $expected_diagnostic"
        cat "$output_file"
        tests_failed=$((tests_failed + 1))
        return
    fi

    printf '%s\n' "ok - $test_name"
}

fixture_dir="$TEST_ROOT/empty-ledger"
make_empty_fixture "$fixture_dir"
assert_validation "accepts a series with no findings" 0 "review artifacts valid" "$fixture_dir"

fixture_dir="$TEST_ROOT/verified-finding"
make_finding_fixture "$fixture_dir"
assert_validation "accepts a verified finding listed in the final review" 0 "review artifacts valid" "$fixture_dir"

fixture_dir="$TEST_ROOT/unable-to-review"
mkdir "$fixture_dir"
write_context_brief "$fixture_dir" "UNABLE TO REVIEW"
write_empty_ledger "$fixture_dir" "UNABLE TO REVIEW"
write_review "$fixture_dir" APPROVE "UNABLE TO REVIEW"
assert_validation "accepts an UNABLE TO REVIEW readiness" 0 "review artifacts valid" "$fixture_dir"

fixture_dir="$TEST_ROOT/terminal-records"
make_finding_fixture "$fixture_dir"
append_finding "$fixture_dir" F02 F02 dismissed F01
append_finding "$fixture_dir" F03 F03 superseded
append_finding "$fixture_dir" F04 F04 verified none F03
write_review "$fixture_dir" "REQUEST CHANGES" ready F01 F04
assert_validation "accepts dismissed and superseded records with resolving links" 0 "review artifacts valid" "$fixture_dir"

fixture_dir="$TEST_ROOT/legacy-epoch-sections"
make_finding_fixture "$fixture_dir"
for artifact_name in context-brief.md findings-ledger.md perfect-review.md; do
    cat >>"$fixture_dir/$artifact_name" <<EOF

## Review Epochs

### Epoch R1

- Epoch: R1
- ObservedBase: 1111111111111111111111111111111111111111
- ObservedHead: $head_sha
- ReviewType: initial-upgrade
- InheritsFrom: initial
- FindingIDs: F01
- FindingStates: F01=verified
EOF
done
cat >>"$fixture_dir/findings-ledger.md" <<'EOF'

## Amendments

### Amendment A001

- ID: A001
- Epoch: R1
- SubjectFinding: F01
EOF
assert_validation "ignores epoch and amendment sections left by earlier series" 0 "review artifacts valid" "$fixture_dir"

fixture_dir="$TEST_ROOT/missing-artifact"
make_empty_fixture "$fixture_dir"
rm "$fixture_dir/perfect-review.md"
assert_validation "rejects a missing canonical artifact" 1 "missing canonical artifact: perfect-review.md" "$fixture_dir"

fixture_dir="$TEST_ROOT/missing-readiness"
make_empty_fixture "$fixture_dir"
grep -v '^- Readiness:' "$fixture_dir/findings-ledger.md" >"$fixture_dir/findings-ledger.tmp"
mv "$fixture_dir/findings-ledger.tmp" "$fixture_dir/findings-ledger.md"
assert_validation "rejects a missing required field" 1 "missing required field: findings-ledger.md: Readiness" "$fixture_dir"

fixture_dir="$TEST_ROOT/observed-head-mismatch"
make_empty_fixture "$fixture_dir"
write_context_brief "$fixture_dir" ready 3333333333333333333333333333333333333333
assert_validation "rejects artifacts that disagree on the observed head" 1 "artifact field mismatch: findings-ledger.md: ObservedHead" "$fixture_dir"

fixture_dir="$TEST_ROOT/readiness-mismatch"
make_empty_fixture "$fixture_dir"
write_empty_ledger "$fixture_dir" "UNABLE TO REVIEW"
assert_validation "rejects artifacts that disagree on readiness" 1 "artifact field mismatch: findings-ledger.md: Readiness" "$fixture_dir"

fixture_dir="$TEST_ROOT/invalid-readiness"
mkdir "$fixture_dir"
write_context_brief "$fixture_dir" pending
write_empty_ledger "$fixture_dir" pending
write_review "$fixture_dir" APPROVE pending
assert_validation "rejects an invalid readiness value" 1 "invalid readiness value: pending" "$fixture_dir"

fixture_dir="$TEST_ROOT/malformed-finding-id"
make_finding_fixture "$fixture_dir"
write_ledger_header "$fixture_dir"
append_finding "$fixture_dir" FX01
write_review "$fixture_dir" "REQUEST CHANGES" ready FX01
assert_validation "rejects a malformed finding ID" 1 "malformed finding ID: FX01" "$fixture_dir"

fixture_dir="$TEST_ROOT/unpadded-finding-id"
make_finding_fixture "$fixture_dir"
write_ledger_header "$fixture_dir"
append_finding "$fixture_dir" F1
write_review "$fixture_dir" "REQUEST CHANGES" ready F1
assert_validation "rejects an unpadded finding ID" 1 "malformed finding ID: F1" "$fixture_dir"

fixture_dir="$TEST_ROOT/header-id-mismatch"
make_finding_fixture "$fixture_dir"
write_ledger_header "$fixture_dir"
append_finding "$fixture_dir" F01 F02
write_review "$fixture_dir" "REQUEST CHANGES" ready F02
assert_validation "rejects a finding whose header and ID differ" 1 "finding header and ID differ: F01" "$fixture_dir"

fixture_dir="$TEST_ROOT/numeric-duplicate-finding-id"
make_finding_fixture "$fixture_dir"
append_finding "$fixture_dir" F001 F001 dismissed F01
assert_validation "rejects padded finding IDs with the same integer" 1 "duplicate finding ID: F001" "$fixture_dir"

fixture_dir="$TEST_ROOT/invalid-disposition"
make_finding_fixture "$fixture_dir"
write_ledger_header "$fixture_dir"
append_finding "$fixture_dir" F01 F01 confirmed
assert_validation "rejects an invalid disposition" 1 "invalid finding disposition: F01: confirmed" "$fixture_dir"

fixture_dir="$TEST_ROOT/unknown-duplicate"
make_finding_fixture "$fixture_dir"
append_finding "$fixture_dir" F02 F02 dismissed F999
assert_validation "rejects a duplicate link to an unknown ID" 1 "duplicate link references unknown finding ID: F999" "$fixture_dir"

fixture_dir="$TEST_ROOT/unknown-supersession"
make_finding_fixture "$fixture_dir"
append_finding "$fixture_dir" F02 F02 superseded none F999
assert_validation "rejects a supersession link to an unknown ID" 1 "supersession link references unknown finding ID: F999" "$fixture_dir"

fixture_dir="$TEST_ROOT/dangling-final-finding"
make_empty_fixture "$fixture_dir"
write_review "$fixture_dir" APPROVE ready F999
assert_validation "rejects a final finding that is not in the ledger" 1 "final finding references unknown ledger ID: F999" "$fixture_dir"

fixture_dir="$TEST_ROOT/unverified-final-finding"
make_finding_fixture "$fixture_dir"
write_ledger_header "$fixture_dir"
append_finding "$fixture_dir" F01 F01 dismissed
assert_validation "rejects a final finding whose ledger record is not verified" 1 "final finding is not verified: F01" "$fixture_dir"

fixture_dir="$TEST_ROOT/repeated-final-finding"
make_finding_fixture "$fixture_dir"
write_review "$fixture_dir" "REQUEST CHANGES" ready F01 F01
assert_validation "rejects a final finding listed twice" 1 "final finding must appear exactly once: F01" "$fixture_dir"

fixture_dir="$TEST_ROOT/missing-final-finding"
make_finding_fixture "$fixture_dir"
write_review "$fixture_dir" "REQUEST CHANGES" ready
assert_validation "rejects a verified finding missing from the final review" 1 "verified finding is missing from final review: F01" "$fixture_dir"

if [ "$tests_failed" -ne 0 ]; then
    printf '%s\n' "$tests_failed of $tests_run review artifact tests failed"
    exit 1
fi

printf '%s\n' "all $tests_run review artifact tests passed"
