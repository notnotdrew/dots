append_epoch_to_fixture "$fixture_dir" R3 "$old_base" "$new_head" incremental R1 "context:application behavior" none none none none
assert_validation "rejects a skipped review epoch" 1 "skipped review epoch: expected R2, found R3" "$fixture_dir"

fixture_dir="$TEST_ROOT/dangling-amendment"
