#!/bin/sh

set -eu

export LC_ALL=C

script_name=${0##*/}
script_dir=$(CDPATH='' cd "$(dirname "$0")" && pwd -P)
skill_dir=$(CDPATH='' cd "$script_dir/.." && pwd -P)
skill_file=$skill_dir/SKILL.md
agent_file=$skill_dir/agents/openai.yaml

fail() {
    printf '%s\n' "$script_name: $*" >&2
    exit 1
}

[ -f "$skill_file" ] || fail "missing skill entry point: $skill_file"
[ -f "$agent_file" ] || fail "missing agent metadata: $agent_file"

awk '
    NR == 1 {
        if ($0 != "---") {
            print "check-skill-package: SKILL.md must start with delimited YAML frontmatter" > "/dev/stderr"
            exit 1
        }
        in_frontmatter = 1
        next
    }
    in_frontmatter && $0 == "---" {
        in_frontmatter = 0
        closed = 1
        next
    }
    in_frontmatter {
        if ($0 == "" || $0 ~ /^[[:space:]]*#/) {
            next
        }
        if ($0 ~ /^[[:space:]]/) {
            print "check-skill-package: unexpected nested frontmatter content" > "/dev/stderr"
            invalid = 1
            next
        }
        separator = index($0, ":")
        if (!separator) {
            print "check-skill-package: malformed top-level frontmatter line: " $0 > "/dev/stderr"
            invalid = 1
            next
        }
        key = substr($0, 1, separator - 1)
        value = substr($0, separator + 1)
        sub(/^[[:space:]]*/, "", value)
        keys[key]++
        values[key] = value
        if (key != "name" && key != "description") {
            print "check-skill-package: unexpected top-level frontmatter key: " key > "/dev/stderr"
            invalid = 1
        }
        next
    }
    END {
        if (!closed) {
            print "check-skill-package: SKILL.md frontmatter is not closed" > "/dev/stderr"
            invalid = 1
        }
        if (keys["name"] != 1 || values["name"] != "pr-review") {
            print "check-skill-package: expected exactly name: pr-review" > "/dev/stderr"
            invalid = 1
        }
        description = values["description"]
        if (keys["description"] != 1 ||
            description == "" ||
            description == "\"\"" ||
            description == "\047\047") {
            print "check-skill-package: expected exactly one nonempty description" > "/dev/stderr"
            invalid = 1
        }
        exit invalid ? 1 : 0
    }
' "$skill_file" || exit 1

awk '
    /Never invoke the `pr-review`/ {
        prohibition_started = 1
    }
    prohibition_started && /shell command from inside the agent/ {
        prohibition_complete = 1
    }
    END {
        if (!prohibition_complete) {
            print "check-skill-package: SKILL.md must prohibit recursive launcher invocation" > "/dev/stderr"
            exit 1
        }
    }
' "$skill_file" || exit 1

awk '
    /^[^[:space:]#][^:]*:/ {
        top_level_count++
        if ($0 != "interface:") {
            print "check-skill-package: unexpected agents/openai.yaml top-level key" > "/dev/stderr"
            invalid = 1
        }
        next
    }
    /^  [a-z_][a-z_]*: / {
        line = substr($0, 3)
        separator = index(line, ":")
        key = substr(line, 1, separator - 1)
        value = substr(line, separator + 1)
        sub(/^[[:space:]]*/, "", value)
        if (value ~ /^".*"$/ || value ~ /^\047.*\047$/) {
            value = substr(value, 2, length(value) - 2)
        }
        keys[key]++
        values[key] = value
        if (key != "display_name" &&
            key != "short_description" &&
            key != "default_prompt") {
            print "check-skill-package: unexpected agents/openai.yaml interface key: " key > "/dev/stderr"
            invalid = 1
        }
        next
    }
    /^[[:space:]]*$/ || /^[[:space:]]*#/ {
        next
    }
    {
        print "check-skill-package: malformed agents/openai.yaml line: " $0 > "/dev/stderr"
        invalid = 1
    }
    END {
        if (top_level_count != 1) {
            print "check-skill-package: agents/openai.yaml requires one interface mapping" > "/dev/stderr"
            invalid = 1
        }
        required_count = split("display_name short_description default_prompt", required_keys, " ")
        for (required_index = 1; required_index <= required_count; required_index++) {
            key = required_keys[required_index]
            if (keys[key] != 1 || values[key] == "") {
                print "check-skill-package: missing required agents/openai.yaml field: " key > "/dev/stderr"
                invalid = 1
            }
        }
        if (values["display_name"] != "PR Review") {
            print "check-skill-package: display_name is inconsistent with pr-review" > "/dev/stderr"
            invalid = 1
        }
        if (values["short_description"] !~ /pull requests/ ||
            values["short_description"] !~ /PERFECT/) {
            print "check-skill-package: short_description must describe PERFECT pull request review" > "/dev/stderr"
            invalid = 1
        }
        if (values["default_prompt"] !~ /pull request/ ||
            values["default_prompt"] !~ /PERFECT/) {
            print "check-skill-package: default_prompt must request PERFECT pull request review" > "/dev/stderr"
            invalid = 1
        }
        exit invalid ? 1 : 0
    }
' "$agent_file" || exit 1

printf '%s\n' "skill package valid: $skill_dir"
