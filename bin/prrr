#!/usr/bin/env bash
# prrr — pr-review-review: browse ~/.cdx-artifacts/pr-reviews
#
# Usage:
#   prrr                        Home picker: start a new review, or open a local one
#   prrr start <number|url>     Start (or re-run) a review for that PR
#   prrr --clean [number|url]   Remove local artifacts/worktrunks for closed/merged
#                               PRs, or local reviews older than 14 days
#   prrr <number|url>           Pick an artifact for that PR review
#
# Home picker:
#   +        open PR requesting your review, not reviewed locally yet
#   *        local review whose PR still requests your review
#   enter    start the review (+ rows) or browse artifacts (local rows)
#   ctrl-n   start/re-run a review for the highlighted row, or for a typed
#            PR number or URL when nothing matches
#
# Artifact picker:
#   enter  open in vim
#   tab    open Cursor agent (ask mode) ready to discuss the file
#   space  re-run the PR review (standard)
#   ctrl-d deep review with --full-rebuild (same-head needs a forced epoch)
#   ctrl-r resume the most recent agent session for this PR

set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_NAME
readonly SCRIPT_DIR
readonly ARTIFACTS_ROOT="${HOME}/.cdx-artifacts/pr-reviews"
readonly PR_PARSE="${HOME}/.codex/skills/pr-review/scripts/gh-pr-parse"
readonly PR_REVIEW="${SCRIPT_DIR}/pr-review"
readonly DEV_ROOT="${PRRR_DEV_ROOT:-${HOME}/Documents/dev}"
readonly EXIT_CANCELLED=130
readonly CLEAN_MAX_AGE_DAYS=14
readonly USAGE="usage: ${SCRIPT_NAME} [start <PR-number-or-URL> | --clean [PR-number-or-URL] | <PR-number-or-URL>]"

die() {
  printf '%s: %s\n' "$SCRIPT_NAME" "$*" >&2
  exit 1
}

require_cmds() {
  local cmd
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || die "$cmd is required but not found"
  done
}

# fzf draws on /dev/tty, so stdout being a pipe (command substitution) is fine.
require_tty() {
  { exec 3<>/dev/tty; } 2>/dev/null || die "$1"
  exec 3>&-
}

is_review_dir() {
  local base
  base="$(basename "$1")"
  [[ "$base" =~ ^pr-[1-9][0-9]*$ ]]
}

review_title() {
  local context_brief="${1}/context-brief.md"
  local line

  [[ -f "$context_brief" ]] || return 0

  while IFS= read -r line; do
    case "$line" in
      '- Title: '*)
        printf '%s\n' "${line#- Title: }"
        return 0
        ;;
    esac
  done < "$context_brief"
}

# Normalize a git remote URL to owner/repo (GitHub only).
github_repo_from_remote() {
  local remote=$1

  remote="${remote%.git}"
  case "$remote" in
    git@github.com:*)
      printf '%s\n' "${remote#git@github.com:}"
      ;;
    https://github.com/*)
      printf '%s\n' "${remote#https://github.com/}"
      ;;
    http://github.com/*)
      printf '%s\n' "${remote#http://github.com/}"
      ;;
    ssh://git@github.com/*)
      printf '%s\n' "${remote#ssh://git@github.com/}"
      ;;
    *)
      return 1
      ;;
  esac
}

dir_is_github_repo() {
  local dir=$1
  local want=$2
  local remote normalized

  remote="$(git -C "$dir" remote get-url origin 2>/dev/null)" || return 1
  normalized="$(github_repo_from_remote "$remote")" || return 1
  [[ "$normalized" == "$want" ]]
}

# Resolve a local clone for owner/repo.
# Prefer the current checkout when it already matches; otherwise DEV_ROOT/owner/repo.
resolve_clone_dir() {
  local want=$1
  local owner repo candidate toplevel

  owner="${want%%/*}"
  repo="${want#*/}"

  if toplevel="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    if dir_is_github_repo "$toplevel" "$want"; then
      printf '%s\n' "$toplevel"
      return 0
    fi
  fi

  candidate="${DEV_ROOT}/${owner}/${repo}"
  if [[ -e "$candidate" ]] && dir_is_github_repo "$candidate" "$want"; then
    printf '%s\n' "$candidate"
    return 0
  fi

  return 1
}

# Print "owner/repo<TAB>number<TAB>title<TAB>url" for open PRs requesting your review.
# Soft-fails so the picker still works when gh is missing, logged out, or offline.
list_review_requested_prs() {
  command -v gh >/dev/null 2>&1 || return 0

  gh search prs \
    --review-requested=@me \
    --state=open \
    --sort=updated \
    --order=desc \
    --limit=50 \
    --json url,title,number,repository \
    --jq '.[] | "\(.repository.nameWithOwner)\t\(.number)\t\(.title)\t\(.url)"' \
    2>/dev/null || true
}

# Print "action<TAB>label<TAB>payload" rows for the home picker: PRs awaiting a
# first review (+) first, then local reviews newest first, with '*' on the local
# reviews whose PR still requests your review.
list_home_choices() {
  local name_with_owner number title url owner repo artifact_dir
  local path mtime label review_title_text marker
  local -A awaiting=()
  local -a start_rows=() local_rows=()

  while IFS=$'\t' read -r name_with_owner number title url; do
    [[ -n "$url" ]] || continue
    owner="${name_with_owner%%/*}"
    repo="${name_with_owner#*/}"
    artifact_dir="${ARTIFACTS_ROOT}/${owner}--${repo}/pr-${number}"
    awaiting["$artifact_dir"]=1
    # Reviewed locally already: annotate the local row instead of listing twice.
    [[ -d "$artifact_dir" ]] && continue
    start_rows+=("start"$'\t'"+ ${name_with_owner} #${number}  ${title}"$'\t'"${url}")
  done < <(list_review_requested_prs)

  if ((${#start_rows[@]} > 0)); then
    printf '%s\n' "${start_rows[@]}"
  fi

  [[ -d "$ARTIFACTS_ROOT" ]] || return 0

  while IFS= read -r path; do
    [[ -d "$path" ]] || continue
    is_review_dir "$path" || continue
    mtime="$(stat -f '%m' "$path")"
    label="${path#"${ARTIFACTS_ROOT}/"}"
    review_title_text="$(review_title "$path")"
    if [[ -n "$review_title_text" ]]; then
      label="${label}  ${review_title_text}"
    fi
    if [[ -n "${awaiting[$path]:-}" ]]; then
      marker='*'
    else
      marker=' '
    fi
    local_rows+=("${mtime}"$'\t'"open"$'\t'"${marker} ${label}"$'\t'"${path}")
  done < <(find "$ARTIFACTS_ROOT" -mindepth 2 -maxdepth 2 -type d -name 'pr-*' 2>/dev/null)

  if ((${#local_rows[@]} == 0)); then
    return 0
  fi

  printf '%s\n' "${local_rows[@]}" \
    | sort -t $'\t' -k1,1nr \
    | cut -f2-
}

# Print "basename<TAB>abspath" for files in a review dir.
list_artifacts() {
  local review_dir=$1
  local path

  while IFS= read -r path; do
    [[ -f "$path" ]] || continue
    printf '%s\t%s\n' "$(basename "$path")" "$path"
  done < <(find "$review_dir" -maxdepth 1 -type f ! -name '.*' | sort)
}

# Resolve clone + exec pr-review for a GitHub PR URL.
start_review_from_url() {
  local pr_url=$1
  local parsed owner repo clone_dir

  [[ -x "$PR_REVIEW" ]] || die "missing launcher: $PR_REVIEW"
  [[ -x "$PR_PARSE" ]] || die "missing parser: $PR_PARSE"

  parsed="$("$PR_PARSE" "$pr_url")" || exit 1
  # shellcheck disable=SC2086
  eval "$parsed"
  owner="${OWNER:?}"
  repo="${REPO:?}"

  if ! clone_dir="$(resolve_clone_dir "${owner}/${repo}")"; then
    die "no local clone of ${owner}/${repo} (checked cwd and ${DEV_ROOT}/${owner}/${repo}; set PRRR_DEV_ROOT to override)"
  fi

  printf '%s: starting pr-review in %s\n' "$SCRIPT_NAME" "$clone_dir" >&2
  cd "$clone_dir" || die "failed to cd into ${clone_dir}"
  exec "$PR_REVIEW" "$pr_url"
}

# Start a review for a home picker row, whichever section it came from.
start_review_from_row() {
  local row=$1
  local action payload owner repo pr_number

  action="${row%%$'\t'*}"
  payload="${row#*$'\t'}"
  payload="${payload#*$'\t'}"

  case "$action" in
    start)
      start_review_from_url "$payload"
      ;;
    open)
      parse_review_identity "$payload" owner repo pr_number
      start_review_from_url "https://github.com/${owner}/${repo}/pull/${pr_number}"
      ;;
    *)
      die "unexpected home picker action: ${action}"
      ;;
  esac
}

# Print owner/repo for a bare PR number: prefer the current checkout, then any
# repo with a local review for that number. Confirms the PR exists with gh so a
# number from an unrelated checkout still lands on the right repo.
repo_slug_for_pr_number() {
  local pr_number=$1
  local remote slug review_dir series_dir
  local -a candidates=()

  if remote="$(git remote get-url origin 2>/dev/null)" \
    && slug="$(github_repo_from_remote "$remote")"; then
    candidates+=("$slug")
  fi

  while IFS= read -r review_dir; do
    [[ -d "$review_dir" ]] || continue
    series_dir="$(basename "$(dirname "$review_dir")")"
    [[ "$series_dir" == *--* ]] || continue
    candidates+=("${series_dir%%--*}/${series_dir#*--}")
  done < <(find "$ARTIFACTS_ROOT" -mindepth 2 -maxdepth 2 -type d -name "pr-${pr_number}" 2>/dev/null)

  ((${#candidates[@]} > 0)) || return 1

  if ! command -v gh >/dev/null 2>&1; then
    printf '%s\n' "${candidates[0]}"
    return 0
  fi

  for slug in "${candidates[@]}"; do
    if gh pr view "$pr_number" --repo "$slug" --json number >/dev/null 2>&1; then
      printf '%s\n' "$slug"
      return 0
    fi
  done

  return 1
}

# Start a review for a typed PR reference: a full GitHub PR URL, or a number.
start_review_from_ref() {
  local ref=$1
  local repo_slug

  case "$ref" in
    https://github.com/*/pull/*)
      start_review_from_url "$ref"
      ;;
    '' | 0)
      die "expected a PR number or GitHub PR URL"
      ;;
    *[!0-9]*)
      die "expected a PR number or GitHub PR URL, got: ${ref}"
      ;;
    *)
      if ! repo_slug="$(repo_slug_for_pr_number "$ref")"; then
        die "cannot find PR #${ref}; run from its repo, or type the full PR URL"
      fi
      start_review_from_url "https://github.com/${repo_slug}/pull/${ref}"
      ;;
  esac
}

# Home picker: browse a local review, or start a new one.
pick_home() {
  local choice_lines result header status=0
  local query key selection payload new_count awaiting_count local_count
  local -a result_lines=()

  require_cmds fzf
  require_tty "interactive terminal required for picker"

  choice_lines="$(list_home_choices)"
  if [[ -z "$choice_lines" ]]; then
    die "nothing to show (no local reviews under ${ARTIFACTS_ROOT}, and no open review-requested PRs)"
  fi

  new_count="$(printf '%s\n' "$choice_lines" | grep -c $'^start\t' || true)"
  awaiting_count="$(printf '%s\n' "$choice_lines" | grep -c $'^open\t\\*' || true)"
  local_count="$(printf '%s\n' "$choice_lines" | grep -c $'^open\t' || true)"

  header="$(
    printf '%s\n%s' \
      "enter: open  ·  ctrl-n: start or re-run a review  ·  esc: quit" \
      "+ ${new_count} new  ·  * ${awaiting_count} awaiting your review  ·  ${local_count} local"
  )"

  result="$(
    printf '%s\n' "$choice_lines" | fzf \
      --delimiter=$'\t' \
      --with-nth=2 \
      --prompt='prrr> ' \
      --header="$header" \
      --no-multi \
      --print-query \
      --expect=ctrl-n
  )" || status=$?

  # fzf: 0 selected, 1 no match, 2 error, 130 aborted.
  ((status == 130)) && return "$EXIT_CANCELLED"
  ((status > 1)) && die "fzf failed (exit ${status})"

  mapfile -t result_lines <<< "$result"
  query="${result_lines[0]-}"
  key="${result_lines[1]-}"
  selection="${result_lines[2]-}"

  # Trim so a stray space in the query does not look like a PR reference.
  query="${query#"${query%%[![:space:]]*}"}"
  query="${query%"${query##*[![:space:]]}"}"

  if [[ "$key" == ctrl-n ]]; then
    if [[ -n "$selection" ]]; then
      start_review_from_row "$selection"
    elif [[ -n "$query" ]]; then
      start_review_from_ref "$query"
    else
      die "ctrl-n needs a highlighted row, or a typed PR number or URL"
    fi
  fi

  [[ -n "$selection" ]] || return "$EXIT_CANCELLED"

  case "${selection%%$'\t'*}" in
    start)
      start_review_from_row "$selection"
      ;;
    open)
      payload="${selection#*$'\t'}"
      pick_artifact "${payload#*$'\t'}"
      ;;
    *)
      die "unexpected home picker action"
      ;;
  esac
}

discuss_artifact() {
  local review_dir=$1
  local artifact_path=$2
  local repo_dir_name owner repo pr_number clone_dir

  require_cmds wt agent

  repo_dir_name="$(basename "$(dirname "$review_dir")")"
  [[ "$repo_dir_name" == *--* ]] || die "cannot determine repository from ${review_dir}"
  owner="${repo_dir_name%%--*}"
  repo="${repo_dir_name#*--}"
  pr_number="$(basename "$review_dir")"
  pr_number="${pr_number#pr-}"

  if ! clone_dir="$(resolve_clone_dir "${owner}/${repo}")"; then
    die "no local clone of ${owner}/${repo} (checked cwd and ${DEV_ROOT}/${owner}/${repo}; set PRRR_DEV_ROOT to override)"
  fi

  exec wt -C "$clone_dir" switch --execute agent "pr:${pr_number}" -- \
    --mode ask -- \
    "Read ${artifact_path} carefully and be ready to discuss it. When ready, give a short briefing on what the artifact is and its key points, then wait for my questions."
}

# Re-run pr-review for an existing series.
# Optional mode: standard|deep (default: omitted). Deep always includes
# --full-rebuild so a same-head ready series can append a Deep epoch instead
# of no-oping; prior epochs and finding history are preserved.
rerun_review() {
  local review_dir=$1
  local mode=${2:-}
  local owner repo pr_number clone_dir pr_url
  local -a review_args=()

  [[ -x "$PR_REVIEW" ]] || die "missing launcher: $PR_REVIEW"

  case "$mode" in
    '' | standard | deep) ;;
    *)
      die "unknown review mode: ${mode}"
      ;;
  esac

  parse_review_identity "$review_dir" owner repo pr_number
  pr_url="https://github.com/${owner}/${repo}/pull/${pr_number}"

  if ! clone_dir="$(resolve_clone_dir "${owner}/${repo}")"; then
    die "no local clone of ${owner}/${repo} (checked cwd and ${DEV_ROOT}/${owner}/${repo}; set PRRR_DEV_ROOT to override)"
  fi

  if [[ -n "$mode" ]]; then
    review_args+=(--mode "$mode")
  fi
  if [[ "$mode" == deep ]]; then
    review_args+=(--full-rebuild)
  fi
  review_args+=("$pr_url")

  printf '%s: re-running pr-review%s in %s\n' \
    "$SCRIPT_NAME" \
    "${mode:+ (${mode})}" \
    "$clone_dir" >&2
  cd "$clone_dir" || die "failed to cd into ${clone_dir}"
  exec "$PR_REVIEW" "${review_args[@]}"
}

# Escape a string for use inside a single-quoted SQL literal.
sql_single_quote() {
  local value=$1
  printf "%s" "${value//\'/\'\'}"
}

# True when a Cursor chat store mentions this PR's review launch or discuss prompt.
# Review launches may include flags (e.g. --mode deep) between /pr-review and the URL.
chat_store_matches_pr() {
  local db=$1
  local pr_url=$2
  local discuss_needle=$3
  local pr_url_sql discuss_sql discuss_phrase_sql review_prefix_sql

  pr_url_sql="$(sql_single_quote "$pr_url")"
  discuss_sql="$(sql_single_quote "$discuss_needle")"
  discuss_phrase_sql="$(sql_single_quote 'be ready to discuss it')"
  review_prefix_sql="$(sql_single_quote '/pr-review')"

  [[ "$(
    sqlite3 -readonly "$db" \
      "SELECT 1 FROM blobs
       WHERE instr(data, CAST('${review_prefix_sql}' AS BLOB)) > 0
         AND instr(data, CAST('${pr_url_sql}' AS BLOB)) > 0
       LIMIT 1;"
  )" == 1 ]] && return 0

  [[ "$(
    sqlite3 -readonly "$db" \
      "SELECT 1 FROM blobs
       WHERE instr(data, CAST('${discuss_sql}' AS BLOB)) > 0
         AND instr(data, CAST('${discuss_phrase_sql}' AS BLOB)) > 0
       LIMIT 1;"
  )" == 1 ]]
}

# Print the newest chat id for this PR under clone_dir's Cursor workspace, or return 1.
latest_pr_agent_chat_id() {
  local owner=$1
  local repo=$2
  local pr_number=$3
  local clone_dir=$4
  local chats_root="${HOME}/.cursor/chats"
  local ws_hash pr_url discuss_needle chat_dir db meta_file
  local updated chat_id best_updated=0 best_id=""

  require_cmds md5 sqlite3 jq

  ws_hash="$(md5 -q -s "$clone_dir")"
  [[ -d "${chats_root}/${ws_hash}" ]] || return 1

  pr_url="https://github.com/${owner}/${repo}/pull/${pr_number}"
  discuss_needle="${ARTIFACTS_ROOT}/${owner}--${repo}/pr-${pr_number}/"

  for chat_dir in "${chats_root}/${ws_hash}"/*/; do
    [[ -d "$chat_dir" ]] || continue
    db="${chat_dir}store.db"
    [[ -f "$db" ]] || continue
    meta_file="${chat_dir}meta.json"
    [[ -f "$meta_file" ]] || continue

    updated="$(jq -r 'if .hasConversation == false then empty else (.updatedAtMs // 0) end' "$meta_file" 2>/dev/null || true)"
    [[ -n "$updated" ]] || continue
    [[ "$updated" =~ ^[0-9]+$ ]] || continue
    ((updated > best_updated)) || continue

    chat_store_matches_pr "$db" "$pr_url" "$discuss_needle" || continue

    chat_id="$(basename "${chat_dir%/}")"
    [[ "$chat_id" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || continue
    best_updated=$updated
    best_id="$chat_id"
  done

  [[ -n "$best_id" ]] || return 1
  printf '%s\n' "$best_id"
}

resume_pr_agent_session() {
  local review_dir=$1
  local owner repo pr_number clone_dir chat_id

  require_cmds agent

  parse_review_identity "$review_dir" owner repo pr_number

  if ! clone_dir="$(resolve_clone_dir "${owner}/${repo}")"; then
    die "no local clone of ${owner}/${repo} (checked cwd and ${DEV_ROOT}/${owner}/${repo}; set PRRR_DEV_ROOT to override)"
  fi

  if ! chat_id="$(latest_pr_agent_chat_id "$owner" "$repo" "$pr_number" "$clone_dir")"; then
    die "no agent session found for ${owner}/${repo}#${pr_number}"
  fi

  printf '%s: resuming agent session %s for %s/%s#%s\n' \
    "$SCRIPT_NAME" "$chat_id" "$owner" "$repo" "$pr_number" >&2
  exec agent --workspace "$clone_dir" --resume "$chat_id"
}

pick_artifact() {
  local review_dir=$1
  local artifact_lines result key selection artifact_path

  require_cmds fzf vim
  require_tty "interactive terminal required for picker"

  artifact_lines="$(list_artifacts "$review_dir")"
  [[ -n "$artifact_lines" ]] || die "no artifacts in ${review_dir}"

  # enter → vim; tab → discuss; space → re-review; ctrl-d → deep; ctrl-r → resume
  result="$(
    printf '%s\n' "$artifact_lines" | fzf \
      --delimiter=$'\t' \
      --with-nth=1 \
      --prompt='artifact> ' \
      --header="enter: vim  |  tab: discuss  |  ctrl-r: resume agent  |  space: re-review  |  ctrl-d: deep review (full rebuild)  |  ${review_dir#"${ARTIFACTS_ROOT}/"}" \
      --no-multi \
      --expect=tab,space,ctrl-r,ctrl-d \
      --bind 'enter:become(vim {2})' \
      || true
  )"

  [[ -n "$result" ]] || return "$EXIT_CANCELLED"
  key="${result%%$'\n'*}"
  case "$key" in
    space)
      rerun_review "$review_dir"
      ;;
    ctrl-d)
      rerun_review "$review_dir" deep
      ;;
    ctrl-r)
      resume_pr_agent_session "$review_dir"
      ;;
    tab)
      ;;
    *)
      die "unexpected artifact picker result"
      ;;
  esac
  selection="${result#*$'\n'}"
  artifact_path="${selection#*$'\t'}"
  discuss_artifact "$review_dir" "$artifact_path"
}

resolve_from_ref() {
  local ref=$1
  local pr_number candidate parsed selection
  local owner repo
  local -a matches=()

  case "$ref" in
    https://github.com/*/pull/*)
      [[ -x "$PR_PARSE" ]] || die "missing parser: $PR_PARSE"
      parsed="$("$PR_PARSE" "$ref")" || exit 1
      # gh-pr-parse prints OWNER=... REPO=... PR_NUMBER=...
      # shellcheck disable=SC2086
      eval "$parsed"
      owner="${OWNER:?}"
      repo="${REPO:?}"
      pr_number="${PR_NUMBER:?}"
      candidate="${ARTIFACTS_ROOT}/${owner}--${repo}/pr-${pr_number}"
      [[ -d "$candidate" ]] || die "no review artifacts at ${candidate}"
      printf '%s\n' "$candidate"
      ;;
    *[!0-9]*)
      die "expected a PR number or GitHub PR URL, got: ${ref}"
      ;;
    0)
      die "PR number must be a positive integer"
      ;;
    *)
      pr_number=$ref
      while IFS= read -r candidate; do
        [[ -d "$candidate" ]] || continue
        matches+=("$candidate")
      done < <(find "$ARTIFACTS_ROOT" -mindepth 2 -maxdepth 2 -type d -name "pr-${pr_number}" 2>/dev/null)

      if ((${#matches[@]} == 0)); then
        die "no review artifacts for pr-${pr_number} under ${ARTIFACTS_ROOT}"
      elif ((${#matches[@]} == 1)); then
        printf '%s\n' "${matches[0]}"
      else
        require_cmds fzf
        require_tty "interactive terminal required to disambiguate pr-${pr_number}"
        selection="$(
          printf '%s\n' "${matches[@]}" \
            | while IFS= read -r candidate; do
                printf '%s\t%s\n' "${candidate#"${ARTIFACTS_ROOT}/"}" "$candidate"
              done \
            | fzf \
                --delimiter=$'\t' \
                --with-nth=1 \
                --prompt='which repo> ' \
                --header="Multiple reviews for pr-${pr_number}" \
                --no-multi \
            || true
        )"
        [[ -n "$selection" ]] || return "$EXIT_CANCELLED"
        printf '%s\n' "${selection#*$'\t'}"
      fi
      ;;
  esac
}

# Parse a series dir into owner, repo, and PR number via nameref outs.
parse_review_identity() {
  local review_dir=$1
  local -n out_owner=$2
  local -n out_repo=$3
  local -n out_pr_number=$4
  local repo_dir_name

  repo_dir_name="$(basename "$(dirname "$review_dir")")"
  [[ "$repo_dir_name" == *--* ]] || die "cannot determine repository from ${review_dir}"
  out_owner="${repo_dir_name%%--*}"
  out_repo="${repo_dir_name#*--}"
  out_pr_number="$(basename "$review_dir")"
  out_pr_number="${out_pr_number#pr-}"
  [[ "$out_pr_number" =~ ^[1-9][0-9]*$ ]] || die "invalid review directory: ${review_dir}"
}

# Print absolute paths of every local pr-<n> series directory.
list_review_dirs() {
  local path

  [[ -d "$ARTIFACTS_ROOT" ]] || return 0

  while IFS= read -r path; do
    [[ -d "$path" ]] || continue
    is_review_dir "$path" || continue
    printf '%s\n' "$path"
  done < <(find "$ARTIFACTS_ROOT" -mindepth 2 -maxdepth 2 -type d -name 'pr-*' 2>/dev/null | sort)
}

# Print disposable epoch checkout branch names for a PR in a local clone.
list_epoch_worktrees() {
  local clone_dir=$1
  local pr_number=$2
  local branch

  require_cmds wt jq

  while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    [[ "$branch" =~ ^pr-${pr_number}-R[1-9][0-9]*$ ]] || continue
    printf '%s\n' "$branch"
  done < <(
    {
      wt -C "$clone_dir" list --format json --branches 2>/dev/null \
        | jq -r '.[].branch // empty'
      git -C "$clone_dir" for-each-ref --format='%(refname:short)' 'refs/heads/pr-*' 2>/dev/null
    } | sort -u
  )
}

remove_epoch_worktrees() {
  local clone_dir=$1
  local pr_number=$2
  local branch
  local -a branches=()

  while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    branches+=("$branch")
  done < <(list_epoch_worktrees "$clone_dir" "$pr_number")

  if ((${#branches[@]} == 0)); then
    printf '%s: no epoch worktrees for pr-%s in %s\n' "$SCRIPT_NAME" "$pr_number" "$clone_dir" >&2
    return 0
  fi

  require_cmds wt
  printf '%s: removing worktrees: %s\n' "$SCRIPT_NAME" "${branches[*]}" >&2
  # Epoch checkouts are disposable evidence pinned to observed heads; force both
  # dirty trees and unmerged-looking branches so closed-PR cleanup always lands.
  wt -C "$clone_dir" remove --yes --foreground --force -D "${branches[@]}"
}

remove_review_artifacts() {
  local review_dir=$1
  local pr_number=$2
  local series_parent sibling

  series_parent="$(dirname "$review_dir")"

  if [[ -d "$series_parent" ]]; then
    while IFS= read -r sibling; do
      [[ -e "$sibling" ]] || continue
      printf '%s: removing %s\n' "$SCRIPT_NAME" "$sibling" >&2
      rm -rf "$sibling"
    done < <(find "$series_parent" -mindepth 1 -maxdepth 1 \
      \( -name ".pr-${pr_number}.*" -o -name "pr-${pr_number}" \) 2>/dev/null)
  fi

  if [[ -d "$review_dir" ]]; then
    printf '%s: removing %s\n' "$SCRIPT_NAME" "$review_dir" >&2
    rm -rf "$review_dir"
  fi

  if [[ -d "$series_parent" ]] && [[ -z "$(ls -A "$series_parent" 2>/dev/null)" ]]; then
    printf '%s: removing empty %s\n' "$SCRIPT_NAME" "$series_parent" >&2
    rmdir "$series_parent" 2>/dev/null || true
  fi
}

review_is_stale() {
  local review_dir=$1
  local mtime now_epoch max_age_seconds

  mtime="$(stat -f '%m' "$review_dir")"
  now_epoch="$(date +%s)"
  max_age_seconds=$((CLEAN_MAX_AGE_DAYS * 86400))
  if ((now_epoch - mtime > max_age_seconds)); then
    return 0
  fi
  return 1
}

clean_one_review() {
  local review_dir=$1
  local owner repo pr_number clone_dir state_label reason

  parse_review_identity "$review_dir" owner repo pr_number

  state_label=""
  if ! state_label="$(
    gh pr view "$pr_number" --repo "${owner}/${repo}" --json state --jq '.state' 2>/dev/null
  )"; then
    state_label=""
  fi

  if [[ "$state_label" == MERGED || "$state_label" == CLOSED ]]; then
    reason="$state_label"
  elif review_is_stale "$review_dir"; then
    reason="older than ${CLEAN_MAX_AGE_DAYS}d"
  else
    if [[ -n "$state_label" ]]; then
      printf '%s: keep %s/%s#%s (%s)\n' \
        "$SCRIPT_NAME" "$owner" "$repo" "$pr_number" "$state_label" >&2
    else
      printf '%s: skip %s/%s#%s (could not query GitHub)\n' \
        "$SCRIPT_NAME" "$owner" "$repo" "$pr_number" >&2
    fi
    return 0
  fi

  printf '%s: cleaning %s %s/%s#%s\n' \
    "$SCRIPT_NAME" "$reason" "$owner" "$repo" "$pr_number" >&2

  if clone_dir="$(resolve_clone_dir "${owner}/${repo}")"; then
    remove_epoch_worktrees "$clone_dir" "$pr_number"
  else
    printf '%s: no local clone of %s/%s; skipping worktree cleanup\n' \
      "$SCRIPT_NAME" "$owner" "$repo" >&2
  fi

  remove_review_artifacts "$review_dir" "$pr_number"
}

# Remove local artifacts/worktrunks for closed/merged PRs, or reviews older than
# CLEAN_MAX_AGE_DAYS.
clean_closed_reviews() {
  local ref=${1:-}
  local review_dir
  local -a targets=()
  local cleaned=0

  require_cmds gh

  if [[ -n "$ref" ]]; then
    review_dir="$(resolve_from_ref "$ref")" || return $?
    targets+=("$review_dir")
  else
    while IFS= read -r review_dir; do
      [[ -n "$review_dir" ]] || continue
      targets+=("$review_dir")
    done < <(list_review_dirs)
  fi

  if ((${#targets[@]} == 0)); then
    printf '%s: no local reviews under %s\n' "$SCRIPT_NAME" "$ARTIFACTS_ROOT" >&2
    return 0
  fi

  for review_dir in "${targets[@]}"; do
    clean_one_review "$review_dir"
    cleaned=$((cleaned + 1))
  done

  printf '%s: checked %d review(s)\n' "$SCRIPT_NAME" "$cleaned" >&2
}

main() {
  local review_dir status

  if (($# >= 1)) && [[ "$1" == --clean ]]; then
    if (($# > 2)); then
      die "$USAGE"
    fi
    require_cmds gh
    clean_closed_reviews "${2:-}" || status=$?
    if [[ -n "${status:-}" ]]; then
      ((status == EXIT_CANCELLED)) && exit 0
      exit "$status"
    fi
    exit 0
  fi

  if (($# >= 1)) && [[ "$1" == start ]]; then
    if (($# != 2)); then
      die "usage: ${SCRIPT_NAME} start <PR-number-or-URL>"
    fi
    start_review_from_ref "$2"
  fi

  if (($# > 1)); then
    die "$USAGE"
  fi

  if (($# == 1)) && [[ "$1" == --new ]]; then
    die "--new was removed; use: ${SCRIPT_NAME} start <PR-number-or-URL>"
  fi

  if (($# == 1)) && [[ "$1" == -* ]]; then
    die "unknown option: $1"$'\n'"$USAGE"
  fi

  if (($# == 0)); then
    pick_home || status=$?
    if [[ -n "${status:-}" ]]; then
      ((status == EXIT_CANCELLED)) && exit 0
      exit "$status"
    fi
    exit 0
  fi

  review_dir="$(resolve_from_ref "$1")" || status=$?
  if [[ -n "${status:-}" ]]; then
    ((status == EXIT_CANCELLED)) && exit 0
    exit "$status"
  fi

  pick_artifact "$review_dir"
}

main "$@"
