  out_file="$TEST_ROOT/run-file-scouts-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    unset INCHWORM_SCOUT_FIXTURE_DIR 2>/dev/null || true
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_AGENT="$file_agent"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  finds_md=$(finds_md_for "$data_dir" "$repo_dir")
  problems=""

  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if grep -qi 'scout JSON invalid' "$out_file"; then
    problems="${problems}must not report invalid scout JSON when candidates were written to file"$'\n'
  fi
  if [ ! -f "$finds_md" ]; then
    problems="${problems}expected finds.md: $finds_md"$'\n'
  else
    for id in file-smell file-lint file-errors file-backlog; do
      if ! grep -q "$id" "$finds_md"; then
        problems="${problems}finds.md missing candidate $id"$'\n'
      fi
    done
  fi
  if ! grep -qiE 'selected F-file-' "$out_file"; then
    problems="${problems}expected a file-written candidate to be selected"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" \
      "finds.md:" "$(cat "$finds_md" 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

test_run_repo_guidance_injected_into_agent_prompts() {
  # .inchworm.yml guidance is plain text for agents (scouts + implementer).
  # Injected into prompts because .inchworm.yml is gitignored (absent from worktrees).
  test_name="repo guidance from .inchworm.yml is injected into scout and implementer prompts"
  now="2026-08-18T10:00:00"
  setup_eligible_run_env "guidance"
  guidance_marker="use honeybadger; do not touch hubspot sync"
  cat >"$repo_dir/.inchworm.yml" <<EOF
version: 1
guidance: |
  ${guidance_marker}
state:
  last_run_date: null
  active_draft_pr: null
EOF
  live_agent="$TEST_ROOT/run-guidance-agent"
  write_uncommitted_work_agent "$live_agent"
  # No scout fixtures → live scouts; no implement fixture → live implementer.
  # Seed one smell candidate via live agent (write_live_scout_agent pattern) but
  # keep implementer side-effect from write_uncommitted_work_agent.
  cat >"$live_agent" <<EOF
#!/usr/bin/env bash
printf '%s\n' "agent \$*" >>"$TEST_ROOT/agent-invocations.log"
prompt="\$*"
if printf '%s' "\$prompt" | grep -qi 'smell scout'; then
  printf '%s\n' '[{"id":"guidance-smell","source":"smell","title":"Guidance smell","summary":"pick me","rank":1,"status":"open"}]'
elif printf '%s' "\$prompt" | grep -qiE 'lint scout|errors scout|backlog scout'; then
  printf '%s\n' '[]'
elif printf '%s' "\$prompt" | grep -qi 'Work item:'; then
  printf '%s\n' "implemented by agent" >"./agent-work.txt"
  printf '%s\n' "Implemented the find."
  exit 0
fi
exit 0
EOF
  chmod +x "$live_agent"

  out_file="$TEST_ROOT/run-guidance-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    unset INCHWORM_SCOUT_FIXTURE_DIR 2>/dev/null || true
    unset INCHWORM_IMPLEMENT_FIXTURE 2>/dev/null || true
    export INCHWORM_AGENT="$live_agent"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  problems=""
  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [ ! -f "$TEST_ROOT/agent-invocations.log" ]; then
    problems="${problems}expected agent invocations log"$'\n'
  else
    # Agent -p prompts are multiline; flatten each "agent …" record to one line.
    flattened=$(
      awk '
        /^agent / { if (NR > 1) print buf; buf = $0; next }
        { buf = buf " " $0 }
        END { if (length(buf)) print buf }
      ' "$TEST_ROOT/agent-invocations.log"
    )
    scout_hits=$(printf '%s\n' "$flattened" | grep -ci 'smell scout' || true)
    impl_hits=$(printf '%s\n' "$flattened" | grep -ci 'Work item:' || true)
    if [ "${scout_hits:-0}" -lt 1 ]; then
      problems="${problems}expected smell scout invocation"$'\n'
    fi
    if [ "${impl_hits:-0}" -lt 1 ]; then
      problems="${problems}expected implementer invocation"$'\n'
    fi
    if ! printf '%s\n' "$flattened" | grep -Fq "$guidance_marker"; then
      problems="${problems}expected guidance text in agent prompts"$'\n'
    fi
    if ! printf '%s\n' "$flattened" | grep -F 'smell scout' | grep -Fq "$guidance_marker"; then
      problems="${problems}expected guidance on smell scout prompt"$'\n'
    fi
    if ! printf '%s\n' "$flattened" | grep -F 'Work item:' | grep -Fq "$guidance_marker"; then
      problems="${problems}expected guidance on implementer prompt"$'\n'
    fi
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" \
      "agent log:" "$(cat "$TEST_ROOT/agent-invocations.log" 2>/dev/null || true)" \
      "repo yml:" "$(cat "$repo_dir/.inchworm.yml" 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

test_run_live_implement_commits_agent_work() {
  test_name="live implementer work is committed before push so draft PR has commits"
  now="2026-08-18T10:00:00"
  setup_eligible_run_env "live-impl"
  live_agent="$TEST_ROOT/run-live-impl-agent"
  write_uncommitted_work_agent "$live_agent"
  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"live-commit","source":"smell","title":"Commit my work","summary":"agent leaves changes uncommitted","rank":1,"status":"open"}]'

  out_file="$TEST_ROOT/run-live-impl-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    unset INCHWORM_IMPLEMENT_FIXTURE 2>/dev/null || true
    export INCHWORM_AGENT="$live_agent"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  finds_md=$(finds_md_for "$data_dir" "$repo_dir")
  draft_cache=$(yaml_get "$repo_dir/.inchworm.yml" "state.active_draft_pr" 2>/dev/null || printf 'ERR')
  branch_name=$(first_implement_branch "$repo_dir")
  problems=""

  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [ -z "$branch_name" ]; then
    problems="${problems}expected an implement branch after live implement"$'\n'
  else
    ahead=$(git -C "$repo_dir" rev-list --count "origin/develop..$branch_name" 2>/dev/null || printf '0')
    if [ "$ahead" -lt 1 ]; then
      problems="${problems}expected >=1 commit ahead of origin/develop on $branch_name, got: $ahead"$'\n'
    fi
    if ! git -C "$repo_dir" show "$branch_name:agent-work.txt" >/dev/null 2>&1; then
      problems="${problems}agent work must be committed on $branch_name"$'\n'
    fi
  fi
  if ! assert_gh_pr_create_draft "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}expected gh pr create --draft --base develop after committed implement"$'\n'"$(cat "$TEST_ROOT/gh-invocations.log" 2>/dev/null || true)"$'\n'
  fi
  if [ "$draft_cache" != "https://example.test/pr/99" ]; then
    problems="${problems}expected active_draft_pr set, got: $draft_cache"$'\n'
  fi
  if [ -f "$finds_md" ] && ! grep -A30 'live-commit' "$finds_md" | grep -qiE 'status:[[:space:]]*in_pr'; then
    problems="${problems}selected find must be in_pr after draft PR"$'\n'
  fi
  if ! assert_agent_argv_safe "$TEST_ROOT/agent-invocations.log"; then
    problems="${problems}agent argv must not include --yolo/--force/--trust"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" \
      "finds.md:" "$(cat "$finds_md" 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

