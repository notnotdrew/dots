write_mock_notify() {
  mock_path=$1
  cat >"$mock_path" <<EOF
#!/usr/bin/env bash
set -u
printf '%s\n' "\$*" >>"${TEST_ROOT}/notify-invocations.log"
exit 0
EOF
  chmod +x "$mock_path"
}

# Phase 5: notify that logs argv then exits non-zero (fallback path).
write_mock_notify_failing() {
  mock_path=$1
  cat >"$mock_path" <<EOF
#!/usr/bin/env bash
set -u
printf '%s\n' "\$*" >>"${TEST_ROOT}/notify-invocations.log"
