    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    run_inchworm run
  ) >"$out_file" 2>&1

  # make_repo sets user.name "Fixture Author".
  branch_name=$(git -C "$repo_dir" branch --list 'fixture-author/*' 2>/dev/null | sed 's/^[*+ ]*//' | head -n 1)
  problems=""
