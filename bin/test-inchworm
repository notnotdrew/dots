    problems="${problems}blocked run must not stamp the day, got: $after_last"$'\n'
  fi
  if ! assert_no_gh_pr_create "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}blocked run must not open a second draft"$'\n'
  fi
