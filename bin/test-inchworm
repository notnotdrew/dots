}

# True when no implement checkout remains (legacy .inchworm/worktrees/ or Worktrunk sibling).
assert_no_inchworm_worktree_registered() {
  repo=$1
  list=$(git -C "$repo" worktree list 2>/dev/null || true)
  if printf '%s' "$list" | grep -F '.inchworm/worktrees' >/dev/null; then
    return 1
  fi
  if printf '%s' "$list" | grep -F "${repo}.${TEST_BRANCH_PREFIX}-" >/dev/null; then
    return 1
  fi
  if [ -d "$repo/.inchworm/worktrees" ]; then
    return 1
  fi
  return 0
}

# Worktrunk default: <repo>.<branch with / as -> beside the repo, not under .inchworm/.
expected_worktree_path_for() {
  repo=$1
  find_id=$2
  ymd=$3
  printf '%s.%s-%s-%s\n' "$repo" "$TEST_BRANCH_PREFIX" "$find_id" "$ymd"
}

assert_wt_switch_logged() {
  log=${1:-$TEST_ROOT/wt-invocations.log}
  [ -f "$log" ] || return 1
  grep -E '(^|[[:space:]])switch([[:space:]]|$)' "$log" >/dev/null
}

assert_wt_remove_keeps_branch_logged() {
  log=${1:-$TEST_ROOT/wt-invocations.log}
  [ -f "$log" ] || return 1
  grep -F -- '--no-delete-branch' "$log" >/dev/null
}

# True if repo has an implement branch and/or a Worktrunk implement checkout.
assert_implement_worktree_or_branch() {
  repo=$1
  if git -C "$repo" branch --list "$TEST_BRANCH_PREFIX/*" 2>/dev/null | grep -q .; then
    return 0
  fi
  if git -C "$repo" worktree list 2>/dev/null | grep -qF "${repo}.${TEST_BRANCH_PREFIX}-"; then
    return 0
  fi
  return 1
}

# Extract first implement branch name (empty if none).
first_implement_branch() {
  repo=$1
  # Strip checkout markers: * (current) and + (checked out in another worktree).
  git -C "$repo" branch --list "$TEST_BRANCH_PREFIX/*" 2>/dev/null | sed 's/^[*+ ]*//' | head -n 1
}

# The runner names itself only when the name reads as a word. Path-shaped
# mentions (.inchworm/pr, bin/inchworm, …/inchworm) are fine: a leading dot or
# slash is excluded the same way. `inchworm/…` at the start of a branch name
# still matches. Plain grep -w would still trip on those paths.
TOOL_NAME_WORD_RE='(^|[^[:alnum:]_./])inchworm([^[:alnum:]_]|$)'

# The runner never names itself where a reviewer can see it.
assert_no_tool_name_in_branch_commits() {
  repo=$1
  branch=$2
  git -C "$repo" log --format='%B' "origin/develop..$branch" 2>/dev/null |
    grep -qiE "$TOOL_NAME_WORD_RE" && return 1
  return 0
}

# Same check against what actually reached the remote — the only history the
# human sees when the ping arrives.
assert_no_tool_name_in_remote_commits() {
  origin=$1
  branch=$2
  git -C "$origin" log --format='%B' "develop..$branch" 2>/dev/null |
    grep -qiE "$TOOL_NAME_WORD_RE" && return 1
  return 0
}

# Commits ahead of origin/develop on an implement branch (0 when unknown).
branch_commit_count() {
  repo=$1
  branch=$2
  git -C "$repo" rev-list --count "origin/develop..$branch" 2>/dev/null || printf '0'
}

# True when a path is present in a branch's tree (works on a bare origin too).
branch_has_file() {
  repo=$1
  branch=$2
  path=$3
  git -C "$repo" show "$branch:$path" >/dev/null 2>&1
}

write_scout_fixture_dir() {
  # $1 = fixture dir; remaining args unused — caller writes JSON files.
  fixture_dir=$1
  mkdir -p "$fixture_dir"
}

write_smell_candidates_json() {
  # Writes smell.json to fixture dir. Body is raw JSON array string ($2).
  fixture_dir=$1
  json_body=$2
  mkdir -p "$fixture_dir"
  printf '%s\n' "$json_body" >"$fixture_dir/smell.json"
}

write_finds_md() {
  # Seed durable finds.md for merge/pick scenarios.
  finds_md=$1
  body=$2
  mkdir -p "$(dirname "$finds_md")"
  printf '%s\n' "$body" >"$finds_md"
}

run_inchworm() {
  # stdout+stderr captured by caller via redirection; exit status returned.
  if [ ! -x "$INCHWORM" ]; then
    printf '%s\n' "error: inchworm binary missing or not executable: $INCHWORM"
    return 127
  fi
  # Prevent a leaked parent INCHWORM_BRANCH_PREFIX from overriding yaml
  # branch_prefix. Tests that need the override export it in their subshell
  # before calling us.
  prefix_env=()
  if [ -z "${INCHWORM_BRANCH_PREFIX+x}" ]; then
    prefix_env=(env -u INCHWORM_BRANCH_PREFIX)
  fi
  PATH="$TEST_ROOT/fake-bin:$PATH" \
    INCHWORM_AGENT="${INCHWORM_AGENT:-$TEST_ROOT/fake-bin/agent}" \
    INCHWORM_CURSOR_PROJECTS_DIR="${INCHWORM_CURSOR_PROJECTS_DIR:-$TEST_ROOT/cursor-projects}" \
    "${prefix_env[@]}" "$INCHWORM" "$@"
}

seed_registered_repo() {
  # Manually seed what init would create so run/status tests stay independent
  # of init when the binary is only partially implemented — but Phase 1 RED
  # still requires init to create these. For run tests we seed after assuming
  # production will match this shape.
  repo_dir=$1
  config_dir=$2
  last_run=${3:-null}

  mkdir -p "$config_dir"
  cat >"$config_dir/config.yml" <<EOF
version: 1
defaults:
  runtime: cursor-cli
  schedule:
    days: [mon, tue, wed, thu, fri]
    window_local: "08:00-15:00"
    catch_up_missed_days: false
    poll_interval_hint: 1h
repos:
  - path: ${repo_dir}
EOF

  if [ "$last_run" = "null" ]; then
    last_run_yaml="null"
  else
    last_run_yaml="\"$last_run\""
  fi

  cat >"$repo_dir/.inchworm.yml" <<EOF
version: 1
guidance: ""
branch_prefix: "${TEST_BRANCH_PREFIX}"
state:
  last_run_date: ${last_run_yaml}
  active_draft_pr: null
EOF
}

# Shared eligible-run bootstrap: registered repo, mocks, data/fixture dirs.
setup_eligible_run_env() {
  # Sets globals used by discover/implement/review tests: config_dir, repo_dir,
  # origin_dir, mock_gh, mock_pr_review, mock_notify, data_dir, fixture_dir,
  # now, implement_fixture (caller may override before call).
  suffix=${1:-$tests_run}
  now=${now:-2026-08-18T10:00:00}
  implement_fixture=${implement_fixture:-success}
  config_dir="$TEST_ROOT/run-$suffix-config"
  repo_dir="$TEST_ROOT/run-$suffix-repo"
  origin_dir="$TEST_ROOT/run-$suffix-origin.git"
  mock_gh="$TEST_ROOT/run-$suffix-gh"
  mock_pr_review="$TEST_ROOT/run-$suffix-pr-review"
  mock_notify="$TEST_ROOT/run-$suffix-notify"
  data_dir="$TEST_ROOT/run-$suffix-data"
  fixture_dir="$TEST_ROOT/run-$suffix-fixtures"
  make_repo "$repo_dir"
  seed_registered_repo "$repo_dir" "$config_dir" "null"
  add_local_origin "$repo_dir" "$origin_dir"
  write_mock_gh "$mock_gh" "none"
  write_mock_pr_review "$mock_pr_review"
  write_mock_notify "$mock_notify"
  mkdir -p "$data_dir" "$fixture_dir"
  rm -f "$TEST_ROOT/gh-pr-title.txt" "$TEST_ROOT/gh-pr-body.txt"
  : >"$TEST_ROOT/agent-invocations.log"
  : >"$TEST_ROOT/gh-invocations.log"
  : >"$TEST_ROOT/pr-review-invocations.log"
  : >"$TEST_ROOT/notify-invocations.log"
  : >"$TEST_ROOT/wt-invocations.log"
}

assert_finds_md_structure() {
  # Soft structural checks for Phase 2 finds.md shape.
  finds_md=$1
  [ -f "$finds_md" ] || return 1
  grep -q 'Inchworm finds' "$finds_md" || return 1
  grep -q 'inchworm:finds-version:1' "$finds_md" || return 1
  return 0
}

# --- A. init -----------------------------------------------------------------

test_init_creates_repo_config_and_registry() {
  test_name="init creates .inchworm.yml, registers repo, writes global defaults, appends gitignore"
  config_dir="$TEST_ROOT/init-config"
  gitignore_file="$TEST_ROOT/init-gitignore"
  repo_dir="$TEST_ROOT/init-repo"
  mkdir -p "$config_dir"
  : >"$gitignore_file"
  make_repo "$repo_dir"

  out_file="$TEST_ROOT/init-out.txt"
  (
    cd "$repo_dir" || exit 1
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_GITIGNORE_GLOBAL="$gitignore_file"
    unset INCHWORM_NOW INCHWORM_GH INCHWORM_REPO 2>/dev/null || true
    run_inchworm init
  ) >"$out_file" 2>&1
  status=$?

  if [ "$status" -ne 0 ]; then
    fail "$test_name" "expected exit 0, got $status" "output:" "$(cat "$out_file")"
    return
  fi

  repo_yml="$repo_dir/.inchworm.yml"
  global_yml="$config_dir/config.yml"
  problems=""

  if [ ! -f "$repo_yml" ]; then
    problems="${problems}missing $repo_yml"$'\n'
  else
    version=$(yaml_get "$repo_yml" "version" 2>/dev/null || printf 'ERR')
    last=$(yaml_get "$repo_yml" "state.last_run_date" 2>/dev/null || printf 'ERR')
    draft=$(yaml_get "$repo_yml" "state.active_draft_pr" 2>/dev/null || printf 'ERR')
    guidance=$(yaml_get "$repo_yml" "guidance" 2>/dev/null || printf 'ERR')
    if [ "$version" != "1" ]; then
      problems="${problems}expected version 1, got: $version"$'\n'
    fi
    if [ "$last" != "null" ]; then
      problems="${problems}expected state.last_run_date null, got: $last"$'\n'
    fi
    if [ "$draft" != "null" ]; then
      problems="${problems}expected state.active_draft_pr null, got: $draft"$'\n'
    fi
    if [ "$guidance" = "null" ]; then
      problems="${problems}expected guidance key on init (empty string OK)"$'\n'
    elif [ -n "$guidance" ]; then
      problems="${problems}expected guidance empty on init, got: $guidance"$'\n'
    fi
  fi

  if [ ! -f "$global_yml" ]; then
    problems="${problems}missing $global_yml"$'\n'
  else
    runtime=$(yaml_get "$global_yml" "defaults.runtime" 2>/dev/null || printf 'ERR')
    window=$(yaml_get "$global_yml" "defaults.schedule.window_local" 2>/dev/null || printf 'ERR')
    if [ "$runtime" != "cursor-cli" ]; then
      problems="${problems}expected defaults.runtime cursor-cli, got: $runtime"$'\n'
    fi
    if [ "$window" != "08:00-15:00" ]; then
      problems="${problems}expected defaults.schedule.window_local 08:00-15:00, got: $window"$'\n'
    fi
    if ! yaml_has_exact_repo_once "$global_yml" "$repo_dir"; then
      problems="${problems}expected repos to contain absolute path exactly once: $repo_dir"$'\n'
    fi
  fi

  if ! file_contains_line "$gitignore_file" ".inchworm.yml"; then
    problems="${problems}gitignore missing .inchworm.yml"$'\n'
  fi
  if ! file_contains_line "$gitignore_file" ".inchworm/"; then
    problems="${problems}gitignore missing .inchworm/"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_init_is_idempotent() {
  test_name="init is idempotent (does not duplicate repo path)"
  config_dir="$TEST_ROOT/init-idem-config"
  gitignore_file="$TEST_ROOT/init-idem-gitignore"
  repo_dir="$TEST_ROOT/init-idem-repo"
  mkdir -p "$config_dir"
  : >"$gitignore_file"
  make_repo "$repo_dir"

  out_file="$TEST_ROOT/init-idem-out.txt"
  (
    cd "$repo_dir" || exit 1
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_GITIGNORE_GLOBAL="$gitignore_file"
    run_inchworm init
    run_inchworm init
  ) >"$out_file" 2>&1
  status=$?

  if [ "$status" -ne 0 ]; then
    fail "$test_name" "expected exit 0, got $status" "output:" "$(cat "$out_file")"
    return
  fi

  global_yml="$config_dir/config.yml"
  if [ ! -f "$global_yml" ]; then
    fail "$test_name" "missing $global_yml" "output:" "$(cat "$out_file")"
    return
  fi

  count=$(yaml_repo_occurrences "$global_yml" "$repo_dir" 2>/dev/null || printf '0')
  if [ "$count" != "1" ]; then
    fail "$test_name" "expected repo path exactly once, got count=$count" "output:" "$(cat "$out_file")"
    return
  fi

  # Ignore entries should still appear once each (no runaway duplication required,
  # but must remain present).
  yml_count=$(grep -Fxc -- ".inchworm.yml" "$gitignore_file" || true)
  dir_count=$(grep -Fxc -- ".inchworm/" "$gitignore_file" || true)
  if [ "$yml_count" -lt 1 ] || [ "$dir_count" -lt 1 ]; then
    fail "$test_name" "gitignore entries missing after second init"
    return
  fi
  if [ "$yml_count" -gt 1 ] || [ "$dir_count" -gt 1 ]; then
    fail "$test_name" "gitignore entries duplicated (yml=$yml_count dir=$dir_count)"
    return
  fi

  pass "$test_name"
}

# --- C. run eligibility (Phase 1 gates; no finds update on skip) -------------

assert_run_refuses_without_stamp() {
  test_name=$1
  now=$2
  reason_substr=$3
  last_run_seed=${4:-null}
  gh_mode=${5:-none}

  config_dir="$TEST_ROOT/run-$tests_run-config"
  repo_dir="$TEST_ROOT/run-$tests_run-repo"
  mock_gh="$TEST_ROOT/run-$tests_run-gh"
  data_dir="$TEST_ROOT/run-$tests_run-data"
  fixture_dir="$TEST_ROOT/run-$tests_run-fixtures"
  make_repo "$repo_dir"
  seed_registered_repo "$repo_dir" "$config_dir" "$last_run_seed"
  write_mock_gh "$mock_gh" "$gh_mode"
  mkdir -p "$data_dir" "$fixture_dir"
  write_smell_candidates_json "$fixture_dir" '[{"id":"should-not-merge","source":"smell","title":"Skip me","summary":"must not land on refuse","rank":1,"status":"open"}]'
  : >"$TEST_ROOT/agent-invocations.log"
  : >"$TEST_ROOT/gh-invocations.log"

  before_last=$(yaml_get "$repo_dir/.inchworm.yml" "state.last_run_date")
  expected_finds=$(finds_md_for "$data_dir" "$repo_dir")

  out_file="$TEST_ROOT/run-$tests_run-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    unset INCHWORM_REPO 2>/dev/null || true
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  after_last=$(yaml_get "$repo_dir/.inchworm.yml" "state.last_run_date" 2>/dev/null || printf 'ERR')

  problems=""
  if [ "$status" -eq 127 ] && [ ! -x "$INCHWORM" ]; then
    problems="${problems}inchworm binary missing (expected for RED until GREEN)"$'\n'
  elif ! grep -qiE "$reason_substr" "$out_file"; then
    # Soft refuse may exit 0 or non-zero; require a clear skip/refuse reason in output.
    problems="${problems}expected output to mention /$reason_substr/"$'\n'
  fi
  if [ "$after_last" != "$before_last" ]; then
    problems="${problems}last_run_date changed from '$before_last' to '$after_last' (must not stamp on refuse/skip)"$'\n'
  fi
  if [ -e "$expected_finds" ]; then
    problems="${problems}finds.md must not be created/updated on refuse/skip: $expected_finds"$'\n'
  fi
  if [ -s "$TEST_ROOT/agent-invocations.log" ]; then
    problems="${problems}agent/codex was invoked:"$'\n'"$(cat "$TEST_ROOT/agent-invocations.log")"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "exit=$status" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_refuses_weekend() {
  # 2026-08-15 is Saturday
  assert_run_refuses_without_stamp \
    "run refuses weekend and does not stamp last_run_date" \
    "2026-08-15T10:00:00" \
    "weekend|not a weekday|saturday|sat"
}

test_run_refuses_at_or_after_window_end() {
  # Tuesday 15:00 — half-open window ends; refuse at/after 15:00
  assert_run_refuses_without_stamp \
    "run refuses at/after 15:00 and does not stamp" \
    "2026-08-18T15:00:00" \
    "window|outside|15:00|after"
}

test_run_refuses_before_window() {
  assert_run_refuses_without_stamp \
    "run refuses before 08:00 and does not stamp" \
    "2026-08-18T07:59:00" \
    "window|outside|before|08:00"
}

test_run_refuses_same_day_relaunch() {
  assert_run_refuses_without_stamp \
    "run refuses same-day re-launch when last_run_date already today" \
    "2026-08-18T10:00:00" \
    "already|same.?day|last_run|launched today" \
    "2026-08-18"
}

test_run_skips_blocking_draft_without_stamp() {
  test_name="run skips a blocking draft without stamping last_run_date"
  now="2026-08-18T10:00:00"
  config_dir="$TEST_ROOT/run-draft-config"
  repo_dir="$TEST_ROOT/run-draft-repo"
  mock_gh="$TEST_ROOT/run-draft-gh"
  data_dir="$TEST_ROOT/run-draft-data"
  fixture_dir="$TEST_ROOT/run-draft-fixtures"
  make_repo "$repo_dir"
  seed_registered_repo "$repo_dir" "$config_dir" "null"
  write_mock_gh "$mock_gh" "blocking_draft"
  mkdir -p "$data_dir" "$fixture_dir"
  write_smell_candidates_json "$fixture_dir" '[{"id":"draft-skip","source":"smell","title":"No","summary":"skip","rank":1,"status":"open"}]'
  : >"$TEST_ROOT/agent-invocations.log"
  : >"$TEST_ROOT/gh-invocations.log"
  expected_finds=$(finds_md_for "$data_dir" "$repo_dir")

  out_file="$TEST_ROOT/run-draft-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  after_last=$(yaml_get "$repo_dir/.inchworm.yml" "state.last_run_date" 2>/dev/null || printf 'ERR')
  draft_cache=$(yaml_get "$repo_dir/.inchworm.yml" "state.active_draft_pr" 2>/dev/null || printf 'ERR')

  problems=""
  if [ "$status" -eq 127 ] && [ ! -x "$INCHWORM" ]; then
    problems="${problems}inchworm binary missing (expected for RED until GREEN)"$'\n'
  elif ! grep -qiE "draft|blocking" "$out_file"; then
    problems="${problems}expected skip reason mentioning draft/blocking"$'\n'
  fi
  if [ "$after_last" != "null" ]; then
    problems="${problems}expected last_run_date to remain null, got: $after_last"$'\n'
  fi
  if [ -e "$expected_finds" ]; then
    problems="${problems}finds.md must not be created on draft skip: $expected_finds"$'\n'
  fi
  # May refresh active_draft_pr cache to match blocking PR (url or owner/repo#n).
  if [ -x "$INCHWORM" ]; then
    if ! grep -q "pr list" "$TEST_ROOT/gh-invocations.log" 2>/dev/null; then
      problems="${problems}expected gh pr list invocation for draft discovery"$'\n'
      problems="${problems}gh log: $(tr '\n' ' ' <"$TEST_ROOT/gh-invocations.log" 2>/dev/null)"$'\n'
    elif ! grep -F -- '--json' "$TEST_ROOT/gh-invocations.log" >/dev/null \
      || ! grep -F -- 'number,url,isDraft,headRefName' "$TEST_ROOT/gh-invocations.log" >/dev/null \
      || ! grep -F -- '@me' "$TEST_ROOT/gh-invocations.log" >/dev/null; then
      problems="${problems}gh pr list argv missing expected flags"$'\n'
      problems="${problems}expected roughly: gh pr list --author @me --state open --json number,url,isDraft,headRefName"$'\n'
      problems="${problems}gh argv log:"$'\n'"$(cat "$TEST_ROOT/gh-invocations.log")"$'\n'
    fi
  fi
  if [ -s "$TEST_ROOT/agent-invocations.log" ]; then
    problems="${problems}agent/codex was invoked"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "exit=$status" "output:" "$(cat "$out_file")" "active_draft_pr=$draft_cache"
    return
  fi
  pass "$test_name"
}

# --- C2. Phase 3 eligible run: discover → implement → draft PR ---------------

test_run_eligible_implements_and_opens_draft_pr() {
  # Phase 3: after stamp + pick, implement fixture success → worktree + draft PR.
  test_name="run eligible implements selected find, opens draft PR, sets active_draft_pr"
  now="2026-08-18T10:00:00"
  implement_fixture=success
  setup_eligible_run_env "ok"

  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"smell-unused-helper","source":"smell","title":"Remove unused helper","summary":"Dead helper in lib/unused.rb","rank":1,"status":"open"}]'

  out_file="$TEST_ROOT/run-ok-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  after_last=$(yaml_get "$repo_dir/.inchworm.yml" "state.last_run_date" 2>/dev/null || printf 'ERR')
  draft_cache=$(yaml_get "$repo_dir/.inchworm.yml" "state.active_draft_pr" 2>/dev/null || printf 'ERR')
  finds_md=$(finds_md_for "$data_dir" "$repo_dir")
  expected_pr_url="https://example.test/pr/99"

  problems=""
  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [ "$after_last" != "2026-08-18" ]; then
    problems="${problems}expected last_run_date 2026-08-18, got: $after_last"$'\n'
  fi
  if [ ! -f "$finds_md" ]; then
    problems="${problems}expected finds.md at $finds_md"$'\n'
  else
    if ! assert_finds_md_structure "$finds_md"; then
      problems="${problems}finds.md missing header/version markers"$'\n'
    fi
    if ! grep -q 'smell-unused-helper' "$finds_md"; then
      problems="${problems}finds.md missing candidate id smell-unused-helper"$'\n'
    fi
    if ! grep -A30 'smell-unused-helper' "$finds_md" | grep -qiE 'status:[[:space:]]*in_pr'; then
      problems="${problems}selected find must be marked status: in_pr after draft PR"$'\n'
    fi
  fi
  if ! grep -q 'smell-unused-helper' "$out_file"; then
    problems="${problems}expected selected find id in output"$'\n'
  fi
  if ! grep -qiE 'Remove unused helper' "$out_file"; then
    problems="${problems}expected selected find title in output"$'\n'
  fi
  if ! assert_implement_worktree_or_branch "$repo_dir"; then
    problems="${problems}expected implement branch or worktree after implement"$'\n'
  else
    branch_name=$(first_implement_branch "$repo_dir")
    if [ -n "$branch_name" ]; then
      case "$branch_name" in
        "$TEST_BRANCH_PREFIX"/*) ;;
        *)
          problems="${problems}branch must start with $TEST_BRANCH_PREFIX/, got: $branch_name"$'\n'
          ;;
      esac
      if ! printf '%s' "$branch_name" | grep -q '20260818'; then
        problems="${problems}expected YYYYMMDD (20260818) in branch name, got: $branch_name"$'\n'
      fi
    fi
  fi
  if ! assert_gh_pr_create_draft "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}expected gh pr create --draft"$'\n'"$(cat "$TEST_ROOT/gh-invocations.log" 2>/dev/null || true)"$'\n'
  fi
  if [ "$draft_cache" != "$expected_pr_url" ]; then
    problems="${problems}expected state.active_draft_pr=$expected_pr_url, got: $draft_cache"$'\n'
  fi
  if ! grep -qiE "$expected_pr_url|opened draft|draft pr|draft pull" "$out_file"; then
    problems="${problems}expected PR URL or opened-draft signal in output"$'\n'
  fi
  if ! assert_agent_argv_safe "$TEST_ROOT/agent-invocations.log"; then
    problems="${problems}agent argv must not include --yolo/--force/--trust"$'\n'"$(cat "$TEST_ROOT/agent-invocations.log")"$'\n'
  fi

  # Stamp burned: same-day second run must refuse (no second pick / PR).
  : >"$TEST_ROOT/gh-invocations.log"
  second_out="$TEST_ROOT/run-ok-second-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$second_out" 2>&1
  if ! grep -qiE 'already|same.?day|last_run|launched today' "$second_out"; then
    problems="${problems}same-day second run must refuse (stamp burned)"$'\n'
  fi
  if ! assert_no_gh_pr_create "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}same-day second run must not call gh pr create"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" "finds.md:" "$(cat "$finds_md" 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

test_run_pretrusts_implement_worktree() {
  # A fresh worktree is never trusted, and the agent CLI refuses to start in an
  # untrusted directory while --trust is forbidden. inchworm must write the trust
  # marker itself, keyed by a slug of the worktree's physical path.
  test_name="implement worktree is pre-trusted for the agent before it runs"
  now="2026-08-18T10:00:00"
  implement_fixture=success
  setup_eligible_run_env "trust-worktree"
  projects_dir="$TEST_ROOT/cursor-projects-trust"

  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"smell-trust","source":"smell","title":"Trust marker find","summary":"Worktree must be pre-trusted","rank":1,"status":"open"}]'

  out_file="$TEST_ROOT/run-trust-worktree-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_NOTIFY="$mock_notify"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    export INCHWORM_CURSOR_PROJECTS_DIR="$projects_dir"
    run_inchworm run
  ) >"$out_file" 2>&1

  problems=""
  worktree_path=$(expected_worktree_path_for "$repo_dir" "smell-trust" "20260818")
  worktree_dir_name=$(basename "$worktree_path")

  # The physical path is what the agent slugifies, and TEST_ROOT may sit behind a
  # symlink (/var -> /private/var), so match on the recorded workspacePath.
  marker=$(grep -rl -F "$worktree_dir_name" "$projects_dir" 2>/dev/null | head -n 1)
  if [ -z "$marker" ]; then
    problems="${problems}expected a .workspace-trusted marker naming $worktree_dir_name under $projects_dir"$'\n'
  else
    case "$(basename "$marker")" in
      .workspace-trusted) ;;
      *) problems="${problems}marker must be named .workspace-trusted, got: $(basename "$marker")"$'\n' ;;
    esac
    if ! grep -q '"workspacePath"' "$marker"; then
      problems="${problems}marker must record workspacePath"$'\n'
    fi
    if ! grep -q '"trustedAt"' "$marker"; then
      problems="${problems}marker must record trustedAt"$'\n'
    fi
    # Slug is derived from the physical path: alphanumerics kept, everything else
    # collapsed to single dashes.
    slug_dir=$(basename "$(dirname "$marker")")
    if printf '%s' "$slug_dir" | grep -qE '[^a-zA-Z0-9-]|--|^-|-$'; then
      problems="${problems}marker dir must be a dash-slug of the path, got: $slug_dir"$'\n'
    fi
    recorded=$(sed -n 's/.*"workspacePath": "\([^"]*\)".*/\1/p' "$marker")
    if [ "$slug_dir" != "$(printf '%s' "$recorded" | sed 's/[^a-zA-Z0-9]/-/g; s/--*/-/g; s/^-*//; s/-*$//')" ]; then
      problems="${problems}marker dir $slug_dir does not match slug of recorded path $recorded"$'\n'
    fi
  fi
  # Markers must land in the overridden projects dir, never the real ~/.cursor.
  if [ ! -d "$projects_dir" ]; then
    problems="${problems}expected projects dir $projects_dir to be created"$'\n'
  fi
  if ! assert_agent_argv_safe "$TEST_ROOT/agent-invocations.log"; then
    problems="${problems}agent argv must not include --yolo/--force/--trust"$'\n'"$(cat "$TEST_ROOT/agent-invocations.log")"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" \
      "markers:" "$(find "$projects_dir" -type f 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

test_run_implement_failure_defers_without_pr_or_second_pick() {
  test_name="implement fail marks deferred, no PR, stamp burned; skips review/fix/ping"
  now="2026-08-18T10:00:00"
  implement_fixture=fail
  setup_eligible_run_env "impl-fail"

  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"smell-risky","source":"smell","title":"Risky change","summary":"Should defer on fail","rank":1,"status":"open"},{"id":"smell-second","source":"smell","title":"Second find","summary":"Must not be picked after fail","rank":2,"status":"open"}]'

  out_file="$TEST_ROOT/run-impl-fail-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=blocking
    export INCHWORM_FIX_FIXTURE=success
    export INCHWORM_NOTIFY="$mock_notify"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  after_last=$(yaml_get "$repo_dir/.inchworm.yml" "state.last_run_date" 2>/dev/null || printf 'ERR')
  draft_cache=$(yaml_get "$repo_dir/.inchworm.yml" "state.active_draft_pr" 2>/dev/null || printf 'ERR')
  finds_md=$(finds_md_for "$data_dir" "$repo_dir")

  problems=""
  # Soft: implement failure may exit non-zero; require clear failure signal.
  if [ "$status" -eq 127 ] && [ ! -x "$INCHWORM" ]; then
    problems="${problems}inchworm binary missing"$'\n'
  elif ! grep -qiE 'implement (fail|failed)|deferred|too_?large|could not implement' "$out_file"; then
    problems="${problems}expected implement-failed / deferred signal in output"$'\n'
  fi
  if [ "$after_last" != "2026-08-18" ]; then
    problems="${problems}expected last_run_date stamped 2026-08-18, got: $after_last"$'\n'
  fi
  if [ "$draft_cache" != "null" ]; then
    problems="${problems}active_draft_pr must stay null on implement failure, got: $draft_cache"$'\n'
  fi
  if ! assert_no_gh_pr_create "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}must not call gh pr create on implement failure"$'\n'"$(cat "$TEST_ROOT/gh-invocations.log")"$'\n'
  fi
  if [ ! -f "$finds_md" ]; then
    problems="${problems}missing finds.md"$'\n'
  elif ! grep -A30 'smell-risky' "$finds_md" | grep -qiE 'status:[[:space:]]*deferred'; then
    problems="${problems}failed find smell-risky must be status: deferred"$'\n'
  fi
  # Must not have selected / advanced the second find as a replacement pick.
  if grep -qiE 'smell-second|Second find' "$out_file" \
    && ! grep -qiE 'smell-risky|Risky change|deferred|implement' "$out_file"; then
    problems="${problems}must not select second find after implement failure"$'\n'
  fi
  if grep -A30 'smell-second' "$finds_md" 2>/dev/null | grep -qiE 'status:[[:space:]]*in_pr'; then
    problems="${problems}second find must not be marked in_pr"$'\n'
  fi
  if ! assert_agent_argv_safe "$TEST_ROOT/agent-invocations.log"; then
    problems="${problems}agent argv must not include --yolo/--force/--trust"$'\n'
  fi

  # Phase 4: implement failure must skip review / fixer / ping entirely.
  if ! assert_no_pr_review "$TEST_ROOT/pr-review-invocations.log"; then
    problems="${problems}implement fail must not invoke Standard pr-review"$'\n'"$(cat "$TEST_ROOT/pr-review-invocations.log" 2>/dev/null || true)"$'\n'
  fi
  if ! assert_no_notify "$TEST_ROOT/notify-invocations.log"; then
    problems="${problems}implement fail must not ping/notify"$'\n'"$(cat "$TEST_ROOT/notify-invocations.log" 2>/dev/null || true)"$'\n'
  fi
  review_dir=$(review_dir_for "$data_dir" "$repo_dir")
  if [ -e "$review_dir" ]; then
    problems="${problems}implement fail must not write review artifacts: $review_dir"$'\n'
  fi
  if ! assert_no_fix_fixture_side_effect "$data_dir" "$repo_dir"; then
    problems="${problems}implement fail must not run fixer (fix fixture side-effect present)"$'\n'
  fi

  # Same-day relaunch still refused — stamp burned; no re-pick.
  : >"$TEST_ROOT/gh-invocations.log"
  second_out="$TEST_ROOT/run-impl-fail-second-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE=success
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_NOTIFY="$mock_notify"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$second_out" 2>&1
  if ! grep -qiE 'already|same.?day|last_run|launched today' "$second_out"; then
    problems="${problems}same-day run after implement failure must refuse"$'\n'
  fi
  if ! assert_no_gh_pr_create "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}same-day refuse must not open a PR"$'\n'
  fi
  if grep -qiE 'smell-second|Second find' "$second_out"; then
    problems="${problems}same-day refuse must not pick second find"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" "finds.md:" "$(cat "$finds_md" 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

test_run_implement_too_large_marks_without_pr() {
  test_name="implement too_large marks find too_large and does not open PR"
  now="2026-08-18T10:00:00"
  implement_fixture=too_large
  setup_eligible_run_env "impl-large"

  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"smell-huge","source":"smell","title":"Huge refactor","summary":"Too large for one day","rank":1,"status":"open"}]'

  out_file="$TEST_ROOT/run-impl-large-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$out_file" 2>&1

  after_last=$(yaml_get "$repo_dir/.inchworm.yml" "state.last_run_date" 2>/dev/null || printf 'ERR')
  draft_cache=$(yaml_get "$repo_dir/.inchworm.yml" "state.active_draft_pr" 2>/dev/null || printf 'ERR')
  finds_md=$(finds_md_for "$data_dir" "$repo_dir")

  problems=""
  if [ "$after_last" != "2026-08-18" ]; then
    problems="${problems}expected stamp 2026-08-18, got: $after_last"$'\n'
  fi
  if [ "$draft_cache" != "null" ]; then
    problems="${problems}active_draft_pr must stay null, got: $draft_cache"$'\n'
  fi
  if ! assert_no_gh_pr_create "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}must not call gh pr create"$'\n'
  fi
  if [ ! -f "$finds_md" ] \
    || ! grep -A30 'smell-huge' "$finds_md" | grep -qiE 'status:[[:space:]]*too_large'; then
    problems="${problems}find smell-huge must be status: too_large"$'\n'
  fi
  if ! grep -qiE 'too_?large|too large' "$out_file"; then
    problems="${problems}expected too_large signal in output"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" "finds.md:" "$(cat "$finds_md" 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

test_finds_path_hash_isolates_repos() {
  test_name="finds path hash isolates different absolute repo paths"
  data_dir="$TEST_ROOT/hash-data"
  repo_a="$TEST_ROOT/hash-repo-a"
  repo_b="$TEST_ROOT/hash-repo-b"
  make_repo "$repo_a"
  make_repo "$repo_b"

  hash_a=$(repo_path_hash "$repo_a")
  hash_b=$(repo_path_hash "$repo_b")
  dir_a=$(finds_dir_for "$data_dir" "$repo_a")
  dir_b=$(finds_dir_for "$data_dir" "$repo_b")

  problems=""
  if [ "$hash_a" = "$hash_b" ]; then
    problems="${problems}expected different path hashes for different abs paths ($hash_a)"$'\n'
  fi
  if [ "${#hash_a}" -ne 16 ] || ! printf '%s' "$hash_a" | grep -Eq '^[0-9a-f]{16}$'; then
    problems="${problems}hash_a must be 16 lowercase hex, got: $hash_a"$'\n'
  fi

  # Production must use the same hash: eligible run on repo_a must write under
  # dir_a only, never create dir_b.
  config_dir="$TEST_ROOT/hash-config"
  mock_gh="$TEST_ROOT/hash-gh"
  fixture_dir="$TEST_ROOT/hash-fixtures"
  seed_registered_repo "$repo_a" "$config_dir" "null"
  write_mock_gh "$mock_gh" "none"
  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"only-in-a","source":"smell","title":"A only","summary":"isolated","rank":1,"status":"open"}]'
  : >"$TEST_ROOT/agent-invocations.log"
  : >"$TEST_ROOT/gh-invocations.log"

  out_file="$TEST_ROOT/hash-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="2026-08-18T10:00:00"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE=success
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    export INCHWORM_REPO="$repo_a"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  finds_a="$dir_a/finds.md"
  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0 for repo_a run, got $status"$'\n'
  fi
  if [ ! -f "$finds_a" ]; then
    problems="${problems}expected finds under hashed dir for repo_a: $finds_a"$'\n'
  fi
  if [ -e "$dir_b" ]; then
    problems="${problems}must not create finds dir for unrelated repo_b: $dir_b"$'\n'
  fi
  if [ -f "$finds_a" ] && ! grep -q 'only-in-a' "$finds_a"; then
    problems="${problems}finds.md for repo_a missing candidate only-in-a"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "hash_a=$hash_a hash_b=$hash_b" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_pick_none_when_no_open_finds() {
  test_name="eligible run with empty fixtures prints none; no implement/PR"
  now="2026-08-18T10:00:00"
  implement_fixture=success
  setup_eligible_run_env "none"

  write_smell_candidates_json "$fixture_dir" '[]'

  out_file="$TEST_ROOT/run-none-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  after_last=$(yaml_get "$repo_dir/.inchworm.yml" "state.last_run_date" 2>/dev/null || printf 'ERR')
  draft_cache=$(yaml_get "$repo_dir/.inchworm.yml" "state.active_draft_pr" 2>/dev/null || printf 'ERR')
  finds_md=$(finds_md_for "$data_dir" "$repo_dir")

  problems=""
  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [ "$after_last" != "2026-08-18" ]; then
    problems="${problems}expected stamp 2026-08-18, got: $after_last"$'\n'
  fi
  if [ "$draft_cache" != "null" ]; then
    problems="${problems}active_draft_pr must stay null when pick none, got: $draft_cache"$'\n'
  fi
  if [ ! -f "$finds_md" ]; then
    problems="${problems}expected finds.md structure even when no candidates: $finds_md"$'\n'
  elif ! assert_finds_md_structure "$finds_md"; then
    problems="${problems}finds.md missing header/version when empty"$'\n'
  fi
  if ! grep -qiE '\bnone\b|no (open )?find|nothing to pick|no eligible' "$out_file"; then
    problems="${problems}expected clear none/no-find signal in output"$'\n'
  fi
  if ! assert_no_gh_pr_create "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}must not call gh pr create"$'\n'
  fi
  if assert_implement_worktree_or_branch "$repo_dir"; then
    problems="${problems}pick none must not create an implement branch or worktree"$'\n'
  fi
  if [ -s "$TEST_ROOT/agent-invocations.log" ]; then
    problems="${problems}pick none must not invoke implementer agent"$'\n'"$(cat "$TEST_ROOT/agent-invocations.log")"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" "finds.md:" "$(cat "$finds_md" 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

test_run_live_scouts_all_four_sources() {
  test_name="eligible run without scout fixtures invokes smell/lint/errors/backlog agents"
  now="2026-08-18T10:00:00"
  implement_fixture=success
  setup_eligible_run_env "live-scouts"
  live_agent="$TEST_ROOT/run-live-scouts-agent"
  write_live_scout_agent "$live_agent"

  out_file="$TEST_ROOT/run-live-scouts-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    unset INCHWORM_SCOUT_FIXTURE_DIR 2>/dev/null || true
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_AGENT="$live_agent"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  finds_md=$(finds_md_for "$data_dir" "$repo_dir")
  after_last=$(yaml_get "$repo_dir/.inchworm.yml" "state.last_run_date" 2>/dev/null || printf 'ERR')
  problems=""

  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [ "$after_last" != "2026-08-18" ]; then
    problems="${problems}expected stamp 2026-08-18, got: $after_last"$'\n'
  fi
  if ! grep -qiE 'selected F-live-smell|Live smell find' "$out_file"; then
    problems="${problems}expected pick of live-smell (rank 1) from live scouts"$'\n'
  fi
  if [ ! -f "$finds_md" ]; then
    problems="${problems}expected finds.md from live scouts: $finds_md"$'\n'
  else
    for id in live-smell live-lint live-errors live-backlog; do
      if ! grep -q "$id" "$finds_md"; then
        problems="${problems}finds.md missing candidate $id"$'\n'
      fi
    done
  fi
  for source in smell lint errors backlog; do
    if ! grep -qi "${source} scout" "$TEST_ROOT/agent-invocations.log"; then
      problems="${problems}expected live ${source} scout agent invocation"$'\n'
    fi
  done
  if ! assert_agent_argv_safe "$TEST_ROOT/agent-invocations.log"; then
    problems="${problems}scout agent argv must not include --yolo/--force/--trust"$'\n'"$(cat "$TEST_ROOT/agent-invocations.log")"$'\n'
  fi
  if ! assert_gh_pr_create_draft "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}expected draft PR after live scout pick"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" \
      "agent log:" "$(cat "$TEST_ROOT/agent-invocations.log" 2>/dev/null || true)" \
      "finds.md:" "$(cat "$finds_md" 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

test_run_live_scouts_tolerate_prose_stdout() {
  test_name="live scouts read candidates from scout output file when stdout is prose"
  now="2026-08-18T10:00:00"
  implement_fixture=success
  setup_eligible_run_env "file-scouts"
  file_agent="$TEST_ROOT/run-file-scouts-agent"
