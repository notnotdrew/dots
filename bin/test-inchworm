# Fake git that refuses `reset --soft` (the sanitize rewrite) and otherwise
# delegates to the real binary. Absolute path avoids re-entering this shim.
write_reset_failing_git() {
  bin_dir=$1
  real_git=$(command -v git)
  mkdir -p "$bin_dir"
  cat >"$bin_dir/git" <<EOF
#!/usr/bin/env bash
set -u
for arg in "\$@"; do
  if [ "\$arg" = "--soft" ]; then
    printf '%s\n' "fake git: refusing reset --soft" >&2
    exit 1
  fi
done
exec "$real_git" "\$@"
EOF
  chmod +x "$bin_dir/git"
}

# Live-scout mock that only narrates on stdout and writes candidate JSON to the
# scout output file named in the prompt (real agents rarely emit bare JSON).
write_file_writing_scout_agent() {
  agent_path=$1
  cat >"$agent_path" <<EOF
#!/usr/bin/env bash
printf '%s\n' "agent \$*" >>"$TEST_ROOT/agent-invocations.log"
prompt="\$*"
out_path=\$(printf '%s' "\$prompt" | grep -oE '/[^[:space:]]*/(smell|lint|errors|backlog)\.json' | head -n 1)
source_name=""
if printf '%s' "\$prompt" | grep -qi 'smell scout'; then
  source_name=smell
elif printf '%s' "\$prompt" | grep -qi 'lint scout'; then
  source_name=lint
elif printf '%s' "\$prompt" | grep -qi 'errors scout'; then
  source_name=errors
elif printf '%s' "\$prompt" | grep -qi 'backlog scout'; then
  source_name=backlog
fi
if [ -n "\$source_name" ] && [ -n "\$out_path" ]; then
  printf '%s\n' "[{\"id\":\"file-\$source_name\",\"source\":\"\$source_name\",\"title\":\"File \$source_name find\",\"summary\":\"written to file\",\"rank\":1,\"status\":\"open\"}]" >"\$out_path"
fi
printf '%s\n' "I reviewed the workspace and wrote my candidates to the requested file."
exit 0
EOF
  chmod +x "$agent_path"
}

# Live-scout mock: record argv and emit one candidate per scout source from the prompt.
write_live_scout_agent() {
  agent_path=$1
  cat >"$agent_path" <<EOF
#!/usr/bin/env bash
printf '%s\n' "agent \$*" >>"$TEST_ROOT/agent-invocations.log"
prompt="\$*"
if printf '%s' "\$prompt" | grep -qi 'smell scout'; then
  printf '%s\n' '[{"id":"live-smell","source":"smell","title":"Live smell find","summary":"from smell scout","rank":1,"status":"open"}]'
elif printf '%s' "\$prompt" | grep -qi 'lint scout'; then
  printf '%s\n' '[{"id":"live-lint","source":"lint","title":"Live lint find","summary":"from lint scout","rank":2,"status":"open"}]'
elif printf '%s' "\$prompt" | grep -qi 'errors scout'; then
  printf '%s\n' '[{"id":"live-errors","source":"errors","title":"Live errors find","summary":"from errors scout","rank":3,"status":"open"}]'
elif printf '%s' "\$prompt" | grep -qi 'backlog scout'; then
  printf '%s\n' '[{"id":"live-backlog","source":"backlog","title":"Live backlog find","summary":"from backlog scout","rank":4,"status":"open"}]'
else
  # Implementer / fixer / other agent calls: succeed with no scout JSON.
  exit 0
fi
exit 0
EOF
  chmod +x "$agent_path"
}

# Assert recorded agent argv never includes dangerous trust flags.
assert_agent_argv_safe() {
  log=$1
  [ -f "$log" ] || return 0
  if grep -E -- '(^|[[:space:]])(--yolo|--force|--trust)([[:space:]]|$)' "$log" >/dev/null 2>&1; then
    return 1
  fi
  return 0
}

# Assert mock gh never saw `pr create`.
assert_no_gh_pr_create() {
  log=$1
  [ -f "$log" ] || return 0
  if grep -E '(^|[[:space:]])pr[[:space:]].*create' "$log" >/dev/null 2>&1; then
    return 1
  fi
  return 0
}

# Assert mock gh saw `pr create` with `--draft` and `--base develop`.
assert_gh_pr_create_draft() {
  log=$1
  [ -f "$log" ] || return 1
  if ! grep -E '(^|[[:space:]])pr[[:space:]].*create' "$log" >/dev/null 2>&1; then
    return 1
  fi
  if ! grep -E '(^|[[:space:]])--draft([[:space:]]|$)' "$log" >/dev/null 2>&1; then
    return 1
  fi
  if ! grep -E '(^|[[:space:]])--base[[:space:]]+develop([[:space:]]|$)' "$log" >/dev/null 2>&1; then
    return 1
  fi
  return 0
}

# Count non-empty lines in an invocations log (0 if missing/empty).
count_log_lines() {
  log=$1
  if [ ! -f "$log" ]; then
    printf '0\n'
    return
  fi
  # grep -c exits 1 when count is 0; still prints 0 — do not ||-append another 0.
  count=$(grep -c . "$log" 2>/dev/null || true)
  printf '%s\n' "${count:-0}"
}

# Assert Standard pr-review was invoked exactly once (and not a lite path).
assert_pr_review_once() {
  log=$1
  count=$(count_log_lines "$log")
  [ "$count" = "1" ] || return 1
  if grep -qiE 'inchworm-lite|lite.?review' "$log" 2>/dev/null; then
    return 1
  fi
  return 0
}

assert_no_pr_review() {
  log=$1
  count=$(count_log_lines "$log")
  [ "$count" = "0" ]
}

assert_notify_once_with_pr_url() {
  log=$1
  pr_url=$2
  count=$(count_log_lines "$log")
  [ "$count" = "1" ] || return 1
  grep -Fq -- "$pr_url" "$log" || return 1
  return 0
}

assert_no_notify() {
  log=$1
  count=$(count_log_lines "$log")
  [ "$count" = "0" ]
}

assert_review_artifacts_present() {
  review_dir=$1
  ledger="$review_dir/findings-ledger.md"
  [ -f "$ledger" ] || return 1
  return 0
}

assert_no_fix_fixture_side_effect() {
  data_dir=$1
  repo_path=$2
  marker=$(fix_fixture_ran_for "$data_dir" "$repo_path")
  [ ! -e "$marker" ]
}

assert_fix_fixture_ran() {
  data_dir=$1
  repo_path=$2
  expected=$3
  marker=$(fix_fixture_ran_for "$data_dir" "$repo_path")
  [ -f "$marker" ] || return 1
  actual=$(tr -d '[:space:]' <"$marker")
  [ "$actual" = "$expected" ]
}

# Mock Standard pr-review launcher. Writes fixture artifacts under
# INCHWORM_REVIEW_ARTIFACT_DIR via production write_fixture (keeps ledger in sync).
write_mock_pr_review() {
  mock_path=$1
  review_helper="$DOTS/bin/lib/inchworm_review.rb"
  cat >"$mock_path" <<EOF
#!/usr/bin/env bash
set -u
printf '%s\n' "\$*" >>"${TEST_ROOT}/pr-review-invocations.log"

# Reject lite / yolo flags if somehow passed through.
for arg in "\$@"; do
  case "\$arg" in
    --yolo|--force|--trust)
      printf '%s\n' "mock pr-review: forbidden flag: \$arg" >&2
      exit 2
      ;;
    *inchworm-lite*|*lite-review*)
      printf '%s\n' "mock pr-review: lite path forbidden" >&2
      exit 2
      ;;
  esac
done

artifact_dir="\${INCHWORM_REVIEW_ARTIFACT_DIR:-}"
if [ -z "\$artifact_dir" ]; then
  printf '%s\n' "mock pr-review: INCHWORM_REVIEW_ARTIFACT_DIR unset" >&2
  exit 2
fi

fixture="\${INCHWORM_REVIEW_FIXTURE:-none}"
case "\$fixture" in
  none|advisory|blocking) ;;
  *)
    printf '%s\n' "mock pr-review: unknown INCHWORM_REVIEW_FIXTURE=\$fixture" >&2
    exit 2
    ;;
esac

if command -v mise >/dev/null 2>&1; then
  mise exec -- ruby "${review_helper}" write_fixture "\$fixture" "\$artifact_dir"
else
  ruby "${review_helper}" write_fixture "\$fixture" "\$artifact_dir"
fi
printf '%s\n' "inchworm: mock Standard pr-review complete (\$fixture)"
exit 0
EOF
  chmod +x "$mock_path"
}

