    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    unset INCHWORM_IMPLEMENT_FIXTURE 2>/dev/null || true
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  finds_md=$(finds_md_for "$data_dir" "$repo_dir")
  draft_cache=$(yaml_get "$repo_dir/.inchworm.yml" "state.active_draft_pr" 2>/dev/null || printf 'ERR')
  problems=""

  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if ! assert_no_gh_pr_create "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}must not call gh pr create when implement produced no commits"$'\n'
  fi
  if [ "$draft_cache" != "null" ]; then
    problems="${problems}active_draft_pr must stay null, got: $draft_cache"$'\n'
  fi
  if [ ! -f "$finds_md" ]; then
    problems="${problems}missing finds.md"$'\n'
  elif ! grep -A30 'live-noop' "$finds_md" | grep -qiE 'status:[[:space:]]*deferred'; then
    problems="${problems}find live-noop must be deferred when no commits were produced"$'\n'
  fi
  if ! grep -qiE 'no commits|no change|deferred' "$out_file"; then
    problems="${problems}expected a no-commits/deferred signal in output"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" \
      "finds.md:" "$(cat "$finds_md" 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

# --- Authored output: branch, commit message, PR copy ------------------------

test_run_authors_branch_and_pr_from_find() {
  # With no agent copy to work from, the branch, commit, and PR still read as
  # something a person wrote, and carry the find's reason for the change.
  test_name="branch, commit, and PR are authored for humans and never name the runner"
  now="2026-08-18T10:00:00"
  implement_fixture=success
  setup_eligible_run_env "authored"
  fault_url="https://app.honeybadger.io/projects/1/faults/987654"

  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"export-retries","source":"errors","title":"Stop retrying exports that already failed","summary":"One failed export fills the retry queue and blocks the rest.","evidence":"'"$fault_url"'","rank":1,"status":"open"}]'

  out_file="$TEST_ROOT/run-authored-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    run_inchworm run
  ) >"$out_file" 2>&1

  branch_name=$(first_implement_branch "$repo_dir")
  pr_title=$(cat "$TEST_ROOT/gh-pr-title.txt" 2>/dev/null || true)
  pr_body=$(cat "$TEST_ROOT/gh-pr-body.txt" 2>/dev/null || true)
  problems=""

  if [ -z "$branch_name" ]; then
    problems="${problems}expected implement branch"$'\n'
  else
    case "$branch_name" in
      "$TEST_BRANCH_PREFIX"/export-retries-20260818) ;;
      *)
        problems="${problems}expected $TEST_BRANCH_PREFIX/export-retries-20260818, got: $branch_name"$'\n'
        ;;
    esac
    subject=$(git -C "$repo_dir" log -1 --format='%s' "$branch_name" 2>/dev/null || true)
    if [ "$subject" != "Stop retrying exports that already failed" ]; then
      problems="${problems}expected commit subject from the find title, got: $subject"$'\n'
    fi
  fi
  if printf '%s' "$branch_name" | grep -qi 'inchworm'; then
    problems="${problems}branch must not name the runner: $branch_name"$'\n'
  fi
  if [ "$pr_title" != "Stop retrying exports that already failed" ]; then
    problems="${problems}expected PR title from the find title, got: $pr_title"$'\n'
  fi
  if ! printf '%s' "$pr_body" | grep -Fq "One failed export fills the retry queue"; then
    problems="${problems}PR body must say why the change was made"$'\n'
  fi
  if ! printf '%s' "$pr_body" | grep -Fq "$fault_url"; then
    problems="${problems}PR body must link the evidence a reviewer can open"$'\n'
  fi
  if printf '%s\n%s' "$pr_title" "$pr_body" | grep -qi 'inchworm'; then
    problems="${problems}PR title/body must not name the runner"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" \
      "pr title:" "$pr_title" "pr body:" "$pr_body"
    return
  fi
  pass "$test_name"
}

test_run_uses_agent_authored_pr_copy() {
  # The implementer knows the change best, so its title and body win — minus any
  # line naming the runner, and without the draft files reaching the commit.
  test_name="agent-written PR copy is used, scrubbed, and kept out of the commit"
  now="2026-08-18T10:00:00"
  setup_eligible_run_env "pr-copy"
  live_agent="$TEST_ROOT/run-pr-copy-agent"
  write_pr_authoring_agent "$live_agent"
  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"export-retries","source":"errors","title":"Stop retrying failed exports","summary":"One failed export blocks the queue.","evidence":"https://app.honeybadger.io/projects/1/faults/987654","rank":1,"status":"open"}]'

  out_file="$TEST_ROOT/run-pr-copy-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    unset INCHWORM_IMPLEMENT_FIXTURE 2>/dev/null || true
    export INCHWORM_AGENT="$live_agent"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    run_inchworm run
  ) >"$out_file" 2>&1

  branch_name=$(first_implement_branch "$repo_dir")
  pr_title=$(cat "$TEST_ROOT/gh-pr-title.txt" 2>/dev/null || true)
  pr_body=$(cat "$TEST_ROOT/gh-pr-body.txt" 2>/dev/null || true)
  problems=""

  if [ "$pr_title" != "Stop retrying exports that already failed" ]; then
    problems="${problems}expected the agent's PR title, got: $pr_title"$'\n'
  fi
  if ! printf '%s' "$pr_body" | grep -Fq "Exports kept retrying"; then
    problems="${problems}expected the agent's PR body, got: $pr_body"$'\n'
  fi
  if printf '%s\n%s' "$pr_title" "$pr_body" | grep -qi 'inchworm'; then
    problems="${problems}PR copy must drop lines naming the runner"$'\n'
  fi
  if [ -z "$branch_name" ]; then
    problems="${problems}expected implement branch"$'\n'
  else
    if git -C "$repo_dir" ls-tree -r --name-only "$branch_name" | grep -q '^\.inchworm'; then
      problems="${problems}PR draft files must not be committed"$'\n'
    fi
    if ! git -C "$repo_dir" show "$branch_name:agent-work.txt" >/dev/null 2>&1; then
      problems="${problems}agent work must be committed on $branch_name"$'\n'
    fi
    subject=$(git -C "$repo_dir" log -1 --format='%s' "$branch_name" 2>/dev/null || true)
    body=$(git -C "$repo_dir" log -1 --format='%b' "$branch_name" 2>/dev/null || true)
    if [ "$subject" != "Stop retrying failed exports" ]; then
      problems="${problems}expected fallback commit subject, got: $subject"$'\n'
    fi
    if ! printf '%s' "$body" | grep -Fq "One failed export blocks the queue."; then
      problems="${problems}fallback commit body must carry the find's summary"$'\n'
    fi
    if ! printf '%s' "$body" | grep -Fq "faults/987654"; then
      problems="${problems}fallback commit body must carry the evidence link"$'\n'
    fi
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" \
      "pr title:" "$pr_title" "pr body:" "$pr_body"
    return
  fi
  pass "$test_name"
}

test_run_rewrites_commit_that_names_the_runner() {
  # Nothing is pushed until the branch is clean, so a leaked name is rewritten
  # rather than shipped to the reviewer.
  test_name="commit message naming the runner is rewritten before the branch is pushed"
  now="2026-08-18T10:00:00"
  setup_eligible_run_env "scrub-commit"
  live_agent="$TEST_ROOT/run-scrub-commit-agent"
  write_tool_naming_commit_agent "$live_agent"
  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"export-retries","source":"errors","title":"Stop retrying failed exports","summary":"One failed export blocks the queue.","rank":1,"status":"open"}]'

  out_file="$TEST_ROOT/run-scrub-commit-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    unset INCHWORM_IMPLEMENT_FIXTURE 2>/dev/null || true
    export INCHWORM_AGENT="$live_agent"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    run_inchworm run
  ) >"$out_file" 2>&1

  branch_name=$(first_implement_branch "$repo_dir")
  problems=""

  if [ -z "$branch_name" ]; then
    problems="${problems}expected implement branch"$'\n'
  else
    if ! assert_no_tool_name_in_branch_commits "$repo_dir" "$branch_name"; then
      problems="${problems}commit messages must not name the runner:"$'\n'"$(git -C "$repo_dir" log --format='%B' "origin/develop..$branch_name")"$'\n'
    fi
    subject=$(git -C "$repo_dir" log -1 --format='%s' "$branch_name" 2>/dev/null || true)
    if [ "$subject" != "Stop retrying failed exports" ]; then
      problems="${problems}expected rewritten subject from the find title, got: $subject"$'\n'
    fi
    if ! git -C "$repo_dir" show "$branch_name:agent-work.txt" >/dev/null 2>&1; then
      problems="${problems}rewrite must keep the agent's work"$'\n'
    fi
  fi
  if ! assert_gh_pr_create_draft "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}expected the draft PR to open after the rewrite"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_keeps_commit_that_only_names_the_draft_path() {
  # .inchworm/ is where the runner keeps its scratch files, not a name a
  # reviewer would object to — mentioning that path must not cost the agent
  # the commit message it wrote.
  test_name="commit naming only the .inchworm/ path is kept, not rewritten"
  now="2026-08-18T10:00:00"
  setup_eligible_run_env "keep-path-commit"
  live_agent="$TEST_ROOT/run-keep-path-commit-agent"
  write_path_mentioning_commit_agent "$live_agent"
  # Title differs from the agent's subject so a rewrite is visible.
  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"export-retries","source":"errors","title":"Reduce export retries","summary":"One failed export blocks the queue.","rank":1,"status":"open"}]'

  out_file="$TEST_ROOT/run-keep-path-commit-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    unset INCHWORM_IMPLEMENT_FIXTURE 2>/dev/null || true
    export INCHWORM_AGENT="$live_agent"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    run_inchworm run
  ) >"$out_file" 2>&1

  branch_name=$(first_implement_branch "$repo_dir")
  problems=""

  if [ -z "$branch_name" ]; then
    problems="${problems}expected implement branch"$'\n'
  else
    subject=$(git -C "$repo_dir" log -1 --format='%s' "$branch_name" 2>/dev/null || true)
    if [ "$subject" != "Stop retrying failed exports" ]; then
      problems="${problems}expected the agent's own subject to survive, got: $subject"$'\n'
    fi
    body=$(git -C "$repo_dir" log -1 --format='%b' "$branch_name" 2>/dev/null || true)
    if ! printf '%s' "$body" | grep -Fq '.inchworm/pr'; then
      problems="${problems}expected the agent's .inchworm/pr mention to survive, got: $body"$'\n'
    fi
    if ! printf '%s' "$body" | grep -Fq 'bin/inchworm'; then
      problems="${problems}expected the agent's bin/inchworm mention to survive, got: $body"$'\n'
    fi
    if ! assert_no_tool_name_in_branch_commits "$repo_dir" "$branch_name"; then
      problems="${problems}a .inchworm/ path must not count as naming the runner"$'\n'
    fi
    if ! git -C "$repo_dir" show "$branch_name:agent-work.txt" >/dev/null 2>&1; then
      problems="${problems}agent work must be committed on $branch_name"$'\n'
    fi
  fi
  if grep -qi 'rewriting as a single commit' "$out_file"; then
    problems="${problems}must not rewrite a commit that only names the draft path"$'\n'
  fi
  if ! assert_gh_pr_create_draft "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}expected the draft PR to open"$'\n'"$(cat "$TEST_ROOT/gh-invocations.log" 2>/dev/null || true)"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_defers_when_rewrite_fallback_also_names_the_runner() {
  # Rejecting the agent's copy is pointless if the find's own words leak the
  # name instead — that branch never reaches a reviewer.
  test_name="rewrite fallback that names the runner defers instead of opening a draft"
  now="2026-08-18T10:00:00"
  setup_eligible_run_env "dirty-fallback"
  live_agent="$TEST_ROOT/run-dirty-fallback-agent"
  write_tool_naming_commit_agent "$live_agent"
  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"export-retries","source":"errors","title":"Rename the inchworm helper","summary":"The inchworm helper name confuses readers.","rank":1,"status":"open"},{"id":"smell-second","source":"smell","title":"Second find","summary":"Must not be picked after the failure.","rank":2,"status":"open"}]'

  out_file="$TEST_ROOT/run-dirty-fallback-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    unset INCHWORM_IMPLEMENT_FIXTURE 2>/dev/null || true
    export INCHWORM_AGENT="$live_agent"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    run_inchworm run
  ) >"$out_file" 2>&1

  finds_md=$(finds_md_for "$data_dir" "$repo_dir")
  draft_cache=$(yaml_get "$repo_dir/.inchworm.yml" "state.active_draft_pr" 2>/dev/null || printf 'ERR')
  after_last=$(yaml_get "$repo_dir/.inchworm.yml" "state.last_run_date" 2>/dev/null || printf 'ERR')
  problems=""

  if ! assert_no_gh_pr_create "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}must not open a draft when the fallback names the runner"$'\n'"$(cat "$TEST_ROOT/gh-invocations.log" 2>/dev/null || true)"$'\n'
  fi
  if [ "$draft_cache" != "null" ]; then
    problems="${problems}active_draft_pr must stay null, got: $draft_cache"$'\n'
  fi
  if [ "$after_last" != "2026-08-18" ]; then
    problems="${problems}stamp must still be burned, got: $after_last"$'\n'
  fi
  if [ ! -f "$finds_md" ]; then
    problems="${problems}missing finds.md"$'\n'
  elif ! grep -A30 'export-retries' "$finds_md" | grep -qiE 'status:[[:space:]]*deferred'; then
    problems="${problems}find export-retries must be deferred"$'\n'
  fi
  if grep -A30 'smell-second' "$finds_md" 2>/dev/null | grep -qiE 'status:[[:space:]]*in_pr'; then
    problems="${problems}must not pick a second find after the failure"$'\n'
  fi
  if ! grep -qiE 'implement (fail|failed)|deferred' "$out_file"; then
    problems="${problems}expected a deferred signal in output"$'\n'
  fi
  if ! assert_no_notify "$TEST_ROOT/notify-invocations.log"; then
    problems="${problems}must not ping without a draft PR"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" \
      "finds.md:" "$(cat "$finds_md" 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

