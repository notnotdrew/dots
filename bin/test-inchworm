# Same path-shaped mentions on the implement commit, plus a fixer pass that
# leaves work to squash — the implementer body must still survive the squash.
write_path_mentioning_implement_and_fix_agent() {
  agent_path=$1
  cat >"$agent_path" <<EOF
#!/usr/bin/env bash
printf '%s\n' "agent \$*" >>"$TEST_ROOT/agent-invocations.log"
case "\$*" in
  *"Work item:"*)
    printf '%s\n' "implemented by agent" >"./agent-work.txt"
    mkdir -p .inchworm/pr
    printf '%s\n' "Stop retrying failed exports" >.inchworm/pr/title.txt
    printf '%s\n' "One failed export blocks the queue." >.inchworm/pr/body.md
    git add agent-work.txt
    git commit -q -m "Stop retrying failed exports" \\
      -m "The PR copy lives in .inchworm/pr; the runner is bin/inchworm."
    ;;
  *"Fix only verified"*)
    printf '%s\n' "fixed by agent" >"./fix-work.txt"
    ;;
esac
exit 0
EOF
  chmod +x "$agent_path"
}

# Live agent mock for the whole implement → fix path. Both passes commit, and
# both name the runner, so only a rewrite can make the branch presentable.
write_implement_and_fix_agent() {
