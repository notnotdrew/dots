    problems="${problems}expected a blocking-draft signal in output"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_hand_cut_draft_does_not_block() {
  # The prefix is shared with branches the human cuts, so the date suffix is what
  # marks a draft as ours. A hand-cut draft must not stall the day's run.
  test_name="a hand-cut draft on the same prefix does not block the run"
  now="2026-08-18T10:00:00"
  implement_fixture=success
  setup_eligible_run_env "hand-cut"
  write_mock_gh "$mock_gh" "hand_cut_draft"
  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"tidy-helper","source":"smell","title":"Remove the unused export helper","summary":"Nothing calls it.","rank":1,"status":"open"}]'

  out_file="$TEST_ROOT/run-hand-cut-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    run_inchworm run
  ) >"$out_file" 2>&1

  after_last=$(yaml_get "$repo_dir/.inchworm.yml" "state.last_run_date" 2>/dev/null || printf 'ERR')
  problems=""
  if [ "$after_last" != "2026-08-18" ]; then
    problems="${problems}expected the run to proceed and stamp the day, got: $after_last"$'\n'
  fi
  if ! assert_gh_pr_create_draft "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}expected a draft PR despite the hand-cut draft"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

# --- Implement base: always origin/develop after fetch -----------------------

test_run_implement_base_ignores_checked_out_feature() {
  # Regression: checked-out feature branch must not become the implement base.
  test_name="implement worktree bases on origin/develop, not checked-out feature"
  now="2026-08-18T10:00:00"
  implement_fixture=success
  setup_eligible_run_env "base-feature"

  printf 'develop-tip\n' >"$repo_dir/develop-marker.txt"
  git -C "$repo_dir" add develop-marker.txt
  git -C "$repo_dir" commit -q -m "develop tip marker"
  develop_tip=$(git -C "$repo_dir" rev-parse HEAD)
  git -C "$repo_dir" push -q origin develop

  git -C "$repo_dir" checkout -q -b feature/local-wip
  printf 'feature-only\n' >"$repo_dir/feature-marker.txt"
  git -C "$repo_dir" add feature-marker.txt
  git -C "$repo_dir" commit -q -m "feature tip"
  feature_tip=$(git -C "$repo_dir" rev-parse HEAD)

  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"base-feature","source":"smell","title":"Base from develop","summary":"must ignore feature HEAD","rank":1,"status":"open"}]'

  out_file="$TEST_ROOT/run-base-feature-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  branch_name=$(first_implement_branch "$repo_dir")
  problems=""

  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [ -z "$branch_name" ]; then
    problems="${problems}expected implement branch"$'\n'
  else
    if ! git -C "$repo_dir" merge-base --is-ancestor origin/develop "$branch_name"; then
      problems="${problems}origin/develop must be an ancestor of $branch_name"$'\n'
    fi
    if git -C "$repo_dir" merge-base --is-ancestor "$feature_tip" "$branch_name"; then
      problems="${problems}$branch_name must not include feature tip $feature_tip (based on feature HEAD)"$'\n'
    fi
    inchworm_base=$(git -C "$repo_dir" merge-base "$branch_name" origin/develop)
    if [ "$inchworm_base" != "$(git -C "$repo_dir" rev-parse origin/develop)" ]; then
      problems="${problems}merge-base with origin/develop must be origin/develop tip"$'\n'
    fi
    if [ "$(git -C "$repo_dir" rev-parse origin/develop)" != "$develop_tip" ]; then
      problems="${problems}origin/develop tip drift: expected $develop_tip"$'\n'
    fi
  fi
  if ! assert_gh_pr_create_draft "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}expected gh pr create --draft --base develop"$'\n'"$(cat "$TEST_ROOT/gh-invocations.log" 2>/dev/null || true)"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" \
      "HEAD=$(git -C "$repo_dir" symbolic-ref --short HEAD 2>/dev/null || true)" \
      "branches:" "$(git -C "$repo_dir" branch -vv 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

test_run_implement_fetches_origin_before_worktree() {
  # Worktree must see a develop tip that only exists on origin after fetch.
  test_name="implement fetches origin so worktree sees remote develop tip"
  now="2026-08-18T10:00:00"
  implement_fixture=success
  setup_eligible_run_env "base-fetch"

  remote_tip=$(push_remote_only_develop_commit \
    "$TEST_ROOT/run-base-fetch-origin.git" \
    "only-on-remote-develop" \
    "$TEST_ROOT/run-base-fetch-remote-clone")

  # Stale tracking ref proves we have not fetched yet.
  local_tracking=$(git -C "$repo_dir" rev-parse origin/develop)
  if [ "$local_tracking" = "$remote_tip" ]; then
    fail "$test_name" "precondition failed: origin/develop already at remote tip before run"
    return
  fi

  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"base-fetch","source":"smell","title":"Fetch then base","summary":"must fetch origin/develop","rank":1,"status":"open"}]'

  out_file="$TEST_ROOT/run-base-fetch-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  branch_name=$(first_implement_branch "$repo_dir")
  problems=""

  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [ "$(git -C "$repo_dir" rev-parse origin/develop)" != "$remote_tip" ]; then
    problems="${problems}expected origin/develop updated to remote tip $remote_tip after fetch"$'\n'
  fi
  if [ -z "$branch_name" ]; then
    problems="${problems}expected implement branch"$'\n'
  elif ! git -C "$repo_dir" merge-base --is-ancestor "$remote_tip" "$branch_name"; then
    problems="${problems}$branch_name must include remote-only develop tip $remote_tip"$'\n'
  fi
  if ! git -C "$repo_dir" show "$branch_name:remote-only-develop.txt" >/dev/null 2>&1; then
    problems="${problems}inchworm branch must contain remote-only-develop.txt from fetched develop"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" \
      "origin/develop=$(git -C "$repo_dir" rev-parse origin/develop 2>/dev/null || true)" \
      "remote_tip=$remote_tip"
    return
  fi
  pass "$test_name"
}

test_run_live_implement_missing_origin_develop_defers() {
  test_name="live implement defers when origin/develop is missing"
  now="2026-08-18T10:00:00"
  setup_eligible_run_env "missing-develop"

  # Origin exists but only has a non-develop branch — no origin/develop.
  git -C "$repo_dir" branch -M main
  git -C "$repo_dir" push -q origin refs/heads/main:refs/heads/main
  git -C "$repo_dir" push -q origin --delete develop 2>/dev/null || true
  git -C "$repo_dir" update-ref -d refs/remotes/origin/develop 2>/dev/null || true
  git -C "$repo_dir" branch -D develop 2>/dev/null || true

  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"missing-dev","source":"smell","title":"No develop","summary":"live path must soft-fail","rank":1,"status":"open"}]'

  out_file="$TEST_ROOT/run-missing-develop-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    unset INCHWORM_IMPLEMENT_FIXTURE 2>/dev/null || true
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  finds_md=$(finds_md_for "$data_dir" "$repo_dir")
  draft_cache=$(yaml_get "$repo_dir/.inchworm.yml" "state.active_draft_pr" 2>/dev/null || printf 'ERR')
  problems=""

  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0 (soft defer), got $status"$'\n'
  fi
  if ! assert_no_gh_pr_create "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}must not open a PR when origin/develop is missing"$'\n'
  fi
  if [ "$draft_cache" != "null" ]; then
    problems="${problems}active_draft_pr must stay null, got: $draft_cache"$'\n'
  fi
  if [ -f "$finds_md" ] && ! grep -A30 'missing-dev' "$finds_md" | grep -qiE 'status:[[:space:]]*deferred'; then
    problems="${problems}find must be deferred when origin/develop missing"$'\n'
  fi
  if ! grep -qiE 'origin/develop|fetch origin|no origin' "$out_file"; then
    problems="${problems}expected clear signal mentioning origin/develop or fetch failure"$'\n'
  fi
  if ! assert_no_inchworm_worktree_registered "$repo_dir"; then
    problems="${problems}worktree must be cleaned up after defer"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" \
      "finds.md:" "$(cat "$finds_md" 2>/dev/null || true)" \
      "refs:" "$(git -C "$repo_dir" show-ref 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

test_run_pick_open_over_deferred() {
  test_name="pick prefers open find over existing deferred find"
  now="2026-08-18T10:00:00"
  implement_fixture=success
  setup_eligible_run_env "deferred"

  finds_md=$(finds_md_for "$data_dir" "$repo_dir")
  write_finds_md "$finds_md" "$(cat <<'EOF'
# Inchworm finds

<!-- inchworm:finds-version:1 -->

## F-old-deferred

- status: deferred
- source: smell
- rank: 1
- title: Deferred classic
- summary: Already deferred; must not be picked
EOF
)"

  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"fresh-open","source":"smell","title":"Fresh open find","summary":"Should win over deferred","rank":2,"status":"open"}]'

  out_file="$TEST_ROOT/run-deferred-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  problems=""
  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [ ! -f "$finds_md" ]; then
    problems="${problems}missing finds.md after merge"$'\n'
  else
    # Phase 5 tidy may DROP deferred/too_large; only require the open find survives.
    if ! grep -q 'fresh-open' "$finds_md"; then
      problems="${problems}curator must merge new open find"$'\n'
    fi
  fi
  if ! grep -q 'fresh-open' "$out_file"; then
    problems="${problems}expected selected id fresh-open"$'\n'
  fi
  if ! grep -qiE 'Fresh open find' "$out_file"; then
    problems="${problems}expected selected title Fresh open find"$'\n'
  fi
  if grep -qiE 'Deferred classic|old-deferred' "$out_file" \
    && ! grep -qiE 'fresh-open|Fresh open find' "$out_file"; then
    problems="${problems}must not select deferred find"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" "finds.md:" "$(cat "$finds_md" 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

test_run_pick_prefers_lower_rank() {
  test_name="pick prefers lower rank number among open finds"
  now="2026-08-18T10:00:00"
  implement_fixture=success
  setup_eligible_run_env "rank"

  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"rank-two","source":"smell","title":"Second priority","summary":"rank 2","rank":2,"status":"open"},{"id":"rank-one","source":"smell","title":"First priority","summary":"rank 1","rank":1,"status":"open"}]'

  out_file="$TEST_ROOT/run-rank-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  finds_md=$(finds_md_for "$data_dir" "$repo_dir")

  problems=""
  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if ! grep -q 'rank-one' "$out_file"; then
    problems="${problems}expected selected id rank-one (rank 1)"$'\n'
  fi
  if ! grep -qiE 'First priority' "$out_file"; then
    problems="${problems}expected selected title First priority"$'\n'
  fi
  # Selection line should not prefer rank-two over rank-one.
  if grep -q 'rank-two' "$out_file" && ! grep -q 'rank-one' "$out_file"; then
    problems="${problems}incorrectly selected rank-two"$'\n'
  fi
  if [ -f "$finds_md" ]; then
    if ! grep -q 'rank-one' "$finds_md" || ! grep -q 'rank-two' "$finds_md"; then
      problems="${problems}finds.md should contain both candidates after merge"$'\n'
    fi
  else
    problems="${problems}missing finds.md"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" "finds.md:" "$(cat "$finds_md" 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

# --- C3. Phase 4: review → map blocking → fix once → ping --------------------

# Shared runner for Phase 4 post-draft paths. Sets review/fix fixtures and
# returns via globals: out_file, status, draft_cache, review_dir, ledger,
# expected_pr_url, finds_md.
run_phase4_eligible_with_fixtures() {
  # Args: suffix smell_id smell_title review_fixture [fix_fixture]
  # fix_fixture may be empty (unset) when no fixer expected.
  suffix=$1
  smell_id=$2
  smell_title=$3
  review_fixture=$4
  fix_fixture=${5:-}

  now="2026-08-18T10:00:00"
  implement_fixture=success
  setup_eligible_run_env "$suffix"

  write_smell_candidates_json "$fixture_dir" \
    "[{\"id\":\"${smell_id}\",\"source\":\"smell\",\"title\":\"${smell_title}\",\"summary\":\"Phase 4 fixture find\",\"rank\":1,\"status\":\"open\"}]"

  out_file="$TEST_ROOT/run-$suffix-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE="$review_fixture"
    if [ -n "$fix_fixture" ]; then
      export INCHWORM_FIX_FIXTURE="$fix_fixture"
    else
      unset INCHWORM_FIX_FIXTURE 2>/dev/null || true
    fi
    export INCHWORM_NOTIFY="$mock_notify"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  draft_cache=$(yaml_get "$repo_dir/.inchworm.yml" "state.active_draft_pr" 2>/dev/null || printf 'ERR')
  finds_md=$(finds_md_for "$data_dir" "$repo_dir")
  review_dir=$(review_dir_for "$data_dir" "$repo_dir")
  ledger=$(findings_ledger_for "$data_dir" "$repo_dir")
  expected_pr_url="https://example.test/pr/99"
}

test_run_review_none_pings_without_fixer() {
  test_name="Phase 4: review fixture none → artifacts + ping with PR URL; fixer skipped"
  run_phase4_eligible_with_fixtures "p4-none" "smell-clean" "Clean change" "none" "success"

  problems=""
  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [ "$draft_cache" != "$expected_pr_url" ]; then
    problems="${problems}expected active_draft_pr=$expected_pr_url, got: $draft_cache"$'\n'
  fi
  if ! assert_gh_pr_create_draft "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}expected draft PR create"$'\n'
  fi
  if ! assert_pr_review_once "$TEST_ROOT/pr-review-invocations.log"; then
    problems="${problems}expected exactly one Standard pr-review invocation"$'\n'"$(cat "$TEST_ROOT/pr-review-invocations.log" 2>/dev/null || true)"$'\n'
  fi
  if ! assert_review_artifacts_present "$review_dir"; then
    problems="${problems}expected review artifacts at $review_dir (findings-ledger.md)"$'\n'
  elif ! grep -qiE 'No findings' "$ledger"; then
    problems="${problems}none fixture ledger should say No findings"$'\n'
  fi
  if ! assert_no_fix_fixture_side_effect "$data_dir" "$repo_dir"; then
    problems="${problems}fixer must NOT run when review has no verified blockers"$'\n'
  fi
  if grep -qiE 'fixer|fixed blocking|fix pass|addressed blocking' "$out_file" \
    && ! grep -qiE 'skip(ping)? fix|no (blocking|fixer)|fixer not (needed|required)' "$out_file"; then
    problems="${problems}output must not claim fixer ran for none fixture"$'\n'
  fi
  if ! assert_notify_once_with_pr_url "$TEST_ROOT/notify-invocations.log" "$expected_pr_url"; then
    problems="${problems}expected one ping/notify containing $expected_pr_url"$'\n'"$(cat "$TEST_ROOT/notify-invocations.log" 2>/dev/null || true)"$'\n'
  fi
  if ! grep -Fq -- "$expected_pr_url" "$out_file"; then
    problems="${problems}expected PR URL in run output / log"$'\n'
  fi
  if ! assert_agent_argv_safe "$TEST_ROOT/agent-invocations.log"; then
    problems="${problems}agent argv must not include --yolo/--force/--trust"$'\n'"$(cat "$TEST_ROOT/agent-invocations.log")"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" "ledger:" "$(cat "$ledger" 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

test_run_review_advisory_skips_fixer_and_pings() {
  test_name="Phase 4: review fixture advisory → artifacts; fixer skipped; ping with PR URL"
  run_phase4_eligible_with_fixtures "p4-adv" "smell-advisory" "Advisory-only change" "advisory" "success"

  problems=""
  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [ "$draft_cache" != "$expected_pr_url" ]; then
    problems="${problems}expected active_draft_pr=$expected_pr_url, got: $draft_cache"$'\n'
  fi
  if ! assert_pr_review_once "$TEST_ROOT/pr-review-invocations.log"; then
    problems="${problems}expected exactly one Standard pr-review"$'\n'"$(cat "$TEST_ROOT/pr-review-invocations.log" 2>/dev/null || true)"$'\n'
  fi
  if ! assert_review_artifacts_present "$review_dir"; then
    problems="${problems}expected review artifacts at $review_dir"$'\n'
  else
    if ! grep -qiE 'Class:[[:space:]]*advisory' "$ledger"; then
      problems="${problems}advisory fixture ledger missing Class: advisory"$'\n'
    fi
    if grep -qiE 'Class:[[:space:]]*blocking' "$ledger"; then
      problems="${problems}advisory fixture must not include Class: blocking"$'\n'
    fi
  fi
  if ! assert_no_fix_fixture_side_effect "$data_dir" "$repo_dir"; then
    problems="${problems}fixer must NOT run for verified advisory-only findings"$'\n'
  fi
  if ! assert_notify_once_with_pr_url "$TEST_ROOT/notify-invocations.log" "$expected_pr_url"; then
    problems="${problems}expected one ping with $expected_pr_url"$'\n'"$(cat "$TEST_ROOT/notify-invocations.log" 2>/dev/null || true)"$'\n'
  fi
  if ! assert_agent_argv_safe "$TEST_ROOT/agent-invocations.log"; then
    problems="${problems}agent argv must not include --yolo/--force/--trust"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" "ledger:" "$(cat "$ledger" 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

test_run_review_blocking_fix_success_pings() {
  test_name="Phase 4: review blocking + fix success → fixer once; ping; no second review"
  run_phase4_eligible_with_fixtures "p4-fix-ok" "smell-block" "Needs blocker fix" "blocking" "success"

  problems=""
  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [ "$draft_cache" != "$expected_pr_url" ]; then
    problems="${problems}expected active_draft_pr=$expected_pr_url, got: $draft_cache"$'\n'
  fi
  if ! assert_pr_review_once "$TEST_ROOT/pr-review-invocations.log"; then
    problems="${problems}expected exactly one Standard pr-review (no review↔fix loop)"$'\n'"$(cat "$TEST_ROOT/pr-review-invocations.log" 2>/dev/null || true)"$'\n'
  fi
  if ! assert_review_artifacts_present "$review_dir"; then
    problems="${problems}expected review artifacts at $review_dir"$'\n'
  elif ! grep -qiE 'Class:[[:space:]]*blocking' "$ledger" \
    || ! grep -qiE 'Disposition:[[:space:]]*verified' "$ledger"; then
    problems="${problems}blocking fixture ledger must include verified Class: blocking"$'\n'
  fi
  if ! assert_fix_fixture_ran "$data_dir" "$repo_dir" "success"; then
    problems="${problems}expected fixer side-effect fix/fixture-ran=success"$'\n'
  fi
  if ! grep -qiE 'fix(er|ed|ing)?|addressed blocking|blocking (findings )?fixed|fix pass' "$out_file"; then
    problems="${problems}expected fixer success signal in output"$'\n'
  fi
  if ! assert_notify_once_with_pr_url "$TEST_ROOT/notify-invocations.log" "$expected_pr_url"; then
    problems="${problems}expected one ping with $expected_pr_url"$'\n'"$(cat "$TEST_ROOT/notify-invocations.log" 2>/dev/null || true)"$'\n'
  fi
  if ! assert_agent_argv_safe "$TEST_ROOT/agent-invocations.log"; then
    problems="${problems}agent argv must not include --yolo/--force/--trust"$'\n'"$(cat "$TEST_ROOT/agent-invocations.log")"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" "ledger:" "$(cat "$ledger" 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

test_run_review_blocking_fix_fail_still_pings() {
  test_name="Phase 4: review blocking + fix fail → still ping; residual blockers; one review only"
  run_phase4_eligible_with_fixtures "p4-fix-fail" "smell-block-fail" "Blocker hard to fix" "blocking" "fail"

  problems=""
  # Soft exit: residual blockers may yield non-zero; require ping + residual signal.
  if [ "$status" -eq 127 ] && [ ! -x "$INCHWORM" ]; then
    problems="${problems}inchworm binary missing"$'\n'
  fi
  if [ "$draft_cache" != "$expected_pr_url" ]; then
    problems="${problems}expected active_draft_pr=$expected_pr_url, got: $draft_cache"$'\n'
  fi
  if ! assert_pr_review_once "$TEST_ROOT/pr-review-invocations.log"; then
    problems="${problems}expected exactly one Standard pr-review (no second review after fix fail)"$'\n'"$(cat "$TEST_ROOT/pr-review-invocations.log" 2>/dev/null || true)"$'\n'
  fi
  if ! assert_review_artifacts_present "$review_dir"; then
    problems="${problems}expected review artifacts at $review_dir"$'\n'
  fi
  if ! assert_fix_fixture_ran "$data_dir" "$repo_dir" "fail"; then
    problems="${problems}expected fixer side-effect fix/fixture-ran=fail"$'\n'
  fi
  if ! grep -qiE 'residual|remaining|unresolved|still blocking|blocking (finding|issue)|could not (fix|address)' "$out_file"; then
    problems="${problems}expected residual/blocking surfaced in output after fix fail"$'\n'
  fi
  if ! assert_notify_once_with_pr_url "$TEST_ROOT/notify-invocations.log" "$expected_pr_url"; then
    problems="${problems}must still ping once with $expected_pr_url after fix fail"$'\n'"$(cat "$TEST_ROOT/notify-invocations.log" 2>/dev/null || true)"$'\n'
  fi
  if ! assert_agent_argv_safe "$TEST_ROOT/agent-invocations.log"; then
    problems="${problems}agent argv must not include --yolo/--force/--trust"$'\n'"$(cat "$TEST_ROOT/agent-invocations.log")"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" "ledger:" "$(cat "$ledger" 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

test_run_fixer_work_lands_on_the_implement_branch() {
  # A fixer that only edits the worktree has fixed nothing a reviewer can see.
  # Its work has to be committed on the branch the draft PR points at, and the
  # push that updates that branch has to be distinguishable from the first one.
  test_name="Phase 5: fixer work is committed on the implement branch and pushed with force-with-lease"
  run_phase4_eligible_with_fixtures "fix-land" "smell-land" "Land the fix" "blocking" "success"

  branch_name=$(first_implement_branch "$repo_dir")
  problems=""

  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [ -z "$branch_name" ]; then
    problems="${problems}expected an implement branch after the fixer pass"$'\n'
  else
    if ! branch_has_file "$repo_dir" "$branch_name" "fix-fixture.txt"; then
      problems="${problems}fixer work must be committed on $branch_name"$'\n'
    fi
    if ! branch_has_file "$repo_dir" "$branch_name" "implement-fixture.txt"; then
      problems="${problems}the rewrite must keep the implement work on $branch_name"$'\n'
    fi
    ahead=$(branch_commit_count "$repo_dir" "$branch_name")
    if [ "$ahead" != "1" ]; then
      problems="${problems}expected one authored commit ahead of origin/develop, got: $ahead"$'\n'"$(git -C "$repo_dir" log --oneline "origin/develop..$branch_name" 2>/dev/null || true)"$'\n'
    fi
    if ! assert_no_tool_name_in_branch_commits "$repo_dir" "$branch_name"; then
      problems="${problems}rewritten history must not name the runner:"$'\n'"$(git -C "$repo_dir" log --format='%B' "origin/develop..$branch_name")"$'\n'
    fi
  fi
  if ! grep -qiE 'skipping the post-fix push.*--force-with-lease' "$out_file"; then
    problems="${problems}expected a skipped post-fix force-with-lease push in fixture mode"$'\n'
  fi
  if ! grep -qiE 'skipping the first push' "$out_file"; then
    problems="${problems}expected the first push to be reported separately from the post-fix push"$'\n'
  fi
  if ! assert_fix_fixture_ran "$data_dir" "$repo_dir" "success"; then
    problems="${problems}expected fixer side-effect fix/fixture-ran=success"$'\n'
  fi
  if ! assert_notify_once_with_pr_url "$TEST_ROOT/notify-invocations.log" "$expected_pr_url"; then
    problems="${problems}expected one ping with $expected_pr_url after the fix landed"$'\n'
  fi
  if ! assert_agent_argv_safe "$TEST_ROOT/agent-invocations.log"; then
    problems="${problems}agent argv must not include --yolo/--force/--trust"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_fixer_rewrite_pushes_authored_history() {
  # The human is pinged straight after the fixer, so that is the moment the
  # remote branch has to read like one change someone made — even though both
  # the implementer and the fixer named the runner in their own commits.
  test_name="Phase 5: implement + fix commits are squashed and force-pushed as one authored commit"
  now="2026-08-18T10:00:00"
  setup_eligible_run_env "fix-rewrite"
  live_agent="$TEST_ROOT/run-fix-rewrite-agent"
  write_implement_and_fix_agent "$live_agent"
  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"export-retries","source":"errors","title":"Stop retrying failed exports","summary":"One failed export blocks the queue.","rank":1,"status":"open"}]'

  out_file="$TEST_ROOT/run-fix-rewrite-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    unset INCHWORM_IMPLEMENT_FIXTURE INCHWORM_FIX_FIXTURE 2>/dev/null || true
    export INCHWORM_AGENT="$live_agent"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=blocking
    export INCHWORM_NOTIFY="$mock_notify"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  branch_name=$(first_implement_branch "$repo_dir")
  expected_pr_url="https://example.test/pr/99"
  problems=""

  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [ -z "$branch_name" ]; then
    problems="${problems}expected an implement branch"$'\n'
  else
    ahead=$(branch_commit_count "$repo_dir" "$branch_name")
    if [ "$ahead" != "1" ]; then
      problems="${problems}expected implement + fix squashed to one commit, got: $ahead"$'\n'"$(git -C "$repo_dir" log --oneline "origin/develop..$branch_name" 2>/dev/null || true)"$'\n'
    fi
    if ! assert_no_tool_name_in_branch_commits "$repo_dir" "$branch_name"; then
      problems="${problems}history after the fix must not name the runner:"$'\n'"$(git -C "$repo_dir" log --format='%B' "origin/develop..$branch_name")"$'\n'
    fi
    subject=$(git -C "$repo_dir" log -1 --format='%s' "$branch_name" 2>/dev/null || true)
    # Implementer named the runner, so the pre-fix commit is already the find
    # fallback — squash must keep that authored subject, not invent another.
    if [ "$subject" != "Stop retrying failed exports" ]; then
      problems="${problems}expected the authored pre-fix subject on the squashed commit, got: $subject"$'\n'
    fi
    for tracked in agent-work.txt fix-work.txt; do
      if ! branch_has_file "$repo_dir" "$branch_name" "$tracked"; then
        problems="${problems}$tracked must survive the rewrite on $branch_name"$'\n'
      fi
    done

    local_sha=$(git -C "$repo_dir" rev-parse "$branch_name" 2>/dev/null || printf 'none')
    remote_sha=$(git -C "$origin_dir" rev-parse --verify --quiet "refs/heads/$branch_name" 2>/dev/null || printf 'none')
    if [ "$remote_sha" = "none" ]; then
      problems="${problems}expected $branch_name on the remote"$'\n'
    elif [ "$remote_sha" != "$local_sha" ]; then
      problems="${problems}post-fix push must update the remote draft branch (remote=$remote_sha local=$local_sha)"$'\n'
    fi
    if ! branch_has_file "$origin_dir" "$branch_name" "fix-work.txt"; then
      problems="${problems}the fix must reach the remote branch the human is pinged about"$'\n'
    fi
    if ! assert_no_tool_name_in_remote_commits "$origin_dir" "$branch_name"; then
      problems="${problems}pushed history must not name the runner:"$'\n'"$(git -C "$origin_dir" log --format='%B' "develop..$branch_name" 2>/dev/null || true)"$'\n'
    fi
  fi
  if ! assert_gh_pr_create_draft "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}expected the draft PR to open before the fixer ran"$'\n'
  fi
  if ! assert_pr_review_once "$TEST_ROOT/pr-review-invocations.log"; then
    problems="${problems}expected exactly one Standard pr-review"$'\n'
  fi
  if ! assert_notify_once_with_pr_url "$TEST_ROOT/notify-invocations.log" "$expected_pr_url"; then
    problems="${problems}expected one ping with $expected_pr_url"$'\n'
  fi
  if ! assert_agent_argv_safe "$TEST_ROOT/agent-invocations.log"; then
    problems="${problems}agent argv must not include --yolo/--force/--trust"$'\n'"$(cat "$TEST_ROOT/agent-invocations.log")"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_fixer_preserves_clean_implementer_message() {
  # A dirty find title used to replace a good implementer message on squash.
  # The agent's own copy is clean, so the draft opens; squash must keep that
  # message and may publish the fix.
  test_name="Phase 5: fixer squash keeps a clean implementer message when the find title names the runner"
  now="2026-08-18T10:00:00"
  setup_eligible_run_env "keep-implementer"
  live_agent="$TEST_ROOT/run-keep-implementer-agent"
  write_clean_implement_dirty_fix_agent "$live_agent"
  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"export-retries","source":"errors","title":"Rename the inchworm helper","summary":"The helper name confuses readers.","rank":1,"status":"open"}]'

  out_file="$TEST_ROOT/run-keep-implementer-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    unset INCHWORM_IMPLEMENT_FIXTURE INCHWORM_FIX_FIXTURE 2>/dev/null || true
    export INCHWORM_AGENT="$live_agent"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=blocking
    export INCHWORM_NOTIFY="$mock_notify"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  branch_name=$(first_implement_branch "$repo_dir")
  expected_pr_url="https://example.test/pr/99"
  problems=""

  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if ! assert_gh_pr_create_draft "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}expected the draft PR to open from the agent's clean copy"$'\n'
  fi
  if [ -z "$branch_name" ]; then
    problems="${problems}expected an implement branch"$'\n'
  else
    ahead=$(branch_commit_count "$repo_dir" "$branch_name")
    if [ "$ahead" != "1" ]; then
      problems="${problems}expected implement + fix squashed to one commit, got: $ahead"$'\n'
    fi
    subject=$(git -C "$repo_dir" log -1 --format='%s' "$branch_name" 2>/dev/null || true)
    if [ "$subject" != "Rename the export retry helper" ]; then
      problems="${problems}expected the implementer's subject to survive squash, got: $subject"$'\n'
    fi
    if ! branch_has_file "$origin_dir" "$branch_name" "fix-work.txt"; then
      problems="${problems}a clean implementer message must allow the fix to be published"$'\n'
    fi
    if ! assert_no_tool_name_in_branch_commits "$repo_dir" "$branch_name"; then
      problems="${problems}squashed history must not name the runner:"$'\n'"$(git -C "$repo_dir" log --format='%B' "origin/develop..$branch_name")"$'\n'
    fi
  fi
  if grep -qiE 'refusing to push|fix stayed local' "$out_file"; then
    problems="${problems}must not refuse to push when the implementer message is clean"$'\n'
  fi
  if ! assert_notify_once_with_pr_url "$TEST_ROOT/notify-invocations.log" "$expected_pr_url"; then
    problems="${problems}expected one ping with $expected_pr_url"$'\n'
  fi
  if ! assert_agent_argv_safe "$TEST_ROOT/agent-invocations.log"; then
    problems="${problems}agent argv must not include --yolo/--force/--trust"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_path_mention_survives_fixer_squash() {
  # bin/inchworm in a commit body is a path, not a name leak — implement must
  # keep the message, and the fixer squash must not treat it as dirty.
  test_name="Phase 5: commit body naming only bin/inchworm is kept through implement and fix"
  now="2026-08-18T10:00:00"
  setup_eligible_run_env "path-fix"
  live_agent="$TEST_ROOT/run-path-fix-agent"
  write_path_mentioning_implement_and_fix_agent "$live_agent"
  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"export-retries","source":"errors","title":"Reduce export retries","summary":"One failed export blocks the queue.","rank":1,"status":"open"}]'

  out_file="$TEST_ROOT/run-path-fix-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    unset INCHWORM_IMPLEMENT_FIXTURE INCHWORM_FIX_FIXTURE 2>/dev/null || true
    export INCHWORM_AGENT="$live_agent"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=blocking
    export INCHWORM_NOTIFY="$mock_notify"
    run_inchworm run
  ) >"$out_file" 2>&1

  branch_name=$(first_implement_branch "$repo_dir")
  expected_pr_url="https://example.test/pr/99"
  problems=""

  if grep -qi 'rewriting as a single commit' "$out_file"; then
    problems="${problems}must not rewrite a commit that only names bin/inchworm"$'\n'
  fi
  if [ -z "$branch_name" ]; then
    problems="${problems}expected an implement branch"$'\n'
  else
    subject=$(git -C "$repo_dir" log -1 --format='%s' "$branch_name" 2>/dev/null || true)
    if [ "$subject" != "Stop retrying failed exports" ]; then
      problems="${problems}expected the implementer's subject to survive squash, got: $subject"$'\n'
    fi
    body=$(git -C "$repo_dir" log -1 --format='%b' "$branch_name" 2>/dev/null || true)
    if ! printf '%s' "$body" | grep -Fq 'bin/inchworm'; then
      problems="${problems}expected bin/inchworm in the squashed body, got: $body"$'\n'
    fi
    if ! assert_no_tool_name_in_branch_commits "$repo_dir" "$branch_name"; then
      problems="${problems}bin/inchworm must not count as naming the runner"$'\n'
    fi
    if ! branch_has_file "$origin_dir" "$branch_name" "fix-work.txt"; then
      problems="${problems}the fix must still be published"$'\n'
    fi
  fi
  if ! assert_notify_once_with_pr_url "$TEST_ROOT/notify-invocations.log" "$expected_pr_url"; then
    problems="${problems}expected one ping with $expected_pr_url"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_dirty_fix_history_is_not_pushed() {
  # Implement + find can both be dirty only at implement, which Wave 1 defers.
  # At fix, a squash that cannot publish must restore the already-pushed
  # implement HEAD: leftover fix commits must not remain as local HEAD, the
  # remote stays pre-fix, and the human is still pinged.
  test_name="Phase 5: failed fixer squash restores pre-fix HEAD and is not force-pushed; ping still happens"
  now="2026-08-18T10:00:00"
  setup_eligible_run_env "dirty-fix"
  live_agent="$TEST_ROOT/run-dirty-fix-agent"
  write_clean_implement_dirty_fix_agent "$live_agent"
  reset_fail_bin="$TEST_ROOT/run-dirty-fix-bin"
  write_reset_failing_git "$reset_fail_bin"
  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"export-retries","source":"errors","title":"Rename the export retry helper","summary":"The helper name confuses readers.","rank":1,"status":"open"}]'

  out_file="$TEST_ROOT/run-dirty-fix-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    unset INCHWORM_IMPLEMENT_FIXTURE INCHWORM_FIX_FIXTURE 2>/dev/null || true
    export INCHWORM_AGENT="$live_agent"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=blocking
    export INCHWORM_NOTIFY="$mock_notify"
    export PATH="$reset_fail_bin:$PATH"
    run_inchworm run
  ) >"$out_file" 2>&1

  branch_name=$(first_implement_branch "$repo_dir")
  expected_pr_url="https://example.test/pr/99"
  problems=""

  if ! assert_gh_pr_create_draft "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}expected the draft PR to open from the agent's clean copy"$'\n'
  fi
  if [ -z "$branch_name" ]; then
    problems="${problems}expected an implement branch"$'\n'
  else
    if ! branch_has_file "$origin_dir" "$branch_name" "agent-work.txt"; then
      problems="${problems}the first push must have put the implement work on the remote"$'\n'
    fi
    if branch_has_file "$origin_dir" "$branch_name" "fix-work.txt"; then
      problems="${problems}must not push the fix when squash cannot publish"$'\n'"$(git -C "$origin_dir" log --format='%B' "develop..$branch_name" 2>/dev/null || true)"$'\n'
    fi
    if branch_has_file "$repo_dir" "$branch_name" "fix-work.txt"; then
      problems="${problems}local HEAD must match pre-fix history; fix-work.txt must not remain"$'\n'"$(git -C "$repo_dir" log --oneline "origin/develop..$branch_name" 2>/dev/null || true)"$'\n'
    fi
    local_sha=$(git -C "$repo_dir" rev-parse "$branch_name" 2>/dev/null || printf 'none')
    remote_sha=$(git -C "$origin_dir" rev-parse --verify --quiet "refs/heads/$branch_name" 2>/dev/null || printf 'none')
    if [ "$local_sha" != "$remote_sha" ]; then
      problems="${problems}local $branch_name must match the already-pushed implement SHA (local=$local_sha remote=$remote_sha)"$'\n'
    fi
    if ! assert_no_tool_name_in_remote_commits "$origin_dir" "$branch_name"; then
      problems="${problems}pushed history must stay clean:"$'\n'"$(git -C "$origin_dir" log --format='%B' "develop..$branch_name" 2>/dev/null || true)"$'\n'
    fi
  fi
  if ! grep -qiE 'refusing to push|fix stayed local' "$out_file"; then
    problems="${problems}expected the fixer to say the fix was not published"$'\n'
  fi
  if ! grep -qiE 'pre-fix history|matches the pre-fix' "$out_file"; then
    problems="${problems}expected the operator log to say the checkout matches the pre-fix history"$'\n'
  fi
  if ! assert_notify_once_with_pr_url "$TEST_ROOT/notify-invocations.log" "$expected_pr_url"; then
    problems="${problems}must still ping once with $expected_pr_url after a fixer failure"$'\n'"$(cat "$TEST_ROOT/notify-invocations.log" 2>/dev/null || true)"$'\n'
  fi
  if ! assert_agent_argv_safe "$TEST_ROOT/agent-invocations.log"; then
    problems="${problems}agent argv must not include --yolo/--force/--trust"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

# --- E. skill presence (Phase 4 docs) ----------------------------------------

test_inchworm_skill_and_references_exist() {
  test_name="codex/skills/inchworm skill + references mention Phase 4 review/fix/ping contracts"
  skill_md="$SKILL_ROOT/SKILL.md"
  problems=""

  if [ ! -f "$skill_md" ]; then
    problems="${problems}missing $skill_md"$'\n'
  fi

  ref_roots=""
  if [ -d "$SKILL_ROOT/references" ]; then
    ref_roots="$SKILL_ROOT/references"
  fi
  if [ -d "$SKILL_ROOT/workflows" ]; then
    ref_roots="${ref_roots}${ref_roots:+ }$SKILL_ROOT/workflows"
  fi
  if [ -z "$ref_roots" ]; then
    problems="${problems}missing references/ or workflows/ under $SKILL_ROOT"$'\n'
  else
    # Concatenate for term search once files exist (include SKILL.md).
    corpus=$(find $ref_roots -type f 2>/dev/null | head -n 50 || true)
    if [ -z "$corpus" ]; then
      problems="${problems}references/workflows dir empty"$'\n'
    else
      blob=$(cat $skill_md $corpus 2>/dev/null || true)
      for term in "finds.md" "scout" "curator" "pick" "implementer" "worktree" "active_draft_pr" "Worktrunk"; do
        if ! printf '%s' "$blob" | grep -qiF -- "$term"; then
          problems="${problems}skill/references must mention: $term"$'\n'
        fi
      done
      if ! printf '%s' "$blob" | grep -qiE 'lint|errors|backlog|smell'; then
        problems="${problems}references must mention scout sources (lint|errors|backlog|smell)"$'\n'
      fi
      if ! printf '%s' "$blob" | grep -qE 'branch_prefix'; then
        problems="${problems}skill/references must document the branch_prefix naming"$'\n'
      fi
      # The reviewer-facing boundary is part of the contract, not a style note.
      for term in "writing-git-commits" "writing-for-humans" "pr/title.txt" "pr/body.md"; do
        if ! printf '%s' "$blob" | grep -qiF -- "$term"; then
          problems="${problems}skill/references must mention authored-output term: $term"$'\n'
        fi
      done
      if ! printf '%s' "$blob" | grep -qiE 'gh pr create|draft pr|pr create --draft'; then
        problems="${problems}skill/references must mention draft PR / gh pr create"$'\n'
      fi
      if ! printf '%s' "$blob" | grep -qiE 'no second pick|second pick|same.?day|stamp.*(burn|already)|implement (fail|failure).*defer'; then
        problems="${problems}skill/references must mention failure / no-second-pick (stamp burned)"$'\n'
      fi
      # Phase 4: Standard pr-review (not lite), reviewer, fixer, blocking, ping.
      for term in "pr-review" "reviewer" "fixer" "blocking" "ping"; do
        if ! printf '%s' "$blob" | grep -qiF -- "$term"; then
          problems="${problems}skill/references must mention Phase 4 term: $term"$'\n'
        fi
      done
      if ! printf '%s' "$blob" | grep -qiE 'Standard.*(pr-review|review)|full Standard|Standard pr-review'; then
        problems="${problems}skill/references must mention Standard pr-review (not lite)"$'\n'
      fi
      if printf '%s' "$blob" | grep -qiE 'inchworm-lite' \
        && ! printf '%s' "$blob" | grep -qiE 'not.*lite|no.*lite|deferred.*lite|without.*lite'; then
        problems="${problems}skill must not prescribe inchworm-lite as the v1 reviewer"$'\n'
      fi
      if printf '%s' "$blob" | grep -qF '.inchworm/worktrees'; then
        problems="${problems}skill/references must not use .inchworm/worktrees/ (Worktrunk instead)"$'\n'
      fi
    fi
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems"
    return
  fi
  pass "$test_name"
}

# --- D. status ---------------------------------------------------------------

test_status_shows_repo_window_and_draft() {
  test_name="status shows registered repo, last_run_date, create-window, draft status"
  now="2026-08-18T10:00:00"
  config_dir="$TEST_ROOT/status-config"
  repo_dir="$TEST_ROOT/status-repo"
  mock_gh="$TEST_ROOT/status-gh"
  make_repo "$repo_dir"
  seed_registered_repo "$repo_dir" "$config_dir" "2026-08-17"
  write_mock_gh "$mock_gh" "blocking_draft"

  out_file="$TEST_ROOT/status-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    run_inchworm status
  ) >"$out_file" 2>&1
  status=$?

  problems=""
  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if ! grep -F -- "$repo_dir" "$out_file" >/dev/null; then
    problems="${problems}expected registered repo path in output"$'\n'
  fi
  if ! grep -E -- '2026-08-17|last_run' "$out_file" >/dev/null; then
    problems="${problems}expected last_run_date (2026-08-17) in output"$'\n'
  fi
  if ! grep -qiE 'window|open|closed|create' "$out_file"; then
    problems="${problems}expected create-window open/closed signal"$'\n'
  fi
  if ! grep -qiE "draft|blocking" "$out_file"; then
    problems="${problems}expected draft status from mock gh"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

# --- F. Phase 5: launchd + harden -------------------------------------------

test_launchd_plist_and_install_notes() {
  # Phase 5: LaunchAgent *template* + install notes (portable; no hard-coded home).
  # launchd-setup renders the template into ~/Library/LaunchAgents/.
  test_name="Phase 5: launchd template + install notes cover weekday hours 8–14"
  plist="$DOTS/launchd/com.inchworm.plist.template"
  notes="$SKILL_ROOT/references/launchd-install.md"
  problems=""

  if [ ! -f "$plist" ]; then
    problems="${problems}missing plist template: $plist"$'\n'
  else
    if ! grep -q '<string>com.inchworm</string>' "$plist" \
      && ! grep -q 'com.inchworm' "$plist"; then
      problems="${problems}plist Label must be com.inchworm"$'\n'
    fi
    # Template must use placeholders — not a specific user's home.
    if grep -E '/Users/[^/@]+/' "$plist" >/dev/null; then
      problems="${problems}template must not hard-code /Users/... paths"$'\n'
    fi
    for placeholder in '@HOME@' '@PATH@' '@LAUNCHD_RUNNER@' '@INCHWORM_BIN@'; do
      if ! grep -Fq "$placeholder" "$plist"; then
        problems="${problems}template missing placeholder $placeholder"$'\n'
      fi
    done
    # ProgramArguments: FDA-scoped runner + inchworm script + run (via placeholders / run).
    if ! grep -E 'inchworm-launchd|@LAUNCHD_RUNNER@' "$plist" >/dev/null; then
      problems="${problems}ProgramArguments must include inchworm-launchd / @LAUNCHD_RUNNER@"$'\n'
    fi
    if ! grep -E '@INCHWORM_BIN@|bin/inchworm' "$plist" >/dev/null; then
      problems="${problems}ProgramArguments must include @INCHWORM_BIN@"$'\n'
    fi
    if ! grep -E '<string>run</string>|>run<' "$plist" >/dev/null \
      && ! grep -Fq '>run<' "$plist"; then
      if ! grep -A20 'ProgramArguments' "$plist" | grep -qw run; then
        problems="${problems}ProgramArguments must include run"$'\n'
      fi
    fi
    # Weekdays Mon–Fri (1–5) and hours 8–14 inclusive.
    for weekday in 1 2 3 4 5; do
      if ! grep -E "<integer>${weekday}</integer>" "$plist" >/dev/null; then
        problems="${problems}StartCalendarInterval missing Weekday ${weekday}"$'\n'
      fi
    done
    for hour in 8 9 10 11 12 13 14; do
      if ! grep -E "<integer>${hour}</integer>" "$plist" >/dev/null; then
        problems="${problems}StartCalendarInterval missing Hour ${hour}"$'\n'
      fi
    done
    # No hour-15 tick (create window ends before 15:00).
    if grep -E '<key>Hour</key>[[:space:]]*<integer>15</integer>' "$plist" >/dev/null \
      || grep -B1 '<integer>15</integer>' "$plist" | grep -q 'Hour'; then
      problems="${problems}StartCalendarInterval must not include Hour 15"$'\n'
    fi
    # LaunchAgent must carry a usable PATH (mise Ruby + Homebrew); default launchd PATH is too bare.
    if ! grep -q '<key>EnvironmentVariables</key>' "$plist"; then
      problems="${problems}plist must set EnvironmentVariables (PATH for mise/homebrew)"$'\n'
    fi
    if ! grep -E '@PATH@|mise|/opt/homebrew' "$plist" >/dev/null; then
      problems="${problems}plist PATH should include @PATH@ / mise / Homebrew"$'\n'
    fi
  fi

  if [ ! -f "$notes" ]; then
    problems="${problems}missing install notes: $notes"$'\n'
  else
    if ! grep -qiF -- 'launchctl' "$notes"; then
      problems="${problems}launchd-install.md must mention: launchctl"$'\n'
    fi
    if ! grep -qiE 'bootstrap|load' "$notes"; then
      problems="${problems}launchd-install.md must mention bootstrap and/or load"$'\n'
    fi
    if ! grep -qiF -- 'com.inchworm' "$notes"; then
      problems="${problems}launchd-install.md must mention: com.inchworm"$'\n'
    fi
    if ! grep -qiE 'create window|hours?[[:space:]]*8|8[[:space:]]*[-–].*14|8am|08:00|8.?14' "$notes"; then
      problems="${problems}launchd-install.md must mention create window / hours 8–14"$'\n'
    fi
    if ! grep -qiE 'missed|catch.?up|not caught|no catch' "$notes"; then
      problems="${problems}launchd-install.md must mention missed days are not caught up"$'\n'
    fi
    if ! grep -qiE 'mise|PATH|EnvironmentVariables' "$notes"; then
      problems="${problems}launchd-install.md must mention mise/PATH for LaunchAgent env"$'\n'
    fi
    if ! grep -qiE 'inchworm-launchd|launchd-setup|Full Disk Access|FDA' "$notes"; then
      problems="${problems}launchd-install.md must mention FDA-scoped runner / launchd-setup"$'\n'
    fi
    if ! grep -qiE 'template|placeholder|portable' "$notes"; then
      problems="${problems}launchd-install.md must mention portable template"$'\n'
    fi
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems"
    return
  fi
  pass "$test_name"
}

test_launchd_setup_installs_runner_binary() {
  test_name="launchd-setup installs runner + renders user-local plist from template"
  fake_home="$TEST_ROOT/launchd-home"
  runner="$fake_home/.local/share/inchworm/inchworm-launchd"
  plist="$fake_home/Library/LaunchAgents/com.inchworm.plist"
  mkdir -p "$fake_home/Library/LaunchAgents"
  out_file="$TEST_ROOT/launchd-setup-out.txt"
  (
    export HOME="$fake_home"
    export INCHWORM_LAUNCHD_RUNNER="$runner"
    export INCHWORM_LAUNCHD_PLIST="$plist"
    export INCHWORM_LAUNCHD_TEMPLATE="$DOTS/launchd/com.inchworm.plist.template"
    run_inchworm launchd-setup --no-open --no-reload
  ) >"$out_file" 2>&1
  status=$?
  problems=""

  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [ ! -x "$runner" ]; then
    problems="${problems}expected executable runner at $runner"$'\n'
  fi
  # Must be a Mach-O / binary copy of bash, not a shell script text file.
  if file "$runner" 2>/dev/null | grep -qi 'shell script'; then
    problems="${problems}runner must be a binary (bash copy), not a shell script"$'\n'
  fi
  # Must not keep Apple's com.apple.bash platform identity: AMFI enforces a launch
  # constraint that kills such a binary outside /bin/bash (OS_REASON_CODESIGNING).
  runner_identity=$(codesign --display --verbose=2 "$runner" 2>&1 | sed -n 's/^Identifier=//p')
  if [ "$runner_identity" = "com.apple.bash" ]; then
    problems="${problems}runner must be re-signed, not left as com.apple.bash"$'\n'
  fi
  if [ "$runner_identity" != "com.inchworm.launchd" ]; then
    problems="${problems}expected runner identifier com.inchworm.launchd, got: $runner_identity"$'\n'
  fi
  if ! codesign --verify "$runner" >/dev/null 2>&1; then
    problems="${problems}runner ad-hoc signature must verify"$'\n'
  fi
  if [ ! -f "$plist" ]; then
    problems="${problems}expected generated plist at $plist"$'\n'
  else
    if ! grep -Fq "$runner" "$plist"; then
      problems="${problems}generated plist must contain runner path"$'\n'
    fi
    if ! grep -Fq "$fake_home" "$plist"; then
      problems="${problems}generated plist must contain fake HOME paths"$'\n'
    fi
    if grep -Fq '@HOME@' "$plist" || grep -Fq '@PATH@' "$plist"; then
      problems="${problems}generated plist must not leave placeholders unexpanded"$'\n'
    fi
    if ! grep -E '<string>run</string>' "$plist" >/dev/null; then
      problems="${problems}generated plist must include run"$'\n'
    fi
  fi
  if ! grep -Fq "$runner" "$out_file"; then
    problems="${problems}setup output must print the runner path for FDA"$'\n'
  fi
  if ! grep -qiE 'Full Disk Access|FDA' "$out_file"; then
    problems="${problems}setup output must mention Full Disk Access"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" \
      "plist:" "$(cat "$plist" 2>/dev/null | head -n 40 || true)"
    return
  fi
  pass "$test_name"
}

test_inchworm_skill_mentions_launchd() {
  # Phase 5: skill corpus must positively mention launchd/LaunchAgent (no longer deferred).
  test_name="Phase 5: skill/references mention launchd / LaunchAgent (not No launchd)"
  skill_md="$SKILL_ROOT/SKILL.md"
  problems=""

  if [ ! -f "$skill_md" ]; then
    problems="${problems}missing $skill_md"$'\n'
    fail "$test_name" "$problems"
    return
  fi

  corpus_files="$skill_md"
  if [ -d "$SKILL_ROOT/references" ]; then
    corpus_files="$corpus_files $(find "$SKILL_ROOT/references" -type f 2>/dev/null | head -n 50)"
  fi
  blob=$(cat $corpus_files 2>/dev/null || true)

  if ! printf '%s' "$blob" | grep -qiE 'LaunchAgent|launchd'; then
    problems="${problems}skill/references must mention launchd or LaunchAgent"$'\n'
  fi
  # Phase 4 deferral text must be gone (or superseded — "No launchd" is no longer correct).
  if printf '%s' "$blob" | grep -qiE 'No launchd'; then
    problems="${problems}skill must not still say No launchd (Phase 5 owns schedule)"$'\n'
  fi
  if ! printf '%s' "$blob" | grep -qiE 'LaunchAgent|launchd-install|com\.drewprice\.inchworm'; then
    problems="${problems}skill/references must mention LaunchAgent, launchd-install, or com.inchworm"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems"
    return
  fi
  pass "$test_name"
}

test_run_curator_dedupes_shared_identity_finds() {
  # Scouts reach the same work from different angles, so exact-id dedupe is not
  # enough: one Linear issue found by two scouts, or one Honeybadger fault reported
  # twice, must collapse into a single find instead of being picked on back-to-back
  # days. Identity = shared issue key, shared HB fault, or same source-stripped id.
  test_name="Phase 5: curator collapses finds sharing an issue key, HB fault, or id"
  now="2026-08-18T10:00:00"
  implement_fixture=success
  setup_eligible_run_env "dedupe"

  # Control: no shared identity, must survive on its own.
  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"smell-unrelated","source":"smell","title":"Unrelated find","summary":"shares nothing","rank":9,"status":"open"}]'
  # Same Linear issue as the backlog entry; same base id as the backlog entry.
  printf '%s\n' '[{"id":"pro-9001-widget-lint","source":"lint","title":"Widget lint angle","summary":"Linear PRO-9001 from lint","rank":2,"status":"open","evidence":"Linear PRO-9001"},{"id":"lint-shared-slug","source":"lint","title":"Shared slug lint","summary":"same slug as backlog entry","rank":4,"status":"open"}]' \
    >"$fixture_dir/lint.json"
  # Two angles on one Honeybadger fault.
  printf '%s\n' '[{"id":"errors-widget-boom","source":"errors","title":"Widget boom","summary":"hard failure","rank":3,"status":"open","evidence":"HB#987654321 (12 notices)"},{"id":"widget-boom-transient","source":"errors","title":"Widget boom transient","summary":"same fault, retry angle","rank":5,"status":"open","evidence":"HB 987654321 last seen today"}]' \
    >"$fixture_dir/errors.json"
  printf '%s\n' '[{"id":"backlog-pro-9001-widget","source":"backlog","title":"Widget cleanup","summary":"PRO-9001 agreed cleanup","rank":1,"status":"open","evidence":"https://linear.app/x/issue/PRO-9001/widget-cleanup"},{"id":"shared-slug","source":"backlog","title":"Shared slug backlog","summary":"same slug as lint entry","rank":6,"status":"open"}]' \
    >"$fixture_dir/backlog.json"

  out_file="$TEST_ROOT/run-dedupe-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$out_file" 2>&1

  finds_md=$(finds_md_for "$data_dir" "$repo_dir")
  problems=""

  if [ ! -f "$finds_md" ]; then
    problems="${problems}missing finds.md"$'\n'
  else
    count_of() {
      grep -cE "^## F-$1\$" "$finds_md" 2>/dev/null || true
    }
    issue_pair=$(( $(count_of 'backlog-pro-9001-widget') + $(count_of 'pro-9001-widget-lint') ))
    if [ "$issue_pair" -ne 1 ]; then
      problems="${problems}expected exactly 1 find for Linear PRO-9001, got $issue_pair"$'\n'
    fi
    fault_pair=$(( $(count_of 'errors-widget-boom') + $(count_of 'widget-boom-transient') ))
    if [ "$fault_pair" -ne 1 ]; then
      problems="${problems}expected exactly 1 find for HB fault 987654321, got $fault_pair"$'\n'
    fi
    slug_pair=$(( $(count_of 'lint-shared-slug') + $(count_of 'shared-slug') ))
    if [ "$slug_pair" -ne 1 ]; then
      problems="${problems}expected exactly 1 find for the shared base id, got $slug_pair"$'\n'
    fi
    if [ "$(count_of 'smell-unrelated')" -ne 1 ]; then
      problems="${problems}unrelated find must survive dedupe untouched"$'\n'
    fi
    total=$(grep -cE '^## F-' "$finds_md" 2>/dev/null || true)
    if [ "$total" -ne 4 ]; then
      problems="${problems}expected 4 finds after dedupe (3 groups + control), got $total"$'\n'
    fi
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" \
      "finds.md:" "$(cat "$finds_md" 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

test_run_curator_drops_deferred_too_large_and_caps_open() {
  # Phase 5 noisy finds tidy:
  # - DROP deferred + too_large after merge
  # - KEEP open + in_pr
  # - Cap open to top 20 by lowest rank (keep best 20 open + any in_pr)
  test_name="Phase 5: curator drops deferred/too_large and caps open finds at 20"
  now="2026-08-18T10:00:00"
  implement_fixture=success
  setup_eligible_run_env "tidy"

  finds_md=$(finds_md_for "$data_dir" "$repo_dir")
  mkdir -p "$(dirname "$finds_md")"
  {
    printf '%s\n' "# Inchworm finds" "" "<!-- inchworm:finds-version:1 -->" ""
    printf '%s\n' "## F-keep-in-pr" "" \
      "- status: in_pr" "- source: smell" "- rank: 50" \
      "- title: Already in PR" "- summary: must survive tidy" ""
    printf '%s\n' "## F-drop-deferred" "" \
      "- status: deferred" "- source: smell" "- rank: 1" \
      "- title: Deferred noise" "- summary: must be dropped" ""
    printf '%s\n' "## F-drop-too-large" "" \
      "- status: too_large" "- source: smell" "- rank: 2" \
      "- title: Too large noise" "- summary: must be dropped" ""
    rank=1
    while [ "$rank" -le 25 ]; do
      printf '%s\n' "## F-open-${rank}" "" \
        "- status: open" "- source: smell" "- rank: ${rank}" \
        "- title: Open find ${rank}" "- summary: rank ${rank}" ""
      rank=$((rank + 1))
    done
  } >"$finds_md"

  # New smell candidate merges in; pick will select lowest open rank (or new).
  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"smell-tidy-new","source":"smell","title":"Fresh smell","summary":"new candidate for tidy run","rank":3,"status":"open"}]'

  out_file="$TEST_ROOT/run-tidy-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  problems=""
  if [ "$status" -eq 127 ] && [ ! -x "$INCHWORM" ]; then
    problems="${problems}inchworm binary missing"$'\n'
  fi
  if [ ! -f "$finds_md" ]; then
    problems="${problems}missing finds.md after tidy"$'\n'
  else
    if grep -q 'drop-deferred' "$finds_md" || grep -qiE 'status:[[:space:]]*deferred' "$finds_md"; then
      problems="${problems}deferred finds must be dropped from finds.md after tidy"$'\n'
    fi
    if grep -q 'drop-too-large' "$finds_md" || grep -qiE 'status:[[:space:]]*too_large' "$finds_md"; then
      problems="${problems}too_large finds must be dropped from finds.md after tidy"$'\n'
    fi
    if ! grep -q 'keep-in-pr' "$finds_md"; then
      problems="${problems}in_pr find must remain after tidy"$'\n'
    fi
    open_count=$(grep -cE 'status:[[:space:]]*open' "$finds_md" || true)
    if [ "$open_count" -gt 20 ]; then
      problems="${problems}open finds capped at 20, got $open_count"$'\n'
    fi
    # Worst open ranks (21–25) should be dropped when over cap; best ranks stay.
    if grep -q 'open-25' "$finds_md" || grep -q 'open-21' "$finds_md"; then
      problems="${problems}excess open finds beyond top 20 by rank must be dropped (e.g. open-21..25)"$'\n'
    fi
    if ! grep -q 'open-1' "$finds_md"; then
      problems="${problems}best-ranked open find (open-1) must remain"$'\n'
    fi
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" "finds.md:" "$(cat "$finds_md" 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

test_run_success_removes_worktree_keeps_branch() {
  # After successful PR+review+ping: Worktrunk checkout must not remain;
  # the implement branch MAY remain for the draft PR.
  test_name="Phase 5: success path removes worktree registration; branch may remain"
  now="2026-08-18T10:00:00"
  implement_fixture=success
  setup_eligible_run_env "wt-clean"

  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"smell-wt-clean","source":"smell","title":"Worktree cleanup","summary":"assert worktree gone","rank":1,"status":"open"}]'

  out_file="$TEST_ROOT/run-wt-clean-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  expected_pr_url="https://example.test/pr/99"
  problems=""
  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if ! assert_gh_pr_create_draft "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}expected draft PR create"$'\n'
  fi
  if ! assert_wt_switch_logged; then
    problems="${problems}success path must create the checkout with wt switch"$'\n'"$(cat "$TEST_ROOT/wt-invocations.log" 2>/dev/null || true)"$'\n'
  fi
  if ! assert_wt_remove_keeps_branch_logged; then
    problems="${problems}success path must wt remove --no-delete-branch"$'\n'"$(cat "$TEST_ROOT/wt-invocations.log" 2>/dev/null || true)"$'\n'
  fi
  if ! assert_no_inchworm_worktree_registered "$repo_dir"; then
    problems="${problems}implement checkout must be gone after success (no .inchworm/worktrees, no sibling Worktrunk path)"$'\n'
    problems="${problems}$(git -C "$repo_dir" worktree list 2>/dev/null || true)"$'\n'
  fi
  expected_path=$(expected_worktree_path_for "$repo_dir" "smell-wt-clean" "20260818")
  if [ -e "$expected_path" ]; then
    problems="${problems}Worktrunk checkout $expected_path must not remain after cleanup"$'\n'
  fi
  branch_name=$(first_implement_branch "$repo_dir")
  if [ -z "$branch_name" ]; then
    problems="${problems}implement branch MAY remain (expected for PR); none found"$'\n'
  fi
  if ! grep -Fq -- "$expected_pr_url" "$out_file"; then
    problems="${problems}expected PR URL in output"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_stale_worktree_path_still_opens_draft_pr() {
  # If stale worktree path already exists before create, run still succeeds
  # (production removes/recreates).
  test_name="Phase 5: stale worktree path is removed/recreated; draft PR still opens"
  now="2026-08-18T10:00:00"
  implement_fixture=success
  setup_eligible_run_env "wt-stale"

  find_id="smell-wt-stale"
  write_smell_candidates_json "$fixture_dir" \
    "[{\"id\":\"${find_id}\",\"source\":\"smell\",\"title\":\"Stale worktree\",\"summary\":\"pre-seed empty dir\",\"rank\":1,\"status\":\"open\"}]"

  stale_path=$(expected_worktree_path_for "$repo_dir" "$find_id" "20260818")
  mkdir -p "$stale_path"
  printf '%s\n' "stale" >"$stale_path/stale-marker.txt"

  out_file="$TEST_ROOT/run-wt-stale-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  expected_pr_url="https://example.test/pr/99"
  problems=""
  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0 despite stale worktree path, got $status"$'\n'
  fi
  if ! assert_gh_pr_create_draft "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}expected draft PR create when stale worktree path pre-existed"$'\n'
  fi
  if ! grep -Fq -- "$expected_pr_url" "$out_file" \
    && ! grep -qiE 'opened draft|draft pr' "$out_file"; then
    problems="${problems}expected opened draft PR signal"$'\n'
  fi
  draft_cache=$(yaml_get "$repo_dir/.inchworm.yml" "state.active_draft_pr" 2>/dev/null || printf 'ERR')
  if [ "$draft_cache" != "$expected_pr_url" ]; then
    problems="${problems}expected active_draft_pr=$expected_pr_url, got: $draft_cache"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" "stale_path=$stale_path"
    return
  fi
  pass "$test_name"
}

test_run_notify_failure_prints_fallback() {
  # When INCHWORM_NOTIFY exits non-zero: still print ping line + fallback line.
  test_name="Phase 5: notify failure still pings and prints notification fallback"
  now="2026-08-18T10:00:00"
  implement_fixture=success
  setup_eligible_run_env "notify-fail"
  write_mock_notify_failing "$mock_notify"

  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"smell-notify-fail","source":"smell","title":"Notify fail","summary":"fallback required","rank":1,"status":"open"}]'

  out_file="$TEST_ROOT/run-notify-fail-out.txt"
  expected_pr_url="https://example.test/pr/99"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  problems=""
  if [ "$status" -eq 127 ] && [ ! -x "$INCHWORM" ]; then
    problems="${problems}inchworm binary missing"$'\n'
  fi
  if ! grep -Fq -- "inchworm: ping — draft PR ${expected_pr_url}" "$out_file" \
    && ! grep -E "inchworm: ping .*${expected_pr_url}" "$out_file" >/dev/null; then
    problems="${problems}expected inchworm: ping — draft PR <url> despite notify failure"$'\n'
  fi
  if ! grep -qiE 'notify fallback|notification fallback|logged PR' "$out_file"; then
    problems="${problems}expected fallback line matching /notify fallback|notification fallback|logged PR/i"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_same_day_retry_after_draft_clears() {
  # Run 1: blocking_draft, last_run null → skip without stamp; may set active_draft_pr.
  # Run 2 same day: gh none, last_run still null → stamp + discover + implement success.
  # After run2 success, active_draft_pr is the new PR URL (stale cache cleared or overwritten).
  test_name="Phase 5: same-day retry after draft clears proceeds and refreshes active_draft_pr"
  now="2026-08-18T10:00:00"
  config_dir="$TEST_ROOT/run-retry-config"
  repo_dir="$TEST_ROOT/run-retry-repo"
  mock_gh="$TEST_ROOT/run-retry-gh"
  mock_pr_review="$TEST_ROOT/run-retry-pr-review"
  mock_notify="$TEST_ROOT/run-retry-notify"
  data_dir="$TEST_ROOT/run-retry-data"
  fixture_dir="$TEST_ROOT/run-retry-fixtures"
  make_repo "$repo_dir"
  seed_registered_repo "$repo_dir" "$config_dir" "null"
  add_local_origin "$repo_dir" "$TEST_ROOT/run-retry-origin.git"
  write_mock_gh "$mock_gh" "blocking_draft"
  write_mock_pr_review "$mock_pr_review"
  write_mock_notify "$mock_notify"
  mkdir -p "$data_dir" "$fixture_dir"
  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"smell-retry","source":"smell","title":"Retry after draft","summary":"should run on second tick","rank":1,"status":"open"}]'
  : >"$TEST_ROOT/agent-invocations.log"
  : >"$TEST_ROOT/gh-invocations.log"
  : >"$TEST_ROOT/pr-review-invocations.log"
  : >"$TEST_ROOT/notify-invocations.log"

  out1="$TEST_ROOT/run-retry-out1.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE=success
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$out1" 2>&1

  after_last1=$(yaml_get "$repo_dir/.inchworm.yml" "state.last_run_date" 2>/dev/null || printf 'ERR')
  draft_cache1=$(yaml_get "$repo_dir/.inchworm.yml" "state.active_draft_pr" 2>/dev/null || printf 'ERR')

  problems=""
  if [ "$after_last1" != "null" ]; then
    problems="${problems}run1: last_run_date must stay null on draft skip, got: $after_last1"$'\n'
  fi
  if ! grep -qiE "draft|blocking" "$out1"; then
    problems="${problems}run1: expected blocking-draft skip signal"$'\n'
  fi
  # Cache may be set to blocking PR URL (optional but allowed).
  # Rewrite mock gh to none for same-day retry.
  write_mock_gh "$mock_gh" "none"
  : >"$TEST_ROOT/gh-invocations.log"

  out2="$TEST_ROOT/run-retry-out2.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE=success
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$out2" 2>&1
  status2=$?

  after_last2=$(yaml_get "$repo_dir/.inchworm.yml" "state.last_run_date" 2>/dev/null || printf 'ERR')
  draft_cache2=$(yaml_get "$repo_dir/.inchworm.yml" "state.active_draft_pr" 2>/dev/null || printf 'ERR')
  expected_pr_url="https://example.test/pr/99"

  if [ "$status2" -ne 0 ]; then
    problems="${problems}run2: expected exit 0 after draft cleared, got $status2"$'\n'
  fi
  if [ "$after_last2" != "2026-08-18" ]; then
    problems="${problems}run2: expected last_run_date stamped 2026-08-18, got: $after_last2"$'\n'
  fi
  if ! assert_gh_pr_create_draft "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}run2: expected gh pr create --draft after draft cleared"$'\n'
  fi
  if [ "$draft_cache2" != "$expected_pr_url" ]; then
    problems="${problems}run2: active_draft_pr must be new PR URL (was run1=$draft_cache1), got: $draft_cache2"$'\n'
  fi
  if ! grep -q 'smell-retry' "$out2"; then
    problems="${problems}run2: expected selected find smell-retry"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "run1:" "$(cat "$out1")" "run2:" "$(cat "$out2")"
    return
  fi
  pass "$test_name"
}

test_run_malformed_gh_pr_list_treated_as_no_blocking() {
  # Soft gh quirk: non-JSON pr list → treat as no blocking draft; do not crash; may proceed.
  test_name="Phase 5: malformed gh pr list JSON treated as no blocking draft"
  now="2026-08-18T10:00:00"
  implement_fixture=success
  setup_eligible_run_env "gh-malformed"
  write_mock_gh "$mock_gh" "malformed"

  write_smell_candidates_json "$fixture_dir" \
    '[{"id":"smell-malformed-gh","source":"smell","title":"Malformed gh","summary":"soft parse","rank":1,"status":"open"}]'

  out_file="$TEST_ROOT/run-gh-malformed-out.txt"
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_NOW="$now"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_DATA_DIR="$data_dir"
    export INCHWORM_SCOUT_FIXTURE_DIR="$fixture_dir"
    export INCHWORM_IMPLEMENT_FIXTURE="$implement_fixture"
    export INCHWORM_PR_REVIEW="$mock_pr_review"
    export INCHWORM_REVIEW_FIXTURE=none
    export INCHWORM_NOTIFY="$mock_notify"
    export INCHWORM_AGENT="$TEST_ROOT/fake-bin/agent"
    run_inchworm run
  ) >"$out_file" 2>&1
  status=$?

  after_last=$(yaml_get "$repo_dir/.inchworm.yml" "state.last_run_date" 2>/dev/null || printf 'ERR')
  expected_pr_url="https://example.test/pr/99"
  problems=""

  if grep -qiE 'JSON::ParserError|unexpected token|parse error|traceback|fatal' "$out_file"; then
    problems="${problems}must not crash on malformed gh pr list JSON"$'\n'
  fi
  if [ "$status" -eq 127 ] && [ ! -x "$INCHWORM" ]; then
    problems="${problems}inchworm binary missing"$'\n'
  elif [ "$status" -ne 0 ]; then
    # Soft: non-zero OK only if clearly treated as no draft and continued; prefer success.
    if [ "$after_last" = "null" ] && ! grep -qiE 'eligible|selected|opened draft' "$out_file"; then
      problems="${problems}malformed pr list should not block; expected proceed (got exit $status)"$'\n'
    fi
  fi
  if [ "$after_last" != "2026-08-18" ]; then
    problems="${problems}expected stamp last_run_date when treating malformed list as no draft, got: $after_last"$'\n'
  fi
  if ! assert_gh_pr_create_draft "$TEST_ROOT/gh-invocations.log"; then
    problems="${problems}expected draft PR create (malformed list = no blocking draft)"$'\n'
  fi
  draft_cache=$(yaml_get "$repo_dir/.inchworm.yml" "state.active_draft_pr" 2>/dev/null || printf 'ERR')
  if [ "$draft_cache" != "$expected_pr_url" ]; then
    problems="${problems}expected active_draft_pr=$expected_pr_url, got: $draft_cache"$'\n'
  fi

  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "exit=$status" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

# --- human `inchworm review` (not the daily Standard pr-review path) ---------

review_worktree_path_for() {
  repo=$1
  branch=$2
  printf '%s.%s\n' "$repo" "${branch//\//-}"
}

test_review_usage_mentions_review() {
  test_name="usage lists the review command"
  out_file="$TEST_ROOT/review-usage-out.txt"
  run_inchworm -h >"$out_file" 2>&1
  if grep -qE '(^|[[:space:]])review([[:space:]]|$)' "$out_file"; then
    pass "$test_name"
    return
  fi
  fail "$test_name" "expected usage to mention review" "output:" "$(cat "$out_file")"
}

test_review_zero_drafts_exits_without_agent() {
  test_name="review with no matching drafts prints that and exits 0"
  setup_review_command_env "review-zero"
  write_review_gh_list "$repo_dir" '[]'
  out_file="$TEST_ROOT/review-zero-out.txt"
  run_review_cmd >"$out_file" 2>&1
  status=$?
  problems=""
  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if ! grep -qi 'no open drafts' "$out_file"; then
    problems="${problems}expected a no-open-drafts message"$'\n'
  fi
  if [ -s "$TEST_ROOT/agent-invocations.log" ]; then
    problems="${problems}must not launch agent"$'\n'"$(cat "$TEST_ROOT/agent-invocations.log")"$'\n'
  fi
  if grep -E '(^|[[:space:]])switch([[:space:]]|$)' "$TEST_ROOT/wt-invocations.log" >/dev/null 2>&1; then
    problems="${problems}must not wt switch"$'\n'"$(cat "$TEST_ROOT/wt-invocations.log")"$'\n'
  fi
  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_review_lists_gate_shaped_drafts_not_hand_cut() {
  test_name="review lists recorded or dated drafts across repos; omits hand-cut and ready PRs"
  setup_review_command_env "review-list"
  repo_a=$repo_dir
  repo_b="$TEST_ROOT/review-list-repo-b"
  make_repo "$repo_b"
  cp "$repo_a/.inchworm.yml" "$repo_b/.inchworm.yml"
  cat >"$config_dir/config.yml" <<EOF
version: 1
defaults:
  runtime: cursor-cli
  schedule:
    days: [mon, tue, wed, thu, fri]
    window_local: "08:00-15:00"
    catch_up_missed_days: false
    poll_interval_hint: 1h
repos:
  - path: ${repo_a}
  - path: ${repo_b}
EOF
  ruby -e '
    require "yaml"
    path = ARGV.fetch(0)
    data = YAML.load_file(path)
    data["state"] ||= {}
    data["state"]["active_draft_pr"] = "https://example.test/pr/44"
    File.write(path, YAML.dump(data))
  ' "$repo_a/.inchworm.yml"

  write_review_gh_list "$repo_a" \
    "[{\"number\":42,\"url\":\"https://example.test/pr/42\",\"isDraft\":true,\"headRefName\":\"${TEST_BRANCH_PREFIX}/foo-20260817\"},{\"number\":43,\"url\":\"https://example.test/pr/43\",\"isDraft\":true,\"headRefName\":\"${TEST_BRANCH_PREFIX}/refactor-widgets\"},{\"number\":7,\"url\":\"https://example.test/pr/7\",\"isDraft\":false,\"headRefName\":\"${TEST_BRANCH_PREFIX}/bar-20260817\"},{\"number\":44,\"url\":\"https://example.test/pr/44\",\"isDraft\":true,\"headRefName\":\"legacy/old-naming\"}]"
  write_review_gh_list "$repo_b" \
    "[{\"number\":50,\"url\":\"https://example.test/pr/50\",\"isDraft\":true,\"headRefName\":\"${TEST_BRANCH_PREFIX}/other-20260818\"}]"

  out_file="$TEST_ROOT/review-list-out.txt"
  run_review_cmd >"$out_file" 2>&1
  status=$?
  problems=""
  if [ "$status" -eq 0 ]; then
    problems="${problems}non-TTY multi-draft review must fail instead of hanging"$'\n'
  fi
  for needle in "$repo_a" "$repo_b" "${TEST_BRANCH_PREFIX}/foo-20260817" \
    "https://example.test/pr/42" "legacy/old-naming" "https://example.test/pr/44" \
    "${TEST_BRANCH_PREFIX}/other-20260818" "https://example.test/pr/50"; do
    if ! grep -F -- "$needle" "$out_file" >/dev/null; then
      problems="${problems}list missing: $needle"$'\n'
    fi
  done
  if grep -F "${TEST_BRANCH_PREFIX}/refactor-widgets" "$out_file" >/dev/null; then
    problems="${problems}hand-cut draft without a date suffix must not be listed"$'\n'
  fi
  if grep -F "https://example.test/pr/7" "$out_file" >/dev/null; then
    problems="${problems}ready (non-draft) PR must not be listed"$'\n'
  fi
  if [ -s "$TEST_ROOT/agent-invocations.log" ]; then
    problems="${problems}multi-draft non-TTY must not launch agent"$'\n'
  fi
  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "exit=$status" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_review_unique_draft_switches_worktree_and_launches_agent() {
  test_name="unique review draft switches Worktrunk and launches a relic/force-with-lease agent"
  setup_review_command_env "review-unique"
  branch="${TEST_BRANCH_PREFIX}/foo-20260817"
  git -C "$repo_dir" branch "$branch" develop
  write_review_gh_list "$repo_dir" \
    "[{\"number\":42,\"url\":\"https://example.test/pr/42\",\"isDraft\":true,\"headRefName\":\"${branch}\"}]"
  expected_wt=$(review_worktree_path_for "$repo_dir" "$branch")

  out_file="$TEST_ROOT/review-unique-out.txt"
  run_review_cmd >"$out_file" 2>&1
  status=$?
  problems=""
  if [ "$status" -ne 0 ]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if ! assert_wt_switch_logged; then
    problems="${problems}expected wt switch"$'\n'"$(cat "$TEST_ROOT/wt-invocations.log")"$'\n'
  fi
  if ! grep -F -- "$branch" "$TEST_ROOT/wt-invocations.log" >/dev/null; then
    problems="${problems}wt switch must target $branch"$'\n'"$(cat "$TEST_ROOT/wt-invocations.log")"$'\n'
  fi
  if grep -F '.inchworm/worktrees' "$TEST_ROOT/wt-invocations.log" >/dev/null; then
    problems="${problems}must not use .inchworm/worktrees/"$'\n'
  fi
  if ! grep -qiE 'relic' "$TEST_ROOT/agent-invocations.log"; then
    problems="${problems}agent prompt must mention relics"$'\n'"$(cat "$TEST_ROOT/agent-invocations.log")"$'\n'
  fi
  if ! grep -qF -- '--force-with-lease' "$TEST_ROOT/agent-invocations.log"; then
    problems="${problems}agent prompt must mention --force-with-lease"$'\n'"$(cat "$TEST_ROOT/agent-invocations.log")"$'\n'
  fi
  if ! grep -qiE 'discuss' "$TEST_ROOT/agent-invocations.log"; then
    problems="${problems}agent prompt must prepare to discuss the PR"$'\n'
  fi
  if grep -E '(^|[[:space:]])-p([[:space:]]|$)|(^|[[:space:]])--print([[:space:]]|$)' \
    "$TEST_ROOT/agent-invocations.log" >/dev/null; then
    problems="${problems}review agent must be interactive (no -p/--print)"$'\n'
  fi
  if ! assert_agent_argv_safe "$TEST_ROOT/agent-invocations.log"; then
    problems="${problems}agent argv must not include --yolo/--force/--trust"$'\n'
  fi
  if ! grep -F "cwd=$expected_wt" "$TEST_ROOT/agent-invocations.log" >/dev/null; then
    problems="${problems}agent must run in Worktrunk checkout $expected_wt"$'\n'"$(cat "$TEST_ROOT/agent-invocations.log")"$'\n'
  fi
  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_review_argv_skips_prompt_when_unique() {
  test_name="review argv (PR number or repo path) selects uniquely without a TTY prompt"
  setup_review_command_env "review-argv"
  branch_a="${TEST_BRANCH_PREFIX}/foo-20260817"
  branch_b="${TEST_BRANCH_PREFIX}/other-20260818"
  git -C "$repo_dir" branch "$branch_a" develop
  git -C "$repo_dir" branch "$branch_b" develop
  write_review_gh_list "$repo_dir" \
    "[{\"number\":42,\"url\":\"https://example.test/pr/42\",\"isDraft\":true,\"headRefName\":\"${branch_a}\"},{\"number\":50,\"url\":\"https://example.test/pr/50\",\"isDraft\":true,\"headRefName\":\"${branch_b}\"}]"

  out_file="$TEST_ROOT/review-argv-out.txt"
  run_review_cmd 42 >"$out_file" 2>&1
  status=$?
  problems=""
  if [ "$status" -ne 0 ]; then
    problems="${problems}PR number argv expected exit 0, got $status"$'\n'
  fi
  if ! grep -F -- "$branch_a" "$TEST_ROOT/wt-invocations.log" >/dev/null; then
    problems="${problems}number 42 must switch $branch_a"$'\n'
  fi
  if grep -F -- "$branch_b" "$TEST_ROOT/wt-invocations.log" >/dev/null; then
    problems="${problems}number 42 must not switch $branch_b"$'\n'
  fi

  repo_a=$repo_dir
  repo_b="$TEST_ROOT/review-argv-repo-b"
  make_repo "$repo_b"
  cp "$repo_a/.inchworm.yml" "$repo_b/.inchworm.yml"
  cat >"$config_dir/config.yml" <<EOF
version: 1
defaults:
  runtime: cursor-cli
  schedule:
    days: [mon, tue, wed, thu, fri]
    window_local: "08:00-15:00"
    catch_up_missed_days: false
    poll_interval_hint: 1h
repos:
  - path: ${repo_a}
  - path: ${repo_b}
EOF
  git -C "$repo_b" branch "$branch_b" develop
  write_review_gh_list "$repo_b" \
    "[{\"number\":50,\"url\":\"https://example.test/pr/50\",\"isDraft\":true,\"headRefName\":\"${branch_b}\"}]"
  : >"$TEST_ROOT/wt-invocations.log"
  : >"$TEST_ROOT/agent-invocations.log"
  run_review_cmd "$repo_b" >>"$out_file" 2>&1
  status=$?
  if [ "$status" -ne 0 ]; then
    problems="${problems}repo path argv expected exit 0, got $status"$'\n'
  fi
  if ! grep -F -- "$branch_b" "$TEST_ROOT/wt-invocations.log" >/dev/null; then
    problems="${problems}repo path must switch $branch_b"$'\n'"$(cat "$TEST_ROOT/wt-invocations.log")"$'\n'
  fi
  expected_wt=$(review_worktree_path_for "$repo_b" "$branch_b")
  if ! grep -F "cwd=$expected_wt" "$TEST_ROOT/agent-invocations.log" >/dev/null; then
    problems="${problems}repo path must launch agent in $expected_wt"$'\n'"$(cat "$TEST_ROOT/agent-invocations.log")"$'\n'
  fi
  if [ -n "$problems" ]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_review_skill_keeps_human_command_distinct() {
  test_name="skill docs describe inchworm review separately from daily Standard pr-review"
  skill_md="$SKILL_ROOT/SKILL.md"
  corpus_files="$skill_md"
  if [ -d "$SKILL_ROOT/references" ]; then
    corpus_files="$corpus_files $(find "$SKILL_ROOT/references" -type f 2>/dev/null | head -n 50)"
  fi
  blob=$(cat $corpus_files 2>/dev/null || true)
  problems=""
  if ! printf '%s' "$blob" | grep -qiE 'inchworm review'; then
    problems="${problems}skill/references must mention inchworm review"$'\n'
  fi
  if ! printf '%s' "$blob" | grep -qiE 'relic'; then
    problems="${problems}skill/references must mention the relic sweep"$'\n'
  fi
  if ! printf '%s' "$blob" | grep -qiE 'force-with-lease'; then
    problems="${problems}skill/references must mention force-with-lease for review"$'\n'
  fi
  if [ -n "$problems" ]; then
    fail "$test_name" "$problems"
    return
  fi
  pass "$test_name"
}

