#!/usr/bin/env bash
# Phase 5 inchworm RED tests (practicing-tdd). Extends Phase 1–4 gates.
#
# Production CLI contracts this harness expects (implement in bin/inchworm + skills):
#
# Env overrides (never touch real ~/.config or ~/.local/share from these tests):
#   INCHWORM_CONFIG_DIR       — global config directory (contains config.yml)
#   INCHWORM_NOW              — injectable local wall time: YYYY-MM-DDTHH:MM:SS
#   INCHWORM_GH               — gh binary used for draft discovery + pr create
#   INCHWORM_GITIGNORE_GLOBAL — path init should ensure ignore entries on
#   INCHWORM_REPO (optional)  — operate on one registered path; else all / cwd for init
#   INCHWORM_DATA_DIR         — root for finds (default ~/.local/share/inchworm);
#                               tests MUST set this under TEST_ROOT
#   INCHWORM_SCOUT_FIXTURE_DIR — if set, load scout candidate JSON from this dir
#                               (test stub). Filenames: smell.json, lint.json,
#                               errors.json, backlog.json. When unset, live agent
#                               scouts run for all four sources (smell, lint,
#                               errors, backlog) via INCHWORM_AGENT.
#   INCHWORM_BRANCH_PREFIX    — overrides yaml/git identity. The harness unsets
#                               it unless a test exported it on purpose.
#                               Production reads .inchworm.yml branch_prefix,
#                               then git user.name.
#   INCHWORM_IMPLEMENT_FIXTURE — Phase 3 implementer stub (no live agent required):
#                               success   — worktree + implement branch ready for draft PR
#                               fail      — implement fails; mark find deferred; no PR
#                               too_large — implement fails; mark find too_large; no PR
#                               Unset in production → real implementer process.
#   INCHWORM_PR_REVIEW        — path to Standard pr-review launcher
#                               (default: bin/pr-review sibling or PATH). Tests set a mock.
#   INCHWORM_REVIEW_FIXTURE   — none | advisory | blocking
#                               none      — Standard review artifacts with no findings
#                                           (empty ledger / "No findings.")
#                               advisory  — artifacts with verified Class: advisory only
#                                           (no fixer required)
#                               blocking  — artifacts with ≥1 verified Class: blocking
#                               unset     — live Standard pr-review against the draft PR URL
#   INCHWORM_FIX_FIXTURE      — success | fail (only when blocking findings exist)
#                               success — fixer addresses blockers (signal in output)
#                               fail    — residual blockers surfaced in ping/output; still ping
#                               unset   — live fixer agent in worktree (blocking only; one pass)
#   INCHWORM_NOTIFY           — optional notify binary (tests mock it); production may use
#                               osascript. Invoked once with the draft PR URL (or equivalent
#                               argv containing that URL) after review (+ optional fix).
#                               If notify exits non-zero: still print ping line + a fallback
#                               line matching /notify fallback|notification fallback|logged PR/i
#
# Repo config (.inchworm.yml):
#   guidance — optional plain text injected into scout / implementer / fixer prompts
#              (file is gitignored; guidance is not read from the worktree)
# Finds path:
#   Dir:  $INCHWORM_DATA_DIR/<path-hash>/
#   <path-hash> = first 16 hex chars of sha256(UTF-8 absolute registered repo path)
#   File: finds.md inside that dir
#   Different absolute paths → different hashes.
#
# Review artifacts (Phase 4; prefer DATA_DIR path-hash, stay out of gitignored worktrees):
#   Dir:  $INCHWORM_DATA_DIR/<path-hash>/review/
#   Required: findings-ledger.md
#   Ideally also: context-brief.md, perfect-review.md (stubs OK in fixtures)
#   Coordinator sets INCHWORM_REVIEW_ARTIFACT_DIR to that review/ path when launching
#   INCHWORM_PR_REVIEW so the mock/launcher can write fixtures there.
#
# Fix fixture side-effect (when INCHWORM_FIX_FIXTURE is set and fixer runs):
#   File: $INCHWORM_DATA_DIR/<path-hash>/fix/fixture-ran
#   Contents: success | fail (matches INCHWORM_FIX_FIXTURE)
#   Must NOT exist when review has no verified blockers (none / advisory-only).
#   `success` also leaves tracked fix content (fix-fixture.txt) in the worktree
#   so the leftover-commit → rewrite → push path has something to land.
#
# After the fixer pass (fixture or live):
#   1. Commit leftover fixer edits under the find's subject/body
#   2. Squash origin/develop..HEAD into one authored commit (always). Message:
#      pre-fix implement commit if present and clean; else the find fallback
#      if that is clean; else restore HEAD to the pre-fix SHA, do not push
#   3. Update the existing draft branch: git push --force-with-lease origin HEAD
#      (the first implement push stays a non-force `git push -u origin HEAD`;
#      never force-push develop / main / master)
#   4. Then ping, then remove the worktree (keep the branch)
#   Fixture mode skips the network for both pushes but still rewrites locally,
#   and logs the two pushes distinguishably (first push vs post-fix push).
#   No clean squash message, or a failed squash → restore pre-fix HEAD, fixer
#   fail, no push; the coordinator still pings.
#
# Blocking mapping for fixer (open decision #6, locked for v1):
#   Blocking = ledger findings with Class: blocking AND Disposition: verified
#   Advisory and/or non-verified → leave for human; do not require fixer
#   After fixer (or after review if no blockers): ping immediately (decision #7 v1)
#
# Candidate schema (scout JSON arrays). Each object MUST include at least:
#   id (string slug), source (lint|errors|backlog|smell), title, summary,
#   rank (int, lower = higher priority; 1 best), status (new → "open");
#   optional evidence (string).
#
# finds.md durable backlog (curator-owned). Minimum shape:
#   # Inchworm finds
#   <!-- inchworm:finds-version:1 -->
#   ## F-<id>
#   - status: open
#   - source: smell
#   - rank: 1
#   - title: ...
#   - summary: ...
# Statuses: open (eligible for pick); deferred / in_pr / too_large ignored by pick.
# Phase 3: successful implement → status in_pr; fail fixture → deferred;
#          too_large fixture → too_large.
# Phase 5 curator tidy (on eligible discover write):
#   - DROP status deferred and too_large from finds.md after merge
#   - KEEP open and in_pr
#   - Cap: keep at most 20 open finds (best by lowest rank); always keep in_pr;
#     deferred/too_large always dropped (even under the cap)
#
# Eligible `inchworm run` pipeline (create-window gates pass):
#   1. Stamp state.last_run_date first (burns the day; no second pick same day)
#   2. Ensure finds dir for repo path hash under INCHWORM_DATA_DIR
#   3. Run scouts: smell, lint, errors, backlog (fixtures when
#      INCHWORM_SCOUT_FIXTURE_DIR set; else live INCHWORM_AGENT per source)
#   4. Curator merge into finds.md (scout candidates + existing; dedupe by id)
#      then Phase 5 tidy (drop deferred/too_large; cap open at 20)
#   5. Pick highest-ranked eligible open find (lowest rank wins); else print none
#   6. If none: stop — no implement, no worktree, no `gh pr create`
#   7. If selected: implementer process in a Worktrunk checkout on branch
#      <branch_prefix>/<slug>-<YYYYMMDD> — the prefix names the human, never the runner
#      Checkout path: <repo>.<branch with / replaced by -> (wt switch, not git worktree add)
#      If that path already exists (stale empty dir), clobber/recreate and still succeed
#   8. On implement success: coordinator `gh pr create --draft`, record
#      state.active_draft_pr to the PR URL, mark find in_pr, print PR URL / opened draft
#   9. On implement failure (fail|too_large): mark deferred|too_large, no PR,
#      active_draft_pr stays null, do not pick a second find (stamp already burned);
#      skip review / fixer / ping; clean up any worktree created on live fail paths
#  10. After successful draft PR: run full Standard pr-review once (reuse launcher;
#      no inchworm-lite). Write artifacts under review/ path above.
#  11. Map ledger → blocking for fixer (Class: blocking + Disposition: verified only)
#  12. If blockers: one fixer pass (blocking only); no review↔fix loop
#  13. Ping immediately (notify and/or log) with PR URL — even if residual blockers
#  14. Phase 5: after successful PR+review+ping, remove the Worktrunk checkout
#      (wt remove --no-delete-branch); git worktree list must not show it or
#      .inchworm/worktrees/; branch MAY remain
#
# Authored output (branch, commits, PR title/body):
#   Never name the runner. Branch = <prefix>/<slug>-<YYYYMMDD>; commits are Tim Pope
#   style from the implementer (coordinator falls back to the find's title/summary);
#   PR title/body come from the agent's gitignored .inchworm/pr/{title.txt,body.md},
#   with lines naming the runner dropped. A commit message that names the runner is
#   rewritten by resetting onto the base and committing once (nothing pushed yet).
#
# Agent rules: fixtures / local curator+pick+implement+review+fix fixtures. If agent
# argv is recorded, never allow --yolo, --force, or --trust.
# At most one Standard review + one blocking-fix pass per run.
#
# Mock gh:
#   Draft gate list (approx):
#     gh pr list --author @me --state open --json number,url,isDraft,headRefName
#   Blocking rule: an open PR with isDraft=true whose url matches
#     state.active_draft_pr, or whose headRefName matches
#     <branch_prefix>/<slug>-<YYYYMMDD> (the date suffix keeps hand-cut branches out).
#   active_draft_pr is cache/UX only; never the sole gate.
#   Soft skip without stamp when blocked; same-day retry after draft clears (gh → none)
#   must proceed (stamp + discover + implement) while last_run still null.
#   On eligible (no blocking draft): clear stale active_draft_pr to null before/at stamp,
#   OR overwrite only when a new PR opens.
#   Soft quirk: mode malformed (non-JSON pr list) → treat as no blocking draft; do not crash.
#   Phase 3 create: gh pr create --draft --base develop … → prints https://example.test/pr/99
#   Implement base: always git fetch origin then branch from origin/develop (not HEAD).
#   Soft-defer when origin/develop cannot be resolved (live); fixture mode may fall back.
#
# Create window: Mon–Fri local, half-open [08:00, 15:00).
# Phase 4 eligible: stamp + discover + implement + draft PR + Standard review +
#   optional one fix pass + ping (when a find is selected and implement succeeds).
#
# Phase 5 launchd:
#   Template: launchd/com.inchworm.plist.template (placeholders; no hard-coded $HOME)
#   Installed by: inchworm launchd-setup → ~/Library/LaunchAgents/com.inchworm.plist
#   ProgramArguments: FDA-scoped runner + absolute bin/inchworm + run
#   StartCalendarInterval: Weekday 1–5, Hour 8–14 inclusive (last tick 2pm; no hour 15)
#   Install notes: codex/skills/inchworm/references/launchd-install.md
#   Skill corpus may mention launchd / LaunchAgent (Phase 5; no longer "No launchd").
#   inchworm launchd-setup installs the runner (private bash copy) for scoped FDA.

set -u

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
DOTS=$(CDPATH= cd "$SCRIPT_DIR/.." && pwd)
INCHWORM="$DOTS/bin/inchworm"
SKILL_ROOT="$DOTS/codex/skills/inchworm"

# Branch namespace used by fixture repos (production derives it from git user.name).
TEST_BRANCH_PREFIX="tester"

TEST_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/test-inchworm.XXXXXX") || exit 1
# Normalize spelling (macOS TMPDIR trailing slash can yield T//… from mktemp).
TEST_ROOT=$(CDPATH= cd "$TEST_ROOT" && pwd)
trap 'rm -rf "$TEST_ROOT"' EXIT HUP INT TERM

tests_run=0
tests_failed=0

# --- helpers -----------------------------------------------------------------

pass() {
  printf '%s\n' "ok - $1"
}

fail() {
  printf '%s\n' "not ok - $1"
  if [ "$#" -gt 1 ]; then
    shift
    printf '%s\n' "$@"
  fi
  tests_failed=$((tests_failed + 1))
}

run_test() {
  tests_run=$((tests_run + 1))
  "$@"
}

write_yaml_helpers() {
  cat >"$TEST_ROOT/yaml_get.rb" <<'RUBY'
#!/usr/bin/env ruby
# frozen_string_literal: true

require "yaml"

path = ARGV.fetch(0)
keys = ARGV.fetch(1).split(".")
data = YAML.load_file(path)
value = keys.reduce(data) do |current, key|
  break nil unless current.is_a?(Hash)

  current.key?(key) ? current[key] : current[key.to_sym]
end

case value
when nil
  print "null"
when true
  print "true"
when false
  print "false"
when Array
  print value.map { |item| item.is_a?(Hash) ? (item["path"] || item[:path]).to_s : item.to_s }.join("\n")
else
  print value
end
RUBY

  cat >"$TEST_ROOT/yaml_has_repo.rb" <<'RUBY'
#!/usr/bin/env ruby
# frozen_string_literal: true

require "yaml"

path = ARGV.fetch(0)
wanted = ARGV.fetch(1)
data = YAML.load_file(path)
repos = data.is_a?(Hash) ? (data["repos"] || data[:repos] || []) : []
paths = Array(repos).map do |entry|
  entry.is_a?(Hash) ? (entry["path"] || entry[:path]).to_s : entry.to_s
end
exit(paths.count { |repo_path| repo_path == wanted } == 1 ? 0 : 1)
RUBY

  cat >"$TEST_ROOT/yaml_repo_count.rb" <<'RUBY'
#!/usr/bin/env ruby
# frozen_string_literal: true

require "yaml"

path = ARGV.fetch(0)
wanted = ARGV.fetch(1)
data = YAML.load_file(path)
repos = data.is_a?(Hash) ? (data["repos"] || data[:repos] || []) : []
paths = Array(repos).map do |entry|
  entry.is_a?(Hash) ? (entry["path"] || entry[:path]).to_s : entry.to_s
end
print paths.count { |repo_path| repo_path == wanted }
RUBY

  chmod +x "$TEST_ROOT/yaml_get.rb" "$TEST_ROOT/yaml_has_repo.rb" "$TEST_ROOT/yaml_repo_count.rb"
}

yaml_get() {
  mise exec -- ruby "$TEST_ROOT/yaml_get.rb" "$1" "$2"
}

yaml_has_exact_repo_once() {
  mise exec -- ruby "$TEST_ROOT/yaml_has_repo.rb" "$1" "$2"
}

yaml_repo_occurrences() {
  mise exec -- ruby "$TEST_ROOT/yaml_repo_count.rb" "$1" "$2"
}

file_contains_line() {
  file=$1
  line=$2
  [ -f "$file" ] || return 1
  grep -Fxq -- "$line" "$file"
}

# First 16 hex chars of sha256 of absolute repo path (UTF-8 bytes).
repo_path_hash() {
  abs_path=$1
  printf '%s' "$abs_path" | openssl dgst -sha256 | awk '{print substr($NF,1,16)}'
}

finds_dir_for() {
  data_dir=$1
  repo_path=$2
  printf '%s/%s\n' "$data_dir" "$(repo_path_hash "$repo_path")"
}

finds_md_for() {
  data_dir=$1
  repo_path=$2
  printf '%s/finds.md\n' "$(finds_dir_for "$data_dir" "$repo_path")"
}

# Phase 4: Standard review artifacts under DATA_DIR/<path-hash>/review/
review_dir_for() {
  data_dir=$1
  repo_path=$2
  printf '%s/review\n' "$(finds_dir_for "$data_dir" "$repo_path")"
}

findings_ledger_for() {
  data_dir=$1
  repo_path=$2
  printf '%s/findings-ledger.md\n' "$(review_dir_for "$data_dir" "$repo_path")"
}

# Phase 4: fix fixture side-effect marker
fix_fixture_ran_for() {
  data_dir=$1
  repo_path=$2
  printf '%s/fix/fixture-ran\n' "$(finds_dir_for "$data_dir" "$repo_path")"
}

make_repo() {
  repo_dir=$1
  mkdir -p "$repo_dir"
  git -C "$repo_dir" init -q
  git -C "$repo_dir" config user.email "fixture@example.com"
  git -C "$repo_dir" config user.name "Fixture Author"
  printf '%s\n' "# fixture" >"$repo_dir/README.md"
  git -C "$repo_dir" add README.md
  git -C "$repo_dir" commit -q -m "fixture"
  # Implement worktrees always base on origin/develop — keep fixtures on develop.
  git -C "$repo_dir" branch -M develop
}

# Give a fixture repo a pushable origin (bare) so fetch/push/PR-base paths can run.
# Pushes local develop even when another branch is checked out.
add_local_origin() {
  repo_dir=$1
  origin_dir=$2
  if [ ! -d "$origin_dir" ]; then
    git init -q --bare "$origin_dir"
  fi
  if ! git -C "$repo_dir" remote get-url origin >/dev/null 2>&1; then
    git -C "$repo_dir" remote add origin "$origin_dir"
  fi
  if ! git -C "$repo_dir" show-ref --verify --quiet refs/heads/develop; then
    git -C "$repo_dir" branch develop HEAD
  fi
  git -C "$repo_dir" push -q -u origin refs/heads/develop:refs/heads/develop
}

# Push a new commit to origin/develop via a throwaway clone (does not update
# the main repo's remote-tracking refs until fetch).
push_remote_only_develop_commit() {
  origin_dir=$1
  marker_content=$2
  clone_dir=$3
  git clone -q "$origin_dir" "$clone_dir"
  git -C "$clone_dir" config user.email "fixture@example.com"
  git -C "$clone_dir" config user.name "Fixture Author"
  git -C "$clone_dir" checkout -q develop
  printf '%s\n' "$marker_content" >"$clone_dir/remote-only-develop.txt"
  git -C "$clone_dir" add remote-only-develop.txt
  git -C "$clone_dir" commit -q -m "remote-only develop tip"
  git -C "$clone_dir" push -q origin develop
  git -C "$clone_dir" rev-parse HEAD
}

write_mock_gh() {
  mock_path=$1
  mode=$2
  # modes: none | blocking_draft | ready_non_blocking | malformed
  cat >"$mock_path" <<EOF
#!/usr/bin/env bash
set -u
# Record invocations for agent-leak / argv assertions.
printf '%s\n' "\$*" >>"${TEST_ROOT}/gh-invocations.log"

# Resolve gh pr <subcommand> (list vs create).
pr_cmd=""
prev=""
for arg in "\$@"; do
  if [ "\$prev" = "pr" ]; then
    pr_cmd="\$arg"
    break
  fi
  prev="\$arg"
done

# Draft gate contract: CLI should invoke approximately:
#   gh pr list --author @me --state open --json number,url,isDraft,headRefName
if [ "\$pr_cmd" = "list" ]; then
  case "$mode" in
    none)
      printf '%s\n' '[]'
      exit 0
      ;;
    blocking_draft)
      printf '%s\n' '[{"number":42,"url":"https://example.test/pr/42","isDraft":true,"headRefName":"${TEST_BRANCH_PREFIX}/foo-20260817"}]'
      exit 0
      ;;
    recorded_draft)
      # Open draft on a branch shape we no longer create; only the record matches.
      printf '%s\n' '[{"number":44,"url":"https://example.test/pr/44","isDraft":true,"headRefName":"legacy/old-naming-20260817"}]'
      exit 0
      ;;
    hand_cut_draft)
      # Same prefix, no date suffix: a branch the human cut, not one of ours.
      printf '%s\n' '[{"number":43,"url":"https://example.test/pr/43","isDraft":true,"headRefName":"${TEST_BRANCH_PREFIX}/refactor-widgets"}]'
      exit 0
      ;;
    ready_non_blocking)
      printf '%s\n' '[{"number":7,"url":"https://example.test/pr/7","isDraft":false,"headRefName":"${TEST_BRANCH_PREFIX}/bar-20260817"}]'
      exit 0
      ;;
    malformed)
      # Soft gh quirk: non-JSON stdout with exit 0 → treat as no blocking draft.
      printf '%s\n' 'not-json { broken'
      exit 0
      ;;
    *)
      printf '%s\n' "unknown mock mode: $mode" >&2
      exit 2
      ;;
  esac
fi

# Phase 3: coordinator opens a draft PR after successful implement.
# Record the reviewer-facing copy so tests can assert on title and body.
if [ "\$pr_cmd" = "create" ]; then
  prev=""
  for arg in "\$@"; do
    case "\$prev" in
      --title) printf '%s\n' "\$arg" >"${TEST_ROOT}/gh-pr-title.txt" ;;
      --body-file) cat "\$arg" >"${TEST_ROOT}/gh-pr-body.txt" 2>/dev/null || true ;;
      --body) printf '%s\n' "\$arg" >"${TEST_ROOT}/gh-pr-body.txt" ;;
    esac
    prev="\$arg"
  done
  printf '%s\n' 'https://example.test/pr/99'
  exit 0
fi

# Other gh subcommands: empty/minimal success.
printf '%s\n' '[]'
exit 0
EOF
  chmod +x "$mock_path"
}

# Per-repo PR lists for `inchworm review` (keyed by PWD, which gh_pr_list_json cds into).
write_review_gh_mock() {
  mock_path=$1
  mkdir -p "$TEST_ROOT/review-gh-lists"
  cat >"$mock_path" <<EOF
#!/usr/bin/env bash
set -u
printf '%s\n' "\$*" >>"${TEST_ROOT}/gh-invocations.log"
pr_cmd=""
prev=""
for arg in "\$@"; do
  if [ "\$prev" = "pr" ]; then
    pr_cmd="\$arg"
    break
  fi
  prev="\$arg"
done
if [ "\$pr_cmd" = "list" ]; then
  key=\$(printf '%s' "\$PWD" | sed 's|/|_|g')
  list_file="${TEST_ROOT}/review-gh-lists/\${key}.json"
  if [ -f "\$list_file" ]; then
    cat "\$list_file"
    exit 0
  fi
  printf '%s\n' '[]'
  exit 0
fi
printf '%s\n' '[]'
exit 0
EOF
  chmod +x "$mock_path"
}

write_review_gh_list() {
  repo_path=$1
  json=$2
  mkdir -p "$TEST_ROOT/review-gh-lists"
  key=$(printf '%s' "$repo_path" | sed 's|/|_|g')
  printf '%s\n' "$json" >"$TEST_ROOT/review-gh-lists/${key}.json"
}

setup_review_command_env() {
  suffix=${1:-review}
  config_dir="$TEST_ROOT/$suffix-config"
  repo_dir="$TEST_ROOT/$suffix-repo"
  mock_gh="$TEST_ROOT/$suffix-gh"
  rm -rf "$TEST_ROOT/review-gh-lists"
  mkdir -p "$config_dir"
  make_repo "$repo_dir"
  seed_registered_repo "$repo_dir" "$config_dir" "null"
  write_review_gh_mock "$mock_gh"
  : >"$TEST_ROOT/agent-invocations.log"
  : >"$TEST_ROOT/gh-invocations.log"
  : >"$TEST_ROOT/wt-invocations.log"
}

run_review_cmd() {
  (
    export INCHWORM_CONFIG_DIR="$config_dir"
    export INCHWORM_GH="$mock_gh"
    export INCHWORM_AGENT="${INCHWORM_AGENT:-$TEST_ROOT/fake-bin/agent}"
    unset INCHWORM_REPO 2>/dev/null || true
    run_inchworm review "$@"
  )
}

write_fake_agent_binaries() {
  # If production shells out to agent/codex, these record argv for safety checks.
  mkdir -p "$TEST_ROOT/fake-bin"
  for name in agent codex; do
    cat >"$TEST_ROOT/fake-bin/$name" <<EOF
#!/usr/bin/env bash
printf '%s\n' "cwd=\$(pwd)" >>"$TEST_ROOT/agent-invocations.log"
printf '%s\n' "$name \$*" >>"$TEST_ROOT/agent-invocations.log"
exit 0
EOF
    chmod +x "$TEST_ROOT/fake-bin/$name"
  done
  write_mock_wt
}

# Worktrunk stand-in: records argv and still makes a real git checkout at the
# default Worktrunk path (<repo>.<branch with slashes as dashes>) so the rest of
# the pipeline can git -C into it. Production must call wt, not git worktree add.
write_mock_wt() {
  mkdir -p "$TEST_ROOT/fake-bin"
  cat >"$TEST_ROOT/fake-bin/wt" <<EOF
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "\$*" >>"${TEST_ROOT}/wt-invocations.log"

repo="."
create=""
base=""
cmd=""
target=""
while [ "\$#" -gt 0 ]; do
  case "\$1" in
    -C)
      repo=\$2
      shift 2
      ;;
    --base)
      base=\$2
      shift 2
      ;;
    --base=*)
      base=\${1#--base=}
      shift
      ;;
    --format)
      shift 2
      ;;
    --format=*)
      shift
      ;;
    --create|-c)
      create=1
      shift
      ;;
    -y|--yes|--no-cd|--no-hooks|--clobber|--force|-f|--foreground|--no-delete-branch)
      shift
      ;;
    switch|remove|list)
      cmd=\$1
      shift
      ;;
    --*)
      shift
      ;;
    *)
      target=\$1
      shift
      ;;
  esac
done

repo=\$(CDPATH= cd "\$repo" && pwd)
if [ -z "\$target" ]; then
  printf '%s\n' "wt mock: missing branch or path" >&2
  exit 1
fi
if [ "\${target#/}" != "\$target" ]; then
  path=\$target
else
  path="\${repo}.\${target//\\//-}"
fi

case "\$cmd" in
  switch)
    if [ -n "\$create" ] && git -C "\$repo" show-ref --verify --quiet "refs/heads/\${target}"; then
      printf '%s\n' "wt mock: branch already exists; omit --create" >&2
      exit 1
    fi
    git -C "\$repo" worktree remove --force "\$path" >/dev/null 2>&1 || true
    if [ -e "\$path" ]; then
      rm -rf "\$path"
    fi
    if [ -n "\$create" ]; then
      git -C "\$repo" worktree add -b "\$target" "\$path" "\${base:-HEAD}" >/dev/null
    else
      git -C "\$repo" worktree add "\$path" "\$target" >/dev/null
    fi
    printf '%s\n' "{\"action\":\"created\",\"branch\":\"\$target\",\"path\":\"\$path\"}"
    ;;
  remove)
    git -C "\$repo" worktree remove --force "\$path" >/dev/null 2>&1 || true
    if [ -e "\$path" ]; then
      rm -rf "\$path"
    fi
    git -C "\$repo" worktree prune >/dev/null 2>&1 || true
    ;;
  list)
    printf '%s\n' '[]'
    ;;
  *)
    printf '%s\n' "wt mock: unsupported command: \$cmd" >&2
    exit 1
    ;;
esac
EOF
  chmod +x "$TEST_ROOT/fake-bin/wt"
}

# Live implementer mock: edits the worktree but leaves the work uncommitted.
write_uncommitted_work_agent() {
  agent_path=$1
  cat >"$agent_path" <<EOF
#!/usr/bin/env bash
printf '%s\n' "agent \$*" >>"$TEST_ROOT/agent-invocations.log"
printf '%s\n' "implemented by agent" >"./agent-work.txt"
printf '%s\n' "Implemented the find; verification skipped. No PR opened."
exit 0
EOF
  chmod +x "$agent_path"
}

# Live implementer mock: leaves work uncommitted and writes the PR copy the
# coordinator should use, including one line that names the runner.
write_pr_authoring_agent() {
  agent_path=$1
  cat >"$agent_path" <<EOF
#!/usr/bin/env bash
printf '%s\n' "agent \$*" >>"$TEST_ROOT/agent-invocations.log"
case "\$*" in
  *"Work item:"*) ;;
  *) exit 0 ;;
esac
printf '%s\n' "implemented by agent" >"./agent-work.txt"
mkdir -p .inchworm/pr
printf '%s\n' "Stop retrying exports that already failed" >.inchworm/pr/title.txt
cat >.inchworm/pr/body.md <<'BODY'
## Description of the change

Exports kept retrying after the server gave up, so one bad export filled the queue.

Drafted by inchworm on the daily run.
BODY
exit 0
EOF
  chmod +x "$agent_path"
}

