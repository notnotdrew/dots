#!/usr/bin/env bash
# Init a repo, gate the Wednesday run, open a dated worktree, and ask the orchestrators.
#
# Usage:
#   untangle init
#   untangle run
#   untangle done [change]
#   untangle status
#   untangle launchd-setup [--no-open] [--no-reload]

set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
SCRIPT_DIR="$(CDPATH= cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_NAME
readonly SCRIPT_DIR

readonly YAML_HELPER="${SCRIPT_DIR}/lib/untangle_yaml.rb"
readonly CONFIG_DIR="${UNTANGLE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/untangle}"
readonly CONFIG_FILE="${CONFIG_DIR}/config.yml"
readonly GITIGNORE_GLOBAL="${UNTANGLE_GITIGNORE_GLOBAL:-$HOME/.gitignore_global}"

die() {
  printf '%s: error: %s\n' "$SCRIPT_NAME" "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: untangle <init|run|done|status|launchd-setup>

  init    Write the untangle directory, register cwd, and ensure the gitignore entry
  run     Consider each registered repository on Wednesday
  done    Clear the open plan and advance the cursor; done change clears the open change plan
  status  Show the cursor and the open plan
  launchd-setup   Install the Wednesday LaunchAgent [--no-open] [--no-reload]
EOF
}

# Prefer mise Ruby when PATH is minimal and the shell has not been initialized.
resolve_mise() {
  local candidate
  if command -v mise >/dev/null 2>&1; then
    command -v mise
    return 0
  fi
  for candidate in \
    "${HOME}/.local/bin/mise" \
    /opt/homebrew/bin/mise \
    /usr/local/bin/mise
  do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

ruby_yaml() {
  local mise_bin
  if mise_bin=$(resolve_mise); then
    "$mise_bin" exec -- ruby "$YAML_HELPER" "$@"
  else
    ruby "$YAML_HELPER" "$@"
  fi
}

ensure_gitignore_entry() {
  local file=$1
  local line="untangle/"
  touch "$file"
  if ! grep -Fxq -- "$line" "$file"; then
    printf '%s\n' "$line" >>"$file"
  fi
}

write_guide() {
  local path=$1
  [[ -f "$path" ]] && return 0
  cat >"$path" <<'EOF'
# Guide

The buckets, in cursor order, are Language, Ownership, Boundaries, Representation, Flow, Dependencies, Consolidation, and Removal.

Look at one bucket. Name one knot. Name a completion condition. Behavior preserved. Stop.

A plan names one knot, why the next change is expensive, a completion condition, and behavior-preserving steps. A quiet note says what was looked at and why nothing is ready.

The note opens with the word `plan` or the word `quiet`.

Under Language, when an old and a new generation coexist and the new one should win, the old name becomes `legacy-<name>` and the new one keeps `<name>`. When that would lie, the plan says so and picks another name.

Do not edit the app, commit, or open a pull request.

One orchestrator writes `log.md` and `notes/<yymmdd>.md`. It may delegate a code read. Subagents do not write those files.
EOF
}

write_change_guide() {
  local path=$1
  [[ -f "$path" ]] && return 0
  cat >"$path" <<'EOF'
# Change guide

The buckets, in cursor order, are Language, Ownership, Boundaries, Representation, Flow, Dependencies, Consolidation, and Removal.

Look at one bucket. Ask what valuable change it makes slow or unsafe. A clean kitchen earns its keep by making food safer and faster to cook. Changeable code earns its keep the same way.

A plan names the change, the constraint, what gets faster or safer, a completion condition, and behavior-preserving steps. A quiet note says what change was considered and why this bucket is not the constraint.

The note opens with the word `plan` or the word `quiet`.

Do not edit the app, commit, or open a pull request.

One orchestrator writes `log.md` and `notes/<yymmdd>-change.md`. It may delegate a code read. Subagents do not write those files.
EOF
}

write_log() {
  local path=$1
  [[ -s "$path" ]] && return 0
  printf '%s\n' '# Log' >"$path"
}

# UNTANGLE_NOW=YYYY-MM-DDTHH:MM:SS, otherwise the local clock.
current_now() {
  if [[ -n "${UNTANGLE_NOW:-}" ]]; then
    printf '%s\n' "$UNTANGLE_NOW"
  else
    date '+%Y-%m-%dT%H:%M:%S'
  fi
}

# Print: date weekday hour minute (weekday: 1=Mon .. 7=Sun).
parse_clock() {
  ruby_yaml parse_now "$(current_now)"
}

# %y%m%d from YYYY-MM-DD. 2026-10-14 → 261014.
yymmdd_from_today() {
  local today=$1
  printf '%s%s%s\n' "${today:2:2}" "${today:5:2}" "${today:8:2}"
}

list_registered_repos() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    return 0
  fi
  ruby_yaml list_repos "$CONFIG_FILE"
}

# Repo whose progress_pid this process wrote. The EXIT trap clears only that
# file, so a skip of someone else's live pid leaves their lock alone.
CURRENT_PROGRESS_YML=""
DELIVERED_WORKTREE=""

release_progress() {
  local repo_yml
  repo_yml=${CURRENT_PROGRESS_YML:-}
  [[ -n "$repo_yml" ]] || return 0
  CURRENT_PROGRESS_YML=""
  if [[ -f "$repo_yml" ]]; then
    ruby_yaml clear_progress_pid "$repo_yml" || true
  fi
}

retry_later() {
  local repo_path=$1
  local reason=$2
  printf 'untangle: skip %s — %s; the next tick retries\n' "$repo_path" "$reason"
}

# Point the worktree's untangle entry at the registered directory path.
# The target string stays that path; physical resolution would follow a symlink.
install_untangle_link() {
  local repo_path=$1
  local worktree=$2
  local registered="${repo_path}/untangle"
  local dest="${worktree}/untangle"
  local current=""

  if [[ "$dest" == "$registered" || "$worktree" == "$repo_path" ]]; then
    return 1
  fi
  if [[ ! -e "$registered" && ! -L "$registered" ]]; then
    return 1
  fi

  if [[ -L "$dest" ]]; then
    current=$(readlink "$dest") || return 1
    if [[ "$current" == "$registered" ]]; then
      return 0
    fi
    # Unlink the symlink itself. Do not pass -r or a trailing slash.
    rm -f "$dest" || return 1
  elif [[ -d "$dest" ]]; then
    ruby_yaml remove_copied_dir "$dest" "$registered" || return 1
  elif [[ -e "$dest" ]]; then
    rm -f "$dest" || return 1
  fi

  ln -s "$registered" "$dest"
}

# Fetch trunk, open drew/untangle-<yymmdd>, and link the registered directory.
# On failure the caller clears progress_pid and skips the probe.
deliver_worktree() {
  local repo_path=$1
  local yymmdd=$2
  local repo_abs trunk branch herdr path create_status json_file list_file

  DELIVERED_WORKTREE=""
  repo_abs=$repo_path
  if [[ "$repo_abs" != /* ]]; then
    if ! repo_abs=$(CDPATH= cd "$repo_path" && pwd); then
      retry_later "$repo_path" "delivery failed"
      return 1
    fi
  fi

  if ! trunk=$(ruby_yaml trunk_name "${repo_abs}/untangle/config.yml"); then
    retry_later "$repo_path" "delivery failed"
    return 1
  fi
  if [[ ! "$trunk" =~ ^[A-Za-z0-9._/-]+$ || "$trunk" == *..* ]]; then
    retry_later "$repo_path" "delivery failed"
    return 1
  fi

  if ! GIT_TERMINAL_PROMPT=0 git -C "$repo_abs" fetch origin --prune >/dev/null 2>&1; then
    retry_later "$repo_path" "could not fetch origin"
    return 1
  fi
  if ! git -C "$repo_abs" rev-parse --verify --quiet "refs/remotes/origin/${trunk}^{commit}" >/dev/null 2>&1; then
    retry_later "$repo_path" "missing origin/${trunk}"
    return 1
  fi

  branch="drew/untangle-${yymmdd}"
  herdr=${UNTANGLE_HERDR:-herdr}
  json_file=$(mktemp "${TMPDIR:-/tmp}/untangle-herdr.XXXXXX") || {
    retry_later "$repo_path" "delivery failed"
    return 1
  }
  list_file=$(mktemp "${TMPDIR:-/tmp}/untangle-herdr.XXXXXX") || {
    rm -f "$json_file"
    retry_later "$repo_path" "delivery failed"
    return 1
  }

  create_status=0
  if ! "$herdr" worktree create \
    --cwd "$repo_abs" \
    --branch "$branch" \
    --base "origin/${trunk}" \
    >"$json_file" 2>/dev/null; then
    create_status=1
  fi

  path=""
  if [[ "$create_status" -eq 0 ]]; then
    path=$(ruby_yaml herdr_create_path "$json_file" 2>/dev/null || true)
    if [[ "$path" != /* || ! -d "$path" || "$path" == "$repo_abs" ]]; then
      path=""
    fi
  fi

  if [[ -z "$path" ]]; then
    if "$herdr" worktree list --cwd "$repo_abs" >"$list_file" 2>/dev/null; then
      path=$(ruby_yaml herdr_list_path "$list_file" "$branch" 2>/dev/null || true)
    fi
    if [[ "$path" != /* || ! -d "$path" || "$path" == "$repo_abs" ]]; then
      path=""
    fi
  fi

  rm -f "$json_file" "$list_file"

  if [[ -z "$path" ]]; then
    retry_later "$repo_path" "delivery failed"
    return 1
  fi
  if ! install_untangle_link "$repo_abs" "$path"; then
    retry_later "$repo_path" "delivery failed"
    return 1
  fi

  DELIVERED_WORKTREE=$path
  return 0
}

# Prompt for the one orchestrator. Paths are the registered checkout, the same
# files the worktree symlink points at. The shell does not write the log or the note.
orchestrator_prompt() {
  local repo=$1
  local yymmdd=$2
  local bucket=$3
  local guide="${repo}/untangle/guide.md"
  local log="${repo}/untangle/log.md"
  local note="${repo}/untangle/notes/${yymmdd}.md"

  cat <<EOF
You are the Untangle orchestrator.

Follow the guide at ${guide} for the bucket ${bucket} only. Do not look at the other buckets.

Write the log at ${log} and the weekly note at ${note} itself. Subagents do not.

You may delegate a code read. Subagents do not write those files.

Do not edit or commit application files.
Do not open a pull request.

The note opens with the word plan or the word quiet.

A plan names one knot, why the next change is expensive, a completion condition, and behavior-preserving steps.

A quiet note says what was looked at and why nothing is ready.
EOF
}

# Paths are the registered checkout, same as the knot prompt.
change_orchestrator_prompt() {
  local repo=$1
  local yymmdd=$2
  local bucket=$3
  local change_guide="${repo}/untangle/change-guide.md"
  local log="${repo}/untangle/log.md"
  local note="${repo}/untangle/notes/${yymmdd}-change.md"

  cat <<EOF
You are the Untangle change orchestrator.

Follow the guide at ${change_guide} for the bucket ${bucket} only. Do not look at the other buckets.

Ask what valuable change this bucket makes slow or unsafe.

Write the log at ${log} and the change note at ${note} itself. Subagents do not.

You may delegate a code read. Subagents do not write those files.

Do not edit or commit application files.
Do not open a pull request.

The note opens with the word plan or the word quiet.

A plan names the change, the constraint, what gets faster or safer, a completion condition, and behavior-preserving steps.

A quiet note says what change was considered and why this bucket is not the constraint.
EOF
}

# cwd is the delivered worktree. Arguments are only -p and the prompt.
run_orchestrator() {
  local worktree=$1
  local prompt=$2
  local agent status

  agent=${UNTANGLE_AGENT:-agent}
  status=0
  (
    cd "$worktree" || exit 1
    "$agent" -p "$prompt"
  ) || status=$?
  return "$status"
}

# A kept note opens with plan or quiet. Anything else is deleted.
# A plan is recorded as open_plan and leaves the cursor.
# A quiet note advances the cursor and does not set open_plan.
classify_note() {
  local repo_path=$1
  local repo_yml=$2
  local note_path=$3
  local agent_status=$4
  local word

  if [[ ! -f "$note_path" ]]; then
    if [[ "$agent_status" -ne 0 ]]; then
      printf 'untangle: skip %s — agent failed; the week is unstamped\n' "$repo_path"
    else
      printf 'untangle: %s — week left unstamped\n' "$repo_path"
    fi
    return 0
  fi

  word=$(ruby_yaml note_word "$note_path")
  case "$word" in
    plan)
      ruby_yaml set_open_plan "$repo_yml" "$note_path"
      printf 'untangle: %s — open plan\n' "$repo_path"
      ;;
    quiet)
      ruby_yaml advance_cursor "$repo_yml"
      printf 'untangle: %s — quiet note\n' "$repo_path"
      ;;
    *)
      rm -f -- "$note_path"
      printf 'untangle: %s — note rejected; the week is unstamped\n' "$repo_path"
      ;;
  esac
}

# A quiet note does not advance the cursor.
classify_change_note() {
  local repo_path=$1
  local repo_yml=$2
  local note_path=$3
  local agent_status=$4
  local word

  if [[ ! -f "$note_path" ]]; then
    if [[ "$agent_status" -ne 0 ]]; then
      printf 'untangle: skip %s — agent failed; the change is unstamped\n' "$repo_path"
    else
      printf 'untangle: %s — change left unstamped\n' "$repo_path"
    fi
    return 0
  fi

  word=$(ruby_yaml note_word "$note_path")
  case "$word" in
    plan)
      ruby_yaml set_open_change_plan "$repo_yml" "$note_path"
      printf 'untangle: %s — open change plan\n' "$repo_path"
      ;;
    quiet)
      printf 'untangle: %s — quiet change note\n' "$repo_path"
      ;;
    *)
      rm -f -- "$note_path"
      printf 'untangle: %s — change note rejected; the change is unstamped\n' "$repo_path"
      ;;
  esac
}

# Fail closed for the fixture, or when this path is not inside a work tree.
preflight_repo() {
  local repo_path=$1
  if [[ "${UNTANGLE_PREFLIGHT_FIXTURE:-}" == "fail" ]]; then
    return 1
  fi
  git -C "$repo_path" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1
  return 0
}

# One repo. Skips and probe failures return 0 so the caller can keep going.
# A kept note is the weekly stamp. The shell does not write the note or the log.
# The change look does not move the cursor.
consider_repo() {
  local repo_path=$1
  local today=$2
  local weekday=$3
  local hour=$4
  local minute=$5
  local mins yymmdd repo_yml note_path change_note state pid probe_status
  local open_plan open_change bucket agent_status change_status
  local knot_due change_due prompt

  # 1=Mon .. 7=Sun. Wednesday is 3.
  if [[ "$weekday" -ne 3 ]]; then
    printf 'untangle: skip %s — not Wednesday\n' "$repo_path"
    return 0
  fi

  # 08:00 inclusive, 16:00 exclusive. 10# so 08 and 09 are decimal, not octal.
  mins=$((10#$hour * 60 + 10#$minute))
  if [[ "$mins" -lt $((8 * 60)) || "$mins" -ge $((16 * 60)) ]]; then
    printf 'untangle: skip %s — outside the window\n' "$repo_path"
    return 0
  fi

  repo_yml="${repo_path}/untangle/config.yml"
  if [[ ! -f "$repo_yml" ]]; then
    printf 'untangle: skip %s — not initialized\n' "$repo_path"
    return 0
  fi

  yymmdd=$(yymmdd_from_today "$today")
  note_path="${repo_path}/untangle/notes/${yymmdd}.md"
  change_note="${repo_path}/untangle/notes/${yymmdd}-change.md"

  # A recorded plan blocks later knot looks until it is cleared. Do not clear it here.
  knot_due=1
  open_plan=$(ruby_yaml open_plan_value "$repo_yml")
  if [[ -n "$open_plan" ]]; then
    printf 'untangle: skip %s — open plan\n' "$repo_path"
    knot_due=0
  elif [[ -f "$note_path" ]]; then
    printf 'untangle: skip %s — week already stamped\n' "$repo_path"
    knot_due=0
  fi

  # A recorded change plan blocks later change looks only.
  change_due=1
  open_change=$(ruby_yaml open_change_plan_value "$repo_yml")
  if [[ -n "$open_change" ]]; then
    printf 'untangle: skip %s — open change plan\n' "$repo_path"
    change_due=0
  elif [[ -f "$change_note" ]]; then
    printf 'untangle: skip %s — change already stamped\n' "$repo_path"
    change_due=0
  fi

  if [[ "$knot_due" -eq 0 && "$change_due" -eq 0 ]]; then
    return 0
  fi

  state=$(ruby_yaml progress_pid_state "$repo_yml")
  case "$state" in
    absent)
      ;;
    pid:*)
      pid=${state#pid:}
      if [[ "$pid" =~ ^[1-9][0-9]*$ ]] && kill -0 "$pid" 2>/dev/null; then
        printf 'untangle: skip %s — in progress\n' "$repo_path"
        return 0
      fi
      printf 'untangle: %s — cleared a stale progress pid\n' "$repo_path"
      ruby_yaml clear_progress_pid "$repo_yml"
      ;;
    stale)
      printf 'untangle: %s — cleared a stale progress pid\n' "$repo_path"
      ruby_yaml clear_progress_pid "$repo_yml"
      ;;
    *)
      die "unexpected progress pid state for ${repo_path}: ${state}"
      ;;
  esac

  if ! preflight_repo "$repo_path"; then
    printf 'untangle: skip %s — preflight failed; the next tick retries\n' "$repo_path"
    return 0
  fi

  # Accept only the eight bucket names. Do not rewrite cursor, and do not fetch.
  bucket=$(ruby_yaml cursor_bucket "$repo_yml")
  case "$bucket" in
    Language|Ownership|Boundaries|Representation|Flow|Dependencies|Consolidation|Removal)
      ;;
    *)
      retry_later "$repo_path" "invalid cursor"
      return 0
      ;;
  esac

  CURRENT_PROGRESS_YML=$repo_yml
  ruby_yaml set_progress_pid "$repo_yml" "$$"

  if ! deliver_worktree "$repo_path" "$yymmdd"; then
    release_progress
    return 0
  fi
  printf 'untangle: %s — worktree %s\n' "$repo_path" "$DELIVERED_WORKTREE"

  # Before the probe seam, so a probe sees the guide.
  if [[ "$change_due" -eq 1 ]]; then
    write_change_guide "${repo_path}/untangle/change-guide.md"
  fi

  # UNTANGLE_PROBE is the test seam. When it is set, do not start an agent.
  # One call stands in for every due look.
  agent_status=0
  change_status=0
  if [[ -n "${UNTANGLE_PROBE:-}" ]]; then
    probe_status=0
    "$UNTANGLE_PROBE" "$repo_path" || probe_status=$?
    release_progress
    if [[ "$probe_status" -ne 0 ]]; then
      if [[ "$knot_due" -eq 1 ]]; then
        printf 'untangle: skip %s — probe failed; the week is unstamped\n' "$repo_path"
      fi
      if [[ "$change_due" -eq 1 ]]; then
        printf 'untangle: skip %s — probe failed; the change is unstamped\n' "$repo_path"
      fi
      return 0
    fi
  else
    if [[ "$knot_due" -eq 1 ]]; then
      prompt=$(orchestrator_prompt "$repo_path" "$yymmdd" "$bucket")
      run_orchestrator "$DELIVERED_WORKTREE" "$prompt" || agent_status=$?
    fi
    if [[ "$change_due" -eq 1 ]]; then
      prompt=$(change_orchestrator_prompt "$repo_path" "$yymmdd" "$bucket")
      run_orchestrator "$DELIVERED_WORKTREE" "$prompt" || change_status=$?
    fi
    release_progress
  fi
  if [[ "$knot_due" -eq 1 ]]; then
    classify_note "$repo_path" "$repo_yml" "$note_path" "$agent_status"
  fi
  if [[ "$change_due" -eq 1 ]]; then
    classify_change_note "$repo_path" "$repo_yml" "$change_note" "$change_status"
  fi
  return 0
}

# FDA-scoped LaunchAgent executable: a private copy of bash (not /bin/bash).
# TCC attributes Full Disk Access to this binary only — not every bash script.
LAUNCHD_RUNNER="${UNTANGLE_LAUNCHD_RUNNER:-${XDG_DATA_HOME:-$HOME/.local/share}/untangle/untangle-launchd}"
LAUNCHD_PLIST="${UNTANGLE_LAUNCHD_PLIST:-$HOME/Library/LaunchAgents/com.untangle.plist}"
LAUNCHD_LABEL="com.untangle"
# Apple Silicon: do not copy /bin/bash. It is x86_64+arm64e; keeping the
# platform signature hits a launch constraint, and re-signing it hits the
# preview arm64e ABI check. Homebrew bash is thin arm64. Ad-hoc re-signing as
# com.untangle.launchd gives the copy a cdhash distinct from its source so the
# FDA grant covers only this runner.
LAUNCHD_RUNNER_IDENTIFIER="com.untangle.launchd"
LAUNCHD_RUNNER_SOURCE="/opt/homebrew/bin/bash"

resolve_launchd_template() {
  local candidate dir
  if [[ -n "${UNTANGLE_LAUNCHD_TEMPLATE:-}" && -f "${UNTANGLE_LAUNCHD_TEMPLATE}" ]]; then
    printf '%s\n' "$UNTANGLE_LAUNCHD_TEMPLATE"
    return 0
  fi
  for candidate in \
    "${SCRIPT_DIR}/../launchd/com.untangle.plist.template" \
    "${HOME}/dots/launchd/com.untangle.plist.template"
  do
    if [[ -f "$candidate" ]]; then
      dir=$(CDPATH= cd "$(dirname "$candidate")" && pwd)
      printf '%s/%s\n' "$dir" "$(basename "$candidate")"
      return 0
    fi
  done
  return 1
}

launchd_agent_path() {
  # Prefer mise ruby latest, Homebrew, user bins, then system.
  local data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
  printf '%s' \
    "${data_home}/mise/installs/ruby/latest/bin:/opt/homebrew/bin:/opt/homebrew/sbin:${HOME}/.local/bin:${HOME}/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
}

write_launchd_plist() {
  local template=$1
  local dest=$2
  local runner=$3
  local untangle_bin=$4
  local agent_path
  local tmp

  agent_path=$(launchd_agent_path)
  mkdir -p "$(dirname "$dest")"
  tmp=$(mktemp "${TMPDIR:-/tmp}/untangle-plist.XXXXXX")
  # Portable placeholders — no machine-specific paths in the repo template.
  sed \
    -e "s|@HOME@|${HOME}|g" \
    -e "s|@PATH@|${agent_path}|g" \
    -e "s|@LAUNCHD_RUNNER@|${runner}|g" \
    -e "s|@UNTANGLE_BIN@|${untangle_bin}|g" \
    "$template" >"$tmp"
  mv "$tmp" "$dest"
}

launchd_runner_identifier() {
  local runner=$1
  [[ -x "$runner" ]] || return 1
  # --verbose is required; plain --display omits the Identifier line.
  codesign --display --verbose=2 "$runner" 2>&1 | sed -n 's/^Identifier=//p'
}

build_launchd_runner() {
  local runner=$1
  local bash_src=$2

  mkdir -p "$(dirname "$runner")"
  cp "$bash_src" "$runner"
  chmod 755 "$runner"

  codesign --remove-signature "$runner" >/dev/null 2>&1 || true
  if ! codesign --force --sign - --identifier "$LAUNCHD_RUNNER_IDENTIFIER" "$runner" >/dev/null 2>&1; then
    die "could not ad-hoc sign $runner (is codesign available?)"
  fi
  if ! codesign --verify "$runner" >/dev/null 2>&1; then
    die "ad-hoc signature on $runner did not verify"
  fi
  # Catch an unrunnable runner here rather than at the next Wednesday tick.
  if ! "$runner" -c 'exit 0' >/dev/null 2>&1; then
    die "runner $runner (from $bash_src) cannot execute after signing"
  fi
}

reload_launchd_agent() {
  local plist=$1
  local uid
  uid=$(id -u)
  launchctl bootout "gui/${uid}/${LAUNCHD_LABEL}" 2>/dev/null || true
  # Replace a stale symlink to the old repo plist with the generated file.
  if [[ -L "$plist" ]]; then
    rm -f "$plist"
  fi
  launchctl bootstrap "gui/${uid}" "$plist"
}

cmd_launchd_setup() {
  local runner_dir
  local bash_src
  local open_settings=1
  local do_reload=1
  local runner_rebuilt=0
  local template untangle_bin

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-open)
        open_settings=0
        shift
        ;;
      --no-reload)
        do_reload=0
        shift
        ;;
      -h|--help)
        printf '%s\n' "Usage: untangle launchd-setup [--no-open] [--no-reload]"
        return 0
        ;;
      *)
        die "unknown launchd-setup option: $1"
        ;;
    esac
  done

  bash_src="$LAUNCHD_RUNNER_SOURCE"
  if [[ ! -x "$bash_src" ]]; then
    die "missing $bash_src (try: brew install bash)"
  fi
  if ! lipo -archs "$bash_src" 2>/dev/null | tr ' ' '\n' | grep -qx arm64; then
    die "$bash_src must include an arm64 slice (Apple Silicon only)"
  fi

  if ! template=$(resolve_launchd_template); then
    die "missing launchd plist template (expected launchd/com.untangle.plist.template)"
  fi

  runner_dir=$(dirname "$LAUNCHD_RUNNER")
  mkdir -p "$runner_dir"
  # Rebuilding changes the cdhash and revokes the Full Disk Access grant, so
  # reuse an already correctly signed runner across repeat setup runs.
  if [[ "$(launchd_runner_identifier "$LAUNCHD_RUNNER" 2>/dev/null)" == "$LAUNCHD_RUNNER_IDENTIFIER" ]]; then
    runner_rebuilt=0
  else
    build_launchd_runner "$LAUNCHD_RUNNER" "$bash_src"
    runner_rebuilt=1
  fi

  untangle_bin="${SCRIPT_DIR}/untangle"
  if [[ -L "$LAUNCHD_PLIST" ]]; then
    rm -f "$LAUNCHD_PLIST"
  fi
  write_launchd_plist "$template" "$LAUNCHD_PLIST" "$LAUNCHD_RUNNER" "$untangle_bin"

  if [[ "$runner_rebuilt" -eq 1 ]]; then
    printf 'untangle: launchd runner → %s (rebuilt, ad-hoc signed as %s)\n' \
      "$LAUNCHD_RUNNER" "$LAUNCHD_RUNNER_IDENTIFIER"
  else
    printf 'untangle: launchd runner → %s (reused; Full Disk Access grant intact)\n' \
      "$LAUNCHD_RUNNER"
  fi
  printf 'untangle: launchd plist  → %s\n' "$LAUNCHD_PLIST"
  printf 'untangle: ProgramArguments:\n'
  printf '  %s\n' "$LAUNCHD_RUNNER"
  printf '  %s\n' "$untangle_bin"
  printf '  run\n'
  printf '\n'
  printf 'Grant Full Disk Access to ONLY this binary (not /bin/bash):\n'
  printf '  %s\n' "$LAUNCHD_RUNNER"
  printf 'System Settings → Privacy & Security → Full Disk Access → +\n'
  printf 'Then ⌘⇧G and paste the path above.\n'
  if [[ "$runner_rebuilt" -eq 1 ]]; then
    printf 'The runner was re-signed, so any previous grant no longer applies —\n'
    printf 'remove the stale entry and re-add the path above.\n'
  fi

  if [[ "$do_reload" -eq 1 ]]; then
    if reload_launchd_agent "$LAUNCHD_PLIST"; then
      printf 'untangle: LaunchAgent %s reloaded\n' "$LAUNCHD_LABEL"
    else
      printf 'untangle: warning: could not bootstrap %s (load manually)\n' "$LAUNCHD_LABEL" >&2
    fi
  fi

  if [[ "$open_settings" -eq 1 ]]; then
    open "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles" 2>/dev/null \
      || open "x-apple.systempreferences:com.apple.settings.PrivacySecurity.extension" 2>/dev/null \
      || true
  fi
}

cmd_init() {
  local repo_root dir

  repo_root=$(pwd) || die "could not resolve the current directory"
  [[ "$repo_root" == /* ]] || die "current directory is not absolute: $repo_root"

  dir="${repo_root}/untangle"
  mkdir -p "${dir}/notes"
  write_guide "${dir}/guide.md"
  write_log "${dir}/log.md"
  ruby_yaml ensure_repo_config "${dir}/config.yml"

  mkdir -p "$CONFIG_DIR"
  ruby_yaml ensure_global "$CONFIG_FILE"
  ruby_yaml register_repo "$CONFIG_FILE" "$repo_root"
  ensure_gitignore_entry "$GITIGNORE_GLOBAL"

  printf 'untangle: initialized %s\n' "$repo_root"
  printf 'untangle: registered in %s\n' "$CONFIG_FILE"
}

# Clear a recorded plan, then advance the cursor. Do not write when there is none.
# `done change` clears only the open change plan and leaves the cursor.
# Current directory, any day. Not the registry.
cmd_done() {
  local repo_root repo_yml recorded target

  if [[ $# -gt 1 ]]; then
    die "unknown done target: $*"
  fi

  target=${1:-}
  case "$target" in
    ""|change)
      ;;
    *)
      die "unknown done target: $target"
      ;;
  esac

  repo_root=$(pwd) || die "could not resolve the current directory"
  repo_yml="${repo_root}/untangle/config.yml"
  [[ -f "$repo_yml" ]] || die "missing untangle/config.yml"

  if [[ -z "$target" ]]; then
    recorded=$(ruby_yaml open_plan_value "$repo_yml")
    if [[ -z "$recorded" ]]; then
      die "no open plan"
    fi
    ruby_yaml clear_open_plan "$repo_yml"
    ruby_yaml advance_cursor "$repo_yml"
    return 0
  fi

  recorded=$(ruby_yaml open_change_plan_value "$repo_yml")
  if [[ -z "$recorded" ]]; then
    die "no open change plan"
  fi
  ruby_yaml clear_open_change_plan "$repo_yml"
}

# Print the cursor and, when recorded, the open plan and the open change plan.
# Do not write. Current directory, any day. Not the registry.
cmd_status() {
  local repo_root repo_yml bucket open_plan open_change

  repo_root=$(pwd) || die "could not resolve the current directory"
  repo_yml="${repo_root}/untangle/config.yml"
  [[ -f "$repo_yml" ]] || die "missing untangle/config.yml"

  bucket=$(ruby_yaml cursor_bucket "$repo_yml")
  open_plan=$(ruby_yaml open_plan_value "$repo_yml")
  open_change=$(ruby_yaml open_change_plan_value "$repo_yml")
  printf 'cursor: %s\n' "$bucket"
  if [[ -n "$open_plan" ]]; then
    printf 'open plan: %s\n' "$open_plan"
  fi
  if [[ -n "$open_change" ]]; then
    printf 'open change plan: %s\n' "$open_change"
  fi
}

cmd_run() {
  local today weekday hour minute repo_path

  trap release_progress EXIT
  read -r today weekday hour minute <<<"$(parse_clock)"
  if [[ -z "$today" || -z "$weekday" || -z "$hour" || -z "$minute" ]]; then
    die "could not read the clock"
  fi

  while IFS= read -r repo_path || [[ -n "${repo_path:-}" ]]; do
    [[ -z "$repo_path" ]] && continue
    # Drop the previous repo's pid before the next one starts.
    release_progress
    consider_repo "$repo_path" "$today" "$weekday" "$hour" "$minute"
  done < <(list_registered_repos)
  release_progress
}

main() {
  if [[ $# -lt 1 ]]; then
    usage >&2
    exit 1
  fi

  case "$1" in
    -h|--help)
      usage
      ;;
    init)
      shift
      cmd_init "$@"
      ;;
    run)
      shift
      cmd_run "$@"
      ;;
    done)
      shift
      cmd_done "$@"
      ;;
    status)
      shift
      cmd_status "$@"
      ;;
    launchd-setup)
      shift
      cmd_launchd_setup "$@"
      ;;
    *)
      usage >&2
      die "unknown command: $1"
      ;;
  esac
}

main "$@"
