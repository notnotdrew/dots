#!/usr/bin/env bash
# Coordinator: init a repo, gate the Friday run, open that run in Herdr,
# and start the orchestrator in the dated worktree.
#
# Usage:
#   slowfriday init
#   slowfriday run
#   slowfriday launchd-setup [--no-open] [--no-reload]

set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
SCRIPT_DIR="$(CDPATH= cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_NAME
readonly SCRIPT_DIR

readonly YAML_HELPER="${SCRIPT_DIR}/lib/slowfriday_yaml.rb"
readonly CONFIG_DIR="${SLOWFRIDAY_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/slowfriday}"
readonly CONFIG_FILE="${CONFIG_DIR}/config.yml"
readonly GITIGNORE_GLOBAL="${SLOWFRIDAY_GITIGNORE_GLOBAL:-$HOME/.gitignore_global}"

die() {
  printf '%s: error: %s\n' "$SCRIPT_NAME" "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: slowfriday <init|run>

  init    Write the slowfriday directory, register cwd, and ensure the gitignore entry
  run     Consider each registered repository on Friday
  launchd-setup   Install the Friday LaunchAgent [--no-open] [--no-reload]
EOF
}

# Prefer mise Ruby when PATH is minimal and the shell has not been initialized.
resolve_mise() {
  local candidate
  if command -v mise >/dev/null 2>&1; then
    command -v mise
    return 0
  fi
  for candidate in \
    "${HOME}/.local/bin/mise" \
    /opt/homebrew/bin/mise \
    /usr/local/bin/mise
  do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

ruby_yaml() {
  local mise_bin
  if mise_bin=$(resolve_mise); then
    "$mise_bin" exec -- ruby "$YAML_HELPER" "$@"
  else
    ruby "$YAML_HELPER" "$@"
  fi
}

ensure_gitignore_entry() {
  local file=$1
  local line="slowfriday/"
  touch "$file"
  if ! grep -Fxq -- "$line" "$file"; then
    printf '%s\n' "$line" >>"$file"
  fi
}

write_guide() {
  local path=$1
  [[ -f "$path" ]] && return 0
  cat >"$path" <<'EOF'
# Guide

Use `pup` against Datadog APM for the `screensteps_live` service in production and rank resources by total time (latency times traffic). Do not rank by p95. Do not start from a slow-query list, Prosopite, or the MySQL slow log.

The thing is a request or a job. Skip a single sample. Skip anything Inchworm already has an open slow find for.

Read a trace for the top candidate that also looks worth it. If the time is SQL, name the statement from the trace. If it is many similar queries, say so. If the span is flat Ruby, say that profiling is off and stop there.

Update the watchlist (`log.md`). Write a plan only after the cause is named. Otherwise the note explains why nothing is ready.

A plan is written only when something repeats, matters, has a named cause, and a fix that survives the lenses. The lenses are Best Simple System for Now, simple-made-easy, and knot-or-untangle. Write one short comparison of the real options. A lens counts only when it separates them. The note names the pick and which lens decided it. If two lenses disagree, the note says so and still picks one.

Stop at the plan. Do not edit the app, commit, or open a pull request.

One orchestrator writes `log.md` and `notes/<yymmdd>.md`. It may delegate only a query pass, a code read, or a lens pass over options it already listed. Subagents do not write those files.

A quiet Friday is finished. The note says what was rechecked, what is still being watched, and why nothing is ready.

When the note plans, it says what was picked, the readings, the cause, the options, the lens that decided, and the plan as pull-request-sized steps.
EOF
}

write_log() {
  local path=$1
  [[ -s "$path" ]] && return 0
  printf '%s\n' '# Log' >"$path"
}

# SLOWFRIDAY_NOW=YYYY-MM-DDTHH:MM:SS, otherwise the local clock.
current_now() {
  if [[ -n "${SLOWFRIDAY_NOW:-}" ]]; then
    printf '%s\n' "$SLOWFRIDAY_NOW"
  else
    date '+%Y-%m-%dT%H:%M:%S'
  fi
}

# Print: date weekday hour minute (weekday: 1=Mon .. 7=Sun).
parse_clock() {
  ruby_yaml parse_now "$(current_now)"
}

# %y%m%d from YYYY-MM-DD. 2026-10-09 → 261009.
yymmdd_from_today() {
  local today=$1
  printf '%s%s%s\n' "${today:2:2}" "${today:5:2}" "${today:8:2}"
}

# SLOWFRIDAY_REPO overrides the registry for one path.
list_registered_repos() {
  if [[ -n "${SLOWFRIDAY_REPO:-}" ]]; then
    printf '%s\n' "$SLOWFRIDAY_REPO"
    return 0
  fi
  if [[ ! -f "$CONFIG_FILE" ]]; then
    return 0
  fi
  ruby_yaml list_repos "$CONFIG_FILE"
}

# Repo whose progress_pid this process wrote. The EXIT trap clears only that
# file, so a skip of someone else's live pid leaves their lock alone.
CURRENT_PROGRESS_YML=""
DELIVERED_WORKTREE=""

release_progress() {
  local repo_yml
  repo_yml=${CURRENT_PROGRESS_YML:-}
  [[ -n "$repo_yml" ]] || return 0
  CURRENT_PROGRESS_YML=""
  if [[ -f "$repo_yml" ]]; then
    ruby_yaml clear_progress_pid "$repo_yml" || true
  fi
}

retry_later() {
  local repo_path=$1
  local reason=$2
  printf 'slowfriday: skip %s — %s; the next tick retries\n' "$repo_path" "$reason"
}

# Point the worktree's slowfriday entry at the registered directory path.
# The target string stays that path; physical resolution would follow a symlink.
install_slowfriday_link() {
  local repo_path=$1
  local worktree=$2
  local registered="${repo_path}/slowfriday"
  local dest="${worktree}/slowfriday"
  local current=""

  if [[ "$dest" == "$registered" || "$worktree" == "$repo_path" ]]; then
    return 1
  fi
  if [[ ! -e "$registered" && ! -L "$registered" ]]; then
    return 1
  fi

  if [[ -L "$dest" ]]; then
    current=$(readlink "$dest") || return 1
    if [[ "$current" == "$registered" ]]; then
      return 0
    fi
    # Unlink the symlink itself. Do not pass -r or a trailing slash.
    rm -f "$dest" || return 1
  elif [[ -d "$dest" ]]; then
    ruby_yaml remove_copied_dir "$dest" "$registered" || return 1
  elif [[ -e "$dest" ]]; then
    rm -f "$dest" || return 1
  fi

  ln -s "$registered" "$dest"
}

# Fetch trunk, open drew/slowfriday-<yymmdd>, and share the registered directory.
# On failure the caller clears progress_pid and skips queries. Prints nothing.
deliver_worktree() {
  local repo_path=$1
  local yymmdd=$2
  local repo_abs trunk branch herdr path create_status json_file list_file

  DELIVERED_WORKTREE=""
  repo_abs=$repo_path
  if [[ "$repo_abs" != /* ]]; then
    if ! repo_abs=$(CDPATH= cd "$repo_path" && pwd); then
      retry_later "$repo_path" "delivery failed"
      return 1
    fi
  fi

  if ! trunk=$(ruby_yaml trunk_name "${repo_abs}/slowfriday/config.yml"); then
    retry_later "$repo_path" "delivery failed"
    return 1
  fi
  if [[ ! "$trunk" =~ ^[A-Za-z0-9._/-]+$ || "$trunk" == *..* ]]; then
    retry_later "$repo_path" "delivery failed"
    return 1
  fi

  if ! GIT_TERMINAL_PROMPT=0 git -C "$repo_abs" fetch origin --prune >/dev/null 2>&1; then
    retry_later "$repo_path" "could not fetch origin"
    return 1
  fi
  if ! git -C "$repo_abs" rev-parse --verify --quiet "refs/remotes/origin/${trunk}^{commit}" >/dev/null 2>&1; then
    retry_later "$repo_path" "missing origin/${trunk}"
    return 1
  fi

  branch="drew/slowfriday-${yymmdd}"
  herdr=${SLOWFRIDAY_HERDR:-herdr}
  json_file=$(mktemp "${TMPDIR:-/tmp}/slowfriday-herdr.XXXXXX") || {
    retry_later "$repo_path" "delivery failed"
    return 1
  }
  list_file=$(mktemp "${TMPDIR:-/tmp}/slowfriday-herdr.XXXXXX") || {
    rm -f "$json_file"
    retry_later "$repo_path" "delivery failed"
    return 1
  }

  create_status=0
  if ! "$herdr" worktree create \
    --cwd "$repo_abs" \
    --branch "$branch" \
    --base "origin/${trunk}" \
    >"$json_file" 2>/dev/null; then
    create_status=1
  fi

  path=""
  if [[ "$create_status" -eq 0 ]]; then
    path=$(ruby_yaml herdr_create_path "$json_file" 2>/dev/null || true)
    if [[ "$path" != /* || ! -d "$path" || "$path" == "$repo_abs" ]]; then
      path=""
    fi
  fi

  if [[ -z "$path" ]]; then
    if "$herdr" worktree list --cwd "$repo_abs" >"$list_file" 2>/dev/null; then
      path=$(ruby_yaml herdr_list_path "$list_file" "$branch" 2>/dev/null || true)
    fi
    if [[ "$path" != /* || ! -d "$path" || "$path" == "$repo_abs" ]]; then
      path=""
    fi
  fi

  rm -f "$json_file" "$list_file"

  if [[ -z "$path" ]]; then
    retry_later "$repo_path" "delivery failed"
    return 1
  fi
  if ! install_slowfriday_link "$repo_abs" "$path"; then
    retry_later "$repo_path" "delivery failed"
    return 1
  fi

  DELIVERED_WORKTREE=$path
  return 0
}

# ${SLOWFRIDAY_INCHWORM_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/inchworm}
inchworm_data_dir() {
  if [[ -n "${SLOWFRIDAY_INCHWORM_DATA:-}" ]]; then
    printf '%s\n' "$SLOWFRIDAY_INCHWORM_DATA"
    return 0
  fi
  if [[ -n "${XDG_DATA_HOME:-}" ]]; then
    printf '%s\n' "${XDG_DATA_HOME}/inchworm"
    return 0
  fi
  printf '%s\n' "${HOME}/.local/share/inchworm"
}

# Prompt for the one orchestrator. Paths are the registered checkout.
# The coordinator does not write the log or the weekly note.
orchestrator_prompt() {
  local repo=$1
  local yymmdd=$2
  local guide="${repo}/slowfriday/guide.md"
  local log="${repo}/slowfriday/log.md"
  local note="${repo}/slowfriday/notes/${yymmdd}.md"
  local finds finds_block

  finds=$(ruby_yaml open_slow_finds "$(inchworm_data_dir)" "$repo") || return 1
  if [[ -z "$finds" ]]; then
    finds_block="There are no open slow finds."
  else
    finds_block="Open Inchworm slow finds:
${finds}"
  fi

  cat <<EOF
You are the Slowfriday orchestrator.

Follow the guide at ${guide}.

Write the log at ${log} and the weekly note at ${note} itself. Subagents do not.

It may delegate only a query pass, a code read, or a lens pass over options it already listed.

It must not edit or commit application files.
It must not open a pull request.

${finds_block}

If an open Inchworm slow find is the same thing, say so in the note and do not plan that fix again.
EOF
}

# cwd is the delivered worktree. Arguments are only -p and the prompt.
run_orchestrator() {
  local repo_path=$1
  local yymmdd=$2
  local worktree=$3
  local repo_abs prompt agent status

  repo_abs=$repo_path
  if [[ "$repo_abs" != /* ]]; then
    repo_abs=$(CDPATH= cd "$repo_path" && pwd) || return 1
  fi

  prompt=$(orchestrator_prompt "$repo_abs" "$yymmdd") || return 1
  agent=${SLOWFRIDAY_AGENT:-agent}
  status=0
  (
    cd "$worktree" || exit 1
    "$agent" -p "$prompt"
  ) || status=$?
  return "$status"
}

# Fail closed for the fixture, or when this path is not inside a work tree.
preflight_repo() {
  local repo_path=$1
  if [[ "${SLOWFRIDAY_PREFLIGHT_FIXTURE:-}" == "fail" ]]; then
    return 1
  fi
  git -C "$repo_path" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1
  return 0
}

# One repo. Skips, query failures, and agent failures return 0 so the caller
# can keep going. The weekly stamp is the note file. The coordinator never
# writes the log or the note, and a failed agent does not delete one.
consider_repo() {
  local repo_path=$1
  local today=$2
  local weekday=$3
  local hour=$4
  local minute=$5
  local mins yymmdd repo_yml note_path state pid query_status agent_status

  # 1=Mon .. 7=Sun. Friday is 5.
  if [[ "$weekday" -ne 5 ]]; then
    printf 'slowfriday: skip %s — not Friday\n' "$repo_path"
    return 0
  fi

  # 08:00 inclusive, 16:00 exclusive.
  mins=$((10#$hour * 60 + 10#$minute))
  if [[ "$mins" -lt $((8 * 60)) || "$mins" -ge $((16 * 60)) ]]; then
    printf 'slowfriday: skip %s — outside the window\n' "$repo_path"
    return 0
  fi

  repo_yml="${repo_path}/slowfriday/config.yml"
  if [[ ! -f "$repo_yml" ]]; then
    printf 'slowfriday: skip %s — not initialized\n' "$repo_path"
    return 0
  fi

  yymmdd=$(yymmdd_from_today "$today")
  note_path="${repo_path}/slowfriday/notes/${yymmdd}.md"
  if [[ -f "$note_path" ]]; then
    printf 'slowfriday: skip %s — week already stamped\n' "$repo_path"
    return 0
  fi

  state=$(ruby_yaml progress_pid_state "$repo_yml")
  case "$state" in
    absent)
      ;;
    pid:*)
      pid=${state#pid:}
      if [[ "$pid" =~ ^[1-9][0-9]*$ ]] && kill -0 "$pid" 2>/dev/null; then
        printf 'slowfriday: skip %s — in progress\n' "$repo_path"
        return 0
      fi
      printf 'slowfriday: %s — cleared a stale progress pid\n' "$repo_path"
      ruby_yaml clear_progress_pid "$repo_yml"
      ;;
    stale)
      printf 'slowfriday: %s — cleared a stale progress pid\n' "$repo_path"
      ruby_yaml clear_progress_pid "$repo_yml"
      ;;
    *)
      die "unexpected progress pid state for ${repo_path}: ${state}"
      ;;
  esac

  if ! preflight_repo "$repo_path"; then
    printf 'slowfriday: skip %s — preflight failed; the next tick retries\n' "$repo_path"
    return 0
  fi

  CURRENT_PROGRESS_YML=$repo_yml
  ruby_yaml set_progress_pid "$repo_yml" "$$"

  if ! deliver_worktree "$repo_path" "$yymmdd"; then
    release_progress
    return 0
  fi
  printf 'slowfriday: %s — worktree %s\n' "$repo_path" "$DELIVERED_WORKTREE"

  # SLOWFRIDAY_QUERIES is the test seam. When it is set, do not launch an agent.
  if [[ -n "${SLOWFRIDAY_QUERIES:-}" ]]; then
    query_status=0
    "$SLOWFRIDAY_QUERIES" "$repo_path" || query_status=$?
    release_progress
    if [[ "$query_status" -ne 0 ]]; then
      printf 'slowfriday: skip %s — queries failed; the week is unstamped\n' "$repo_path"
      return 0
    fi
    printf 'slowfriday: %s — week left unstamped\n' "$repo_path"
    return 0
  fi

  agent_status=0
  run_orchestrator "$repo_path" "$yymmdd" "$DELIVERED_WORKTREE" || agent_status=$?
  release_progress

  if [[ -f "$note_path" ]]; then
    return 0
  fi
  if [[ "$agent_status" -ne 0 ]]; then
    printf 'slowfriday: skip %s — agent failed; the week is unstamped\n' "$repo_path"
    return 0
  fi
  printf 'slowfriday: %s — week left unstamped\n' "$repo_path"
  return 0
}

# FDA-scoped LaunchAgent executable: a private copy of bash (not /bin/bash).
# TCC attributes Full Disk Access to this binary only — not every bash script.
LAUNCHD_RUNNER="${SLOWFRIDAY_LAUNCHD_RUNNER:-${XDG_DATA_HOME:-$HOME/.local/share}/slowfriday/slowfriday-launchd}"
LAUNCHD_PLIST="${SLOWFRIDAY_LAUNCHD_PLIST:-$HOME/Library/LaunchAgents/com.slowfriday.plist}"
LAUNCHD_LABEL="com.slowfriday"
# Apple Silicon: do not copy /bin/bash. It is x86_64+arm64e; keeping the
# platform signature hits a launch constraint, and re-signing it hits the
# preview arm64e ABI check. Homebrew bash is thin arm64. Ad-hoc re-signing as
# com.slowfriday.launchd gives the copy a cdhash distinct from its source so the
# FDA grant covers only this runner.
LAUNCHD_RUNNER_IDENTIFIER="com.slowfriday.launchd"
LAUNCHD_RUNNER_SOURCE="/opt/homebrew/bin/bash"

resolve_launchd_template() {
  local candidate dir
  if [[ -n "${SLOWFRIDAY_LAUNCHD_TEMPLATE:-}" && -f "${SLOWFRIDAY_LAUNCHD_TEMPLATE}" ]]; then
    printf '%s\n' "$SLOWFRIDAY_LAUNCHD_TEMPLATE"
    return 0
  fi
  for candidate in \
    "${SCRIPT_DIR}/../launchd/com.slowfriday.plist.template" \
    "${HOME}/dots/launchd/com.slowfriday.plist.template"
  do
    if [[ -f "$candidate" ]]; then
      dir=$(CDPATH= cd "$(dirname "$candidate")" && pwd)
      printf '%s/%s\n' "$dir" "$(basename "$candidate")"
      return 0
    fi
  done
  return 1
}

launchd_agent_path() {
  # Prefer mise ruby latest, Homebrew, user bins, then system.
  local data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
  printf '%s' \
    "${data_home}/mise/installs/ruby/latest/bin:/opt/homebrew/bin:/opt/homebrew/sbin:${HOME}/.local/bin:${HOME}/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
}

write_launchd_plist() {
  local template=$1
  local dest=$2
  local runner=$3
  local slowfriday_bin=$4
  local agent_path
  local tmp

  agent_path=$(launchd_agent_path)
  mkdir -p "$(dirname "$dest")"
  tmp=$(mktemp "${TMPDIR:-/tmp}/slowfriday-plist.XXXXXX")
  # Portable placeholders — no machine-specific paths in the repo template.
  sed \
    -e "s|@HOME@|${HOME}|g" \
    -e "s|@PATH@|${agent_path}|g" \
    -e "s|@LAUNCHD_RUNNER@|${runner}|g" \
    -e "s|@SLOWFRIDAY_BIN@|${slowfriday_bin}|g" \
    "$template" >"$tmp"
  mv "$tmp" "$dest"
}

launchd_runner_identifier() {
  local runner=$1
  [[ -x "$runner" ]] || return 1
  # --verbose is required; plain --display omits the Identifier line.
  codesign --display --verbose=2 "$runner" 2>&1 | sed -n 's/^Identifier=//p'
}

build_launchd_runner() {
  local runner=$1
  local bash_src=$2

  mkdir -p "$(dirname "$runner")"
  cp "$bash_src" "$runner"
  chmod 755 "$runner"

  codesign --remove-signature "$runner" >/dev/null 2>&1 || true
  if ! codesign --force --sign - --identifier "$LAUNCHD_RUNNER_IDENTIFIER" "$runner" >/dev/null 2>&1; then
    die "could not ad-hoc sign $runner (is codesign available?)"
  fi
  if ! codesign --verify "$runner" >/dev/null 2>&1; then
    die "ad-hoc signature on $runner did not verify"
  fi
  # Catch an unrunnable runner here rather than at the next Friday tick.
  if ! "$runner" -c 'exit 0' >/dev/null 2>&1; then
    die "runner $runner (from $bash_src) cannot execute after signing"
  fi
}

reload_launchd_agent() {
  local plist=$1
  local uid
  uid=$(id -u)
  launchctl bootout "gui/${uid}/${LAUNCHD_LABEL}" 2>/dev/null || true
  # Replace a stale symlink to the old repo plist with the generated file.
  if [[ -L "$plist" ]]; then
    rm -f "$plist"
  fi
  launchctl bootstrap "gui/${uid}" "$plist"
}

cmd_launchd_setup() {
  local runner_dir
  local bash_src
  local open_settings=1
  local do_reload=1
  local runner_rebuilt=0
  local template slowfriday_bin

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-open)
        open_settings=0
        shift
        ;;
      --no-reload)
        do_reload=0
        shift
        ;;
      -h|--help)
        printf '%s\n' "Usage: slowfriday launchd-setup [--no-open] [--no-reload]"
        return 0
        ;;
      *)
        die "unknown launchd-setup option: $1"
        ;;
    esac
  done

  bash_src="$LAUNCHD_RUNNER_SOURCE"
  if [[ ! -x "$bash_src" ]]; then
    die "missing $bash_src (try: brew install bash)"
  fi
  if ! lipo -archs "$bash_src" 2>/dev/null | tr ' ' '\n' | grep -qx arm64; then
    die "$bash_src must include an arm64 slice (Apple Silicon only)"
  fi

  if ! template=$(resolve_launchd_template); then
    die "missing launchd plist template (expected launchd/com.slowfriday.plist.template)"
  fi

  runner_dir=$(dirname "$LAUNCHD_RUNNER")
  mkdir -p "$runner_dir"
  # Rebuilding changes the cdhash and revokes the Full Disk Access grant, so
  # reuse an already correctly signed runner across repeat setup runs.
  if [[ "$(launchd_runner_identifier "$LAUNCHD_RUNNER" 2>/dev/null)" == "$LAUNCHD_RUNNER_IDENTIFIER" ]]; then
    runner_rebuilt=0
  else
    build_launchd_runner "$LAUNCHD_RUNNER" "$bash_src"
    runner_rebuilt=1
  fi

  slowfriday_bin="${SCRIPT_DIR}/slowfriday"
  if [[ -L "$LAUNCHD_PLIST" ]]; then
    rm -f "$LAUNCHD_PLIST"
  fi
  write_launchd_plist "$template" "$LAUNCHD_PLIST" "$LAUNCHD_RUNNER" "$slowfriday_bin"

  if [[ "$runner_rebuilt" -eq 1 ]]; then
    printf 'slowfriday: launchd runner → %s (rebuilt, ad-hoc signed as %s)\n' \
      "$LAUNCHD_RUNNER" "$LAUNCHD_RUNNER_IDENTIFIER"
  else
    printf 'slowfriday: launchd runner → %s (reused; Full Disk Access grant intact)\n' \
      "$LAUNCHD_RUNNER"
  fi
  printf 'slowfriday: launchd plist  → %s\n' "$LAUNCHD_PLIST"
  printf 'slowfriday: ProgramArguments:\n'
  printf '  %s\n' "$LAUNCHD_RUNNER"
  printf '  %s\n' "$slowfriday_bin"
  printf '  run\n'
  printf '\n'
  printf 'Grant Full Disk Access to ONLY this binary (not /bin/bash):\n'
  printf '  %s\n' "$LAUNCHD_RUNNER"
  printf 'System Settings → Privacy & Security → Full Disk Access → +\n'
  printf 'Then ⌘⇧G and paste the path above.\n'
  if [[ "$runner_rebuilt" -eq 1 ]]; then
    printf 'The runner was re-signed, so any previous grant no longer applies —\n'
    printf 'remove the stale entry and re-add the path above.\n'
  fi

  if [[ "$do_reload" -eq 1 ]]; then
    if reload_launchd_agent "$LAUNCHD_PLIST"; then
      printf 'slowfriday: LaunchAgent %s reloaded\n' "$LAUNCHD_LABEL"
    else
      printf 'slowfriday: warning: could not bootstrap %s (load manually)\n' "$LAUNCHD_LABEL" >&2
    fi
  fi

  if [[ "$open_settings" -eq 1 ]]; then
    open "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles" 2>/dev/null \
      || open "x-apple.systempreferences:com.apple.settings.PrivacySecurity.extension" 2>/dev/null \
      || true
  fi
}

cmd_init() {
  local repo_root dir

  repo_root=$(pwd) || die "could not resolve the current directory"
  [[ "$repo_root" == /* ]] || die "current directory is not absolute: $repo_root"

  dir="${repo_root}/slowfriday"
  mkdir -p "${dir}/notes"
  write_guide "${dir}/guide.md"
  write_log "${dir}/log.md"
  ruby_yaml ensure_repo_config "${dir}/config.yml"

  mkdir -p "$CONFIG_DIR"
  ruby_yaml ensure_global "$CONFIG_FILE"
  ruby_yaml register_repo "$CONFIG_FILE" "$repo_root"
  ensure_gitignore_entry "$GITIGNORE_GLOBAL"

  printf 'slowfriday: initialized %s\n' "$repo_root"
  printf 'slowfriday: registered in %s\n' "$CONFIG_FILE"
}

cmd_run() {
  local today weekday hour minute repo_path

  trap release_progress EXIT
  read -r today weekday hour minute <<<"$(parse_clock)"
  if [[ -z "$today" || -z "$weekday" || -z "$hour" || -z "$minute" ]]; then
    die "could not read the clock"
  fi

  while IFS= read -r repo_path || [[ -n "${repo_path:-}" ]]; do
    [[ -z "$repo_path" ]] && continue
    # Drop the previous repo's pid before the next one starts.
    release_progress
    consider_repo "$repo_path" "$today" "$weekday" "$hour" "$minute"
  done < <(list_registered_repos)
  release_progress
}

main() {
  if [[ $# -lt 1 ]]; then
    usage >&2
    exit 1
  fi

  case "$1" in
    -h|--help)
      usage
      ;;
    init)
      shift
      cmd_init "$@"
      ;;
    run)
      shift
      cmd_run "$@"
      ;;
    launchd-setup)
      shift
      cmd_launchd_setup "$@"
      ;;
    *)
      usage >&2
      die "unknown command: $1"
      ;;
  esac
}

main "$@"
