#!/usr/bin/env bash
# Coordinator: init a repo, and gate the Friday run across registered repos.
#
# Usage:
#   slowfriday init
#   slowfriday run

set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
SCRIPT_DIR="$(CDPATH= cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_NAME
readonly SCRIPT_DIR

readonly YAML_HELPER="${SCRIPT_DIR}/lib/slowfriday_yaml.rb"
readonly CONFIG_DIR="${SLOWFRIDAY_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/slowfriday}"
readonly CONFIG_FILE="${CONFIG_DIR}/config.yml"
readonly GITIGNORE_GLOBAL="${SLOWFRIDAY_GITIGNORE_GLOBAL:-$HOME/.gitignore_global}"

die() {
  printf '%s: error: %s\n' "$SCRIPT_NAME" "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: slowfriday <init|run>

  init    Write the slowfriday directory, register cwd, and ensure the gitignore entry
  run     Consider each registered repository on Friday
EOF
}

# Prefer mise Ruby when PATH is minimal and the shell has not been initialized.
resolve_mise() {
  local candidate
  if command -v mise >/dev/null 2>&1; then
    command -v mise
    return 0
  fi
  for candidate in \
    "${HOME}/.local/bin/mise" \
    /opt/homebrew/bin/mise \
    /usr/local/bin/mise
  do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

ruby_yaml() {
  local mise_bin
  if mise_bin=$(resolve_mise); then
    "$mise_bin" exec -- ruby "$YAML_HELPER" "$@"
  else
    ruby "$YAML_HELPER" "$@"
  fi
}

ensure_gitignore_entry() {
  local file=$1
  local line="slowfriday/"
  touch "$file"
  if ! grep -Fxq -- "$line" "$file"; then
    printf '%s\n' "$line" >>"$file"
  fi
}

write_guide() {
  local path=$1
  [[ -f "$path" ]] && return 0
  cat >"$path" <<'EOF'
# Guide

This file is the procedure the Friday run follows.
EOF
}

write_log() {
  local path=$1
  [[ -s "$path" ]] && return 0
  printf '%s\n' '# Log' >"$path"
}

# SLOWFRIDAY_NOW=YYYY-MM-DDTHH:MM:SS, otherwise the local clock.
current_now() {
  if [[ -n "${SLOWFRIDAY_NOW:-}" ]]; then
    printf '%s\n' "$SLOWFRIDAY_NOW"
  else
    date '+%Y-%m-%dT%H:%M:%S'
  fi
}

# Print: date weekday hour minute (weekday: 1=Mon .. 7=Sun).
parse_clock() {
  ruby_yaml parse_now "$(current_now)"
}

# %y%m%d from YYYY-MM-DD. 2026-10-09 → 261009.
yymmdd_from_today() {
  local today=$1
  printf '%s%s%s\n' "${today:2:2}" "${today:5:2}" "${today:8:2}"
}

# SLOWFRIDAY_REPO overrides the registry for one path.
list_registered_repos() {
  if [[ -n "${SLOWFRIDAY_REPO:-}" ]]; then
    printf '%s\n' "$SLOWFRIDAY_REPO"
    return 0
  fi
  if [[ ! -f "$CONFIG_FILE" ]]; then
    return 0
  fi
  ruby_yaml list_repos "$CONFIG_FILE"
}

# Repo whose progress_pid this process wrote. The EXIT trap clears only that
# file, so a skip of someone else's live pid leaves their lock alone.
CURRENT_PROGRESS_YML=""

release_progress() {
  local repo_yml
  repo_yml=${CURRENT_PROGRESS_YML:-}
  [[ -n "$repo_yml" ]] || return 0
  CURRENT_PROGRESS_YML=""
  if [[ -f "$repo_yml" ]]; then
    ruby_yaml clear_progress_pid "$repo_yml" || true
  fi
}

# Fail closed for the fixture, or when this path is not inside a work tree.
preflight_repo() {
  local repo_path=$1
  if [[ "${SLOWFRIDAY_PREFLIGHT_FIXTURE:-}" == "fail" ]]; then
    return 1
  fi
  git -C "$repo_path" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1
  return 0
}

# One repo. Skips and query failures return 0 so the caller can keep going.
# The weekly stamp is the note file. This step never writes it.
consider_repo() {
  local repo_path=$1
  local today=$2
  local weekday=$3
  local hour=$4
  local minute=$5
  local mins yymmdd repo_yml note_path state pid query_status

  # 1=Mon .. 7=Sun. Friday is 5.
  if [[ "$weekday" -ne 5 ]]; then
    printf 'slowfriday: skip %s — not Friday\n' "$repo_path"
    return 0
  fi

  # 08:00 inclusive, 16:00 exclusive.
  mins=$((10#$hour * 60 + 10#$minute))
  if [[ "$mins" -lt $((8 * 60)) || "$mins" -ge $((16 * 60)) ]]; then
    printf 'slowfriday: skip %s — outside the window\n' "$repo_path"
    return 0
  fi

  repo_yml="${repo_path}/slowfriday/config.yml"
  if [[ ! -f "$repo_yml" ]]; then
    printf 'slowfriday: skip %s — not initialized\n' "$repo_path"
    return 0
  fi

  yymmdd=$(yymmdd_from_today "$today")
  note_path="${repo_path}/slowfriday/notes/${yymmdd}.md"
  if [[ -f "$note_path" ]]; then
    printf 'slowfriday: skip %s — week already stamped\n' "$repo_path"
    return 0
  fi

  state=$(ruby_yaml progress_pid_state "$repo_yml")
  case "$state" in
    absent)
      ;;
    pid:*)
      pid=${state#pid:}
      if [[ "$pid" =~ ^[1-9][0-9]*$ ]] && kill -0 "$pid" 2>/dev/null; then
        printf 'slowfriday: skip %s — in progress\n' "$repo_path"
        return 0
      fi
      printf 'slowfriday: %s — cleared a stale progress pid\n' "$repo_path"
      ruby_yaml clear_progress_pid "$repo_yml"
      ;;
    stale)
      printf 'slowfriday: %s — cleared a stale progress pid\n' "$repo_path"
      ruby_yaml clear_progress_pid "$repo_yml"
      ;;
    *)
      die "unexpected progress pid state for ${repo_path}: ${state}"
      ;;
  esac

  if ! preflight_repo "$repo_path"; then
    printf 'slowfriday: skip %s — preflight failed; the next tick retries\n' "$repo_path"
    return 0
  fi

  CURRENT_PROGRESS_YML=$repo_yml
  ruby_yaml set_progress_pid "$repo_yml" "$$"

  query_status=0
  if [[ -n "${SLOWFRIDAY_QUERIES:-}" ]]; then
    "$SLOWFRIDAY_QUERIES" "$repo_path" || query_status=$?
  fi
  release_progress

  if [[ "$query_status" -ne 0 ]]; then
    printf 'slowfriday: skip %s — queries failed; the week is unstamped\n' "$repo_path"
    return 0
  fi

  printf 'slowfriday: %s — week left unstamped\n' "$repo_path"
  return 0
}

cmd_init() {
  local repo_root dir

  repo_root=$(pwd) || die "could not resolve the current directory"
  [[ "$repo_root" == /* ]] || die "current directory is not absolute: $repo_root"

  dir="${repo_root}/slowfriday"
  mkdir -p "${dir}/notes"
  write_guide "${dir}/guide.md"
  write_log "${dir}/log.md"
  ruby_yaml ensure_repo_config "${dir}/config.yml"

  mkdir -p "$CONFIG_DIR"
  ruby_yaml ensure_global "$CONFIG_FILE"
  ruby_yaml register_repo "$CONFIG_FILE" "$repo_root"
  ensure_gitignore_entry "$GITIGNORE_GLOBAL"

  printf 'slowfriday: initialized %s\n' "$repo_root"
  printf 'slowfriday: registered in %s\n' "$CONFIG_FILE"
}

cmd_run() {
  local today weekday hour minute repo_path

  trap release_progress EXIT
  read -r today weekday hour minute <<<"$(parse_clock)"
  if [[ -z "$today" || -z "$weekday" || -z "$hour" || -z "$minute" ]]; then
    die "could not read the clock"
  fi

  while IFS= read -r repo_path || [[ -n "${repo_path:-}" ]]; do
    [[ -z "$repo_path" ]] && continue
    # Drop the previous repo's pid before the next one starts.
    release_progress
    consider_repo "$repo_path" "$today" "$weekday" "$hour" "$minute"
  done < <(list_registered_repos)
  release_progress
}

main() {
  if [[ $# -lt 1 ]]; then
    usage >&2
    exit 1
  fi

  case "$1" in
    -h|--help)
      usage
      ;;
    init)
      shift
      cmd_init "$@"
      ;;
    run)
      shift
      cmd_run "$@"
      ;;
    *)
      usage >&2
      die "unknown command: $1"
      ;;
  esac
}

main "$@"
