#!/usr/bin/env ruby
# frozen_string_literal: true

# Run RuboCop and fail only on offenses that touch changed lines.
# Pre-existing offenses on untouched lines are ignored.
#
# Usage:
#   rubocop-changed path/to/a.rb path/to/b.rb
#   rubocop-changed --staged   # staged *.rb / *.rake when no files given (default)
#   rubocop-changed --worktree path/to/a.rb
#   rubocop-changed app/models/foo.rb -- --parallel
#
# For editor autofix, use rubocop-fix-changed instead.

require_relative "lib/rubocop_changed_common"

include RubocopChangedCommon

def parse_args(argv)
  options = {
    line_source: nil,
    files: [],
    rubocop_args: []
  }

  args = argv.dup
  if args.delete("--fix") || args.delete("-A") || args.delete("--stdin")
    abort "fix/stdin belongs in rubocop-fix-changed, not rubocop-changed"
  end

  options[:line_source] = :staged if args.delete("--staged")
  options[:line_source] = :worktree if args.delete("--worktree")
  options[:line_source] ||= :staged

  options[:files], options[:rubocop_args] = split_files_and_rubocop_args(args)
  options[:files] = staged_ruby_files if options[:files].empty?

  options
end

def check_mode(files, rubocop_args, line_source:)
  exit 0 if files.empty?

  changed_lines = changed_lines_by_file(files, line_source: line_source)
  files_with_changes = files.select { |file| changed_lines[normalize_path(file)].any? }
  exit 0 if files_with_changes.empty?

  stdout, stderr, _status = run_rubocop(files_with_changes, rubocop_args)

  if stdout.strip.empty?
    warn stderr unless stderr.strip.empty?
    abort "rubocop produced no JSON output"
  end

  begin
    report = JSON.parse(stdout)
  rescue JSON::ParserError => error
    warn stdout
    warn stderr
    abort "failed to parse rubocop JSON: #{error.message}"
  end

  relevant = []
  report.fetch("files", []).each do |file_report|
    path = normalize_path(file_report.fetch("path"))
    lines = changed_lines[path]
    next if lines.nil? || lines.empty?

    file_report.fetch("offenses", []).each do |offense|
      next unless offense_on_changed_line?(offense, lines)

      relevant << [relative_path(path), offense]
    end
  end

  if relevant.empty?
    puts "RuboCop: no offenses on changed lines (#{files_with_changes.size} file(s))."
    exit 0
  end

  puts "RuboCop: offenses on changed lines:"
  relevant.each do |path, offense|
    loc = offense.fetch("location")
    line = loc["start_line"] || loc["line"]
    column = loc["start_column"] || loc["column"] || 1
    puts "  #{path}:#{line}:#{column}: #{offense['severity']}: #{offense['message']} (#{offense['cop_name']})"
  end

  exit 1
end

options = parse_args(ARGV)
check_mode(
  options[:files],
  options[:rubocop_args],
  line_source: options[:line_source]
)
