#!/usr/bin/env bash
# Show the curated Herdr keybinding cheatsheet.
#
# Lives in ~/dots/bin (exposed as ~/bin via update_symlinks).
# Bound to prefix+u in ~/dots/herdr/config.toml as a pane command, so it can
# stay open in a split while you use the keys it lists.
#
# This is the hand-maintained shortlist, not the live keymap. prefix+? still
# shows every active binding straight from the running config.
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/lib/herdr-pane-agent.bash"

sheet=$HOME/dots/herdr/keybindings.md

if [ ! -f "$sheet" ]; then
  printf '%s: error: %s is missing\n' "$(basename "$0")" "$sheet" >&2
  # The pane closes the moment this exits, so hold it open to be read.
  read -r -n 1 -s -p 'Press any key to close.' || true
  exit 1
fi

# Reading a cheatsheet is not a decision, so this one sits idle rather than
# blocked. It still gets a row in the Agents panel to find and close.
# The pager runs as a child rather than exec so the release trap still fires.
herdr_pane_agent keys idle
trap herdr_pane_agent_release EXIT

if command -v bat >/dev/null 2>&1; then
  bat --language=md --style=plain --paging=always "$sheet"
else
  less -R "$sheet"
fi
