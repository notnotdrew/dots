#!/usr/bin/env bash
# Ask what to work on, let an agent resolve the naming, then create the child
# worktree workspace, focus it, and hand the task to an agent running there.
#
# Some requests are not a task for a fresh checkout but a command that already
# does the job ("start any open prrr reviews"). Those come back as a commands
# plan, which runs here and exits without opening anything.
#
# Lives in ~/dots/bin (exposed as ~/bin via update_symlinks).
# Opened in a dedicated workspace by herdr-open-start-work, so the session stays
# usable and the flow never splits an unrelated workspace.
#
# The planning agent only gathers facts and returns JSON. Every mutation
# happens here so a bad plan cannot create branches or move panes on its own.
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/lib/herdr-pane-agent.bash"

HERDR="${HERDR_BIN_PATH:-herdr}"
NOTE_SOURCE=herdr-note
AGENT_KIND=cursor
# Commands a plan is allowed to dispatch, space separated.
DISPATCHABLE='prrr'
# The planner gets a home of its own instead of the pane's inherited cwd. One
# persistent plain directory, so nothing has to open a throwaway workspace to
# plan in, and the last few plans are still readable after the pane closes.
PLAN_HOME="${XDG_STATE_HOME:-$HOME/.local/state}/herdr-start-work"
PLAN_RUNS_KEPT=20

# Background steps write output to temp files so the spinner owns the
# terminal. Register each one here; a helper cannot, because command
# substitution would append to the array inside a subshell.
TMPFILES=()
cleanup() {
  herdr_pane_agent_release
  [ ${#TMPFILES[@]} -gt 0 ] && rm -f "${TMPFILES[@]}"
  # An EXIT trap that ends on a false test takes the script's status with it.
  return 0
}
trap cleanup EXIT

die() {
  printf '\nerror: %s\n' "$1" >&2
  if [ -n "${2:-}" ] && [ -s "$2" ]; then
    printf '\n%s\n' "$(<"$2")" >&2
  fi
  # The pane closes the moment this exits, so hold it open to be read.
  flush_input
  read -r -n 1 -s -p 'Press any key to close.' || true
  exit 1
}

# Anything typed into this pane while a step runs waits in stdin and would
# answer the next prompt before it is on screen.
flush_input() {
  local _
  while IFS= read -r -s -t 0.05 -n 1024 _; do :; done
}

# Spin until the given pid exits. Planning takes ~30s with no output of its
# own, so show elapsed time to distinguish slow from hung.
spinner() {
  local pid="$1" label="$2" frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏' start=$SECONDS i=0
  # Every long step runs behind this spinner, so it owns the reported state:
  # working while the step runs, back to blocked between steps, where the
  # flow is either asking something or finished with a message to read.
  herdr_pane_state working
  while kill -0 "$pid" 2>/dev/null; do
    printf '\r%s %s %ds' "${frames:i%10:1}" "$label" "$((SECONDS - start))"
    i=$((i + 1))
    sleep 0.1
  done
  printf '\r%s %s %ds\n' '✓' "$label" "$((SECONDS - start))"
  herdr_pane_state blocked
}

# Herdr agent names must match [a-z][a-z0-9_-]{0,31} and be unique among live
# agents.
agent_name() {
  local base
  base=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-')
  base=${base#-}
  base=${base%-}
  base=${base:0:28}
  case "$base" in
    [a-z]*) ;;
    *) base="work-$base" ;;
  esac
  local name="$base" suffix=2
  while "$HERDR" agent list | jq -e --arg n "$name" \
    '.result.agents[]? | select(.name == $n)' >/dev/null 2>&1; do
    name="${base}-${suffix}"
    suffix=$((suffix + 1))
  done
  printf '%s' "$name"
}

# cursor-agent asks to trust every unseen path, and Herdr reports that dialog
# as idle rather than blocked, so the task would be typed into it. Write the
# marker cursor-agent itself writes on trust, before the agent ever starts.
# Answering the dialog after the fact races with it closing, which leaves a
# stray keystroke in the composer.
trust_workspace() {
  local checkout="$1" slug dir
  slug=$(printf '%s' "${checkout#/}" | tr '/.' '-')
  dir="$HOME/.cursor/projects/$slug"
  [ -e "$dir/.workspace-trusted" ] && return 0
  mkdir -p "$dir"
  jq -n --arg at "$(date -u +%Y-%m-%dT%H:%M:%S.000Z)" --arg path "$checkout" \
    '{trustedAt: $at, workspacePath: $path}' >"$dir/.workspace-trusted"
}

# Scratch roots. A git dir under one of these is a probe or a test fixture,
# never a checkout to branch from.
is_scratch_path() {
  local path="$1/" root
  for root in /tmp /private/tmp /var/folders /private/var/folders "${TMPDIR:-}"; do
    [ -n "$root" ] || continue
    case "$path" in "${root%/}"/*) return 0 ;; esac
  done
  return 1
}

# Set up the planner's home and trim its run log.
prepare_plan_home() {
  mkdir -p "$PLAN_HOME/runs"
  [ -e "$PLAN_HOME/README.md" ] || cat >"$PLAN_HOME/README.md" <<'EOF'
# herdr-start-work

Where the planning agent behind prefix+shift+s runs (~/dots/bin/herdr-start-work).

It plans here so it never inherits the focused workspace's checkout. `runs/`
holds the last few plans and whatever the planner wrote to stderr, newest last
by name. Nothing here is a checkout and nothing here is read back: delete it
and the next run rebuilds it.
EOF

  # Run ids start with the timestamp, so the glob comes back oldest first and
  # each .out still has its .err beside it.
  local -a runs=()
  shopt -s nullglob
  runs=("$PLAN_HOME"/runs/*.out)
  shopt -u nullglob
  local i
  for ((i = 0; i < ${#runs[@]} - PLAN_RUNS_KEPT; i++)); do
    rm -f "${runs[i]}" "${runs[i]%.out}.err"
  done
}

# Herdr refuses a pane that is not sitting at its own shell prompt, and only
# retries that itself while the shell is the foreground process. A zshrc that
# shells out to direnv, mise, or compinit hides the shell behind a child, so a
# pane seconds old fails and herdr gives up. Keep asking until it settles.
# Prints the last failing response so die can show it.
start_agent() {
  local name="$1" pane="$2" response code
  for _ in $(seq 15); do
    response=$("$HERDR" agent start "$name" --kind "$AGENT_KIND" --pane "$pane" 2>&1) &&
      return 0
    code=$(jq -r '.error.code // empty' <<<"$response" 2>/dev/null) || code=
    [ "$code" = agent_pane_busy ] || break
    sleep 1
  done
  printf '%s\n' "$response"
  return 1
}

# A fresh checkout spends its first seconds trusting the workspace, and a
# prompt sent during that window is swallowed while the agent still reports
# idle. Retry while it stays idle; a working agent already took the text.
send_task() {
  local name="$1" text="$2" status
  for _ in 1 2 3; do
    if "$HERDR" agent prompt "$name" "$text" >/dev/null 2>&1; then
      return 0
    fi
    status=$("$HERDR" agent get "$name" 2>/dev/null |
      jq -r '.result.agent.agent_status // "unknown"')
    [ "$status" = working ] && return 0
    sleep 3
  done
  return 1
}

# A plan is an agent's word, not a shell. Reject anything that is not a
# DISPATCHABLE command with plain arguments, before it is shown to be run.
check_command() {
  local command="$1" head

  case "$command" in
    *[!A-Za-z0-9\ _.,:/@=+-]*)
      die "command has characters I will not run: $command"
      ;;
  esac
  head=${command%%[[:space:]]*}
  [ -n "$head" ] || die 'plan has an empty command'
  case " $DISPATCHABLE " in
    *" $head "*) ;;
    *) die "not a dispatchable command: $head (allowed: $DISPATCHABLE)" ;;
  esac
}

# Run one checked command as literal argv, with no shell in between.
dispatch_command() {
  local command="$1"
  local -a argv=()

  read -r -a argv <<<"$command"
  printf '\n$ %s\n' "$command"
  "${argv[@]}"
}

# Show what the plan wants to run, then run it on enter. The commands open
# their own workspaces if they need one; this script opens nothing.
run_commands_plan() {
  local plan="$1" summary key command status=0
  local -a commands=()

  mapfile -t commands < <(jq -r '.commands[]?' <<<"$plan")
  [ ${#commands[@]} -gt 0 ] || die "plan has no commands: $plan"

  for command in "${commands[@]}"; do
    check_command "$command"
  done

  summary=$(jq -r '.summary // empty' <<<"$plan")
  [ -n "$summary" ] && printf '%s\n\n' "$summary"
  printf '  %s\n' "${commands[@]}"
  printf '\nenter to run, any other key to cancel '
  flush_input
  IFS= read -r -n 1 -s key || key=cancel
  case "$key" in
    '') printf '\n' ;;
    *)
      printf '\ncancelled\n'
      return 0
      ;;
  esac

  for command in "${commands[@]}"; do
    dispatch_command "$command" || status=$?
  done
  [ "$status" -eq 0 ] || die "command failed (exit $status)"

  # The pane closes the moment this exits. Hold it open long enough to read,
  # but not so long that it lingers after a command has moved focus.
  printf '\n'
  read -r -t 5 -n 1 -s -p 'Press any key to close.' || true
}

# This pane outlives the workspace it was launched from: the worktree below is
# created with --focus, so the rest of this run reports progress into a split
# Drew has already left. Claim an Agents row before anything can block, die
# included.
herdr_pane_agent start-work

command -v jq >/dev/null 2>&1 || die 'jq is required'

plan=
request=
attach_ws=
case "${1:-}" in
  --from-json)
    plan=${2:-}
    [ -n "$plan" ] || die 'missing JSON after --from-json'
    ;;
  --attach)
    attach_ws=${2:-}
    task=${3:-}
    [ -n "$attach_ws" ] && [ -n "$task" ] ||
      die 'usage: herdr-start-work --attach <workspace_id> <task>'
    ;;
  '')
    printf 'What do you want to work on?\n'
    printf 'A Linear ticket (PRO-1234), a URL, or a short phrase.\n\n'
    IFS= read -r -e -p '> ' request || exit 0
    [ -n "${request//[[:space:]]/}" ] || exit 0
    ;;
  *)
    request="$*"
    ;;
esac

if [ -n "$attach_ws" ]; then
  workspace_id="$attach_ws"
  item=$("$HERDR" workspace get "$workspace_id" 2>/dev/null |
    jq -r '.result.workspace.label // empty') || true
  [ -n "$item" ] || die "no such workspace: $workspace_id"
  pane_id=$("$HERDR" pane list --workspace "$workspace_id" |
    jq -r '.result.panes[0].pane_id // empty')
  [ -n "$pane_id" ] || die "no pane in $workspace_id"
  trust_workspace "$("$HERDR" pane list --workspace "$workspace_id" |
    jq -r '.result.panes[0].cwd')"
  "$HERDR" workspace focus "$workspace_id" >/dev/null
  printf 'Reusing %s (%s)\n\n' "$item" "$workspace_id"
fi

if [ -z "$plan" ] && [ -z "$attach_ws" ]; then
  command -v cursor-agent >/dev/null 2>&1 || die 'cursor-agent is required'
  printf '\n'
  prepare_plan_home
  run_id="$(date +%Y%m%d-%H%M%S)-$$"
  plan_out="$PLAN_HOME/runs/$run_id.out"
  plan_err="$PLAN_HOME/runs/$run_id.err"

  # The intake workspace is deliberately unrelated to any checkout. Resolve
  # repo_root from the request instead of biasing the plan toward whatever
  # workspace happened to be focused before this one.
  cursor-agent --workspace "$PLAN_HOME" --trust -p -f --output-format text \
    "Plan how to handle this request:

$request

Work repo_root out from the request itself. The intake workspace deliberately
does not provide a launching checkout as a hint.

Pick one of two plans.

A commands plan, when a tool already does the whole job and no new checkout is
needed. Only \`prrr\` can be dispatched; read the usage header at the top of
~/bin/prrr to see what it offers, and use its own flags rather than stringing
commands together. Those commands open their own workspaces when they need one.
{\"kind\":\"commands\",\"summary\":\"one spoken line about what will run\",\"commands\":[\"prrr start --requested\"]}

A worktree plan, for work that needs its own branch and checkout. Follow the
starting-herdr-work skill for naming. Resolve any Linear ticket with
\`linear issue view <ID> --json --no-pager\` and use its \`branchName\` verbatim.
Reuse an existing sibling project name from \`herdr workspace list\` when that
bucket already exists.
{\"kind\":\"worktree\",\"repo_root\":\"absolute path to the main checkout\",\"branch\":\"git branch name\",\"base\":\"base ref or empty string\",\"item\":\"short lowercase item\",\"project\":\"Title Case project\",\"prompt\":\"task prompt for the coding agent\"}

Gather facts only. Do not create a branch, worktree, workspace, or any files.

Reply with one minified JSON object and nothing else." >"$plan_out" 2>"$plan_err" &
  planner_pid=$!
  spinner "$planner_pid" 'Planning'
  wait "$planner_pid" || die 'planning agent failed' "$plan_err"

  plan_raw=$(<"$plan_out")
  plan=$(printf '%s' "$plan_raw" | grep -o '{.*}' | tail -1) ||
    die "could not find JSON in plan: $plan_raw"
fi
if [ -z "$attach_ws" ]; then
jq -e . >/dev/null 2>&1 <<<"$plan" || die "plan is not valid JSON: $plan"

# herdr-tidy and older callers pass a worktree plan with no kind.
case "$(jq -r '.kind // "worktree"' <<<"$plan")" in
  commands)
    run_commands_plan "$plan"
    exit 0
    ;;
  worktree) ;;
  *) die "unknown plan kind: $plan" ;;
esac

repo_root=$(jq -r '.repo_root // empty' <<<"$plan")
branch=$(jq -r '.branch // empty' <<<"$plan")
base=$(jq -r '.base // empty' <<<"$plan")
item=$(jq -r '.item // empty' <<<"$plan")
project=$(jq -r '.project // empty' <<<"$plan")
task=$(jq -r '.prompt // empty' <<<"$plan")

[ -n "$repo_root" ] || die "plan has no repo_root: $plan"
[ -n "$branch" ] || die "plan has no branch: $plan"
[ -n "$item" ] || die "plan has no item: $plan"
[ -n "$task" ] || task="$request"

# A linked worktree resolves to the main checkout, so the new worktree always
# hangs off the real repo.
git_common=$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
  die "not a git repo: $repo_root"
repo_root=$(dirname "$git_common")
is_scratch_path "$repo_root" &&
  die "that is a scratch checkout, not somewhere to branch from: $repo_root"

printf 'item:    %s\n' "$item"
printf 'project: %s\n' "${project:-none}"
printf 'branch:  %s\n' "$branch"
printf 'repo:    %s\n\n' "$repo_root"

source_ws=$("$HERDR" worktree list --cwd "$repo_root" 2>/dev/null |
  jq -r '.result.source.source_workspace_id // empty') || true
if [ -z "$source_ws" ]; then
  printf 'Opening parent workspace...\n'
  source_ws=$("$HERDR" workspace create --cwd "$repo_root" \
    --label "$(basename "$repo_root")" --no-focus |
    jq -r '.result.workspace.workspace_id')
  [ -n "$source_ws" ] || die 'could not open a parent workspace'
fi

# Match the sibling checkout layout worktrunk already uses for this repo.
checkout="${repo_root}.$(printf '%s' "$branch" | tr '/' '-')"

create_args=(worktree create --workspace "$source_ws" --branch "$branch"
  --path "$checkout" --label "$item" --focus)
[ -n "$base" ] && create_args+=(--base "$base")

trust_workspace "$checkout"

create_out=$(mktemp)
create_err=$(mktemp)
TMPFILES+=("$create_out" "$create_err")
"$HERDR" "${create_args[@]}" >"$create_out" 2>"$create_err" &
create_pid=$!
spinner "$create_pid" 'Creating worktree'
wait "$create_pid" || die 'worktree create failed' "$create_err"
created=$(<"$create_out")

workspace_id=$(jq -r '.result.workspace.workspace_id // empty' <<<"$created")
pane_id=$(jq -r '.result.root_pane.pane_id // empty' <<<"$created")
[ -n "$workspace_id" ] && [ -n "$pane_id" ] || die "unexpected create response: $created"

if [ -n "$project" ]; then
  "$HERDR" workspace report-metadata "$workspace_id" \
    --source "$NOTE_SOURCE" --token "note=$project" >/dev/null
fi
fi

# An attached workspace usually already hosts an agent. Agent commands accept
# the pane id as a target, so reuse it rather than stacking a second agent.
occupied=$("$HERDR" agent list |
  jq --arg p "$pane_id" '[.result.agents[]? | select(.pane_id == $p)] | length')
if [ "$occupied" -gt 0 ]; then
  target="$pane_id"
else
  target=$(agent_name "$item")
  start_err=$(mktemp)
  TMPFILES+=("$start_err")
  start_agent "$target" "$pane_id" >"$start_err" 2>&1 &
  start_pid=$!
  spinner "$start_pid" "Starting $AGENT_KIND"
  # A startup blocked on the trust dialog reports not-ready but still leaves a
  # usable agent in the pane, so only give up when the pane is truly empty.
  if ! wait "$start_pid"; then
    "$HERDR" agent list |
      jq -e --arg p "$pane_id" '.result.agents[]? | select(.pane_id == $p)' >/dev/null ||
      die "agent did not start in $pane_id" "$start_err"
    target="$pane_id"
  fi
fi

"$HERDR" agent wait "$target" --timeout 30000 >/dev/null 2>&1 || true
send_task "$target" "$task" >/dev/null 2>&1 &
send_pid=$!
spinner "$send_pid" 'Sending task'
wait "$send_pid" || die "could not send the task to $target"

printf '\nWorking on %s in %s.\n' "$item" "$workspace_id"
