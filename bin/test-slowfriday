test_run_agent_prompt_names_open_slow_finds_only() {
  local test_name="prompt names the open slow find and omits a closed slow find and an open smell find"
  local config_dir="$TEST_ROOT/run-agent-finds-config"
  local repo_dir="$TEST_ROOT/run-agent-finds-repo"
  local data_dir="$TEST_ROOT/run-agent-finds-inchworm"
  local out_file="$TEST_ROOT/run-agent-finds-out.txt"
  local agent_record="$TEST_ROOT/run-agent-finds-record"
  local finds_path problems=""
  local status

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  finds_path=$(inchworm_finds_path "$data_dir" "$repo_dir") || {
    fail "$test_name" "could not resolve finds.md"
    return
  }
  mkdir -p "$(dirname "$finds_path")"
  cat >"$finds_path" <<'EOF'
# Inchworm finds

## F-slow-one
- status: open
- source: slow
- rank: 1
- title: Checkout totals
- summary: totals are slow

## F-slow-closed
- status: closed
- source: slow
- rank: 2
- title: Retired ledger export
- summary: already done

## F-smell-open
- status: open
- source: smell
- rank: 3
- title: Unused helper smell
- summary: leftover helper
EOF
  use_agent_mock "$agent_record"
  RUN_INCHWORM_DATA=$data_dir

  invoke_run "$config_dir" "2026-10-09T10:00:00" "$out_file"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ "$(agent_invocation_count "$agent_record")" != "1" ]]; then
    problems="${problems}expected the agent once"$'\n'
  fi
  if [[ ! -f "$agent_record/arg-1-1" ]]; then
    problems="${problems}prompt was not recorded"$'\n'
  else
    if ! grep -F -q -- 'F-slow-one' "$agent_record/arg-1-1"; then
      problems="${problems}prompt missing F-slow-one"$'\n'
    fi
    if ! grep -F -q -- 'Checkout totals' "$agent_record/arg-1-1"; then
      problems="${problems}prompt missing Checkout totals"$'\n'
    fi
    if grep -F -q -- 'Retired ledger export' "$agent_record/arg-1-1"; then
      problems="${problems}prompt names the closed slow find"$'\n'
    fi
    if grep -F -q -- 'Unused helper smell' "$agent_record/arg-1-1"; then
      problems="${problems}prompt names the open smell find"$'\n'
    fi
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_agent_prompt_says_when_no_slow_finds() {
  local test_name="a missing finds file tells the agent there are no open slow finds"
  local config_dir="$TEST_ROOT/run-agent-nofinds-config"
  local repo_dir="$TEST_ROOT/run-agent-nofinds-repo"
  local data_dir="$TEST_ROOT/run-agent-nofinds-inchworm"
  local out_file="$TEST_ROOT/run-agent-nofinds-out.txt"
  local agent_record="$TEST_ROOT/run-agent-nofinds-record"
  local status problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  mkdir -p "$data_dir"
  if [[ -e "$(inchworm_finds_path "$data_dir" "$repo_dir")" ]]; then
    fail "$test_name" "finds.md already exists"
    return
  fi
  use_agent_mock "$agent_record"
  RUN_INCHWORM_DATA=$data_dir

  invoke_run "$config_dir" "2026-10-09T10:00:00" "$out_file"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ ! -f "$agent_record/arg-1-1" ]]; then
    problems="${problems}prompt was not recorded"$'\n'
  elif ! grep -F -q -- "There are no open slow finds." "$agent_record/arg-1-1"; then
    problems="${problems}prompt does not say there are no open slow finds"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

# --- launchd -----------------------------------------------------------------

snapshot_launchd_path() {
  local path=$1
  if [[ -e "$path" || -L "$path" ]]; then
    stat -f '%i %m %z' "$path"
  else
    printf '%s\n' missing
  fi
}

runner_cdhash() {
  codesign -dvvv "$1" 2>&1 | sed -n 's/^CDHash=//p'
}

test_launchd_template_is_friday_only() {
  local test_name="launchd template is Friday hours 8–15 at :00 and :30"
  local plist="$DOTS/launchd/com.slowfriday.plist.template"
  local problems="" placeholder program_args last_arg
  local weekday_count hour hour_count minute_0 minute_30

  if [[ ! -f "$plist" ]]; then
    fail "$test_name" "missing plist template: $plist"
    return
  fi

  if ! grep -Fq '<string>com.slowfriday</string>' "$plist"; then
    problems="${problems}plist Label must be com.slowfriday"$'\n'
  fi
  if grep -F '/Users/' "$plist" >/dev/null; then
    problems="${problems}template must not hard-code /Users/ paths"$'\n'
  fi
  for placeholder in '@HOME@' '@PATH@' '@LAUNCHD_RUNNER@' '@SLOWFRIDAY_BIN@'; do
    if ! grep -Fq "$placeholder" "$plist"; then
      problems="${problems}template missing placeholder $placeholder"$'\n'
    fi
  done

  program_args=$(sed -n '/<key>ProgramArguments<\/key>/,/<\/array>/p' "$plist")
  last_arg=$(printf '%s\n' "$program_args" | grep '<string>' | tail -n 1 || true)
  if [[ "$last_arg" != *'<string>run</string>'* ]]; then
    problems="${problems}ProgramArguments must end in run"$'\n'
  fi
  if ! printf '%s\n' "$program_args" | grep -Fq '@LAUNCHD_RUNNER@'; then
    problems="${problems}ProgramArguments must include @LAUNCHD_RUNNER@"$'\n'
  fi
  if ! printf '%s\n' "$program_args" | grep -Fq '@SLOWFRIDAY_BIN@'; then
    problems="${problems}ProgramArguments must include @SLOWFRIDAY_BIN@"$'\n'
  fi

  weekday_count=$(grep -A1 '<key>Weekday</key>' "$plist" | grep -c '<integer>5</integer>' || true)
  if [[ "$weekday_count" -ne 16 ]]; then
    problems="${problems}expected 16 Friday (Weekday 5) intervals, got $weekday_count"$'\n'
  fi
  for hour in 1 2 3 4; do
    if grep -A1 '<key>Weekday</key>' "$plist" | grep -q "<integer>${hour}</integer>"; then
      problems="${problems}StartCalendarInterval includes Weekday ${hour}"$'\n'
    fi
  done
  for hour in 8 9 10 11 12 13 14 15; do
    hour_count=$(grep -A1 '<key>Hour</key>' "$plist" | grep -c "<integer>${hour}</integer>" || true)
    if [[ "$hour_count" -ne 2 ]]; then
      problems="${problems}expected Hour ${hour} twice, got ${hour_count}"$'\n'
    fi
  done
  minute_0=$(grep -A1 '<key>Minute</key>' "$plist" | grep -c '<integer>0</integer>' || true)
  minute_30=$(grep -A1 '<key>Minute</key>' "$plist" | grep -c '<integer>30</integer>' || true)
  if [[ "$minute_0" -ne 8 || "$minute_30" -ne 8 ]]; then
    problems="${problems}expected 8 ticks at :00 and 8 at :30, got :00=$minute_0 :30=$minute_30"$'\n'
  fi
  if ! grep -Fq 'en_US.UTF-8' "$plist"; then
    problems="${problems}plist LANG and LC_ALL must be en_US.UTF-8"$'\n'
  fi
  if ! grep -Fq '@HOME@/Library/Logs/slowfriday.out.log' "$plist" \
    || ! grep -Fq '@HOME@/Library/Logs/slowfriday.err.log' "$plist"; then
    problems="${problems}plist must log to slowfriday.out.log and slowfriday.err.log under @HOME@"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems"
    return
  fi
  pass "$test_name"
}

test_launchd_setup_installs_runner() {
  local test_name="launchd-setup installs a signed runner and reuses it"
  local fake_home="$TEST_ROOT/launchd-home"
  local runner="$TEST_ROOT/slowfriday-launchd"
  local plist="$TEST_ROOT/LaunchAgents/com.slowfriday.plist"
  local out_file="$TEST_ROOT/launchd-setup-out.txt"
  local second_out="$TEST_ROOT/launchd-setup-second.txt"
  local guard_bin="$TEST_ROOT/launchd-guards"
  local real_home=$HOME
  local agents="${real_home}/Library/LaunchAgents"
  local inchworm_runner="${XDG_DATA_HOME:-$real_home/.local/share}/inchworm/inchworm-launchd"
  local before_inchworm_plist before_slowfriday_plist before_inchworm_runner before_agents
  local after_inchworm_plist after_slowfriday_plist after_inchworm_runner after_agents
  local status problems="" identity cdhash second_cdhash

  before_inchworm_plist=$(snapshot_launchd_path "$agents/com.inchworm.plist")
  before_slowfriday_plist=$(snapshot_launchd_path "$agents/com.slowfriday.plist")
  before_inchworm_runner=$(snapshot_launchd_path "$inchworm_runner")
  before_agents=$(stat -f '%m' "$agents" 2>/dev/null || printf '%s\n' missing)

  mkdir -p "$fake_home" "$guard_bin" "$(dirname "$plist")" "$(dirname "$runner")"
  cat >"$guard_bin/launchctl" <<EOF
#!/bin/sh
printf '%s\n' "\$*" >> "$TEST_ROOT/launchctl.log"
exit 99
EOF
  cat >"$guard_bin/open" <<EOF
#!/bin/sh
printf '%s\n' "\$*" >> "$TEST_ROOT/open.log"
exit 99
EOF
  chmod 755 "$guard_bin/launchctl" "$guard_bin/open"

  (
    export HOME="$fake_home"
    export PATH="$guard_bin:$PATH"
    export SLOWFRIDAY_LAUNCHD_RUNNER="$runner"
    export SLOWFRIDAY_LAUNCHD_PLIST="$plist"
    export SLOWFRIDAY_LAUNCHD_TEMPLATE="$DOTS/launchd/com.slowfriday.plist.template"
    "$SLOWFRIDAY" launchd-setup --no-open --no-reload
  ) >"$out_file" 2>&1
  status=$?

  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ ! -x "$runner" ]]; then
    problems="${problems}expected executable runner at $runner"$'\n'
  fi
  identity=$(codesign --display --verbose=2 "$runner" 2>&1 | sed -n 's/^Identifier=//p' || true)
  if [[ "$identity" != "com.slowfriday.launchd" ]]; then
    problems="${problems}expected runner identifier com.slowfriday.launchd, got: $identity"$'\n'
  fi
  if ! "$runner" -c 'exit 0' >/dev/null 2>&1; then
    problems="${problems}runner -c 'exit 0' failed"$'\n'
  fi
  if [[ ! -f "$plist" ]]; then
    problems="${problems}expected generated plist at $plist"$'\n'
  else
    if ! grep -Fq "$runner" "$plist"; then
      problems="${problems}generated plist must contain the temp runner path"$'\n'
    fi
    if ! grep -Fq "$SLOWFRIDAY" "$plist"; then
      problems="${problems}generated plist must contain the slowfriday bin path"$'\n'
    fi
    if ! grep -Fq '<string>run</string>' "$plist"; then
      problems="${problems}generated plist must include run"$'\n'
    fi
    if grep -Fq '@HOME@' "$plist" || grep -Fq '@LAUNCHD_RUNNER@' "$plist" \
      || grep -Fq '@SLOWFRIDAY_BIN@' "$plist" || grep -Fq '@PATH@' "$plist"; then
      problems="${problems}generated plist must not leave placeholders unexpanded"$'\n'
    fi
  fi
  if [[ -s "$TEST_ROOT/launchctl.log" || -s "$TEST_ROOT/open.log" ]]; then
    problems="${problems}launchd-setup --no-open --no-reload invoked launchctl or open"$'\n'
  fi

  cdhash=$(runner_cdhash "$runner" || true)
  if [[ -z "$cdhash" ]]; then
    problems="${problems}runner has no cdhash"$'\n'
  fi

  (
    export HOME="$fake_home"
    export PATH="$guard_bin:$PATH"
    export SLOWFRIDAY_LAUNCHD_RUNNER="$runner"
    export SLOWFRIDAY_LAUNCHD_PLIST="$plist"
    export SLOWFRIDAY_LAUNCHD_TEMPLATE="$DOTS/launchd/com.slowfriday.plist.template"
    "$SLOWFRIDAY" launchd-setup --no-open --no-reload
  ) >"$second_out" 2>&1
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}second setup expected exit 0, got $status"$'\n'
  fi
  second_cdhash=$(runner_cdhash "$runner" || true)
  if [[ -z "$cdhash" || "$second_cdhash" != "$cdhash" ]]; then
    problems="${problems}second setup must reuse the runner cdhash, got first='$cdhash' second='$second_cdhash'"$'\n'
  fi
  if ! grep -Fq 'reused' "$second_out"; then
    problems="${problems}second setup output must say reused"$'\n'
  fi

  after_inchworm_plist=$(snapshot_launchd_path "$agents/com.inchworm.plist")
  after_slowfriday_plist=$(snapshot_launchd_path "$agents/com.slowfriday.plist")
  after_inchworm_runner=$(snapshot_launchd_path "$inchworm_runner")
  after_agents=$(stat -f '%m' "$agents" 2>/dev/null || printf '%s\n' missing)
  if [[ "$before_inchworm_plist" != "$after_inchworm_plist" \
    || "$before_slowfriday_plist" != "$after_slowfriday_plist" \
    || "$before_inchworm_runner" != "$after_inchworm_runner" \
    || "$before_agents" != "$after_agents" ]]; then
    problems="${problems}real LaunchAgents directory or inchworm runner changed"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" "second:" "$(cat "$second_out" 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

test_docs_launchagent() {
  local test_name="docs mention launchd-setup and Full Disk Access"
  local problems=""

  if [[ ! -f "$DOCS_FILE" ]]; then
    fail "$test_name" "missing $DOCS_FILE"
    return
  fi
  if ! grep -Fq 'launchd-setup' "$DOCS_FILE"; then
    problems="${problems}docs must mention launchd-setup"$'\n'
  fi
  if ! grep -Fq 'Full Disk Access' "$DOCS_FILE"; then
    problems="${problems}docs must mention Full Disk Access"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems"
    return
  fi
  pass "$test_name"
}

