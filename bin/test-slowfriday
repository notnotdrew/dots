test_run_plain_directory_fails_preflight() {
  local test_name="a directory that is not a git work tree fails preflight without a fixture"
  local config_dir="$TEST_ROOT/run-plain-config"
  local repo_dir="$TEST_ROOT/run-plain-repo"
  local log="$TEST_ROOT/run-plain-log"
  local out_file="$TEST_ROOT/run-plain-out.txt"
  local status count problems=""

  reset_run_env
  prepare_registered_plain_dir "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  if git -C "$repo_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    fail "$test_name" "fixture directory is inside a work tree, so preflight would pass"
    return
  fi
  use_query_stub "$log"
  RUN_QUERY_STATUS=0

  invoke_run "$config_dir" "2026-10-09T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ "$count" != "0" ]]; then
    problems="${problems}queries ran, count=$count"$'\n'
  fi
  if [[ -e "$repo_dir/slowfriday/notes/261009.md" ]]; then
    problems="${problems}preflight failure wrote notes/261009.md"$'\n'
  fi
  if ! yaml_expect "$repo_dir/slowfriday/config.yml" "progress_pid=absent"; then
    problems="${problems}preflight failure left progress_pid set"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

# --- main --------------------------------------------------------------------

write_yaml_helpers
install_query_stub

printf '%s\n' "# slowfriday tests"
printf '%s\n' "# slowfriday binary: $SLOWFRIDAY$([[ -x "$SLOWFRIDAY" ]] && printf ' (present)' || printf ' (MISSING)')"

run_test test_init_creates_files_registry_and_gitignore
run_test test_init_is_idempotent
run_test test_docs_manual_step_and_script_silence
run_test test_usage_on_missing_and_unknown_command
run_test test_run_success_leaves_week_unstamped_and_queries_again
run_test test_run_skips_when_current_note_exists
run_test test_run_query_failure_retries_on_the_next_tick
run_test test_run_preflight_fixture_failure_retries_when_cleared
run_test test_run_live_pid_blocks_queries
run_test test_run_stale_pid_is_cleared_and_queries_run
run_test test_run_skips_thursday_and_saturday
run_test test_run_window_edges
run_test test_run_two_repos_queries_only_the_unstamped_one
run_test test_run_older_note_does_not_stamp_this_week
run_test test_run_plain_directory_fails_preflight

if [[ "$tests_failed" -ne 0 ]]; then
  printf '%s\n' "$tests_failed of $tests_run slowfriday tests failed"
  exit 1
fi

printf '%s\n' "all $tests_run slowfriday tests passed"
exit 0
