test_run_plain_directory_fails_preflight() {
  local test_name="a directory that is not a git work tree fails preflight without a fixture"
  local config_dir="$TEST_ROOT/run-plain-config"
  local repo_dir="$TEST_ROOT/run-plain-repo"
  local log="$TEST_ROOT/run-plain-log"
  local out_file="$TEST_ROOT/run-plain-out.txt"
  local status count problems=""

  reset_run_env
  prepare_registered_plain_dir "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  if git -C "$repo_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    fail "$test_name" "fixture directory is inside a work tree, so preflight would pass"
    return
  fi
  use_query_stub "$log"
  RUN_QUERY_STATUS=0

  invoke_run "$config_dir" "2026-10-09T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ "$count" != "0" ]]; then
    problems="${problems}queries ran, count=$count"$'\n'
  fi
  if [[ -e "$repo_dir/slowfriday/notes/261009.md" ]]; then
    problems="${problems}preflight failure wrote notes/261009.md"$'\n'
  fi
  if ! yaml_expect "$repo_dir/slowfriday/config.yml" "progress_pid=absent"; then
    problems="${problems}preflight failure left progress_pid set"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_fetches_main_and_links_slowfriday() {
  local test_name="Friday fetch updates stale origin/main, opens drew/slowfriday-261009, and links slowfriday"
  local config_dir="$TEST_ROOT/run-deliver-config"
  local repo_dir="$TEST_ROOT/run-deliver-repo"
  local log="$TEST_ROOT/run-deliver-log"
  local herdr_log="$TEST_ROOT/run-deliver-herdr"
  local out_file="$TEST_ROOT/run-deliver-out.txt"
  local sentinel="$repo_dir/slowfriday/durable-sentinel.txt"
  local old new stale after head wt expected problems=""
  local status count

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  printf '%s\n' 'durable sentinel' >"$sentinel"
  old=$(git -C "$repo_dir" rev-parse origin/main)
  new=$(advance_bare_branch "$repo_dir" main) || {
    fail "$test_name" "could not advance origin/main"
    return
  }
  stale=$(git -C "$repo_dir" rev-parse origin/main)
  if [[ "$stale" != "$old" || "$new" == "$old" ]]; then
    fail "$test_name" "origin/main was not stale before the run (old=$old new=$new stale=$stale)"
    return
  fi

  use_query_stub "$log"
  RUN_QUERY_STATUS=0
  RUN_HERDR_LOG=$herdr_log
  RUN_HERDR_PLANT=copy

  invoke_run "$config_dir" "2026-10-09T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  after=$(git -C "$repo_dir" rev-parse origin/main)
  head=$(git -C "$repo_dir" rev-parse HEAD)
  wt=$(worktree_from_output "$out_file" "$repo_dir")
  expected="worktree create --cwd ${repo_dir} --branch drew/slowfriday-261009 --base origin/main"

  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ "$after" != "$new" ]]; then
    problems="${problems}origin/main did not match the new commit (after=$after new=$new)"$'\n'
  fi
  if [[ "$head" != "$old" ]]; then
    problems="${problems}fetch moved local HEAD"$'\n'
  fi
  if ! grep -F -x -q -- "$expected" "$herdr_log"; then
    problems="${problems}herdr log missing the create invocation"$'\n'"$(cat "$herdr_log" 2>/dev/null || true)"$'\n'
  fi
  if grep -F -q -- '--focus' "$herdr_log"; then
    problems="${problems}herdr log contains --focus"$'\n'
  fi
  if [[ -z "$wt" || ! -d "$wt" ]]; then
    problems="${problems}printed worktree is missing: ${wt}"$'\n'
  else
    if [[ ! -L "$wt/slowfriday" ]]; then
      problems="${problems}worktree slowfriday is not a symlink"$'\n'
    fi
    if [[ "$(readlink "$wt/slowfriday")" != "$repo_dir/slowfriday" ]]; then
      problems="${problems}symlink target is $(readlink "$wt/slowfriday")"$'\n'
    fi
    if [[ "$(count_named copied-only.txt "$wt" "$repo_dir")" != "0" ]]; then
      problems="${problems}copied-only.txt is still present without following links"$'\n'
    fi
    if [[ "$(count_named durable-sentinel.txt "$repo_dir")" != "1" ]]; then
      problems="${problems}registered sentinel count is not 1"$'\n'
    fi
    if [[ "$(count_named durable-sentinel.txt "$wt")" != "0" ]]; then
      problems="${problems}sentinel is visible from the worktree without following links"$'\n'
    fi
    if [[ ! -f "$sentinel" ]]; then
      problems="${problems}registered sentinel is gone"$'\n'
    fi
  fi
  if [[ "$count" != "1" ]]; then
    problems="${problems}expected the query once, got $count"$'\n'
  fi
  if [[ -e "$repo_dir/slowfriday/notes/261009.md" ]]; then
    problems="${problems}run wrote notes/261009.md"$'\n'
  fi
  if ! yaml_expect "$repo_dir/slowfriday/config.yml" "progress_pid=absent"; then
    problems="${problems}run left progress_pid set"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_trunk_develop_fetches_that_base() {
  local test_name="trunk develop fetches origin/develop and passes it as the worktree base"
  local config_dir="$TEST_ROOT/run-develop-config"
  local repo_dir="$TEST_ROOT/run-develop-repo"
  local log="$TEST_ROOT/run-develop-log"
  local herdr_log="$TEST_ROOT/run-develop-herdr"
  local out_file="$TEST_ROOT/run-develop-out.txt"
  local old new stale after expected problems=""
  local status count

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  publish_branch "$repo_dir" develop || {
    fail "$test_name" "could not publish develop"
    return
  }
  old=$(git -C "$repo_dir" rev-parse origin/develop)
  new=$(advance_bare_branch "$repo_dir" develop) || {
    fail "$test_name" "could not advance origin/develop"
    return
  }
  stale=$(git -C "$repo_dir" rev-parse origin/develop)
  if [[ "$stale" != "$old" || "$new" == "$old" ]]; then
    fail "$test_name" "origin/develop was not stale before the run"
    return
  fi
  yaml_set_trunk "$repo_dir/slowfriday/config.yml" "develop"
  use_query_stub "$log"
  RUN_QUERY_STATUS=0
  RUN_HERDR_LOG=$herdr_log

  invoke_run "$config_dir" "2026-10-09T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  after=$(git -C "$repo_dir" rev-parse origin/develop)
  expected="worktree create --cwd ${repo_dir} --branch drew/slowfriday-261009 --base origin/develop"

  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ "$after" != "$new" ]]; then
    problems="${problems}origin/develop did not match the new commit (after=$after new=$new)"$'\n'
  fi
  if ! grep -F -x -q -- "$expected" "$herdr_log"; then
    problems="${problems}herdr log missing the develop create invocation"$'\n'"$(cat "$herdr_log" 2>/dev/null || true)"$'\n'
  fi
  if grep -F -q -- '--focus' "$herdr_log"; then
    problems="${problems}herdr log contains --focus"$'\n'
  fi
  if [[ "$count" != "1" ]]; then
    problems="${problems}expected the query once, got $count"$'\n'
  fi
  if [[ -e "$repo_dir/slowfriday/notes/261009.md" ]]; then
    problems="${problems}run wrote notes/261009.md"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_without_origin_retries_until_origin_exists() {
  local test_name="a repo with no origin retries later and a later origin runs the delivery"
  local config_dir="$TEST_ROOT/run-no-origin-config"
  local repo_dir="$TEST_ROOT/run-no-origin-repo"
  local log="$TEST_ROOT/run-no-origin-log"
  local herdr_log="$TEST_ROOT/run-no-origin-herdr"
  local out_file="$TEST_ROOT/run-no-origin-out.txt"
  local origin status count problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  origin=$(bare_origin_for "$repo_dir")
  git -C "$repo_dir" remote remove origin || {
    fail "$test_name" "could not remove origin"
    return
  }
  use_query_stub "$log"
  RUN_QUERY_STATUS=0
  RUN_HERDR_LOG=$herdr_log

  invoke_run "$config_dir" "2026-10-09T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}missing origin expected exit 0, got $status"$'\n'
  fi
  if [[ -s "$herdr_log" ]]; then
    problems="${problems}missing origin called herdr"$'\n'"$(cat "$herdr_log")"'\n'
  fi
  if [[ "$count" != "0" ]]; then
    problems="${problems}missing origin invoked queries, count=$count"$'\n'
  fi
  if [[ -e "$repo_dir/slowfriday/notes/261009.md" ]]; then
    problems="${problems}missing origin wrote notes/261009.md"$'\n'
  fi
  if ! yaml_expect "$repo_dir/slowfriday/config.yml" "progress_pid=absent"; then
    problems="${problems}missing origin left progress_pid set"$'\n'
  fi
  if ! grep -F -q -- "the next tick retries" "$out_file"; then
    problems="${problems}missing origin did not say the next tick retries"$'\n'
  fi

  git -C "$repo_dir" remote add origin "$origin" || {
    fail "$test_name" "could not add origin" "$problems"
    return
  }
  invoke_run "$config_dir" "2026-10-09T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}retry expected exit 0, got $status"$'\n'
  fi
  if ! grep -F -q -- "worktree create" "$herdr_log"; then
    problems="${problems}retry did not call herdr"$'\n'
  fi
  if ! grep -F -q -- "--cwd ${repo_dir}" "$herdr_log"; then
    problems="${problems}retry herdr log missing --cwd"$'\n'
  fi
  if [[ "$count" != "1" ]]; then
    problems="${problems}retry expected the query once, got $count"$'\n'
  fi
  if [[ -e "$repo_dir/slowfriday/notes/261009.md" ]]; then
    problems="${problems}retry wrote notes/261009.md"$'\n'
  fi
  if ! yaml_expect "$repo_dir/slowfriday/config.yml" "progress_pid=absent"; then
    problems="${problems}retry left progress_pid set"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_herdr_create_failure_without_branch_retries() {
  local test_name="herdr create failure with no listed branch skips queries until a later success"
  local config_dir="$TEST_ROOT/run-herdr-fail-config"
  local repo_dir="$TEST_ROOT/run-herdr-fail-repo"
  local log="$TEST_ROOT/run-herdr-fail-log"
  local herdr_log="$TEST_ROOT/run-herdr-fail-herdr"
  local out_file="$TEST_ROOT/run-herdr-fail-out.txt"
  local status count creates problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  use_query_stub "$log"
  RUN_QUERY_STATUS=0
  RUN_HERDR_LOG=$herdr_log
  RUN_HERDR_CREATE_STATUS=1
  RUN_HERDR_LIST=empty

  invoke_run "$config_dir" "2026-10-09T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  creates=$(grep -F -c -x -- "worktree create --cwd ${repo_dir} --branch drew/slowfriday-261009 --base origin/main" "$herdr_log" || true)
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}failed create expected exit 0, got $status"$'\n'
  fi
  if [[ "$creates" != "1" ]]; then
    problems="${problems}failed create expected one create invocation, got $creates"$'\n'"$(cat "$herdr_log" 2>/dev/null || true)"$'\n'
  fi
  if ! grep -F -q -- "worktree list --cwd ${repo_dir}" "$herdr_log"; then
    problems="${problems}failed create did not list worktrees"$'\n'
  fi
  if [[ "$count" != "0" ]]; then
    problems="${problems}failed create invoked queries, count=$count"$'\n'
  fi
  if [[ -e "$repo_dir/slowfriday/notes/261009.md" ]]; then
    problems="${problems}failed create wrote notes/261009.md"$'\n'
  fi
  if ! yaml_expect "$repo_dir/slowfriday/config.yml" "progress_pid=absent"; then
    problems="${problems}failed create left progress_pid set"$'\n'
  fi
  if ! grep -F -q -- "the next tick retries" "$out_file"; then
    problems="${problems}failed create did not say the next tick retries"$'\n'
  fi

  RUN_HERDR_CREATE_STATUS=
  RUN_HERDR_LIST=
  invoke_run "$config_dir" "2026-10-09T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  creates=$(grep -F -c -x -- "worktree create --cwd ${repo_dir} --branch drew/slowfriday-261009 --base origin/main" "$herdr_log" || true)
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}retry expected exit 0, got $status"$'\n'
  fi
  if [[ "$creates" != "2" ]]; then
    problems="${problems}retry expected a second create, got $creates"$'\n'
  fi
  if [[ "$count" != "1" ]]; then
    problems="${problems}retry expected the query once, got $count"$'\n'
  fi
  if [[ -e "$repo_dir/slowfriday/notes/261009.md" ]]; then
    problems="${problems}retry wrote notes/261009.md"$'\n'
  fi
  if ! yaml_expect "$repo_dir/slowfriday/config.yml" "progress_pid=absent"; then
    problems="${problems}retry left progress_pid set"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_herdr_create_failure_recovers_listed_branch() {
  local test_name="herdr create failure recovers the listed branch, links slowfriday, and queries once"
  local config_dir="$TEST_ROOT/run-herdr-recover-config"
  local repo_dir="$TEST_ROOT/run-herdr-recover-repo"
  local log="$TEST_ROOT/run-herdr-recover-log"
  local herdr_log="$TEST_ROOT/run-herdr-recover-herdr"
  local out_file="$TEST_ROOT/run-herdr-recover-out.txt"
  local sentinel="$repo_dir/slowfriday/durable-sentinel.txt"
  local status count wt problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  printf '%s\n' 'durable sentinel' >"$sentinel"
  use_query_stub "$log"
  RUN_QUERY_STATUS=0
  RUN_HERDR_LOG=$herdr_log
  RUN_HERDR_CREATE_STATUS=1
  RUN_HERDR_LIST=match
  RUN_HERDR_PLANT=copy

  invoke_run "$config_dir" "2026-10-09T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  wt=$(worktree_from_output "$out_file" "$repo_dir")

  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if ! grep -F -q -- "worktree create" "$herdr_log"; then
    problems="${problems}create was not attempted"$'\n'
  fi
  if ! grep -F -q -- "worktree list --cwd ${repo_dir}" "$herdr_log"; then
    problems="${problems}list was not attempted"$'\n'
  fi
  if [[ -z "$wt" || ! -L "$wt/slowfriday" ]]; then
    problems="${problems}recovered worktree slowfriday is not a symlink (${wt})"$'\n'
  elif [[ "$(readlink "$wt/slowfriday")" != "$repo_dir/slowfriday" ]]; then
    problems="${problems}symlink target is $(readlink "$wt/slowfriday")"$'\n'
  fi
  if [[ -n "$wt" && "$(count_named copied-only.txt "$wt" "$repo_dir")" != "0" ]]; then
    problems="${problems}copied directory remained"$'\n'
  fi
  if [[ ! -f "$sentinel" ]]; then
    problems="${problems}registered sentinel is gone"$'\n'
  fi
  if [[ "$count" != "1" ]]; then
    problems="${problems}expected the query once, got $count"$'\n'
  fi
  if [[ -e "$repo_dir/slowfriday/notes/261009.md" ]]; then
    problems="${problems}run wrote notes/261009.md"$'\n'
  fi
  if ! yaml_expect "$repo_dir/slowfriday/config.yml" "progress_pid=absent"; then
    problems="${problems}run left progress_pid set"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_existing_slowfriday_symlink_is_left() {
  local test_name="an existing slowfriday symlink to the registered directory is left in place"
  local config_dir="$TEST_ROOT/run-link-config"
  local repo_dir="$TEST_ROOT/run-link-repo"
  local log="$TEST_ROOT/run-link-log"
  local herdr_log="$TEST_ROOT/run-link-herdr"
  local out_file="$TEST_ROOT/run-link-out.txt"
  local sentinel="$repo_dir/slowfriday/durable-sentinel.txt"
  local status wt before after problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  printf '%s\n' 'durable sentinel' >"$sentinel"
  use_query_stub "$log"
  RUN_QUERY_STATUS=0
  RUN_HERDR_LOG=$herdr_log
  RUN_HERDR_PLANT=symlink

  invoke_run "$config_dir" "2026-10-09T10:00:00" "$out_file"
  status=$?
  wt=$(worktree_from_output "$out_file" "$repo_dir")
  before=$(cat "${herdr_log}.symlink-inode" 2>/dev/null || true)

  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ -z "$wt" || ! -L "$wt/slowfriday" ]]; then
    problems="${problems}worktree slowfriday is not a symlink (${wt})"$'\n'
  else
    after=$(link_inode "$wt/slowfriday")
    if [[ "$(readlink "$wt/slowfriday")" != "$repo_dir/slowfriday" ]]; then
      problems="${problems}symlink target is $(readlink "$wt/slowfriday")"$'\n'
    fi
    if [[ -L "$repo_dir/slowfriday" ]]; then
      problems="${problems}registered slowfriday became a symlink"$'\n'
    fi
    if [[ -z "$before" || "$before" != "$after" ]]; then
      problems="${problems}symlink was replaced (before=$before after=$after)"$'\n'
    fi
    if [[ -d "$wt/slowfriday" && ! -L "$wt/slowfriday" ]]; then
      problems="${problems}worktree slowfriday is a copied directory"$'\n'
    fi
  fi
  if [[ ! -f "$sentinel" ]]; then
    problems="${problems}registered sentinel is gone"$'\n'
  fi
  if [[ "$(count_named durable-sentinel.txt "$repo_dir")" != "1" ]]; then
    problems="${problems}sentinel is not only in the registered tree"$'\n'
  fi
  if [[ "$(path_count_in_log "$log" "$repo_dir")" != "1" ]]; then
    problems="${problems}expected the query once"$'\n'
  fi
  if [[ -e "$repo_dir/slowfriday/notes/261009.md" ]]; then
    problems="${problems}run wrote notes/261009.md"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_agent_writes_note_and_second_friday_skips() {
  local test_name="orchestrator starts in the worktree, keeps the note it wrote, and a second Friday skips it"
  local config_dir="$TEST_ROOT/run-agent-ok-config"
  local repo_dir="$TEST_ROOT/run-agent-ok-repo"
  local out_file="$TEST_ROOT/run-agent-ok-out.txt"
  local agent_record="$TEST_ROOT/run-agent-ok-record"
  local note="$repo_dir/slowfriday/notes/261009.md"
  local log_file="$repo_dir/slowfriday/log.md"
  local expected_note="$TEST_ROOT/run-agent-ok-expected-note"
  local expected_log="$TEST_ROOT/run-agent-ok-expected-log"
  local guide="${repo_dir}/slowfriday/guide.md"
  local head_before head_after wt cwd argc status problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  printf '%s\n' 'distinctive-weekly-note' >"$expected_note"
  printf '%s\n' 'distinctive-log-line' >"$expected_log"
  head_before=$(git -C "$repo_dir" rev-parse HEAD)
  use_agent_mock "$agent_record"
  RUN_AGENT_WRITE=note
  RUN_AGENT_NOTE=$note
  RUN_AGENT_LOG_FILE=$log_file

  invoke_run "$config_dir" "2026-10-09T10:00:00" "$out_file"
  status=$?
  wt=$(worktree_from_output "$out_file" "$repo_dir")
  cwd=$(cat "$agent_record/cwd-1" 2>/dev/null || true)
  argc=$(cat "$agent_record/argc-1" 2>/dev/null || true)

  if [[ "$status" -ne 0 ]]; then
    problems="${problems}first run expected exit 0, got $status"$'\n'
  fi
  if [[ "$(agent_invocation_count "$agent_record")" != "1" ]]; then
    problems="${problems}first run expected the agent once"$'\n'
  fi
  if [[ -z "$wt" || "$cwd" != "$wt" ]]; then
    problems="${problems}agent cwd is not the delivered worktree (cwd=$cwd worktree=$wt)"$'\n'
  fi
  if [[ "$cwd" == "$repo_dir" ]]; then
    problems="${problems}agent started in the registered checkout"$'\n'
  fi
  if [[ "$argc" != "2" ]]; then
    problems="${problems}expected argv length 2, got $argc"$'\n'
  fi
  if [[ "$(cat "$agent_record/arg-1-0" 2>/dev/null || true)" != "-p" ]]; then
    problems="${problems}first argument is not -p"$'\n'
  fi
  if [[ ! -f "$agent_record/arg-1-1" ]]; then
    problems="${problems}prompt was not recorded"$'\n'
  else
    if ! grep -F -q -- "$guide" "$agent_record/arg-1-1"; then
      problems="${problems}prompt missing the registered guide path"$'\n'
    fi
    if ! grep -F -q -- "$log_file" "$agent_record/arg-1-1"; then
      problems="${problems}prompt missing the registered log path"$'\n'
    fi
    if ! grep -F -q -- "$note" "$agent_record/arg-1-1"; then
      problems="${problems}prompt missing the registered notes/261009.md path"$'\n'
    fi
    if ! grep -F -q -- "It may delegate only a query pass, a code read, or a lens pass over options it already listed." "$agent_record/arg-1-1"; then
      problems="${problems}prompt missing the delegation sentence"$'\n'
    fi
    if ! grep -F -q -- "It must not edit or commit application files." "$agent_record/arg-1-1"; then
      problems="${problems}prompt missing the application-files sentence"$'\n'
    fi
    if ! grep -F -q -- "Subagents do not." "$agent_record/arg-1-1"; then
      problems="${problems}prompt does not say subagents do not write the log and note"$'\n'
    fi
    if ! grep -F -q -- "It must not open a pull request." "$agent_record/arg-1-1"; then
      problems="${problems}prompt does not say not to open a pull request"$'\n'
    fi
  fi
  if agent_argv_forbidden "$agent_record" 1; then
    problems="${problems}argv contains --yolo, --force, or --trust"$'\n'
  fi
  if ! files_match "$expected_note" "$note"; then
    problems="${problems}note bytes are not the agent's distinctive line"$'\n'
  fi
  if ! files_match "$expected_log" "$log_file"; then
    problems="${problems}log bytes are not the agent's distinctive line"$'\n'
  fi

  invoke_run "$config_dir" "2026-10-09T10:00:00" "$out_file"
  status=$?
  head_after=$(git -C "$repo_dir" rev-parse HEAD)
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}second run expected exit 0, got $status"$'\n'
  fi
  if [[ "$(agent_invocation_count "$agent_record")" != "1" ]]; then
    problems="${problems}second Friday started the agent"$'\n'
  fi
  if ! files_match "$expected_note" "$note"; then
    problems="${problems}second run changed the note"$'\n'
  fi
  if ! files_match "$expected_log" "$log_file"; then
    problems="${problems}second run changed the log"$'\n'
  fi
  if [[ "$head_before" != "$head_after" ]]; then
    problems="${problems}HEAD changed ($head_before -> $head_after)"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

