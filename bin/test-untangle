    return
  fi
  pass "$test_name"
}

test_run_fetches_main_and_links_untangle() {
  local test_name="Wednesday fetch updates stale origin/main, opens drew/untangle-261014, and links untangle"
  local config_dir="$TEST_ROOT/run-deliver-config"
  local repo_dir="$TEST_ROOT/run-deliver-repo"
  local log="$TEST_ROOT/run-deliver-log"
  local herdr_log="$TEST_ROOT/run-deliver-herdr"
  local out_file="$TEST_ROOT/run-deliver-out.txt"
  local sentinel="$repo_dir/untangle/durable-sentinel.txt"
  local old new stale after head wt expected problems=""
  local status count

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  printf '%s\n' 'durable sentinel' >"$sentinel"
  old=$(git -C "$repo_dir" rev-parse origin/main)
  new=$(advance_bare_branch "$repo_dir" main) || {
    fail "$test_name" "could not advance origin/main"
    return
  }
  stale=$(git -C "$repo_dir" rev-parse origin/main)
  if [[ "$stale" != "$old" || "$new" == "$old" ]]; then
    fail "$test_name" "origin/main was not stale before the run (old=$old new=$new stale=$stale)"
    return
  fi

  use_probe_stub "$log"
  RUN_PROBE_STATUS=0
  RUN_HERDR_LOG=$herdr_log
  RUN_HERDR_PLANT=copy

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  after=$(git -C "$repo_dir" rev-parse origin/main)
  head=$(git -C "$repo_dir" rev-parse HEAD)
  wt=$(worktree_from_output "$out_file" "$repo_dir")
  expected="worktree create --cwd ${repo_dir} --branch drew/untangle-261014 --base origin/main"

  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ "$after" != "$new" ]]; then
    problems="${problems}origin/main did not match the new commit (after=$after new=$new)"$'\n'
  fi
  if [[ "$head" != "$old" ]]; then
    problems="${problems}fetch moved local HEAD"$'\n'
  fi
  if ! grep -F -x -q -- "$expected" "$herdr_log"; then
    problems="${problems}herdr log missing the create invocation"$'\n'"$(cat "$herdr_log" 2>/dev/null || true)"$'\n'
  fi
  if grep -F -q -- '--focus' "$herdr_log"; then
    problems="${problems}herdr log contains --focus"$'\n'
  fi
  if [[ -z "$wt" || ! -d "$wt" ]]; then
    problems="${problems}printed worktree is missing: ${wt}"$'\n'
  else
    if [[ ! -L "$wt/untangle" ]]; then
      problems="${problems}worktree untangle is not a symlink"$'\n'
    fi
    if [[ "$(readlink "$wt/untangle")" != "$repo_dir/untangle" ]]; then
      problems="${problems}symlink target is $(readlink "$wt/untangle")"$'\n'
    fi
    if [[ "$(count_named copied-only.txt "$wt" "$repo_dir")" != "0" ]]; then
      problems="${problems}copied-only.txt is still present without following links"$'\n'
    fi
    if [[ "$(count_named durable-sentinel.txt "$repo_dir")" != "1" ]]; then
      problems="${problems}registered sentinel count is not 1"$'\n'
    fi
    if [[ "$(count_named durable-sentinel.txt "$wt")" != "0" ]]; then
      problems="${problems}sentinel is visible from the worktree without following links"$'\n'
    fi
    if [[ ! -f "$sentinel" ]]; then
      problems="${problems}registered sentinel is gone"$'\n'
    fi
  fi
  if [[ "$count" != "1" ]]; then
    problems="${problems}expected the probe once, got $count"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}run wrote notes/261014.md"$'\n'
  fi
  if ! yaml_expect "$repo_dir/untangle/config.yml" "progress_pid=absent"; then
    problems="${problems}run left progress_pid set"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_trunk_develop_fetches_that_base() {
  local test_name="trunk develop fetches origin/develop and passes it as the worktree base"
  local config_dir="$TEST_ROOT/run-develop-config"
  local repo_dir="$TEST_ROOT/run-develop-repo"
  local log="$TEST_ROOT/run-develop-log"
  local herdr_log="$TEST_ROOT/run-develop-herdr"
  local out_file="$TEST_ROOT/run-develop-out.txt"
  local old new stale after expected problems=""
  local status count

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  publish_branch "$repo_dir" develop || {
    fail "$test_name" "could not publish develop"
    return
  }
  old=$(git -C "$repo_dir" rev-parse origin/develop)
  new=$(advance_bare_branch "$repo_dir" develop) || {
    fail "$test_name" "could not advance origin/develop"
    return
  }
  stale=$(git -C "$repo_dir" rev-parse origin/develop)
  if [[ "$stale" != "$old" || "$new" == "$old" ]]; then
    fail "$test_name" "origin/develop was not stale before the run"
    return
  fi
  yaml_set_trunk "$repo_dir/untangle/config.yml" "develop"
  use_probe_stub "$log"
  RUN_PROBE_STATUS=0
  RUN_HERDR_LOG=$herdr_log

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  after=$(git -C "$repo_dir" rev-parse origin/develop)
  expected="worktree create --cwd ${repo_dir} --branch drew/untangle-261014 --base origin/develop"

  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ "$after" != "$new" ]]; then
    problems="${problems}origin/develop did not match the new commit (after=$after new=$new)"$'\n'
  fi
  if ! grep -F -x -q -- "$expected" "$herdr_log"; then
    problems="${problems}herdr log missing the develop create invocation"$'\n'"$(cat "$herdr_log" 2>/dev/null || true)"$'\n'
  fi
  if grep -F -q -- '--focus' "$herdr_log"; then
    problems="${problems}herdr log contains --focus"$'\n'
  fi
  if [[ "$count" != "1" ]]; then
    problems="${problems}expected the probe once, got $count"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}run wrote notes/261014.md"$'\n'
  fi
  if ! yaml_expect "$repo_dir/untangle/config.yml" "trunk=str:develop"; then
    problems="${problems}trunk was rewritten"$'\n'
  fi
  if ! yaml_expect "$repo_dir/untangle/config.yml" "progress_pid=absent"; then
    problems="${problems}run left progress_pid set"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_without_origin_retries_until_origin_exists() {
  local test_name="a repo with no origin retries later and a later origin runs the delivery"
  local config_dir="$TEST_ROOT/run-no-origin-config"
  local repo_dir="$TEST_ROOT/run-no-origin-repo"
  local log="$TEST_ROOT/run-no-origin-log"
  local herdr_log="$TEST_ROOT/run-no-origin-herdr"
  local out_file="$TEST_ROOT/run-no-origin-out.txt"
  local origin status count problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  origin=$(bare_origin_for "$repo_dir")
  git -C "$repo_dir" remote remove origin || {
    fail "$test_name" "could not remove origin"
    return
  }
  use_probe_stub "$log"
  RUN_PROBE_STATUS=0
  RUN_HERDR_LOG=$herdr_log

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}missing origin expected exit 0, got $status"$'\n'
  fi
  if [[ -s "$herdr_log" ]]; then
    problems="${problems}missing origin called herdr"$'\n'"$(cat "$herdr_log")"'\n'
  fi
  if [[ "$count" != "0" ]]; then
    problems="${problems}missing origin invoked the probe, count=$count"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}missing origin wrote notes/261014.md"$'\n'
  fi
  if ! yaml_expect "$repo_dir/untangle/config.yml" "progress_pid=absent"; then
    problems="${problems}missing origin left progress_pid set"$'\n'
  fi
  if ! grep -F -q -- "the next tick retries" "$out_file"; then
    problems="${problems}missing origin did not say the next tick retries"$'\n'
  fi
  if ! grep -F -q -- "could not fetch origin" "$out_file"; then
    problems="${problems}missing origin did not say could not fetch origin"$'\n'
  fi

  git -C "$repo_dir" remote add origin "$origin" || {
    fail "$test_name" "could not add origin" "$problems"
    return
  }
  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}retry expected exit 0, got $status"$'\n'
  fi
  if ! grep -F -q -- "worktree create" "$herdr_log"; then
    problems="${problems}retry did not call herdr"$'\n'
  fi
  if ! grep -F -q -- "--cwd ${repo_dir}" "$herdr_log"; then
    problems="${problems}retry herdr log missing --cwd"$'\n'
  fi
  if [[ "$count" != "1" ]]; then
    problems="${problems}retry expected the probe once, got $count"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}retry wrote notes/261014.md"$'\n'
  fi
  if ! yaml_expect "$repo_dir/untangle/config.yml" "progress_pid=absent"; then
    problems="${problems}retry left progress_pid set"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_herdr_create_failure_without_branch_retries() {
  local test_name="herdr create failure with no listed branch skips the probe until a later success"
  local config_dir="$TEST_ROOT/run-herdr-fail-config"
  local repo_dir="$TEST_ROOT/run-herdr-fail-repo"
  local log="$TEST_ROOT/run-herdr-fail-log"
  local herdr_log="$TEST_ROOT/run-herdr-fail-herdr"
  local out_file="$TEST_ROOT/run-herdr-fail-out.txt"
  local status count creates problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  use_probe_stub "$log"
  RUN_PROBE_STATUS=0
  RUN_HERDR_LOG=$herdr_log
  RUN_HERDR_CREATE_STATUS=1
  RUN_HERDR_LIST=empty

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  creates=$(grep -F -c -x -- "worktree create --cwd ${repo_dir} --branch drew/untangle-261014 --base origin/main" "$herdr_log" || true)
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}failed create expected exit 0, got $status"$'\n'
  fi
  if [[ "$creates" != "1" ]]; then
    problems="${problems}failed create expected one create invocation, got $creates"$'\n'"$(cat "$herdr_log" 2>/dev/null || true)"$'\n'
  fi
  if ! grep -F -q -- "worktree list --cwd ${repo_dir}" "$herdr_log"; then
    problems="${problems}failed create did not list worktrees"$'\n'
  fi
  if [[ "$count" != "0" ]]; then
    problems="${problems}failed create invoked the probe, count=$count"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}failed create wrote notes/261014.md"$'\n'
  fi
  if ! yaml_expect "$repo_dir/untangle/config.yml" "progress_pid=absent"; then
    problems="${problems}failed create left progress_pid set"$'\n'
  fi
  if ! grep -F -q -- "the next tick retries" "$out_file"; then
    problems="${problems}failed create did not say the next tick retries"$'\n'
  fi

  RUN_HERDR_CREATE_STATUS=
  RUN_HERDR_LIST=
  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  creates=$(grep -F -c -x -- "worktree create --cwd ${repo_dir} --branch drew/untangle-261014 --base origin/main" "$herdr_log" || true)
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}retry expected exit 0, got $status"$'\n'
  fi
  if [[ "$creates" != "2" ]]; then
    problems="${problems}retry expected a second create, got $creates"$'\n'
  fi
  if [[ "$count" != "1" ]]; then
    problems="${problems}retry expected the probe once, got $count"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}retry wrote notes/261014.md"$'\n'
  fi
  if ! yaml_expect "$repo_dir/untangle/config.yml" "progress_pid=absent"; then
    problems="${problems}retry left progress_pid set"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_herdr_create_failure_recovers_listed_branch() {
  local test_name="herdr create failure recovers the listed branch, links untangle, and probes once"
  local config_dir="$TEST_ROOT/run-herdr-recover-config"
  local repo_dir="$TEST_ROOT/run-herdr-recover-repo"
  local log="$TEST_ROOT/run-herdr-recover-log"
  local herdr_log="$TEST_ROOT/run-herdr-recover-herdr"
  local out_file="$TEST_ROOT/run-herdr-recover-out.txt"
  local sentinel="$repo_dir/untangle/durable-sentinel.txt"
  local status count wt problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  printf '%s\n' 'durable sentinel' >"$sentinel"
  use_probe_stub "$log"
  RUN_PROBE_STATUS=0
  RUN_HERDR_LOG=$herdr_log
  RUN_HERDR_CREATE_STATUS=1
  RUN_HERDR_LIST=match
  RUN_HERDR_PLANT=copy

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  wt=$(worktree_from_output "$out_file" "$repo_dir")

  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if ! grep -F -q -- "worktree create" "$herdr_log"; then
    problems="${problems}create was not attempted"$'\n'
  fi
  if ! grep -F -q -- "worktree list --cwd ${repo_dir}" "$herdr_log"; then
    problems="${problems}list was not attempted"$'\n'
  fi
  if [[ -z "$wt" || ! -L "$wt/untangle" ]]; then
    problems="${problems}recovered worktree untangle is not a symlink (${wt})"$'\n'
  elif [[ "$(readlink "$wt/untangle")" != "$repo_dir/untangle" ]]; then
    problems="${problems}symlink target is $(readlink "$wt/untangle")"$'\n'
  fi
  if [[ -n "$wt" && "$(count_named copied-only.txt "$wt" "$repo_dir")" != "0" ]]; then
    problems="${problems}copied directory remained"$'\n'
  fi
  if [[ ! -f "$sentinel" ]]; then
    problems="${problems}registered sentinel is gone"$'\n'
  fi
  if [[ "$count" != "1" ]]; then
    problems="${problems}expected the probe once, got $count"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}run wrote notes/261014.md"$'\n'
  fi
  if ! yaml_expect "$repo_dir/untangle/config.yml" "progress_pid=absent"; then
    problems="${problems}run left progress_pid set"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_existing_untangle_symlink_is_left() {
  local test_name="an existing untangle symlink to the registered directory is left in place"
  local config_dir="$TEST_ROOT/run-link-config"
  local repo_dir="$TEST_ROOT/run-link-repo"
  local log="$TEST_ROOT/run-link-log"
  local herdr_log="$TEST_ROOT/run-link-herdr"
  local out_file="$TEST_ROOT/run-link-out.txt"
  local sentinel="$repo_dir/untangle/durable-sentinel.txt"
  local status wt before after problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  printf '%s\n' 'durable sentinel' >"$sentinel"
  use_probe_stub "$log"
  RUN_PROBE_STATUS=0
  RUN_HERDR_LOG=$herdr_log
  RUN_HERDR_PLANT=symlink

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  wt=$(worktree_from_output "$out_file" "$repo_dir")
  before=$(cat "${herdr_log}.symlink-inode" 2>/dev/null || true)

  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ -z "$wt" || ! -L "$wt/untangle" ]]; then
    problems="${problems}worktree untangle is not a symlink (${wt})"$'\n'
  else
    after=$(link_inode "$wt/untangle")
    if [[ "$(readlink "$wt/untangle")" != "$repo_dir/untangle" ]]; then
      problems="${problems}symlink target is $(readlink "$wt/untangle")"$'\n'
    fi
    if [[ -L "$repo_dir/untangle" ]]; then
      problems="${problems}registered untangle became a symlink"$'\n'
    fi
    if [[ -z "$before" || "$before" != "$after" ]]; then
      problems="${problems}symlink was replaced (before=$before after=$after)"$'\n'
    fi
    if [[ -d "$wt/untangle" && ! -L "$wt/untangle" ]]; then
      problems="${problems}worktree untangle is a copied directory"$'\n'
    fi
  fi
  if [[ ! -f "$sentinel" ]]; then
    problems="${problems}registered sentinel is gone"$'\n'
  fi
  if [[ "$(count_named durable-sentinel.txt "$repo_dir")" != "1" ]]; then
    problems="${problems}sentinel is not only in the registered tree"$'\n'
  fi
  if [[ "$(path_count_in_log "$log" "$repo_dir")" != "1" ]]; then
    problems="${problems}expected the probe once"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}run wrote notes/261014.md"$'\n'
  fi
  if ! yaml_expect "$repo_dir/untangle/config.yml" "progress_pid=absent"; then
    problems="${problems}run left progress_pid set"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_write_through_link_lands_in_registered_dir() {
  local test_name="a write through the worktree untangle symlink lands in the registered directory"
  local config_dir="$TEST_ROOT/run-memory-config"
  local repo_dir="$TEST_ROOT/run-memory-repo"
  local log="$TEST_ROOT/run-memory-log"
  local out_file="$TEST_ROOT/run-memory-out.txt"
  local registered="$repo_dir/untangle"
  local marker="through-the-link.txt"
  local wt target registered_phys worktree_phys status agents_before agents_after problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  use_probe_stub "$log"
  RUN_PROBE_STATUS=0
  RUN_HERDR_PLANT=copy
  agents_before=$(path_agent_invocations)

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  agents_after=$(path_agent_invocations)
  wt=$(worktree_from_output "$out_file" "$repo_dir")

  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ "$agents_after" != "$agents_before" ]]; then
    problems="${problems}run executed a PATH agent"$'\n'
  fi
  if [[ "$(path_count_in_log "$log" "$repo_dir")" != "1" ]]; then
    problems="${problems}expected the probe once"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}run wrote notes/261014.md"$'\n'
  fi
  if ! yaml_expect "$repo_dir/untangle/config.yml" "progress_pid=absent"; then
    problems="${problems}run left progress_pid set"$'\n'
  fi
  if [[ -z "$wt" || ! -d "$wt" ]]; then
    problems="${problems}printed worktree is missing: ${wt}"$'\n'
  elif [[ ! -L "$wt/untangle" ]]; then
    problems="${problems}worktree untangle is not a symlink"$'\n'
  else
    target=$(readlink "$wt/untangle")
    if [[ "$target" != "$registered" ]]; then
      problems="${problems}symlink target is ${target}"$'\n'
    fi
    printf '%s\n' 'through the link' >"$wt/untangle/$marker"
    if [[ ! -L "$wt/untangle" ]]; then
      problems="${problems}worktree untangle stopped being a symlink after the write"$'\n'
    fi
    if [[ ! -f "$registered/$marker" ]]; then
      problems="${problems}write through the symlink is missing from the registered directory"$'\n'
    elif ! grep -F -x -q -- 'through the link' "$registered/$marker"; then
      problems="${problems}registered file does not contain the write"$'\n'
    fi
    if [[ -L "$registered" ]]; then
      problems="${problems}registered untangle is a symlink"$'\n'
    fi
    registered_phys=$(CDPATH= cd "$registered" && pwd -P) || registered_phys=""
    worktree_phys=$(CDPATH= cd "$wt" && pwd -P) || worktree_phys=""
    if [[ -z "$registered_phys" || -z "$worktree_phys" ]]; then
      problems="${problems}could not resolve the registered directory or the worktree"$'\n'
    else
      case "$registered_phys/" in
        "$worktree_phys"/*)
          problems="${problems}registered untangle sits inside the worktree (${registered_phys})"$'\n'
          ;;
      esac
    fi
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_bad_trunk_does_not_fetch() {
  local test_name="trunk ../main does not fetch, does not probe, and retries"
  local config_dir="$TEST_ROOT/run-bad-trunk-config"
  local repo_dir="$TEST_ROOT/run-bad-trunk-repo"
  local log="$TEST_ROOT/run-bad-trunk-log"
  local herdr_log="$TEST_ROOT/run-bad-trunk-herdr"
  local out_file="$TEST_ROOT/run-bad-trunk-out.txt"
  local old new stale after problems=""
  local status count

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  old=$(git -C "$repo_dir" rev-parse origin/main)
  new=$(advance_bare_branch "$repo_dir" main) || {
    fail "$test_name" "could not advance origin/main"
    return
  }
  stale=$(git -C "$repo_dir" rev-parse origin/main)
  if [[ "$stale" != "$old" || "$new" == "$old" ]]; then
    fail "$test_name" "origin/main was not stale before the run (old=$old new=$new stale=$stale)"
    return
  fi
  yaml_set_trunk "$repo_dir/untangle/config.yml" "../main"
  use_probe_stub "$log"
  RUN_PROBE_STATUS=0
  RUN_HERDR_LOG=$herdr_log

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  after=$(git -C "$repo_dir" rev-parse origin/main)

  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ "$after" != "$old" ]]; then
    problems="${problems}fetch ran (origin/main moved from $old to $after)"$'\n'
  fi
  if [[ -s "$herdr_log" ]]; then
    problems="${problems}bad trunk called herdr"$'\n'"$(cat "$herdr_log")"'\n'
  fi
  if [[ "$count" != "0" ]]; then
    problems="${problems}bad trunk invoked the probe, count=$count"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}bad trunk wrote notes/261014.md"$'\n'
  fi
  if ! yaml_expect "$repo_dir/untangle/config.yml" "progress_pid=absent"; then
    problems="${problems}bad trunk left progress_pid set"$'\n'
  fi
  if ! yaml_expect "$repo_dir/untangle/config.yml" "trunk=str:../main"; then
    problems="${problems}bad trunk rewrote config"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: skip ${repo_dir} — delivery failed; the next tick retries" "$out_file"; then
    problems="${problems}bad trunk did not say delivery failed and the next tick retries"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_yaml_helpers_cursor_note_and_open_plan() {
  local test_name="yaml helpers report the cursor bucket, the note word, and an open plan path"
  local dir="$TEST_ROOT/yaml-helpers"
  local missing="$dir/missing.yml"
  local blank="$dir/blank.yml"
  local ownership="$dir/ownership.yml"
  local nope="$dir/nope.yml"
  local lower="$dir/lower.yml"
  local note_plan="$dir/plan.md"
  local note_quiet="$dir/quiet.md"
  local note_planning="$dir/planning.md"
  local note_plan_case="$dir/plan-case.md"
  local note_quiet_dot="$dir/quiet-dot.md"
  local note_padded="$dir/padded.md"
  local note_empty="$dir/empty.md"
  local kept="$dir/kept.yml"
  local got status problems=""

  mkdir -p "$dir"
  printf '%s\n' '---' 'version: 1' "trunk: ''" >"$blank"
  printf '%s\n' 'cursor: ""' >>"$blank"
  printf '%s\n' '---' 'version: 1' "trunk: ''" 'cursor: Ownership' >"$ownership"
  printf '%s\n' '---' 'cursor: Nope' >"$nope"
  printf '%s\n' '---' 'cursor: language' >"$lower"
  printf '%s\n' 'plan' 'one knot' >"$note_plan"
  printf '%s\n' 'quiet' 'looked' >"$note_quiet"
  printf '%s\n' 'planning' 'not a word' >"$note_planning"
  printf '%s\n' 'Plan' 'wrong case' >"$note_plan_case"
  printf '%s\n' 'quiet.' 'punctuation' >"$note_quiet_dot"
  printf '%s\n' '  plan' 'padded' >"$note_padded"
  : >"$note_empty"
  cp "$ownership" "$kept"

  got=$(ruby_untangle cursor_bucket "$missing")
  status=$?
  if [[ "$status" -ne 0 || "$got" != "Language" ]]; then
    problems="${problems}missing cursor expected Language, status=$status got=$got"$'\n'
  fi
  got=$(ruby_untangle cursor_bucket "$blank")
  status=$?
  if [[ "$status" -ne 0 || "$got" != "Language" ]]; then
    problems="${problems}blank cursor expected Language, status=$status got=$got"$'\n'
  fi
  got=$(ruby_untangle cursor_bucket "$ownership")
  status=$?
  if [[ "$status" -ne 0 || "$got" != "Ownership" ]]; then
    problems="${problems}Ownership cursor expected Ownership, status=$status got=$got"$'\n'
  fi
  got=$(ruby_untangle cursor_bucket "$nope")
  status=$?
  if [[ "$status" -ne 0 || "$got" != "invalid" ]]; then
    problems="${problems}Nope cursor expected invalid, status=$status got=$got"$'\n'
  fi
  got=$(ruby_untangle cursor_bucket "$lower")
  status=$?
  if [[ "$status" -ne 0 || "$got" != "invalid" ]]; then
    problems="${problems}lowercase language expected invalid, status=$status got=$got"$'\n'
  fi

  got=$(ruby_untangle note_word "$note_plan")
  status=$?
  if [[ "$status" -ne 0 || "$got" != "plan" ]]; then
    problems="${problems}note_word plan expected plan, status=$status got=$got"$'\n'
  fi
  got=$(ruby_untangle note_word "$note_quiet")
  status=$?
  if [[ "$status" -ne 0 || "$got" != "quiet" ]]; then
    problems="${problems}note_word quiet expected quiet, status=$status got=$got"$'\n'
  fi
  got=$(ruby_untangle note_word "$note_planning")
  status=$?
  if [[ "$status" -ne 0 || -n "$got" ]]; then
    problems="${problems}note_word planning expected empty, status=$status got=$got"$'\n'
  fi
  got=$(ruby_untangle note_word "$note_plan_case")
  status=$?
  if [[ "$status" -ne 0 || -n "$got" ]]; then
    problems="${problems}note_word Plan expected empty, status=$status got=$got"$'\n'
  fi
  got=$(ruby_untangle note_word "$note_quiet_dot")
  status=$?
  if [[ "$status" -ne 0 || -n "$got" ]]; then
    problems="${problems}note_word quiet. expected empty, status=$status got=$got"$'\n'
  fi
  got=$(ruby_untangle note_word "$note_padded")
  status=$?
  if [[ "$status" -ne 0 || "$got" != "plan" ]]; then
    problems="${problems}note_word padded plan expected plan, status=$status got=$got"$'\n'
  fi
  got=$(ruby_untangle note_word "$note_empty")
  status=$?
  if [[ "$status" -ne 0 || -n "$got" ]]; then
    problems="${problems}note_word empty file expected empty, status=$status got=$got"$'\n'
  fi
  got=$(ruby_untangle note_word "$dir/missing-note.md")
  status=$?
  if [[ "$status" -ne 0 || -n "$got" ]]; then
    problems="${problems}note_word missing file expected empty, status=$status got=$got"$'\n'
  fi

  ruby_untangle set_open_plan "$kept" "$dir/notes/261014.md"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}set_open_plan exited $status"$'\n'
  fi
  if ! yaml_expect "$kept" "version=int:1"; then
    problems="${problems}set_open_plan dropped version"$'\n'
  fi
  if ! yaml_expect "$kept" "trunk=blank"; then
    problems="${problems}set_open_plan dropped the blank trunk"$'\n'
  fi
  if ! yaml_expect "$kept" "cursor=str:Ownership"; then
    problems="${problems}set_open_plan dropped cursor"$'\n'
  fi
  if ! yaml_expect "$kept" "open_plan=str:${dir}/notes/261014.md"; then
    problems="${problems}set_open_plan did not store the absolute note path"$'\n'
  fi

  local next="$dir/next.yml"
  local removal="$dir/removal.yml"
  local bare="$dir/bare.yml"
  cp "$ownership" "$next"
  printf '%s\n' '---' 'version: 1' "trunk: ''" 'cursor: Removal' >"$removal"
  printf '%s\n' '---' 'version: 1' "trunk: ''" >"$bare"

  ruby_untangle advance_cursor "$next"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}advance_cursor from Ownership exited $status"$'\n'
  fi
  if ! yaml_expect "$next" "cursor=str:Boundaries"; then
    problems="${problems}advance_cursor from Ownership did not write Boundaries"$'\n'
  fi
  if ! yaml_expect "$next" "version=int:1"; then
    problems="${problems}advance_cursor dropped version"$'\n'
  fi
  if ! yaml_expect "$next" "trunk=blank"; then
    problems="${problems}advance_cursor dropped the blank trunk"$'\n'
  fi
  if ! yaml_expect "$next" "open_plan=absent"; then
    problems="${problems}advance_cursor set open_plan"$'\n'
  fi

  ruby_untangle advance_cursor "$removal"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}advance_cursor from Removal exited $status"$'\n'
  fi
  if ! yaml_expect "$removal" "cursor=str:Language"; then
    problems="${problems}advance_cursor from Removal did not wrap to Language"$'\n'
  fi
  if ! yaml_expect "$removal" "version=int:1"; then
    problems="${problems}advance_cursor from Removal dropped version"$'\n'
  fi
  if ! yaml_expect "$removal" "trunk=blank"; then
    problems="${problems}advance_cursor from Removal dropped the blank trunk"$'\n'
  fi

  ruby_untangle advance_cursor "$bare"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}advance_cursor from a missing cursor exited $status"$'\n'
  fi
  if ! yaml_expect "$bare" "cursor=str:Ownership"; then
    problems="${problems}advance_cursor from a missing cursor did not write Ownership"$'\n'
  fi
  if ! yaml_expect "$bare" "version=int:1"; then
    problems="${problems}advance_cursor from a missing cursor dropped version"$'\n'
  fi
  if ! yaml_expect "$bare" "trunk=blank"; then
    problems="${problems}advance_cursor from a missing cursor dropped the blank trunk"$'\n'
  fi

  ruby_untangle clear_open_plan "$kept"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}clear_open_plan exited $status"$'\n'
  fi
  if ! yaml_expect "$kept" "open_plan=absent"; then
    problems="${problems}clear_open_plan left open_plan set"$'\n'
  fi
  if ! yaml_expect "$kept" "cursor=str:Ownership"; then
    problems="${problems}clear_open_plan changed the cursor"$'\n'
  fi
  if ! yaml_expect "$kept" "version=int:1"; then
    problems="${problems}clear_open_plan dropped version"$'\n'
  fi
  if ! yaml_expect "$kept" "trunk=blank"; then
    problems="${problems}clear_open_plan dropped the blank trunk"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems"
    return
  fi
  pass "$test_name"
}

test_run_plan_note_records_open_plan_and_later_wednesdays_skip() {
  local test_name="a plan note records the open plan and later Wednesdays skip"
  local config_dir="$TEST_ROOT/run-plan-config"
  local repo_dir="$TEST_ROOT/run-plan-repo"
  local out_file="$TEST_ROOT/run-plan-out.txt"
  local record="$TEST_ROOT/run-plan-record"
  local herdr_log="$TEST_ROOT/run-plan-herdr.log"
  local later_herdr="$TEST_ROOT/run-plan-herdr-later.log"
  local note_src="$TEST_ROOT/run-plan-note-src.md"
  local log_src="$TEST_ROOT/run-plan-log-src.md"
  local prompt_file="$TEST_ROOT/run-plan-prompt.txt"
  local note="$repo_dir/untangle/notes/261014.md"
  local log_file="$repo_dir/untangle/log.md"
  local repo_yml head_before wt cwd herdr_before herdr_after
  local old new stale after status problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  repo_yml="$repo_dir/untangle/config.yml"
  write_plan_note "$note_src"
  write_agent_log "$log_src"
  write_expected_prompt "$prompt_file" "$repo_dir" "261014" "Language"
  use_agent_mock "$record"
  RUN_AGENT_NOTE=$note
  RUN_AGENT_NOTE_SRC=$note_src
  RUN_AGENT_LOG_FILE=$log_file
  RUN_AGENT_LOG_SRC=$log_src
  RUN_HERDR_LOG=$herdr_log
  head_before=$(git -C "$repo_dir" rev-parse HEAD)

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  wt=$(worktree_from_output "$out_file" "$repo_dir")
  cwd=$(cat "$record/cwd-1" 2>/dev/null || true)
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}first run expected exit 0, got $status"$'\n'
  fi
  if [[ "$(agent_invocation_count "$record")" != "1" ]]; then
    problems="${problems}first run expected the agent once"$'\n'
  fi
  if [[ -z "$wt" || ! -d "$wt" || "$cwd" != "$wt" ]]; then
    problems="${problems}agent cwd is not the delivered worktree (cwd=$cwd worktree=$wt)"$'\n'
  fi
  if [[ "$cwd" == "$repo_dir" ]]; then
    problems="${problems}agent started in the registered checkout"$'\n'
  fi
  if [[ "$(cat "$record/argc-1" 2>/dev/null || true)" != "2" ]]; then
    problems="${problems}agent argc is not 2"$'\n'
  fi
  if [[ "$(cat "$record/arg-1-0" 2>/dev/null || true)" != "-p" ]]; then
    problems="${problems}agent argv does not start with -p"$'\n'
  fi
  if [[ -e "$record/arg-1-2" ]]; then
    problems="${problems}agent received an extra argument"$'\n'
  fi
  if [[ ! -f "$record/arg-1-1" ]]; then
    problems="${problems}agent prompt was not recorded"$'\n'
  else
    if ! grep -F -q -- 'for the bucket Language only' "$record/arg-1-1"; then
      problems="${problems}prompt does not name the Language bucket"$'\n'
    fi
    if ! grep -F -q -- 'A plan names one knot, why the next change is expensive, a completion condition, and behavior-preserving steps.' "$record/arg-1-1"; then
      problems="${problems}prompt is missing the plan sentence"$'\n'
    fi
    if ! grep -F -q -- 'A quiet note says what was looked at and why nothing is ready.' "$record/arg-1-1"; then
      problems="${problems}prompt is missing the quiet sentence"$'\n'
    fi
    if ! grep -F -q -- 'code read' "$record/arg-1-1"; then
      problems="${problems}prompt does not mention a code read"$'\n'
    fi
    if ! files_match "$prompt_file" "$record/arg-1-1"; then
      problems="${problems}agent prompt mismatch"$'\n'"$(diff -u "$prompt_file" "$record/arg-1-1" || true)"$'\n'
    fi
  fi
  if ! files_match "$note_src" "$note"; then
    problems="${problems}plan note bytes were not kept"$'\n'
  fi
  if ! grep -F -q -- 'Knot: the checkout client name.' "$note"; then
    problems="${problems}plan note does not name one knot"$'\n'
  fi
  if ! grep -F -q -- 'The next change is expensive because both generations are still called.' "$note"; then
    problems="${problems}plan note does not say why the next change is expensive"$'\n'
  fi
  if ! grep -F -q -- 'Completion condition: one name remains and callers still pass.' "$note"; then
    problems="${problems}plan note does not name a completion condition"$'\n'
  fi
  if ! grep -F -q -- 'Behavior-preserving steps: rename one caller at a time.' "$note"; then
    problems="${problems}plan note does not name behavior-preserving steps"$'\n'
  fi
  if ! files_match "$log_src" "$log_file"; then
    problems="${problems}agent log bytes were not kept"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "open_plan=str:${note}"; then
    problems="${problems}open_plan is not the absolute note path"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "cursor=absent"; then
    problems="${problems}plan note wrote a cursor"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "version=int:1"; then
    problems="${problems}plan note dropped version"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "trunk=blank"; then
    problems="${problems}plan note dropped the blank trunk"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "progress_pid=absent"; then
    problems="${problems}plan note left progress_pid set"$'\n'
  fi
  if [[ "$(git -C "$repo_dir" rev-parse HEAD)" != "$head_before" ]]; then
    problems="${problems}HEAD changed"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: ${repo_dir} — open plan" "$out_file"; then
    problems="${problems}first run did not say open plan"$'\n'
  fi

  cp "$note" "$TEST_ROOT/run-plan-note-kept.md"
  cp "$repo_yml" "$TEST_ROOT/run-plan-config-kept.yml"
  cp "$log_file" "$TEST_ROOT/run-plan-log-kept.md"
  herdr_before=$(wc -l <"$herdr_log" | tr -d '[:space:]')
  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  herdr_after=$(wc -l <"$herdr_log" | tr -d '[:space:]')
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}same Wednesday expected exit 0, got $status"$'\n'
  fi
  if [[ "$(agent_invocation_count "$record")" != "1" ]]; then
    problems="${problems}same Wednesday started the agent"$'\n'
  fi
  if [[ "$herdr_after" != "$herdr_before" ]]; then
    problems="${problems}same Wednesday called herdr"$'\n'
  fi
  if ! files_match "$TEST_ROOT/run-plan-note-kept.md" "$note"; then
    problems="${problems}same Wednesday changed the note"$'\n'
  fi
  if ! files_match "$TEST_ROOT/run-plan-config-kept.yml" "$repo_yml"; then
    problems="${problems}same Wednesday changed repo config"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: skip ${repo_dir} — open plan" "$out_file"; then
    problems="${problems}same Wednesday did not skip for the open plan"$'\n'
  fi

  old=$(git -C "$repo_dir" rev-parse origin/main)
  new=$(advance_bare_branch "$repo_dir" main) || {
    fail "$test_name" "could not advance origin/main" "$problems"
    return
  }
  stale=$(git -C "$repo_dir" rev-parse origin/main)
  if [[ "$stale" != "$old" || "$new" == "$old" ]]; then
    fail "$test_name" "origin/main was not stale before the later run (old=$old new=$new stale=$stale)" "$problems"
    return
  fi
  RUN_HERDR_LOG=$later_herdr
  invoke_run "$config_dir" "2026-10-21T10:00:00" "$out_file"
  status=$?
  after=$(git -C "$repo_dir" rev-parse origin/main)
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}2026-10-21 expected exit 0, got $status"$'\n'
  fi
  if [[ "$after" != "$old" ]]; then
    problems="${problems}2026-10-21 fetched (origin/main moved from $old to $after)"$'\n'
  fi
  if [[ -s "$later_herdr" ]]; then
    problems="${problems}2026-10-21 called herdr"$'\n'"$(cat "$later_herdr")"'\n'
  fi
  if [[ "$(agent_invocation_count "$record")" != "1" ]]; then
    problems="${problems}2026-10-21 started the agent"$'\n'
  fi
  if ! files_match "$TEST_ROOT/run-plan-note-kept.md" "$note"; then
    problems="${problems}2026-10-21 changed the note"$'\n'
  fi
  if ! files_match "$TEST_ROOT/run-plan-config-kept.yml" "$repo_yml"; then
    problems="${problems}2026-10-21 changed open_plan or another config key"$'\n'
  fi
  if ! files_match "$TEST_ROOT/run-plan-log-kept.md" "$log_file"; then
    problems="${problems}2026-10-21 changed the log"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: skip ${repo_dir} — open plan" "$out_file"; then
    problems="${problems}2026-10-21 did not skip for the open plan"$'\n'
  fi

  local status_out="$TEST_ROOT/run-plan-status-out.txt"
  local status_err="$TEST_ROOT/run-plan-status-err.txt"
  local done_out="$TEST_ROOT/run-plan-done-out.txt"
  local done_err="$TEST_ROOT/run-plan-done-err.txt"
  local status_expected="$TEST_ROOT/run-plan-status-expected.txt"

  invoke_in_repo "$repo_dir" status "$status_out" "$status_err"
  status=$?
  printf '%s\n' "cursor: Language" "open plan: ${note}" >"$status_expected"
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}status expected exit 0, got $status"$'\n'"$(cat "$status_err")"$'\n'
  fi
  if [[ -s "$status_err" ]]; then
    problems="${problems}status wrote to stderr"$'\n'"$(cat "$status_err")"$'\n'
  fi
  if ! files_match "$status_expected" "$status_out"; then
    problems="${problems}status output mismatch"$'\n'"$(cat "$status_out")"$'\n'
  fi
  if ! files_match "$TEST_ROOT/run-plan-config-kept.yml" "$repo_yml"; then
    problems="${problems}status changed repo config"$'\n'
  fi

  # The plan left the cursor absent, whose successor is Ownership. Move to
  # Ownership first so done has to follow the list, not store that successor.
  yaml_set_key "$repo_yml" cursor Ownership

  invoke_in_repo "$repo_dir" done "$done_out" "$done_err"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}done expected exit 0, got $status"$'\n'"$(cat "$done_err")"$'\n'
  fi
  if [[ -s "$done_out" || -s "$done_err" ]]; then
    problems="${problems}done wrote output"$'\n'"$(cat "$done_out")"$'\n'"$(cat "$done_err")"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "open_plan=absent"; then
    problems="${problems}done left open_plan set"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "cursor=str:Boundaries"; then
    problems="${problems}done left the cursor off Boundaries"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "version=int:1"; then
    problems="${problems}done dropped version"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "trunk=blank"; then
    problems="${problems}done dropped the blank trunk"$'\n'
  fi
  if [[ -e "$TEST_ROOT/not-the-registry/config.yml" ]]; then
    problems="${problems}done wrote the registry"$'\n'
  fi

  invoke_in_repo "$repo_dir" status "$status_out" "$status_err"
  status=$?
  printf '%s\n' "cursor: Boundaries" >"$status_expected"
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}status after done expected exit 0, got $status"$'\n'"$(cat "$status_err")"$'\n'
  fi
  if [[ -s "$status_err" ]]; then
    problems="${problems}status after done wrote to stderr"$'\n'"$(cat "$status_err")"$'\n'
  fi
  if ! files_match "$status_expected" "$status_out"; then
    problems="${problems}status after done output mismatch"$'\n'"$(cat "$status_out")"$'\n'
  fi

  invoke_in_repo "$repo_dir" done "$done_out" "$done_err"
  status=$?
  if [[ "$status" -eq 0 ]]; then
    problems="${problems}second done exited 0"$'\n'
  fi
  if ! grep -F -q -- 'untangle: error: no open plan' "$done_err"; then
    problems="${problems}second done did not report no open plan"$'\n'"$(cat "$done_err")"$'\n'
  fi
  if [[ -s "$done_out" ]]; then
    problems="${problems}second done wrote to stdout"$'\n'"$(cat "$done_out")"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "cursor=str:Boundaries"; then
    problems="${problems}second done changed the cursor"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "open_plan=absent"; then
    problems="${problems}second done set open_plan"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_quiet_note_stamps_the_week_and_the_next_wednesday_runs() {
  local test_name="a quiet note stamps the week and the next Wednesday runs again"
  local config_dir="$TEST_ROOT/run-quiet-config"
  local repo_dir="$TEST_ROOT/run-quiet-repo"
  local out_file="$TEST_ROOT/run-quiet-out.txt"
  local record="$TEST_ROOT/run-quiet-record"
  local note_src="$TEST_ROOT/run-quiet-note-src.md"
  local log_src="$TEST_ROOT/run-quiet-log-src.md"
  local note="$repo_dir/untangle/notes/261014.md"
  local next_note="$repo_dir/untangle/notes/261021.md"
  local log_file="$repo_dir/untangle/log.md"
  local repo_yml wt cwd status problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  repo_yml="$repo_dir/untangle/config.yml"
  write_quiet_note "$note_src"
  write_agent_log "$log_src"
  use_agent_mock "$record"
  RUN_AGENT_NOTE=$note
  RUN_AGENT_NOTE_SRC=$note_src
  RUN_AGENT_LOG_FILE=$log_file
  RUN_AGENT_LOG_SRC=$log_src

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}first run expected exit 0, got $status"$'\n'
  fi
  if [[ "$(agent_invocation_count "$record")" != "1" ]]; then
    problems="${problems}first run expected the agent once"$'\n'
  fi
  if ! files_match "$note_src" "$note"; then
    problems="${problems}quiet note bytes were not kept"$'\n'
  fi
  if ! grep -F -q -- 'Looked at the checkout names.' "$note"; then
    problems="${problems}quiet note does not say what was looked at"$'\n'
  fi
  if ! grep -F -q -- 'Nothing is ready because no single knot is worth the change.' "$note"; then
    problems="${problems}quiet note does not say why nothing is ready"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "open_plan=absent"; then
    problems="${problems}quiet note set open_plan"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "cursor=str:Ownership"; then
    problems="${problems}quiet note left the cursor off Ownership"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "version=int:1"; then
    problems="${problems}quiet note dropped version"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "trunk=blank"; then
    problems="${problems}quiet note dropped the blank trunk"$'\n'
  fi
  if [[ ! -f "$record/arg-1-1" ]] || ! grep -F -q -- 'for the bucket Language only' "$record/arg-1-1"; then
    problems="${problems}first prompt does not name the Language bucket"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: ${repo_dir} — quiet note" "$out_file"; then
    problems="${problems}first run did not say quiet note"$'\n'
  fi

  cp "$note" "$TEST_ROOT/run-quiet-note-kept.md"
  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}same Wednesday expected exit 0, got $status"$'\n'
  fi
  if [[ "$(agent_invocation_count "$record")" != "1" ]]; then
    problems="${problems}same Wednesday started the agent"$'\n'
  fi
  if ! files_match "$TEST_ROOT/run-quiet-note-kept.md" "$note"; then
    problems="${problems}same Wednesday changed the quiet note"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: skip ${repo_dir} — week already stamped" "$out_file"; then
    problems="${problems}same Wednesday did not skip for the stamp"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "cursor=str:Ownership"; then
    problems="${problems}same Wednesday changed the cursor"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "open_plan=absent"; then
    problems="${problems}same Wednesday set open_plan"$'\n'
  fi

  RUN_AGENT_NOTE=$next_note
  invoke_run "$config_dir" "2026-10-21T10:00:00" "$out_file"
  status=$?
  wt=$(worktree_from_output "$out_file" "$repo_dir")
  cwd=$(cat "$record/cwd-2" 2>/dev/null || true)
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}2026-10-21 expected exit 0, got $status"$'\n'
  fi
  if [[ "$(agent_invocation_count "$record")" != "2" ]]; then
    problems="${problems}2026-10-21 did not start the agent again"$'\n'
  fi
  if [[ -z "$wt" || "$cwd" != "$wt" ]]; then
    problems="${problems}2026-10-21 agent cwd is not the worktree (cwd=$cwd worktree=$wt)"$'\n'
  fi
  if [[ ! -f "$record/arg-2-1" ]] || ! grep -F -q -- 'for the bucket Ownership only' "$record/arg-2-1"; then
    problems="${problems}2026-10-21 prompt does not name the Ownership bucket"$'\n'
  fi
  if [[ ! -f "$record/arg-2-1" ]] || ! grep -F -q -- "$next_note" "$record/arg-2-1"; then
    problems="${problems}2026-10-21 prompt does not name notes/261021.md"$'\n'
  fi
  if ! files_match "$note_src" "$next_note"; then
    problems="${problems}2026-10-21 quiet note was not kept"$'\n'
  fi
  if ! files_match "$TEST_ROOT/run-quiet-note-kept.md" "$note"; then
    problems="${problems}2026-10-21 changed the previous quiet note"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "open_plan=absent"; then
    problems="${problems}2026-10-21 set open_plan"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "cursor=str:Boundaries"; then
    problems="${problems}2026-10-21 left the cursor off Boundaries"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "version=int:1"; then
    problems="${problems}2026-10-21 dropped version"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "trunk=blank"; then
    problems="${problems}2026-10-21 dropped the blank trunk"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: ${repo_dir} — quiet note" "$out_file"; then
    problems="${problems}2026-10-21 did not say quiet note"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_ownership_cursor_stays_after_plan_note() {
  local test_name="an Ownership cursor stays Ownership after a plan note"
  local config_dir="$TEST_ROOT/run-own-config"
  local repo_dir="$TEST_ROOT/run-own-repo"
  local out_file="$TEST_ROOT/run-own-out.txt"
  local record="$TEST_ROOT/run-own-record"
  local note_src="$TEST_ROOT/run-own-note-src.md"
  local log_src="$TEST_ROOT/run-own-log-src.md"
  local prompt_file="$TEST_ROOT/run-own-prompt.txt"
  local note="$repo_dir/untangle/notes/261014.md"
  local log_file="$repo_dir/untangle/log.md"
  local repo_yml status problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  repo_yml="$repo_dir/untangle/config.yml"
  yaml_set_key "$repo_yml" cursor Ownership
  write_plan_note "$note_src"
  write_agent_log "$log_src"
  write_expected_prompt "$prompt_file" "$repo_dir" "261014" "Ownership"
  use_agent_mock "$record"
  RUN_AGENT_NOTE=$note
  RUN_AGENT_NOTE_SRC=$note_src
  RUN_AGENT_LOG_FILE=$log_file
  RUN_AGENT_LOG_SRC=$log_src

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ "$(agent_invocation_count "$record")" != "1" ]]; then
    problems="${problems}expected the agent once"$'\n'
  fi
  if [[ ! -f "$record/arg-1-1" ]]; then
    problems="${problems}agent prompt was not recorded"$'\n'
  else
    if ! grep -F -q -- 'for the bucket Ownership only' "$record/arg-1-1"; then
      problems="${problems}prompt does not name the Ownership bucket"$'\n'
    fi
    if ! files_match "$prompt_file" "$record/arg-1-1"; then
      problems="${problems}agent prompt mismatch"$'\n'"$(diff -u "$prompt_file" "$record/arg-1-1" || true)"$'\n'
    fi
  fi
  if ! files_match "$note_src" "$note"; then
    problems="${problems}plan note bytes were not kept"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "cursor=str:Ownership"; then
    problems="${problems}cursor is no longer Ownership"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "open_plan=str:${note}"; then
    problems="${problems}open_plan is not the absolute note path"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "version=int:1"; then
    problems="${problems}plan note dropped version"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "trunk=blank"; then
    problems="${problems}plan note dropped the blank trunk"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: ${repo_dir} — open plan" "$out_file"; then
    problems="${problems}did not say open plan"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_rejects_plan_case_and_planning_then_keeps_a_plan() {
  local test_name="Plan and planning notes are rejected and a later plan note is kept"
  local config_dir="$TEST_ROOT/run-reject-config"
  local repo_dir="$TEST_ROOT/run-reject-repo"
  local out_file="$TEST_ROOT/run-reject-out.txt"
  local record="$TEST_ROOT/run-reject-record"
  local plan_src="$TEST_ROOT/run-reject-plan.md"
  local case_src="$TEST_ROOT/run-reject-case.md"
  local prefix_src="$TEST_ROOT/run-reject-prefix.md"
  local log_src="$TEST_ROOT/run-reject-log.md"
  local note="$repo_dir/untangle/notes/261014.md"
  local log_file="$repo_dir/untangle/log.md"
  local repo_yml status problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  repo_yml="$repo_dir/untangle/config.yml"
  write_opening_note "$case_src" "Plan"
  write_opening_note "$prefix_src" "planning"
  write_plan_note "$plan_src"
  write_agent_log "$log_src"
  use_agent_mock "$record"
  RUN_AGENT_NOTE=$note
  RUN_AGENT_NOTE_SRC=$case_src
  RUN_AGENT_LOG_FILE=$log_file
  RUN_AGENT_LOG_SRC=$log_src

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}Plan tick expected exit 0, got $status"$'\n'
  fi
  if [[ "$(agent_invocation_count "$record")" != "1" ]]; then
    problems="${problems}Plan tick expected the agent once"$'\n'
  fi
  if [[ -e "$note" ]]; then
    problems="${problems}Plan note was kept"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "open_plan=absent"; then
    problems="${problems}Plan note set open_plan"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: ${repo_dir} — note rejected; the week is unstamped" "$out_file"; then
    problems="${problems}Plan tick did not reject the note"$'\n'
  fi

  RUN_AGENT_NOTE_SRC=$prefix_src
  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}planning tick expected exit 0, got $status"$'\n'
  fi
  if [[ "$(agent_invocation_count "$record")" != "2" ]]; then
    problems="${problems}planning tick did not start the agent"$'\n'
  fi
  if [[ -e "$note" ]]; then
    problems="${problems}planning note was kept"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "open_plan=absent"; then
    problems="${problems}planning note set open_plan"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: ${repo_dir} — note rejected; the week is unstamped" "$out_file"; then
    problems="${problems}planning tick did not reject the note"$'\n'
  fi

  RUN_AGENT_NOTE_SRC=$plan_src
  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}plan tick expected exit 0, got $status"$'\n'
  fi
  if [[ "$(agent_invocation_count "$record")" != "3" ]]; then
    problems="${problems}plan tick did not start the agent"$'\n'
  fi
  if ! files_match "$plan_src" "$note"; then
    problems="${problems}plan note bytes were not kept"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "open_plan=str:${note}"; then
    problems="${problems}plan note did not set open_plan"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "cursor=absent"; then
    problems="${problems}plan note wrote a cursor"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: ${repo_dir} — open plan" "$out_file"; then
    problems="${problems}plan tick did not say open plan"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_agent_failure_then_quiet_note_is_not_an_open_plan() {
  local test_name="agent failure leaves the week unstamped and a later quiet note is not an open plan"
  local config_dir="$TEST_ROOT/run-fail-agent-config"
  local repo_dir="$TEST_ROOT/run-fail-agent-repo"
  local out_file="$TEST_ROOT/run-fail-agent-out.txt"
  local record="$TEST_ROOT/run-fail-agent-record"
  local note_src="$TEST_ROOT/run-fail-agent-quiet.md"
  local log_src="$TEST_ROOT/run-fail-agent-log.md"
  local note="$repo_dir/untangle/notes/261014.md"
  local log_file="$repo_dir/untangle/log.md"
  local repo_yml status problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  repo_yml="$repo_dir/untangle/config.yml"
  write_quiet_note "$note_src"
  write_agent_log "$log_src"
  use_agent_mock "$record"
  RUN_AGENT_STATUS=1

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}failed agent expected untangle exit 0, got $status"$'\n'
  fi
  if [[ "$(agent_invocation_count "$record")" != "1" ]]; then
    problems="${problems}failed agent was not started"$'\n'
  fi
  if [[ -e "$note" ]]; then
    problems="${problems}failed agent wrote a note"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "open_plan=absent"; then
    problems="${problems}failed agent set open_plan"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "progress_pid=absent"; then
    problems="${problems}failed agent left progress_pid set"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: skip ${repo_dir} — agent failed; the week is unstamped" "$out_file"; then
    problems="${problems}failed agent did not say the week is unstamped"$'\n'
  fi

  RUN_AGENT_STATUS=0
  RUN_AGENT_NOTE=$note
  RUN_AGENT_NOTE_SRC=$note_src
  RUN_AGENT_LOG_FILE=$log_file
  RUN_AGENT_LOG_SRC=$log_src
  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}quiet retry expected exit 0, got $status"$'\n'
  fi
  if [[ "$(agent_invocation_count "$record")" != "2" ]]; then
    problems="${problems}quiet retry did not start the agent"$'\n'
  fi
  if ! files_match "$note_src" "$note"; then
    problems="${problems}quiet note bytes were not kept"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "open_plan=absent"; then
    problems="${problems}quiet note set open_plan"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "cursor=str:Ownership"; then
    problems="${problems}quiet note left the cursor off Ownership"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: ${repo_dir} — quiet note" "$out_file"; then
    problems="${problems}quiet retry did not say quiet note"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_existing_open_plan_skips_without_fetch_or_agent() {
  local test_name="an existing open plan skips the run and keeps the key"
  local config_dir="$TEST_ROOT/run-open-config"
  local repo_dir="$TEST_ROOT/run-open-repo"
  local out_file="$TEST_ROOT/run-open-out.txt"
  local record="$TEST_ROOT/run-open-record"
  local herdr_log="$TEST_ROOT/run-open-herdr.log"
  local kept="$TEST_ROOT/already-open-plan.md"
  local repo_yml old new stale after status problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  repo_yml="$repo_dir/untangle/config.yml"
  yaml_set_key "$repo_yml" open_plan "$kept"
  cp "$repo_yml" "$TEST_ROOT/run-open-config-kept.yml"
  old=$(git -C "$repo_dir" rev-parse origin/main)
  new=$(advance_bare_branch "$repo_dir" main) || {
    fail "$test_name" "could not advance origin/main"
    return
  }
  stale=$(git -C "$repo_dir" rev-parse origin/main)
  if [[ "$stale" != "$old" || "$new" == "$old" ]]; then
    fail "$test_name" "origin/main was not stale before the run (old=$old new=$new stale=$stale)"
    return
  fi
  use_agent_mock "$record"
  RUN_HERDR_LOG=$herdr_log

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  after=$(git -C "$repo_dir" rev-parse origin/main)
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ "$after" != "$old" ]]; then
    problems="${problems}fetch ran (origin/main moved from $old to $after)"$'\n'
  fi
  if [[ -s "$herdr_log" ]]; then
    problems="${problems}open plan called herdr"$'\n'"$(cat "$herdr_log")"'\n'
  fi
  if [[ "$(agent_invocation_count "$record")" != "0" ]]; then
    problems="${problems}open plan started the agent"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}open plan wrote a note"$'\n'
  fi
  if ! files_match "$TEST_ROOT/run-open-config-kept.yml" "$repo_yml"; then
    problems="${problems}open plan changed repo config"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "open_plan=str:${kept}"; then
    problems="${problems}open plan key was not left in place"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: skip ${repo_dir} — open plan" "$out_file"; then
    problems="${problems}did not skip for the open plan"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_invalid_cursor_skips_before_fetch() {
  local test_name="cursor Nope skips before fetch and leaves the cursor unchanged"
  local config_dir="$TEST_ROOT/run-nope-config"
  local repo_dir="$TEST_ROOT/run-nope-repo"
  local out_file="$TEST_ROOT/run-nope-out.txt"
  local record="$TEST_ROOT/run-nope-record"
  local herdr_log="$TEST_ROOT/run-nope-herdr.log"
  local repo_yml old new stale after status problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  repo_yml="$repo_dir/untangle/config.yml"
  yaml_set_key "$repo_yml" cursor Nope
  cp "$repo_yml" "$TEST_ROOT/run-nope-config-kept.yml"
  old=$(git -C "$repo_dir" rev-parse origin/main)
  new=$(advance_bare_branch "$repo_dir" main) || {
    fail "$test_name" "could not advance origin/main"
    return
  }
  stale=$(git -C "$repo_dir" rev-parse origin/main)
  if [[ "$stale" != "$old" || "$new" == "$old" ]]; then
    fail "$test_name" "origin/main was not stale before the run (old=$old new=$new stale=$stale)"
    return
  fi
  use_agent_mock "$record"
  RUN_HERDR_LOG=$herdr_log

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  after=$(git -C "$repo_dir" rev-parse origin/main)
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ "$after" != "$old" ]]; then
    problems="${problems}fetch ran (origin/main moved from $old to $after)"$'\n'
  fi
  if [[ -s "$herdr_log" ]]; then
    problems="${problems}invalid cursor called herdr"$'\n'"$(cat "$herdr_log")"'\n'
  fi
  if [[ "$(agent_invocation_count "$record")" != "0" ]]; then
    problems="${problems}invalid cursor started the agent"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}invalid cursor wrote a note"$'\n'
  fi
  if ! files_match "$TEST_ROOT/run-nope-config-kept.yml" "$repo_yml"; then
    problems="${problems}invalid cursor rewrote config"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "cursor=str:Nope"; then
    problems="${problems}cursor is no longer Nope"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "open_plan=absent"; then
    problems="${problems}invalid cursor set open_plan"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: skip ${repo_dir} — invalid cursor; the next tick retries" "$out_file"; then
    problems="${problems}did not say invalid cursor and the next tick retries"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_removal_quiet_note_wraps_cursor_to_language() {
  local test_name="a quiet note on Removal wraps the cursor to Language"
  local config_dir="$TEST_ROOT/run-removal-config"
  local repo_dir="$TEST_ROOT/run-removal-repo"
  local out_file="$TEST_ROOT/run-removal-out.txt"
  local record="$TEST_ROOT/run-removal-record"
  local note_src="$TEST_ROOT/run-removal-note-src.md"
  local log_src="$TEST_ROOT/run-removal-log-src.md"
  local prompt_file="$TEST_ROOT/run-removal-prompt.txt"
  local note="$repo_dir/untangle/notes/261014.md"
  local log_file="$repo_dir/untangle/log.md"
  local repo_yml status problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  repo_yml="$repo_dir/untangle/config.yml"
  yaml_set_key "$repo_yml" cursor Removal
  write_quiet_note "$note_src"
  write_agent_log "$log_src"
  write_expected_prompt "$prompt_file" "$repo_dir" "261014" "Removal"
  use_agent_mock "$record"
  RUN_AGENT_NOTE=$note
  RUN_AGENT_NOTE_SRC=$note_src
  RUN_AGENT_LOG_FILE=$log_file
  RUN_AGENT_LOG_SRC=$log_src

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ "$(agent_invocation_count "$record")" != "1" ]]; then
    problems="${problems}expected the agent once"$'\n'
  fi
  if [[ ! -f "$record/arg-1-1" ]]; then
    problems="${problems}agent prompt was not recorded"$'\n'
  else
    if ! grep -F -q -- 'for the bucket Removal only' "$record/arg-1-1"; then
      problems="${problems}prompt does not name the Removal bucket"$'\n'
    fi
    if ! files_match "$prompt_file" "$record/arg-1-1"; then
      problems="${problems}agent prompt mismatch"$'\n'"$(diff -u "$prompt_file" "$record/arg-1-1" || true)"$'\n'
    fi
  fi
  if ! files_match "$note_src" "$note"; then
    problems="${problems}quiet note bytes were not kept"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "cursor=str:Language"; then
    problems="${problems}cursor did not wrap to Language"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "open_plan=absent"; then
    problems="${problems}quiet note set open_plan"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "version=int:1"; then
    problems="${problems}quiet note dropped version"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "trunk=blank"; then
    problems="${problems}quiet note dropped the blank trunk"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: ${repo_dir} — quiet note" "$out_file"; then
    problems="${problems}did not say quiet note"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_done_without_open_plan_leaves_ownership_cursor() {
  local test_name="done with no open plan leaves an Ownership cursor"
  local config_dir="$TEST_ROOT/done-none-config"
  local gitignore_file="$TEST_ROOT/done-none-gitignore"
  local repo_dir="$TEST_ROOT/done-none-repo"
  local repo_yml status_out status_err done_out done_err status problems=""
  local status_expected="$TEST_ROOT/done-none-status-expected.txt"

  mkdir -p "$config_dir"
  printf '%s\n' '# keep' >"$gitignore_file"
  make_repo "$repo_dir"
  run_init "$repo_dir" "$config_dir" "$gitignore_file" >/dev/null
  status=$?
  if [[ "$status" -ne 0 ]]; then
    fail "$test_name" "init exited $status"
    return
  fi
  repo_yml="$repo_dir/untangle/config.yml"
  yaml_set_key "$repo_yml" cursor Ownership

  status_out="$TEST_ROOT/done-none-status-out.txt"
  status_err="$TEST_ROOT/done-none-status-err.txt"
  done_out="$TEST_ROOT/done-none-done-out.txt"
  done_err="$TEST_ROOT/done-none-done-err.txt"

  invoke_in_repo "$repo_dir" done "$done_out" "$done_err"
  status=$?
  if [[ "$status" -eq 0 ]]; then
    problems="${problems}done exited 0"$'\n'
  fi
  if ! grep -F -q -- 'untangle: error: no open plan' "$done_err"; then
    problems="${problems}done did not report no open plan"$'\n'"$(cat "$done_err")"$'\n'
  fi
  if [[ -s "$done_out" ]]; then
    problems="${problems}done wrote to stdout"$'\n'"$(cat "$done_out")"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "cursor=str:Ownership"; then
    problems="${problems}done changed the cursor"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "open_plan=absent"; then
    problems="${problems}done set open_plan"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "version=int:1"; then
    problems="${problems}done dropped version"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "trunk=blank"; then
    problems="${problems}done dropped the blank trunk"$'\n'
  fi

  invoke_in_repo "$repo_dir" status "$status_out" "$status_err"
  status=$?
  printf '%s\n' "cursor: Ownership" >"$status_expected"
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}status expected exit 0, got $status"$'\n'"$(cat "$status_err")"$'\n'
  fi
  if [[ -s "$status_err" ]]; then
    problems="${problems}status wrote to stderr"$'\n'"$(cat "$status_err")"$'\n'
  fi
  if ! files_match "$status_expected" "$status_out"; then
    problems="${problems}status output mismatch"$'\n'"$(cat "$status_out")"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "cursor=str:Ownership"; then
    problems="${problems}status changed the cursor"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems"
    return
  fi
  pass "$test_name"
}

test_status_and_done_without_config_fail() {
  local test_name="status and done fail when untangle/config.yml is missing"
  local repo_dir="$TEST_ROOT/no-config-repo"
  local status_out="$TEST_ROOT/no-config-status-out.txt"
  local status_err="$TEST_ROOT/no-config-status-err.txt"
  local done_out="$TEST_ROOT/no-config-done-out.txt"
  local done_err="$TEST_ROOT/no-config-done-err.txt"
  local status problems=""

  mkdir -p "$repo_dir"

  invoke_in_repo "$repo_dir" status "$status_out" "$status_err"
  status=$?
  if [[ "$status" -eq 0 ]]; then
    problems="${problems}status exited 0"$'\n'
  fi
  if ! grep -F -q -- 'untangle: error: missing untangle/config.yml' "$status_err"; then
    problems="${problems}status did not report a missing config"$'\n'"$(cat "$status_err")"$'\n'
  fi
  if grep -F -q -- 'unknown command' "$status_err"; then
    problems="${problems}status was treated as unknown"$'\n'
  fi
  if [[ -s "$status_out" ]]; then
    problems="${problems}status wrote to stdout"$'\n'"$(cat "$status_out")"$'\n'
  fi

  invoke_in_repo "$repo_dir" done "$done_out" "$done_err"
  status=$?
  if [[ "$status" -eq 0 ]]; then
    problems="${problems}done exited 0"$'\n'
  fi
  if ! grep -F -q -- 'untangle: error: missing untangle/config.yml' "$done_err"; then
    problems="${problems}done did not report a missing config"$'\n'"$(cat "$done_err")"$'\n'
  fi
  if grep -F -q -- 'unknown command' "$done_err"; then
    problems="${problems}done was treated as unknown"$'\n'
  fi
  if [[ -s "$done_out" ]]; then
    problems="${problems}done wrote to stdout"$'\n'"$(cat "$done_out")"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/config.yml" ]]; then
    problems="${problems}a missing config was created"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems"
    return
  fi
  pass "$test_name"
}

# --- launchd -----------------------------------------------------------------

snapshot_launchd_path() {
  local path=$1
  if [[ -e "$path" || -L "$path" ]]; then
    stat -f '%i %m %z' "$path"
  else
    printf '%s\n' missing
  fi
}

runner_cdhash() {
  codesign -dvvv "$1" 2>&1 | sed -n 's/^CDHash=//p'
}

test_launchd_template_is_wednesday_only() {
  local test_name="launchd template is Wednesday hours 8–15 at :00 and :30"
  local plist="$DOTS/launchd/com.untangle.plist.template"
  local problems="" placeholder program_args last_arg
  local weekday_count weekday hour hour_count minute_0 minute_30

  if [[ ! -f "$plist" ]]; then
    fail "$test_name" "missing plist template: $plist"
    return
  fi

  if ! grep -Fq '<string>com.untangle</string>' "$plist"; then
    problems="${problems}plist Label must be com.untangle"$'\n'
  fi
  if grep -F '/Users/' "$plist" >/dev/null; then
    problems="${problems}template must not hard-code /Users/ paths"$'\n'
  fi
  for placeholder in '@HOME@' '@PATH@' '@LAUNCHD_RUNNER@' '@UNTANGLE_BIN@'; do
    if ! grep -Fq "$placeholder" "$plist"; then
      problems="${problems}template missing placeholder $placeholder"$'\n'
    fi
  done

  program_args=$(sed -n '/<key>ProgramArguments<\/key>/,/<\/array>/p' "$plist")
  last_arg=$(printf '%s\n' "$program_args" | grep '<string>' | tail -n 1 || true)
  if [[ "$last_arg" != *'<string>run</string>'* ]]; then
    problems="${problems}ProgramArguments must end in run"$'\n'
  fi
  if ! printf '%s\n' "$program_args" | grep -Fq '@LAUNCHD_RUNNER@'; then
    problems="${problems}ProgramArguments must include @LAUNCHD_RUNNER@"$'\n'
  fi
  if ! printf '%s\n' "$program_args" | grep -Fq '@UNTANGLE_BIN@'; then
    problems="${problems}ProgramArguments must include @UNTANGLE_BIN@"$'\n'
  fi

  weekday_count=$(grep -A1 '<key>Weekday</key>' "$plist" | grep -c '<integer>3</integer>' || true)
  if [[ "$weekday_count" -ne 16 ]]; then
    problems="${problems}expected 16 Wednesday (Weekday 3) intervals, got $weekday_count"$'\n'
  fi
  for weekday in 1 2 4 5; do
    if grep -A1 '<key>Weekday</key>' "$plist" | grep -q "<integer>${weekday}</integer>"; then
      problems="${problems}StartCalendarInterval includes Weekday ${weekday}"$'\n'
    fi
  done
  for hour in 8 9 10 11 12 13 14 15; do
    hour_count=$(grep -A1 '<key>Hour</key>' "$plist" | grep -c "<integer>${hour}</integer>" || true)
    if [[ "$hour_count" -ne 2 ]]; then
      problems="${problems}expected Hour ${hour} twice, got ${hour_count}"$'\n'
    fi
  done
  minute_0=$(grep -A1 '<key>Minute</key>' "$plist" | grep -c '<integer>0</integer>' || true)
  minute_30=$(grep -A1 '<key>Minute</key>' "$plist" | grep -c '<integer>30</integer>' || true)
  if [[ "$minute_0" -ne 8 || "$minute_30" -ne 8 ]]; then
    problems="${problems}expected 8 ticks at :00 and 8 at :30, got :00=$minute_0 :30=$minute_30"$'\n'
  fi
  if ! grep -Fq 'en_US.UTF-8' "$plist"; then
    problems="${problems}plist LANG and LC_ALL must be en_US.UTF-8"$'\n'
  fi
  if ! grep -Fq '@HOME@/Library/Logs/untangle.out.log' "$plist" \
    || ! grep -Fq '@HOME@/Library/Logs/untangle.err.log' "$plist"; then
    problems="${problems}plist must log to untangle.out.log and untangle.err.log under @HOME@"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems"
    return
  fi
  pass "$test_name"
}

test_launchd_setup_installs_runner() {
  local test_name="launchd-setup installs a signed runner and reuses it"
  local fake_home="$TEST_ROOT/launchd-home"
  local runner="$TEST_ROOT/untangle-launchd"
  local plist="$TEST_ROOT/LaunchAgents/com.untangle.plist"
  local out_file="$TEST_ROOT/launchd-setup-out.txt"
  local second_out="$TEST_ROOT/launchd-setup-second.txt"
  local guard_bin="$TEST_ROOT/launchd-guards"
  local real_home=$HOME
  local agents="${real_home}/Library/LaunchAgents"
  local inchworm_runner="${XDG_DATA_HOME:-$real_home/.local/share}/inchworm/inchworm-launchd"
  local slowfriday_runner="${XDG_DATA_HOME:-$real_home/.local/share}/slowfriday/slowfriday-launchd"
  local before_inchworm_plist before_slowfriday_plist before_inchworm_runner before_slowfriday_runner before_agents
  local after_inchworm_plist after_slowfriday_plist after_inchworm_runner after_slowfriday_runner after_agents
  local status problems="" identity cdhash second_cdhash

  before_inchworm_plist=$(snapshot_launchd_path "$agents/com.inchworm.plist")
  before_slowfriday_plist=$(snapshot_launchd_path "$agents/com.slowfriday.plist")
  before_inchworm_runner=$(snapshot_launchd_path "$inchworm_runner")
  before_slowfriday_runner=$(snapshot_launchd_path "$slowfriday_runner")
  before_agents=$(stat -f '%m' "$agents" 2>/dev/null || printf '%s\n' missing)

  mkdir -p "$fake_home" "$guard_bin" "$(dirname "$plist")" "$(dirname "$runner")"
  cat >"$guard_bin/launchctl" <<EOF
#!/bin/sh
printf '%s\n' "\$*" >> "$TEST_ROOT/launchctl.log"
exit 99
EOF
  cat >"$guard_bin/open" <<EOF
#!/bin/sh
printf '%s\n' "\$*" >> "$TEST_ROOT/open.log"
exit 99
EOF
  chmod 755 "$guard_bin/launchctl" "$guard_bin/open"

  (
    export HOME="$fake_home"
    export PATH="$guard_bin:$PATH"
    export UNTANGLE_LAUNCHD_RUNNER="$runner"
    export UNTANGLE_LAUNCHD_PLIST="$plist"
    export UNTANGLE_LAUNCHD_TEMPLATE="$DOTS/launchd/com.untangle.plist.template"
    "$UNTANGLE" launchd-setup --no-open --no-reload
  ) >"$out_file" 2>&1
  status=$?

  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ ! -x "$runner" ]]; then
    problems="${problems}expected executable runner at $runner"$'\n'
  fi
  identity=$(codesign --display --verbose=2 "$runner" 2>&1 | sed -n 's/^Identifier=//p' || true)
  if [[ "$identity" != "com.untangle.launchd" ]]; then
    problems="${problems}expected runner identifier com.untangle.launchd, got: $identity"$'\n'
  fi
  if ! "$runner" -c 'exit 0' >/dev/null 2>&1; then
    problems="${problems}runner -c 'exit 0' failed"$'\n'
  fi
  if [[ ! -f "$plist" ]]; then
    problems="${problems}expected generated plist at $plist"$'\n'
  else
    if ! grep -Fq "$runner" "$plist"; then
      problems="${problems}generated plist must contain the temp runner path"$'\n'
    fi
    if ! grep -Fq "$UNTANGLE" "$plist"; then
      problems="${problems}generated plist must contain the untangle bin path"$'\n'
    fi
    if ! grep -Fq '<string>run</string>' "$plist"; then
      problems="${problems}generated plist must include run"$'\n'
    fi
    if grep -Fq '@HOME@' "$plist" || grep -Fq '@LAUNCHD_RUNNER@' "$plist" \
      || grep -Fq '@UNTANGLE_BIN@' "$plist" || grep -Fq '@PATH@' "$plist"; then
      problems="${problems}generated plist must not leave placeholders unexpanded"$'\n'
    fi
  fi
  if [[ -s "$TEST_ROOT/launchctl.log" || -s "$TEST_ROOT/open.log" ]]; then
    problems="${problems}launchd-setup --no-open --no-reload invoked launchctl or open"$'\n'
  fi

  cdhash=$(runner_cdhash "$runner" || true)
  if [[ -z "$cdhash" ]]; then
    problems="${problems}runner has no cdhash"$'\n'
  fi

  (
    export HOME="$fake_home"
    export PATH="$guard_bin:$PATH"
    export UNTANGLE_LAUNCHD_RUNNER="$runner"
    export UNTANGLE_LAUNCHD_PLIST="$plist"
    export UNTANGLE_LAUNCHD_TEMPLATE="$DOTS/launchd/com.untangle.plist.template"
    "$UNTANGLE" launchd-setup --no-open --no-reload
  ) >"$second_out" 2>&1
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}second setup expected exit 0, got $status"$'\n'
  fi
  second_cdhash=$(runner_cdhash "$runner" || true)
  if [[ -z "$cdhash" || "$second_cdhash" != "$cdhash" ]]; then
    problems="${problems}second setup must reuse the runner cdhash, got first='$cdhash' second='$second_cdhash'"$'\n'
  fi
  if ! grep -Fq 'reused' "$second_out"; then
    problems="${problems}second setup output must say reused"$'\n'
  fi

  after_inchworm_plist=$(snapshot_launchd_path "$agents/com.inchworm.plist")
  after_slowfriday_plist=$(snapshot_launchd_path "$agents/com.slowfriday.plist")
  after_inchworm_runner=$(snapshot_launchd_path "$inchworm_runner")
  after_slowfriday_runner=$(snapshot_launchd_path "$slowfriday_runner")
  after_agents=$(stat -f '%m' "$agents" 2>/dev/null || printf '%s\n' missing)
  if [[ "$before_inchworm_plist" != "$after_inchworm_plist" \
    || "$before_slowfriday_plist" != "$after_slowfriday_plist" \
    || "$before_inchworm_runner" != "$after_inchworm_runner" \
    || "$before_slowfriday_runner" != "$after_slowfriday_runner" \
    || "$before_agents" != "$after_agents" ]]; then
    problems="${problems}real LaunchAgents directory, com.inchworm.plist, com.slowfriday.plist, or their runners changed"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")" "second:" "$(cat "$second_out" 2>/dev/null || true)"
    return
  fi
  pass "$test_name"
}

test_docs_launchagent() {
  local test_name="docs mention launchd-setup and Full Disk Access"
  local problems=""

  if [[ ! -f "$DOCS_FILE" ]]; then
    fail "$test_name" "missing $DOCS_FILE"
    return
  fi
  if ! grep -Fq 'launchd-setup' "$DOCS_FILE"; then
    problems="${problems}docs must mention launchd-setup"$'\n'
  fi
  if ! grep -Fq 'Full Disk Access' "$DOCS_FILE"; then
    problems="${problems}docs must mention Full Disk Access"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems"
    return
  fi
  pass "$test_name"
}

