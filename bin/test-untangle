#!/usr/bin/env bash
# Harness for untangle init, run, done, and status. Failures are recorded; the suite does not
# exit on the first one. Tests set UNTANGLE_CONFIG_DIR and UNTANGLE_NOW so
# they never touch the real home config. Init tests also set
# UNTANGLE_GITIGNORE_GLOBAL.

set -u

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
DOTS=$(CDPATH= cd "$SCRIPT_DIR/.." && pwd)
UNTANGLE="$DOTS/bin/untangle"
YAML_HELPER="$DOTS/bin/lib/untangle_yaml.rb"
DOCS_FILE="$DOTS/docs/untangle.md"

TEST_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/test-untangle.XXXXXX") || exit 1
TEST_ROOT=$(CDPATH= cd "$TEST_ROOT" && pwd)

cleanup() {
  local pid
  if [[ -n "${TEST_ROOT:-}" && -f "$TEST_ROOT/sleeper-pid" ]]; then
    pid=$(cat "$TEST_ROOT/sleeper-pid")
    if [[ -n "$pid" ]]; then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
    fi
  fi
  if [[ -n "${TEST_ROOT:-}" ]]; then
    rm -rf "$TEST_ROOT"
  fi
}
trap cleanup EXIT HUP INT TERM

tests_run=0
tests_failed=0

# --- helpers -----------------------------------------------------------------

pass() {
  printf '%s\n' "ok - $1"
}

fail() {
  printf '%s\n' "not ok - $1"
  if [[ $# -gt 1 ]]; then
    shift
    printf '%s\n' "$@"
  fi
  tests_failed=$((tests_failed + 1))
}

run_test() {
  if [[ -n "${UNTANGLE_TEST_FILTER:-}" ]]; then
    case "$1" in
      *"$UNTANGLE_TEST_FILTER"*) ;;
      *) return 0 ;;
    esac
  fi
  tests_run=$((tests_run + 1))
  "$@"
}

write_yaml_helpers() {
  cat >"$TEST_ROOT/yaml_repo_count.rb" <<'RUBY'
#!/usr/bin/env ruby
# frozen_string_literal: true

require "yaml"

path = ARGV.fetch(0)
wanted = ARGV.fetch(1)
data = YAML.load_file(path)
repos = data.is_a?(Hash) ? (data["repos"] || data[:repos] || []) : []
paths = Array(repos).map do |entry|
  entry.is_a?(Hash) ? (entry["path"] || entry[:path]).to_s : entry.to_s
end
print paths.count { |repo_path| repo_path == wanted }
RUBY

  cat >"$TEST_ROOT/yaml_repo_entry.rb" <<'RUBY'
#!/usr/bin/env ruby
# frozen_string_literal: true

require "yaml"

path = ARGV.fetch(0)
wanted = ARGV.fetch(1)
data = YAML.load_file(path)
repos = data.is_a?(Hash) ? (data["repos"] || data[:repos]) : nil
unless repos.is_a?(Array)
  warn "repos is not an array: #{repos.class}"
  exit 1
end

hash_hits = repos.count do |entry|
  entry.is_a?(Hash) && (entry["path"] || entry[:path]).to_s == wanted
end
string_hits = repos.count { |entry| entry.is_a?(String) && entry == wanted }
unless hash_hits == 1 && string_hits == 0
  warn "expected one {path: absolute} entry, hash_hits=#{hash_hits} string_hits=#{string_hits}"
  exit 1
end
RUBY

  cat >"$TEST_ROOT/yaml_set_trunk.rb" <<'RUBY'
#!/usr/bin/env ruby
# frozen_string_literal: true

require "yaml"

path = ARGV.fetch(0)
trunk = ARGV.fetch(1)
data = YAML.load_file(path)
data = {} unless data.is_a?(Hash)
data["trunk"] = trunk
File.write(path, YAML.dump(data))
RUBY

  cat >"$TEST_ROOT/yaml_expect.rb" <<'RUBY'
#!/usr/bin/env ruby
# frozen_string_literal: true

require "yaml"

path = ARGV.fetch(0)
spec = ARGV.fetch(1)
key_path, kind = spec.split("=", 2)
keys = key_path.split(".")
data = YAML.load_file(path)
missing = false
value = keys.reduce(data) do |current, key|
  unless current.is_a?(Hash) && (current.key?(key) || current.key?(key.to_sym))
    missing = true
    break nil
  end

  current.key?(key) ? current[key] : current[key.to_sym]
end

ok =
  case kind
  when "absent"
    missing
  when "blank"
    !missing && value.is_a?(String) && value.empty?
  when /\Aint:(-?\d+)\z/
    !missing && value.is_a?(Integer) && value == Regexp.last_match(1).to_i
  when "bool:true"
    !missing && value.equal?(true)
  when "bool:false"
    !missing && value.equal?(false)
  when /\Astr:(.*)\z/
    !missing && value.is_a?(String) && value == Regexp.last_match(1)
  when /\Aarray:(.*)\z/
    expected = Regexp.last_match(1).empty? ? [] : Regexp.last_match(1).split(",")
    !missing && value.is_a?(Array) && value == expected
  else
    warn "unknown expect spec: #{spec}"
    false
  end

unless ok
  warn "expected #{spec} at #{key_path}, missing=#{missing} value=#{value.inspect} class=#{value.class}"
  exit 1
end
RUBY

  cat >"$TEST_ROOT/yaml_add_repo.rb" <<'RUBY'
#!/usr/bin/env ruby
# frozen_string_literal: true

require "yaml"

path = ARGV.fetch(0)
repo_path = ARGV.fetch(1)
data = YAML.load_file(path)
data = {} unless data.is_a?(Hash)
repos = data["repos"]
repos = [] unless repos.is_a?(Array)
repos << { "path" => repo_path }
data["repos"] = repos
File.write(path, YAML.dump(data))
RUBY

  cat >"$TEST_ROOT/yaml_set_progress_pid.rb" <<'RUBY'
#!/usr/bin/env ruby
# frozen_string_literal: true

require "yaml"

path = ARGV.fetch(0)
pid = Integer(ARGV.fetch(1))
data = YAML.load_file(path)
data = {} unless data.is_a?(Hash)
data["progress_pid"] = pid
File.write(path, YAML.dump(data))
RUBY

  cat >"$TEST_ROOT/yaml_set_key.rb" <<'RUBY'
#!/usr/bin/env ruby
# frozen_string_literal: true

require "yaml"

path = ARGV.fetch(0)
key = ARGV.fetch(1)
value = ARGV.fetch(2)
data = YAML.load_file(path)
data = {} unless data.is_a?(Hash)
data[key] = value
File.write(path, YAML.dump(data))
RUBY
}

yaml_repo_occurrences() {
  mise exec -- ruby "$TEST_ROOT/yaml_repo_count.rb" "$1" "$2"
}

yaml_repo_entry() {
  mise exec -- ruby "$TEST_ROOT/yaml_repo_entry.rb" "$1" "$2"
}

yaml_set_trunk() {
  mise exec -- ruby "$TEST_ROOT/yaml_set_trunk.rb" "$1" "$2"
}

yaml_expect() {
  mise exec -- ruby "$TEST_ROOT/yaml_expect.rb" "$1" "$2"
}

yaml_add_repo() {
  mise exec -- ruby "$TEST_ROOT/yaml_add_repo.rb" "$1" "$2"
}

yaml_set_progress_pid() {
  mise exec -- ruby "$TEST_ROOT/yaml_set_progress_pid.rb" "$1" "$2"
}

yaml_set_key() {
  mise exec -- ruby "$TEST_ROOT/yaml_set_key.rb" "$1" "$2" "$3"
}

ruby_untangle() {
  mise exec -- ruby "$YAML_HELPER" "$@"
}

files_match() {
  cmp -s "$1" "$2"
}

make_repo() {
  local repo_dir=$1
  mkdir -p "$repo_dir"
  git -C "$repo_dir" init -q
  git -C "$repo_dir" config user.email "fixture@example.com"
  git -C "$repo_dir" config user.name "Fixture Author"
  git -C "$repo_dir" config commit.gpgsign false
  printf '%s\n' "# fixture" >"$repo_dir/README.md"
  git -C "$repo_dir" add README.md
  git -C "$repo_dir" commit -q -m "fixture"
  git -C "$repo_dir" branch -M main
}

run_init() {
  local repo_dir=$1
  local config_dir=$2
  local gitignore_file=$3
  (
    cd "$repo_dir" || exit 1
    export UNTANGLE_CONFIG_DIR="$config_dir"
    export UNTANGLE_GITIGNORE_GLOBAL="$gitignore_file"
    "$UNTANGLE" init
  )
}

install_probe_stub() {
  cat >"$TEST_ROOT/probe_snapshot.rb" <<'RUBY'
# frozen_string_literal: true

require "yaml"

repo = ARGV.fetch(0)
out = ARGV.fetch(1)
data = YAML.load_file(File.join(repo, "untangle", "config.yml"))
pid = data["progress_pid"]
version = data["version"]
trunk = data["trunk"]
line =
  if pid.is_a?(Integer) && pid.positive? && version.is_a?(Integer) && trunk.is_a?(String)
    "int:#{pid} version:#{version} trunk:#{trunk}"
  else
    "bad pid=#{pid.inspect} class=#{pid.class} version=#{version.inspect} trunk=#{trunk.inspect}"
  end
File.open(out, "a") { |file| file.puts line }
RUBY

  cat >"$TEST_ROOT/probe-stub" <<EOF
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "\$1" >>"\$UNTANGLE_PROBE_LOG"
if [[ -n "\${UNTANGLE_PID_SNAPSHOT:-}" ]]; then
  mise exec -- ruby "$TEST_ROOT/probe_snapshot.rb" "\$1" "\$UNTANGLE_PID_SNAPSHOT"
fi
exit "\${UNTANGLE_PROBE_STATUS:-0}"
EOF
  chmod +x "$TEST_ROOT/probe-stub"
}

install_herdr_mock() {
  cat >"$TEST_ROOT/herdr-mock" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

log=${UNTANGLE_HERDR_LOG:?}
root=${UNTANGLE_HERDR_ROOT:?}
printf '%s\n' "$*" >>"$log"

group=${1:-}
action=${2:-}
if [[ $# -ge 2 ]]; then
  shift 2
fi

cwd=
branch=
while [[ $# -gt 0 ]]; do
  case "$1" in
    --cwd)
      [[ $# -ge 2 ]] || exit 1
      cwd=$2
      shift 2
      ;;
    --branch)
      [[ $# -ge 2 ]] || exit 1
      branch=$2
      shift 2
      ;;
    --base)
      [[ $# -ge 2 ]] || exit 1
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

plant_untangle() {
  local checkout=$1
  local repo=$2
  local dest="${checkout}/untangle"
  local plant=${UNTANGLE_HERDR_PLANT:-}
  case "$plant" in
    copy)
      if [[ -L "$dest" ]]; then
        rm -f "$dest"
      elif [[ -e "$dest" ]]; then
        rm -rf "$dest"
      fi
      mkdir -p "$dest"
      printf '%s\n' 'copied-only' >"$dest/copied-only.txt"
      ;;
    symlink)
      if [[ -L "$dest" ]]; then
        rm -f "$dest"
      elif [[ -e "$dest" ]]; then
        rm -rf "$dest"
      fi
      ln -s "${repo}/untangle" "$dest"
      local ino
      ino=$(stat -f '%i' "$dest" 2>/dev/null || stat -c '%i' "$dest")
      printf '%s\n' "$ino" >"${log}.symlink-inode"
      ;;
  esac
}

if [[ "$group" == "worktree" && "$action" == "create" ]]; then
  [[ -n "$cwd" && -n "$branch" ]] || exit 1
  slug=$(printf '%s' "$cwd" | tr '/:' '__')
  state="${root}/state/${slug}"
  branch_slug=${branch//\//-}
  checkout="${root}/checkouts/${slug}/${branch_slug}"
  mkdir -p "$state" "$checkout"
  printf '%s\n' "$branch" >"$state/branch"
  printf '%s\n' "$checkout" >"$state/path"
  plant_untangle "$checkout" "$cwd"
  status=${UNTANGLE_HERDR_CREATE_STATUS:-0}
  if [[ "$status" == "0" ]]; then
    printf '{"result":{"worktree":{"path":"%s"}}}\n' "$checkout"
  else
    printf '%s\n' '{"result":{"worktree":{"path":""}}}'
  fi
  exit "$status"
fi

if [[ "$group" == "worktree" && "$action" == "list" ]]; then
  [[ -n "$cwd" ]] || exit 1
  slug=$(printf '%s' "$cwd" | tr '/:' '__')
  state="${root}/state/${slug}"
  mode=${UNTANGLE_HERDR_LIST:-match}
  if [[ "$mode" == "empty" || ! -f "$state/branch" || ! -f "$state/path" ]]; then
    printf '%s\n' '{"result":{"worktrees":[]}}'
    exit 0
  fi
  listed_branch=$(cat "$state/branch")
  listed_path=$(cat "$state/path")
  printf '{"result":{"worktrees":[{"branch":"%s","path":"%s"}]}}\n' "$listed_branch" "$listed_path"
  exit 0
fi

printf '%s\n' '{"result":{}}'
exit 0
EOF
  chmod +x "$TEST_ROOT/herdr-mock"
}

# Records a PATH `agent`. Probe ticks and skips must not invoke it.
# An unprobed tick with no test mock runs it once and writes nothing.
install_path_agent() {
  local bin="$TEST_ROOT/path-agent-bin"
  mkdir -p "$bin"
  cat >"$bin/agent" <<EOF
#!/usr/bin/env bash
set -u
printf '%s\n' "invoked" >>"$TEST_ROOT/path-agent-invocations"
EOF
  chmod +x "$bin/agent"
}

# Records cwd, argc, and each arg. Optionally copies a note and a log, then exits.
install_agent_mock() {
  cat >"$TEST_ROOT/agent-mock" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

record=${UNTANGLE_AGENT_RECORD:?}
mkdir -p "$record"
count_file="$record/count"
if [[ -f "$count_file" ]]; then
  count=$(cat "$count_file")
else
  count=0
fi
count=$((count + 1))
printf '%s\n' "$count" >"$count_file"
printf '%s\n' "$PWD" >"$record/cwd-$count"
printf '%s\n' "$#" >"$record/argc-$count"
i=0
for arg in "$@"; do
  printf '%s' "$arg" >"$record/arg-$count-$i"
  i=$((i + 1))
done

if [[ -n "${UNTANGLE_AGENT_NOTE_SRC:-}" ]]; then
  cp "$UNTANGLE_AGENT_NOTE_SRC" "${UNTANGLE_AGENT_NOTE:?}"
fi
if [[ -n "${UNTANGLE_AGENT_LOG_SRC:-}" ]]; then
  cp "$UNTANGLE_AGENT_LOG_SRC" "${UNTANGLE_AGENT_LOG_FILE:?}"
fi
exit "${UNTANGLE_AGENT_STATUS:-0}"
EOF
  chmod +x "$TEST_ROOT/agent-mock"
}

reset_run_env() {
  RUN_PROBE=
  RUN_PROBE_LOG=
  RUN_PROBE_STATUS=
  RUN_PID_SNAPSHOT=
  RUN_PREFLIGHT=
  RUN_HERDR_LOG=
  RUN_HERDR_CREATE_STATUS=
  RUN_HERDR_LIST=
  RUN_HERDR_PLANT=
  RUN_AGENT=
  RUN_AGENT_RECORD=
  RUN_AGENT_STATUS=
  RUN_AGENT_NOTE=
  RUN_AGENT_NOTE_SRC=
  RUN_AGENT_LOG_FILE=
  RUN_AGENT_LOG_SRC=
}

bare_origin_for() {
  printf '%s.origin.git' "$1"
}

attach_bare_origin() {
  local repo_dir=$1
  local origin
  origin=$(bare_origin_for "$repo_dir")
  git -C "$repo_dir" config commit.gpgsign false || return 1
  if [[ ! -d "$origin" ]]; then
    git init -q --bare "$origin" || return 1
    git -C "$origin" symbolic-ref HEAD refs/heads/main || return 1
    git -C "$origin" config commit.gpgsign false || return 1
  fi
  if ! git -C "$repo_dir" remote get-url origin >/dev/null 2>&1; then
    git -C "$repo_dir" remote add origin "$origin" || return 1
  fi
  git -C "$repo_dir" push -q origin main
}

prepare_registered_repo() {
  local repo_dir=$1
  local config_dir=$2
  local gitignore_file="$config_dir/gitignore"
  local out status
  mkdir -p "$config_dir"
  if [[ ! -f "$gitignore_file" ]]; then
    printf '%s\n' '# keep' >"$gitignore_file"
  fi
  if [[ ! -e "$repo_dir/.git" ]]; then
    make_repo "$repo_dir"
  fi
  out=$(run_init "$repo_dir" "$config_dir" "$gitignore_file" 2>&1)
  status=$?
  if [[ "$status" -ne 0 ]]; then
    printf 'prepare_registered_repo failed (%s): %s\n' "$status" "$out" >&2
    return "$status"
  fi
  if ! attach_bare_origin "$repo_dir"; then
    printf 'prepare_registered_repo failed to attach origin\n' >&2
    return 1
  fi
}

prepare_registered_plain_dir() {
  local repo_dir=$1
  local config_dir=$2
  local gitignore_file="$config_dir/gitignore"
  local out status
  mkdir -p "$config_dir" "$repo_dir"
  if [[ ! -f "$gitignore_file" ]]; then
    printf '%s\n' '# keep' >"$gitignore_file"
  fi
  out=$(run_init "$repo_dir" "$config_dir" "$gitignore_file" 2>&1)
  status=$?
  if [[ "$status" -ne 0 ]]; then
    printf 'prepare_registered_plain_dir failed (%s): %s\n' "$status" "$out" >&2
    return "$status"
  fi
}

invoke_run() {
  local config_dir=$1
  local now=$2
  local out_file=$3
  (
    cd "$TEST_ROOT" || exit 1
    export UNTANGLE_CONFIG_DIR="$config_dir"
    export UNTANGLE_NOW="$now"
    export UNTANGLE_GITIGNORE_GLOBAL="$TEST_ROOT/gitignore-unused"
    export PATH="$TEST_ROOT/path-agent-bin:${PATH}"
    if [[ -n "${RUN_PROBE:-}" ]]; then
      export UNTANGLE_PROBE="$RUN_PROBE"
    else
      unset UNTANGLE_PROBE
    fi
    if [[ -n "${RUN_PROBE_LOG:-}" ]]; then
      export UNTANGLE_PROBE_LOG="$RUN_PROBE_LOG"
    else
      unset UNTANGLE_PROBE_LOG
    fi
    if [[ -n "${RUN_PROBE_STATUS:-}" ]]; then
      export UNTANGLE_PROBE_STATUS="$RUN_PROBE_STATUS"
    else
      unset UNTANGLE_PROBE_STATUS
    fi
    if [[ -n "${RUN_PID_SNAPSHOT:-}" ]]; then
      export UNTANGLE_PID_SNAPSHOT="$RUN_PID_SNAPSHOT"
    else
      unset UNTANGLE_PID_SNAPSHOT
    fi
    if [[ -n "${RUN_PREFLIGHT:-}" ]]; then
      export UNTANGLE_PREFLIGHT_FIXTURE="$RUN_PREFLIGHT"
    else
      unset UNTANGLE_PREFLIGHT_FIXTURE
    fi
    if [[ ! -x "$TEST_ROOT/herdr-mock" ]]; then
      printf 'herdr mock is not executable\n' >&2
      exit 1
    fi
    mkdir -p "$TEST_ROOT/herdr-worktrees"
    export UNTANGLE_HERDR="$TEST_ROOT/herdr-mock"
    export UNTANGLE_HERDR_ROOT="$TEST_ROOT/herdr-worktrees"
    if [[ -n "${RUN_HERDR_LOG:-}" ]]; then
      export UNTANGLE_HERDR_LOG="$RUN_HERDR_LOG"
    else
      export UNTANGLE_HERDR_LOG="$TEST_ROOT/herdr-default.log"
    fi
    if [[ -n "${RUN_HERDR_CREATE_STATUS:-}" ]]; then
      export UNTANGLE_HERDR_CREATE_STATUS="$RUN_HERDR_CREATE_STATUS"
    else
      unset UNTANGLE_HERDR_CREATE_STATUS
    fi
    if [[ -n "${RUN_HERDR_LIST:-}" ]]; then
      export UNTANGLE_HERDR_LIST="$RUN_HERDR_LIST"
    else
      unset UNTANGLE_HERDR_LIST
    fi
    if [[ -n "${RUN_HERDR_PLANT:-}" ]]; then
      export UNTANGLE_HERDR_PLANT="$RUN_HERDR_PLANT"
    else
      unset UNTANGLE_HERDR_PLANT
    fi
    # A test mock wins. Otherwise the recording PATH agent is the orchestrator.
    if [[ -n "${RUN_AGENT:-}" ]]; then
      export UNTANGLE_AGENT="$RUN_AGENT"
    else
      export UNTANGLE_AGENT="$TEST_ROOT/path-agent-bin/agent"
    fi
    if [[ -n "${RUN_AGENT_RECORD:-}" ]]; then
      export UNTANGLE_AGENT_RECORD="$RUN_AGENT_RECORD"
    else
      unset UNTANGLE_AGENT_RECORD
    fi
    if [[ -n "${RUN_AGENT_STATUS:-}" ]]; then
      export UNTANGLE_AGENT_STATUS="$RUN_AGENT_STATUS"
    else
      unset UNTANGLE_AGENT_STATUS
    fi
    if [[ -n "${RUN_AGENT_NOTE:-}" ]]; then
      export UNTANGLE_AGENT_NOTE="$RUN_AGENT_NOTE"
    else
      unset UNTANGLE_AGENT_NOTE
    fi
    if [[ -n "${RUN_AGENT_NOTE_SRC:-}" ]]; then
      export UNTANGLE_AGENT_NOTE_SRC="$RUN_AGENT_NOTE_SRC"
    else
      unset UNTANGLE_AGENT_NOTE_SRC
    fi
    if [[ -n "${RUN_AGENT_LOG_FILE:-}" ]]; then
      export UNTANGLE_AGENT_LOG_FILE="$RUN_AGENT_LOG_FILE"
    else
      unset UNTANGLE_AGENT_LOG_FILE
    fi
    if [[ -n "${RUN_AGENT_LOG_SRC:-}" ]]; then
      export UNTANGLE_AGENT_LOG_SRC="$RUN_AGENT_LOG_SRC"
    else
      unset UNTANGLE_AGENT_LOG_SRC
    fi
    "$UNTANGLE" run
  ) >"$out_file" 2>&1
}

# done and status read the current directory. Point config and the clock away
# from the real home and from Wednesday so a registry walk cannot hide here.
invoke_in_repo() {
  local repo_dir=$1
  local cmd=$2
  local out_file=$3
  local err_file=$4
  mkdir -p "$TEST_ROOT/not-the-registry"
  (
    cd "$repo_dir" || exit 1
    export UNTANGLE_CONFIG_DIR="$TEST_ROOT/not-the-registry"
    export UNTANGLE_GITIGNORE_GLOBAL="$TEST_ROOT/not-the-gitignore"
    export UNTANGLE_NOW="2026-10-13T10:00:00"
    "$UNTANGLE" "$cmd"
  ) >"$out_file" 2>"$err_file"
}

path_count_in_log() {
  local log=$1
  local path=$2
  local count
  if [[ ! -f "$log" ]]; then
    printf '0'
    return 0
  fi
  count=$(grep -F -x -c -- "$path" "$log" || true)
  printf '%s' "$count"
}

snapshot_int_count() {
  local file=$1
  local count
  if [[ ! -f "$file" ]]; then
    printf '0'
    return 0
  fi
  count=$(grep -E -c '^int:[1-9][0-9]* version:1 trunk:$' "$file" || true)
  printf '%s' "$count"
}

path_agent_invocations() {
  local file="$TEST_ROOT/path-agent-invocations"
  local count
  if [[ ! -f "$file" ]]; then
    printf '0'
    return 0
  fi
  count=$(grep -c . "$file" || true)
  printf '%s' "$count"
}

use_agent_mock() {
  local record=$1
  RUN_AGENT="$TEST_ROOT/agent-mock"
  RUN_AGENT_RECORD="$record"
  RUN_AGENT_STATUS=
  RUN_AGENT_NOTE=
  RUN_AGENT_NOTE_SRC=
  RUN_AGENT_LOG_FILE=
  RUN_AGENT_LOG_SRC=
  mkdir -p "$record"
}

agent_invocation_count() {
  local record=$1
  local count_file="$record/count"
  if [[ ! -f "$count_file" ]]; then
    printf '0'
    return 0
  fi
  cat "$count_file"
}

# Keep this identical to orchestrator_prompt in bin/untangle.
write_expected_prompt() {
  local dest=$1
  local repo=$2
  local yymmdd=$3
  local bucket=$4
  local guide="${repo}/untangle/guide.md"
  local log="${repo}/untangle/log.md"
  local note="${repo}/untangle/notes/${yymmdd}.md"
  local text
  text=$(cat <<EOF
You are the Untangle orchestrator.

Follow the guide at ${guide} for the bucket ${bucket} only. Do not look at the other buckets.

Write the log at ${log} and the weekly note at ${note} itself. Subagents do not.

You may delegate a code read. Subagents do not write those files.

Do not edit or commit application files.
Do not open a pull request.

The note opens with the word plan or the word quiet.

A plan names one knot, why the next change is expensive, a completion condition, and behavior-preserving steps.

A quiet note says what was looked at and why nothing is ready.
EOF
)
  printf '%s' "$text" >"$dest"
}

write_plan_note() {
  local dest=$1
  cat >"$dest" <<'EOF'
plan
Knot: the checkout client name.
The next change is expensive because both generations are still called.
Completion condition: one name remains and callers still pass.
Behavior-preserving steps: rename one caller at a time.
EOF
}

write_quiet_note() {
  local dest=$1
  cat >"$dest" <<'EOF'
quiet
Looked at the checkout names.
Nothing is ready because no single knot is worth the change.
EOF
}

write_agent_log() {
  local dest=$1
  printf '%s\n' 'Read the checkout names.' >"$dest"
}

write_opening_note() {
  local dest=$1
  local word=$2
  printf '%s\n%s\n' "$word" 'Knot: this opening is not a kept note.' >"$dest"
}

publish_branch() {
  local repo_dir=$1
  local branch=$2
  git -C "$repo_dir" branch "$branch" main || return 1
  git -C "$repo_dir" push -q origin "$branch"
}

# Print the new commit. Does not fetch in the registered repo.
advance_bare_branch() {
  local repo_dir=$1
  local branch=$2
  local origin side
  origin=$(bare_origin_for "$repo_dir")
  side=$(mktemp -d "${TEST_ROOT}/side.XXXXXX") || return 1
  git clone -q "$origin" "$side" || return 1
  git -C "$side" config user.email "fixture@example.com" || return 1
  git -C "$side" config user.name "Fixture Author" || return 1
  git -C "$side" config commit.gpgsign false || return 1
  git -C "$side" checkout -q "$branch" || return 1
  printf '%s\n' "advance ${branch}" >>"$side/README.md" || return 1
  git -C "$side" add README.md || return 1
  git -C "$side" commit -q -m "advance ${branch}" || return 1
  git -C "$side" push -q origin "HEAD:${branch}" || return 1
  git -C "$side" rev-parse HEAD
}

worktree_from_output() {
  local out=$1
  local repo=$2
  local prefix="untangle: ${repo} — worktree "
  local line
  line=$(grep -F "$prefix" "$out" | tail -n 1 || true)
  if [[ -z "$line" ]]; then
    printf ''
    return 0
  fi
  printf '%s' "${line#"$prefix"}"
}

count_named() {
  local name=$1
  shift
  local count
  count=$(find -P "$@" -name "$name" -print 2>/dev/null | wc -l | tr -d '[:space:]')
  if [[ -z "$count" ]]; then
    printf '0'
  else
    printf '%s' "$count"
  fi
}

link_inode() {
  local path=$1
  local ino
  ino=$(stat -f '%i' "$path" 2>/dev/null || true)
  if [[ "$ino" =~ ^[0-9]+$ ]]; then
    printf '%s' "$ino"
    return 0
  fi
  stat -c '%i' "$path"
}

use_probe_stub() {
  local log=$1
  local snapshot=${2:-}
  RUN_PROBE="$TEST_ROOT/probe-stub"
  RUN_PROBE_LOG="$log"
  RUN_PID_SNAPSHOT="$snapshot"
}

# --- tests -------------------------------------------------------------------

test_init_creates_files_registry_and_gitignore() {
  local test_name="init creates guide, config, log, and notes; registers once; appends gitignore"
  local config_dir="$TEST_ROOT/init-config"
  local gitignore_file="$TEST_ROOT/init-gitignore"
  local repo_dir="$TEST_ROOT/init-repo"
  local out_file="$TEST_ROOT/init-out.txt"
  local status problems count
  local repo_yml global_yml guide

  mkdir -p "$config_dir"
  printf '%s\n' '# keep' >"$gitignore_file"
  make_repo "$repo_dir"

  run_init "$repo_dir" "$config_dir" "$gitignore_file" >"$out_file" 2>&1
  status=$?

  if [[ "$status" -ne 0 ]]; then
    fail "$test_name" "expected exit 0, got $status" "output:" "$(cat "$out_file")"
    return
  fi

  repo_yml="$repo_dir/untangle/config.yml"
  global_yml="$config_dir/config.yml"
  guide="$repo_dir/untangle/guide.md"
  problems=""

  if [[ ! -f "$guide" ]]; then
    problems="${problems}missing guide.md"$'\n'
  else
    if ! grep -F -q -- 'The buckets, in cursor order, are Language, Ownership, Boundaries, Representation, Flow, Dependencies, Consolidation, and Removal.' "$guide"; then
      problems="${problems}guide.md missing the cursor-order sentence"$'\n'
    fi
    if ! grep -F -q -- 'Look at one bucket. Name one knot. Name a completion condition. Behavior preserved. Stop.' "$guide"; then
      problems="${problems}guide.md missing the note-rules sentence"$'\n'
    fi
    if ! grep -F -q -- 'Under Language, when an old and a new generation coexist and the new one should win, the old name becomes `legacy-<name>` and the new one keeps `<name>`. When that would lie, the plan says so and picks another name.' "$guide"; then
      problems="${problems}guide.md missing the legacy-<name> sentence"$'\n'
    fi
  fi

  printf '%s\n' '# Log' >"$TEST_ROOT/expected-init-log"
  if [[ ! -f "$repo_dir/untangle/log.md" ]]; then
    problems="${problems}missing log.md"$'\n'
  elif ! files_match "$TEST_ROOT/expected-init-log" "$repo_dir/untangle/log.md"; then
    problems="${problems}log.md is not # Log"$'\n'
  fi

  if [[ ! -d "$repo_dir/untangle/notes" ]]; then
    problems="${problems}missing notes/"$'\n'
  elif [[ -n "$(ls -A "$repo_dir/untangle/notes")" ]]; then
    problems="${problems}notes/ is not empty"$'\n'
  fi

  if [[ ! -f "$repo_yml" ]]; then
    problems="${problems}missing $repo_yml"$'\n'
  else
    if ! yaml_expect "$repo_yml" "version=int:1"; then
      problems="${problems}expected version integer 1"$'\n'
    fi
    if ! yaml_expect "$repo_yml" "trunk=blank"; then
      problems="${problems}expected trunk to be a blank string"$'\n'
    fi
    if ! yaml_expect "$repo_yml" "progress_pid=absent"; then
      problems="${problems}expected progress_pid to be absent"$'\n'
    fi
    if ! yaml_expect "$repo_yml" "cursor=absent"; then
      problems="${problems}expected cursor to be absent"$'\n'
    fi
    if ! yaml_expect "$repo_yml" "open_plan=absent"; then
      problems="${problems}expected open_plan to be absent"$'\n'
    fi
  fi

  if [[ ! -f "$global_yml" ]]; then
    problems="${problems}missing $global_yml"$'\n'
  else
    if ! yaml_expect "$global_yml" "version=int:1"; then
      problems="${problems}expected global version integer 1"$'\n'
    fi
    if ! yaml_expect "$global_yml" "defaults.runtime=str:cursor-cli"; then
      problems="${problems}expected defaults.runtime string cursor-cli"$'\n'
    fi
    if ! yaml_expect "$global_yml" "defaults.schedule.window_local=str:08:00-16:00"; then
      problems="${problems}expected window string 08:00-16:00"$'\n'
    fi
    if ! yaml_expect "$global_yml" "defaults.schedule.days=array:wed"; then
      problems="${problems}expected schedule days array [wed]"$'\n'
    fi
    if ! yaml_expect "$global_yml" "defaults.schedule.catch_up_missed_days=bool:false"; then
      problems="${problems}expected catch_up_missed_days boolean false"$'\n'
    fi
    count=$(yaml_repo_occurrences "$global_yml" "$repo_dir" 2>/dev/null || printf '0')
    if [[ "$count" != "1" ]]; then
      problems="${problems}expected repos to contain absolute path exactly once, got count=$count: $repo_dir"$'\n'
    fi
    if ! yaml_repo_entry "$global_yml" "$repo_dir"; then
      problems="${problems}expected repos to be a list of {path: absolute}"$'\n'
    fi
  fi

  printf '%s\n' '# keep' 'untangle/' >"$TEST_ROOT/expected-gitignore"
  if ! files_match "$TEST_ROOT/expected-gitignore" "$gitignore_file"; then
    problems="${problems}gitignore is not the pre-existing line followed by untangle/:$(cat "$gitignore_file")"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_init_is_idempotent() {
  local test_name="second init keeps one registry entry, one gitignore line, and existing contents"
  local config_dir="$TEST_ROOT/init-idem-config"
  local gitignore_file="$TEST_ROOT/init-idem-gitignore"
  local repo_dir="$TEST_ROOT/init-idem-repo"
  local out_file="$TEST_ROOT/init-idem-out.txt"
  local guide_sentence="Harbor lights stay on for this test."
  local log_sentence="watch the checkout line"
  local note_sentence="old note stays"
  local status count other_count

  mkdir -p "$config_dir"
  printf '%s\n' '# keep' >"$gitignore_file"
  make_repo "$repo_dir"

  run_init "$repo_dir" "$config_dir" "$gitignore_file" >"$out_file" 2>&1
  status=$?
  if [[ "$status" -ne 0 ]]; then
    fail "$test_name" "first init expected exit 0, got $status" "output:" "$(cat "$out_file")"
    return
  fi

  printf '%s\n' "$guide_sentence" >"$repo_dir/untangle/guide.md"
  printf '%s\n' "$log_sentence" >"$repo_dir/untangle/log.md"
  printf '%s\n' "$note_sentence" >"$repo_dir/untangle/notes/0101.md"
  yaml_set_trunk "$repo_dir/untangle/config.yml" "develop"
  yaml_add_repo "$config_dir/config.yml" "$TEST_ROOT/other-repo"
  printf '%s\n' "$guide_sentence" >"$TEST_ROOT/expected-guide"
  printf '%s\n' "$log_sentence" >"$TEST_ROOT/expected-log"
  printf '%s\n' "$note_sentence" >"$TEST_ROOT/expected-note"
  printf '%s\n' '# keep' 'untangle/' >"$TEST_ROOT/expected-gitignore-idem"

  run_init "$repo_dir" "$config_dir" "$gitignore_file" >>"$out_file" 2>&1
  status=$?
  if [[ "$status" -ne 0 ]]; then
    fail "$test_name" "second init expected exit 0, got $status" "output:" "$(cat "$out_file")"
    return
  fi

  count=$(yaml_repo_occurrences "$config_dir/config.yml" "$repo_dir" 2>/dev/null || printf '0')
  other_count=$(yaml_repo_occurrences "$config_dir/config.yml" "$TEST_ROOT/other-repo" 2>/dev/null || printf '0')

  if [[ "$count" != "1" ]]; then
    fail "$test_name" "expected repo path exactly once, got count=$count" "output:" "$(cat "$out_file")"
    return
  fi
  if [[ "$other_count" != "1" ]]; then
    fail "$test_name" "second init dropped the other registered repo, count=$other_count"
    return
  fi
  if ! files_match "$TEST_ROOT/expected-gitignore-idem" "$gitignore_file"; then
    fail "$test_name" "gitignore was rewritten:" "$(cat "$gitignore_file")"
    return
  fi
  if ! files_match "$TEST_ROOT/expected-guide" "$repo_dir/untangle/guide.md"; then
    fail "$test_name" "guide.md bytes changed"
    return
  fi
  if ! yaml_expect "$repo_dir/untangle/config.yml" "trunk=str:develop"; then
    fail "$test_name" "config.yml trunk changed"
    return
  fi
  if ! files_match "$TEST_ROOT/expected-log" "$repo_dir/untangle/log.md"; then
    fail "$test_name" "log.md bytes changed"
    return
  fi
  if ! files_match "$TEST_ROOT/expected-note" "$repo_dir/untangle/notes/0101.md"; then
    fail "$test_name" "existing note bytes changed"
    return
  fi
  pass "$test_name"
}

test_docs_manual_step_and_script_silence() {
  local test_name="docs name the dots-private symlink step; the script does not"
  local problems=""

  if [[ ! -f "$DOCS_FILE" ]]; then
    fail "$test_name" "missing $DOCS_FILE"
    return
  fi
  if ! grep -F -q -- 'Move `untangle/` into `~/dots-private` and replace the checkout path with a symlink.' "$DOCS_FILE"; then
    problems="${problems}docs do not say to move untangle/ into ~/dots-private and replace the checkout path with a symlink"$'\n'
  fi
  if ! grep -F -q -- 'The orchestrator runs in the worktree. It follows the guide for the cursor'"'"'s bucket only, may delegate a code read, and writes the log and the note.' "$DOCS_FILE"; then
    problems="${problems}docs do not say the orchestrator runs in the worktree for the cursor's bucket"$'\n'
  fi
  if ! grep -F -q -- 'The coordinator keeps a note only when it opens with `plan` or `quiet`.' "$DOCS_FILE"; then
    problems="${problems}docs do not say a note is kept only when it opens with plan or quiet"$'\n'
  fi
  if ! grep -F -q -- 'A plan is recorded as the open plan and later runs skip. A quiet note is not an open plan.' "$DOCS_FILE"; then
    problems="${problems}docs do not say a plan is the open plan and a quiet note is not"$'\n'
  fi
  if ! grep -F -q -- 'A quiet note advances the cursor and wraps after Removal.' "$DOCS_FILE"; then
    problems="${problems}docs do not say a quiet note advances the cursor and wraps after Removal"$'\n'
  fi
  if ! grep -F -q -- 'A plan leaves the cursor on that bucket.' "$DOCS_FILE"; then
    problems="${problems}docs do not say a plan leaves the cursor on that bucket"$'\n'
  fi
  if ! grep -F -q -- '`untangle done` clears the open plan and then advances.' "$DOCS_FILE"; then
    problems="${problems}docs do not say untangle done clears the open plan and then advances"$'\n'
  fi
  if ! grep -F -q -- '`untangle status` shows the cursor and the open plan when there is one.' "$DOCS_FILE"; then
    problems="${problems}docs do not say untangle status shows the cursor and the open plan when there is one"$'\n'
  fi
  if grep -F -q -- 'dots-private' "$UNTANGLE"; then
    problems="${problems}bin/untangle contains dots-private"$'\n'
  fi
  if grep -F -q -- 'dots-private' "$YAML_HELPER"; then
    problems="${problems}bin/lib/untangle_yaml.rb contains dots-private"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems"
    return
  fi
  pass "$test_name"
}

test_usage_on_missing_and_unknown_command() {
  local test_name="missing and unknown commands print usage on stderr and exit non-zero"
  local stdout_file="$TEST_ROOT/usage-stdout.txt"
  local stderr_file="$TEST_ROOT/usage-stderr.txt"
  local status problems=""
  local cmd

  "$UNTANGLE" >"$stdout_file" 2>"$stderr_file"
  status=$?
  if [[ "$status" -eq 0 ]]; then
    problems="${problems}missing command exited 0"$'\n'
  fi
  if ! grep -F -q -- 'Usage: untangle <init|run|done|status|launchd-setup>' "$stderr_file"; then
    problems="${problems}missing command did not print usage on stderr"$'\n'"$(cat "$stderr_file")"$'\n'
  fi
  if [[ -s "$stdout_file" ]]; then
    problems="${problems}missing command wrote to stdout"$'\n'
  fi

  "$UNTANGLE" launchd-setup -h >"$stdout_file" 2>"$stderr_file"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}launchd-setup -h exited $status"$'\n'"$(cat "$stderr_file")"$'\n'
  fi
  if grep -F -q -- 'unknown command' "$stderr_file"; then
    problems="${problems}launchd-setup was treated as unknown"$'\n'"$(cat "$stderr_file")"$'\n'
  fi

  "$UNTANGLE" no-such >"$stdout_file" 2>"$stderr_file"
  status=$?
  if [[ "$status" -eq 0 ]]; then
    problems="${problems}unknown command no-such exited 0"$'\n'
  fi
  if ! grep -F -q -- 'Usage: untangle <init|run|done|status|launchd-setup>' "$stderr_file"; then
    problems="${problems}unknown command no-such did not print usage on stderr"$'\n'"$(cat "$stderr_file")"$'\n'
  fi
  if ! grep -F -q -- "unknown command: no-such" "$stderr_file"; then
    problems="${problems}unknown command no-such did not name itself"$'\n'"$(cat "$stderr_file")"$'\n'
  fi
  if [[ -s "$stdout_file" ]]; then
    problems="${problems}unknown command no-such wrote to stdout"$'\n'
  fi

  mkdir -p "$TEST_ROOT/usage-empty"
  for cmd in done status; do
    invoke_in_repo "$TEST_ROOT/usage-empty" "$cmd" "$stdout_file" "$stderr_file"
    status=$?
    if [[ "$status" -eq 0 ]]; then
      problems="${problems}${cmd} without config exited 0"$'\n'
    fi
    if grep -F -q -- 'unknown command' "$stderr_file"; then
      problems="${problems}${cmd} was treated as unknown"$'\n'"$(cat "$stderr_file")"$'\n'
    fi
    if grep -F -q -- 'Usage:' "$stderr_file"; then
      problems="${problems}${cmd} printed usage"$'\n'"$(cat "$stderr_file")"$'\n'
    fi
  done

  mkdir -p "$TEST_ROOT/usage-run-config"
  (
    export UNTANGLE_CONFIG_DIR="$TEST_ROOT/usage-run-config"
    export UNTANGLE_NOW="2026-10-14T10:00:00"
    "$UNTANGLE" run >"$stdout_file" 2>"$stderr_file"
  )
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}run exited $status"$'\n'"$(cat "$stderr_file")"$'\n'
  fi
  if grep -F -q -- 'unknown command' "$stderr_file"; then
    problems="${problems}run was treated as unknown"$'\n'"$(cat "$stderr_file")"$'\n'
  fi
  if grep -F -q -- 'Usage:' "$stderr_file"; then
    problems="${problems}run printed usage on stderr"$'\n'"$(cat "$stderr_file")"$'\n'
  fi

  "$UNTANGLE" -h >"$stdout_file" 2>"$stderr_file"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}-h exited $status"$'\n'
  fi
  if ! grep -F -q -- 'Write the untangle directory, register cwd, and ensure the gitignore entry' "$stdout_file"; then
    problems="${problems}-h usage does not say init writes the directory, registers cwd, and ensures the gitignore entry"$'\n'
  fi
  if ! grep -F -q -- 'Consider each registered repository on Wednesday' "$stdout_file"; then
    problems="${problems}-h usage does not say run considers each registered repository on Wednesday"$'\n'
  fi
  if ! grep -F -q -- 'Clear the open plan and advance the cursor' "$stdout_file"; then
    problems="${problems}-h usage does not say done clears the open plan and advances the cursor"$'\n'
  fi
  if ! grep -F -q -- 'Show the cursor and the open plan' "$stdout_file"; then
    problems="${problems}-h usage does not say status shows the cursor and the open plan"$'\n'
  fi
  if ! grep -F -q -- 'launchd-setup' "$stdout_file"; then
    problems="${problems}-h usage does not mention launchd-setup"$'\n'
  fi

  "$UNTANGLE" --help >"$stdout_file" 2>"$stderr_file"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}--help exited $status"$'\n'
  fi
  if ! grep -F -q -- 'Write the untangle directory, register cwd, and ensure the gitignore entry' "$stdout_file"; then
    problems="${problems}--help usage does not say init writes the directory, registers cwd, and ensures the gitignore entry"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems"
    return
  fi
  pass "$test_name"
}

test_guide_omits_slowfriday_notes() {
  local test_name="guide omits pup, Datadog, planhat, simple-made-easy, and knot-or-untangle"
  local config_dir="$TEST_ROOT/guide-config"
  local gitignore_file="$TEST_ROOT/guide-gitignore"
  local repo_dir="$TEST_ROOT/guide-repo"
  local out_file="$TEST_ROOT/guide-out.txt"
  local guide="$repo_dir/untangle/guide.md"
  local status problems=""
  local word

  mkdir -p "$config_dir"
  printf '%s\n' '# keep' >"$gitignore_file"
  make_repo "$repo_dir"

  run_init "$repo_dir" "$config_dir" "$gitignore_file" >"$out_file" 2>&1
  status=$?
  if [[ "$status" -ne 0 ]]; then
    fail "$test_name" "init expected exit 0, got $status" "output:" "$(cat "$out_file")"
    return
  fi
  if [[ ! -f "$guide" ]]; then
    fail "$test_name" "missing guide.md"
    return
  fi

  for word in pup Datadog planhat simple-made-easy knot-or-untangle; do
    if grep -F -q -- "$word" "$guide"; then
      problems="${problems}guide.md contains ${word}"$'\n'
    fi
  done

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems"
    return
  fi
  pass "$test_name"
}

test_run_success_leaves_week_unstamped_and_probes_again() {
  local test_name="Wednesday probe success leaves the note absent, a second run probes again, and an unset probe runs one agent"
  local config_dir="$TEST_ROOT/run-ok-config"
  local repo_dir="$TEST_ROOT/run-ok-repo"
  local log="$TEST_ROOT/run-ok-log"
  local snapshot="$TEST_ROOT/run-ok-snapshot"
  local out_file="$TEST_ROOT/run-ok-out.txt"
  local repo_yml count ints status agents problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  repo_yml="$repo_dir/untangle/config.yml"
  use_probe_stub "$log" "$snapshot"
  RUN_PROBE_STATUS=0

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  ints=$(snapshot_int_count "$snapshot")
  agents=$(path_agent_invocations)
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}first run expected exit 0, got $status"$'\n'
  fi
  if [[ "$count" != "1" ]]; then
    problems="${problems}first run expected the probe once, got $count"$'\n'
  fi
  if [[ "$agents" != "0" ]]; then
    problems="${problems}first run executed agent, count=$agents"$'\n'
  fi
  if [[ "$ints" != "1" ]]; then
    problems="${problems}first run expected an integer progress_pid during the probe, got $ints"$'\n'"$(cat "$snapshot" 2>/dev/null || true)"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}first run wrote notes/261014.md"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: ${repo_dir} — week left unstamped" "$out_file"; then
    problems="${problems}first run did not say the week was left unstamped"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "progress_pid=absent"; then
    problems="${problems}first run left progress_pid set"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "version=int:1"; then
    problems="${problems}first run dropped version"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "trunk=blank"; then
    problems="${problems}first run dropped the blank trunk"$'\n'
  fi

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  ints=$(snapshot_int_count "$snapshot")
  agents=$(path_agent_invocations)
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}second run expected exit 0, got $status"$'\n'
  fi
  if [[ "$count" != "2" ]]; then
    problems="${problems}second run expected the probe again, got count $count"$'\n'
  fi
  if [[ "$ints" != "2" ]]; then
    problems="${problems}second run expected another integer progress_pid, got $ints"$'\n'
  fi
  if [[ "$agents" != "0" ]]; then
    problems="${problems}probe seam executed agent, count=$agents"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}second run wrote notes/261014.md"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "progress_pid=absent"; then
    problems="${problems}second run left progress_pid set"$'\n'
  fi

  RUN_PROBE=
  : >"$out_file"
  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  agents=$(path_agent_invocations)
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}unset probe expected exit 0, got $status"$'\n'
  fi
  if [[ "$count" != "2" ]]; then
    problems="${problems}unset probe invoked the probe, count=$count"$'\n'
  fi
  if [[ "$agents" != "1" ]]; then
    problems="${problems}unset probe expected one PATH agent, count=$agents"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}unset probe wrote notes/261014.md"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: ${repo_dir} — week left unstamped" "$out_file"; then
    problems="${problems}unset probe did not say the week was left unstamped"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "progress_pid=absent"; then
    problems="${problems}unset probe left progress_pid set"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_skips_when_current_note_exists() {
  local test_name="existing notes/261014.md skips the probe and keeps the file bytes"
  local config_dir="$TEST_ROOT/run-stamped-config"
  local repo_dir="$TEST_ROOT/run-stamped-repo"
  local log="$TEST_ROOT/run-stamped-log"
  local out_file="$TEST_ROOT/run-stamped-out.txt"
  local note="$repo_dir/untangle/notes/261014.md"
  local expected="$TEST_ROOT/run-stamped-expected"
  local status count problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  printf '%s\n' 'already stamped this week' >"$note"
  cp "$note" "$expected"
  use_probe_stub "$log"
  RUN_PROBE_STATUS=0

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ "$count" != "0" ]]; then
    problems="${problems}probe ran despite the stamp, count=$count"$'\n'
  fi
  if ! files_match "$expected" "$note"; then
    problems="${problems}notes/261014.md bytes changed"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: skip ${repo_dir} — week already stamped" "$out_file"; then
    problems="${problems}did not say the week was already stamped"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_probe_failure_retries_on_the_next_tick() {
  local test_name="probe failure leaves the week unstamped and a later success is invoked"
  local config_dir="$TEST_ROOT/run-fail-config"
  local repo_a="$TEST_ROOT/run-fail-repo-a"
  local repo_b="$TEST_ROOT/run-fail-repo-b"
  local log="$TEST_ROOT/run-fail-log"
  local snapshot="$TEST_ROOT/run-fail-snapshot"
  local out_file="$TEST_ROOT/run-fail-out.txt"
  local status count_a count_b ints problems=""

  reset_run_env
  prepare_registered_repo "$repo_a" "$config_dir" || {
    fail "$test_name" "prepare repo a failed"
    return
  }
  prepare_registered_repo "$repo_b" "$config_dir" || {
    fail "$test_name" "prepare repo b failed"
    return
  }
  use_probe_stub "$log" "$snapshot"
  RUN_PROBE_STATUS=1

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  count_a=$(path_count_in_log "$log" "$repo_a")
  count_b=$(path_count_in_log "$log" "$repo_b")
  ints=$(snapshot_int_count "$snapshot")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}failed probes expected exit 0, got $status"$'\n'
  fi
  if [[ "$count_a" != "1" || "$count_b" != "1" ]]; then
    problems="${problems}both repos should be probed once, got a=$count_a b=$count_b"$'\n'
  fi
  if [[ "$ints" != "2" ]]; then
    problems="${problems}expected an integer progress_pid during each probe, got $ints"$'\n'"$(cat "$snapshot" 2>/dev/null || true)"$'\n'
  fi
  if [[ -e "$repo_a/untangle/notes/261014.md" || -e "$repo_b/untangle/notes/261014.md" ]]; then
    problems="${problems}probe failure wrote a stamp note"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: skip ${repo_a} — probe failed; the week is unstamped" "$out_file"; then
    problems="${problems}repo a did not say the probe failed"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: skip ${repo_b} — probe failed; the week is unstamped" "$out_file"; then
    problems="${problems}repo b did not say the probe failed"$'\n'
  fi
  if ! yaml_expect "$repo_a/untangle/config.yml" "progress_pid=absent"; then
    problems="${problems}repo a left progress_pid set"$'\n'
  fi
  if ! yaml_expect "$repo_b/untangle/config.yml" "progress_pid=absent"; then
    problems="${problems}repo b left progress_pid set"$'\n'
  fi

  RUN_PROBE_STATUS=0
  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  count_a=$(path_count_in_log "$log" "$repo_a")
  count_b=$(path_count_in_log "$log" "$repo_b")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}retry expected exit 0, got $status"$'\n'
  fi
  if [[ "$count_a" != "2" || "$count_b" != "2" ]]; then
    problems="${problems}retry should probe both repos again, got a=$count_a b=$count_b"$'\n'
  fi
  if [[ -e "$repo_a/untangle/notes/261014.md" || -e "$repo_b/untangle/notes/261014.md" ]]; then
    problems="${problems}retry wrote a stamp note"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: ${repo_a} — week left unstamped" "$out_file"; then
    problems="${problems}retry did not leave repo a unstamped"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: ${repo_b} — week left unstamped" "$out_file"; then
    problems="${problems}retry did not leave repo b unstamped"$'\n'
  fi
  if ! yaml_expect "$repo_a/untangle/config.yml" "progress_pid=absent"; then
    problems="${problems}retry left progress_pid on repo a"$'\n'
  fi
  if ! yaml_expect "$repo_b/untangle/config.yml" "progress_pid=absent"; then
    problems="${problems}retry left progress_pid on repo b"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_preflight_fixture_failure_retries_when_cleared() {
  local test_name="preflight fixture failure skips the probe and a later run probes"
  local config_dir="$TEST_ROOT/run-preflight-config"
  local repo_dir="$TEST_ROOT/run-preflight-repo"
  local log="$TEST_ROOT/run-preflight-log"
  local snapshot="$TEST_ROOT/run-preflight-snapshot"
  local out_file="$TEST_ROOT/run-preflight-out.txt"
  local repo_yml="$repo_dir/untangle/config.yml"
  local status count problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  use_probe_stub "$log" "$snapshot"
  RUN_PROBE_STATUS=0
  RUN_PREFLIGHT=fail

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}preflight failure expected exit 0, got $status"$'\n'
  fi
  if [[ "$count" != "0" ]]; then
    problems="${problems}preflight failure invoked the probe, count=$count"$'\n'
  fi
  if [[ -e "$snapshot" ]]; then
    problems="${problems}preflight failure wrote a pid snapshot"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}preflight failure wrote notes/261014.md"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: skip ${repo_dir} — preflight failed; the next tick retries" "$out_file"; then
    problems="${problems}preflight failure did not say the next tick retries"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "progress_pid=absent"; then
    problems="${problems}preflight failure left progress_pid set"$'\n'
  fi

  RUN_PREFLIGHT=
  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}retry expected exit 0, got $status"$'\n'
  fi
  if [[ "$count" != "1" ]]; then
    problems="${problems}retry expected the probe once, got $count"$'\n'
  fi
  if [[ "$(snapshot_int_count "$snapshot")" != "1" ]]; then
    problems="${problems}retry did not record an integer progress_pid"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}retry wrote notes/261014.md"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "progress_pid=absent"; then
    problems="${problems}retry left progress_pid set"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_live_pid_blocks_probe() {
  local test_name="a live progress_pid blocks the probe and stays in the config"
  local config_dir="$TEST_ROOT/run-live-config"
  local repo_dir="$TEST_ROOT/run-live-repo"
  local log="$TEST_ROOT/run-live-log"
  local out_file="$TEST_ROOT/run-live-out.txt"
  local repo_yml holder status count problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  repo_yml="$repo_dir/untangle/config.yml"
  sleep 120 &
  holder=$!
  printf '%s\n' "$holder" >"$TEST_ROOT/sleeper-pid"
  yaml_set_progress_pid "$repo_yml" "$holder"
  use_probe_stub "$log"
  RUN_PROBE_STATUS=0

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  kill "$holder" 2>/dev/null || true
  wait "$holder" 2>/dev/null || true
  rm -f "$TEST_ROOT/sleeper-pid"

  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ "$count" != "0" ]]; then
    problems="${problems}probe ran while the pid was alive, count=$count"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}live pid wrote notes/261014.md"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: skip ${repo_dir} — in progress" "$out_file"; then
    problems="${problems}did not say the repo was in progress"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "progress_pid=int:$holder"; then
    problems="${problems}live pid was not left as integer $holder"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "version=int:1"; then
    problems="${problems}live skip dropped version"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "trunk=blank"; then
    problems="${problems}live skip dropped trunk"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_stale_pid_is_cleared_and_probe_runs() {
  local test_name="a dead progress_pid is cleared and the probe runs"
  local config_dir="$TEST_ROOT/run-stale-config"
  local repo_dir="$TEST_ROOT/run-stale-repo"
  local log="$TEST_ROOT/run-stale-log"
  local snapshot="$TEST_ROOT/run-stale-snapshot"
  local out_file="$TEST_ROOT/run-stale-out.txt"
  local repo_yml="$repo_dir/untangle/config.yml"
  local stale_pid=99999999
  local status count problems=""

  reset_run_env
  if kill -0 "$stale_pid" 2>/dev/null; then
    fail "$test_name" "pid $stale_pid is alive; cannot use it as a stale lock"
    return
  fi
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  yaml_set_progress_pid "$repo_yml" "$stale_pid"
  use_probe_stub "$log" "$snapshot"
  RUN_PROBE_STATUS=0
  RUN_PREFLIGHT=fail

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}preflight failure expected exit 0, got $status"$'\n'
  fi
  if [[ "$count" != "0" ]]; then
    problems="${problems}preflight failure invoked the probe, count=$count"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: ${repo_dir} — cleared a stale progress pid" "$out_file"; then
    problems="${problems}preflight failure did not say the stale progress pid was cleared"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "progress_pid=absent"; then
    problems="${problems}preflight failure left the dead progress pid set"$'\n'
  fi

  RUN_PREFLIGHT=
  yaml_set_progress_pid "$repo_yml" "$stale_pid"
  : >"$out_file"
  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ "$count" != "1" ]]; then
    problems="${problems}expected the probe once, got $count"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}stale pid run wrote notes/261014.md"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: ${repo_dir} — cleared a stale progress pid" "$out_file"; then
    problems="${problems}did not say the stale progress pid was cleared"$'\n'
  fi
  if ! yaml_expect "$repo_yml" "progress_pid=absent"; then
    problems="${problems}stale pid was not cleared"$'\n'
  fi
  if grep -F -q -- "int:${stale_pid} " "$snapshot" 2>/dev/null; then
    problems="${problems}probe ran while the stale pid was still stored"$'\n'
  fi
  if [[ "$(snapshot_int_count "$snapshot")" != "1" ]]; then
    problems="${problems}expected an integer progress_pid during the probe"$'\n'"$(cat "$snapshot" 2>/dev/null || true)"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_skips_tuesday_and_thursday() {
  local test_name="Tuesday and Thursday skip without probing and say not Wednesday"
  local config_dir="$TEST_ROOT/run-weekday-config"
  local repo_dir="$TEST_ROOT/run-weekday-repo"
  local log="$TEST_ROOT/run-weekday-log"
  local herdr_log="$TEST_ROOT/run-weekday-herdr"
  local out_file="$TEST_ROOT/run-weekday-out.txt"
  local status count problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  use_probe_stub "$log"
  RUN_PROBE_STATUS=0
  RUN_HERDR_LOG=$herdr_log

  invoke_run "$config_dir" "2026-10-13T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}Tuesday expected exit 0, got $status"$'\n'
  fi
  if [[ "$count" != "0" ]]; then
    problems="${problems}Tuesday invoked the probe, count=$count"$'\n'
  fi
  if [[ -s "$herdr_log" ]]; then
    problems="${problems}Tuesday called herdr"$'\n'"$(cat "$herdr_log")"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: skip ${repo_dir} — not Wednesday" "$out_file"; then
    problems="${problems}Tuesday output did not say not Wednesday"$'\n'
  fi
  if grep -F -q -- "outside the window" "$out_file"; then
    problems="${problems}Tuesday was reported as outside the window"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261013.md" || -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}Tuesday wrote a note"$'\n'
  fi

  : >"$out_file"
  invoke_run "$config_dir" "2026-10-15T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}Thursday expected exit 0, got $status"$'\n'
  fi
  if [[ "$count" != "0" ]]; then
    problems="${problems}Thursday invoked the probe, count=$count"$'\n'
  fi
  if [[ -s "$herdr_log" ]]; then
    problems="${problems}Thursday called herdr"$'\n'"$(cat "$herdr_log")"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: skip ${repo_dir} — not Wednesday" "$out_file"; then
    problems="${problems}Thursday output did not say not Wednesday"$'\n'
  fi
  if grep -F -q -- "outside the window" "$out_file"; then
    problems="${problems}Thursday was reported as outside the window"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261015.md" || -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}Thursday wrote a note"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_window_edges() {
  local test_name="Wednesday window skips 07:59 and 16:00 and probes 08:00 and 15:30"
  local config_dir="$TEST_ROOT/run-window-config"
  local repo_dir="$TEST_ROOT/run-window-repo"
  local log="$TEST_ROOT/run-window-log"
  local herdr_log="$TEST_ROOT/run-window-herdr"
  local out_file="$TEST_ROOT/run-window-out.txt"
  local status count problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  use_probe_stub "$log"
  RUN_PROBE_STATUS=0
  RUN_HERDR_LOG=$herdr_log

  invoke_run "$config_dir" "2026-10-14T07:59:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}07:59 expected exit 0, got $status"$'\n'
  fi
  if [[ "$count" != "0" ]]; then
    problems="${problems}07:59 invoked the probe, count=$count"$'\n'
  fi
  if [[ -s "$herdr_log" ]]; then
    problems="${problems}07:59 called herdr"$'\n'"$(cat "$herdr_log")"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: skip ${repo_dir} — outside the window" "$out_file"; then
    problems="${problems}07:59 did not say outside the window"$'\n'
  fi
  if grep -F -q -- "not Wednesday" "$out_file"; then
    problems="${problems}07:59 was reported as not Wednesday"$'\n'
  fi

  invoke_run "$config_dir" "2026-10-14T16:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}16:00 expected exit 0, got $status"$'\n'
  fi
  if [[ "$count" != "0" ]]; then
    problems="${problems}16:00 invoked the probe, count=$count"$'\n'
  fi
  if [[ -s "$herdr_log" ]]; then
    problems="${problems}16:00 called herdr"$'\n'"$(cat "$herdr_log")"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: skip ${repo_dir} — outside the window" "$out_file"; then
    problems="${problems}16:00 did not say outside the window"$'\n'
  fi
  if grep -F -q -- "not Wednesday" "$out_file"; then
    problems="${problems}16:00 was reported as not Wednesday"$'\n'
  fi

  invoke_run "$config_dir" "2026-10-14T08:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}08:00 expected exit 0, got $status"$'\n'
  fi
  if [[ "$count" != "1" ]]; then
    problems="${problems}08:00 expected the probe once, got $count"$'\n'
  fi
  if grep -F -q -- "outside the window" "$out_file"; then
    problems="${problems}08:00 was reported as outside the window"$'\n'
  fi
  if grep -F -q -- "not Wednesday" "$out_file"; then
    problems="${problems}08:00 was reported as not Wednesday"$'\n'
  fi

  invoke_run "$config_dir" "2026-10-14T15:30:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}15:30 expected exit 0, got $status"$'\n'
  fi
  if [[ "$count" != "2" ]]; then
    problems="${problems}15:30 expected a second probe, got $count"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}inside-window run wrote notes/261014.md"$'\n'
  fi
  if ! yaml_expect "$repo_dir/untangle/config.yml" "progress_pid=absent"; then
    problems="${problems}inside-window run left progress_pid set"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_two_repos_probes_only_the_unstamped_one() {
  local test_name="only the repo without notes/261014.md is probed"
  local config_dir="$TEST_ROOT/run-two-config"
  local stamped="$TEST_ROOT/run-two-stamped"
  local open="$TEST_ROOT/run-two-open"
  local log="$TEST_ROOT/run-two-log"
  local out_file="$TEST_ROOT/run-two-out.txt"
  local note="$stamped/untangle/notes/261014.md"
  local expected="$TEST_ROOT/run-two-expected"
  local status stamped_count open_count problems=""

  reset_run_env
  prepare_registered_repo "$stamped" "$config_dir" || {
    fail "$test_name" "prepare stamped repo failed"
    return
  }
  prepare_registered_repo "$open" "$config_dir" || {
    fail "$test_name" "prepare open repo failed"
    return
  }
  printf '%s\n' 'this week is done' >"$note"
  cp "$note" "$expected"
  use_probe_stub "$log"
  RUN_PROBE_STATUS=0

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  stamped_count=$(path_count_in_log "$log" "$stamped")
  open_count=$(path_count_in_log "$log" "$open")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ "$stamped_count" != "0" ]]; then
    problems="${problems}stamped repo was probed, count=$stamped_count"$'\n'
  fi
  if [[ "$open_count" != "1" ]]; then
    problems="${problems}unstamped repo expected one probe, got $open_count"$'\n'
  fi
  if ! files_match "$expected" "$note"; then
    problems="${problems}stamped note bytes changed"$'\n'
  fi
  if [[ -e "$open/untangle/notes/261014.md" ]]; then
    problems="${problems}unstamped repo gained notes/261014.md"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_older_note_does_not_stamp_this_week() {
  local test_name="notes/261014.md is not the 2026-10-21 stamp and is left unchanged"
  local config_dir="$TEST_ROOT/run-old-config"
  local repo_dir="$TEST_ROOT/run-old-repo"
  local log="$TEST_ROOT/run-old-log"
  local out_file="$TEST_ROOT/run-old-out.txt"
  local note="$repo_dir/untangle/notes/261014.md"
  local expected="$TEST_ROOT/run-old-expected"
  local status count problems=""

  reset_run_env
  prepare_registered_repo "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  printf '%s\n' 'an older Wednesday stays put' >"$note"
  cp "$note" "$expected"
  use_probe_stub "$log"
  RUN_PROBE_STATUS=0

  invoke_run "$config_dir" "2026-10-21T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ "$count" != "1" ]]; then
    problems="${problems}older note should not stamp this Wednesday, probe count=$count"$'\n'
  fi
  if ! files_match "$expected" "$note"; then
    problems="${problems}notes/261014.md bytes changed"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261021.md" ]]; then
    problems="${problems}run wrote notes/261021.md"$'\n'
  fi
  if ! yaml_expect "$repo_dir/untangle/config.yml" "progress_pid=absent"; then
    problems="${problems}run left progress_pid set"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

test_run_plain_directory_fails_preflight() {
  local test_name="a directory that is not a git work tree fails preflight without a fixture"
  local config_dir="$TEST_ROOT/run-plain-config"
  local repo_dir="$TEST_ROOT/run-plain-repo"
  local log="$TEST_ROOT/run-plain-log"
  local out_file="$TEST_ROOT/run-plain-out.txt"
  local status count problems=""

  reset_run_env
  prepare_registered_plain_dir "$repo_dir" "$config_dir" || {
    fail "$test_name" "prepare failed"
    return
  }
  if git -C "$repo_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    fail "$test_name" "fixture directory is inside a work tree, so preflight would pass"
    return
  fi
  use_probe_stub "$log"
  RUN_PROBE_STATUS=0

  invoke_run "$config_dir" "2026-10-14T10:00:00" "$out_file"
  status=$?
  count=$(path_count_in_log "$log" "$repo_dir")
  if [[ "$status" -ne 0 ]]; then
    problems="${problems}expected exit 0, got $status"$'\n'
  fi
  if [[ "$count" != "0" ]]; then
    problems="${problems}probe ran, count=$count"$'\n'
  fi
  if [[ -e "$repo_dir/untangle/notes/261014.md" ]]; then
    problems="${problems}preflight failure wrote notes/261014.md"$'\n'
  fi
  if ! grep -F -x -q -- "untangle: skip ${repo_dir} — preflight failed; the next tick retries" "$out_file"; then
    problems="${problems}did not say preflight failed"$'\n'
  fi
  if ! yaml_expect "$repo_dir/untangle/config.yml" "progress_pid=absent"; then
    problems="${problems}preflight failure left progress_pid set"$'\n'
  fi

  if [[ -n "$problems" ]]; then
    fail "$test_name" "$problems" "output:" "$(cat "$out_file")"
    return
  fi
  pass "$test_name"
}

