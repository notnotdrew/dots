#!/usr/bin/env bash
# Start Cursor Agent with the pare-code skill.
#
# Lives in ~/dots/bin (exposed as ~/bin via update_symlinks).
#
#   pc                  /pare-code
#   pc "on head"        /pare-code "on head"
#   pc path/to-file     /pare-code path/to-file
set -euo pipefail

prompt=/pare-code
if [[ $# -gt 0 ]]; then
  target="$*"
  case "$target" in
    *[[:space:]]*|*[\"\\]*)
      target=${target//\\/\\\\}
      target=${target//\"/\\\"}
      prompt="/pare-code \"${target}\""
      ;;
    *)
      prompt="/pare-code ${target}"
      ;;
  esac
fi

exec agent "$prompt"
