#!/usr/bin/env bash
# Phase 5 coordinator: discover → implement → draft PR → Standard review → optional fix → ping → LaunchAgent
#
# Usage:
#   inchworm init
#   inchworm run
#   inchworm status
#   inchworm review

set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
SCRIPT_DIR="$(CDPATH= cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_NAME
readonly SCRIPT_DIR

YAML_HELPER="${SCRIPT_DIR}/lib/inchworm_yaml.rb"
FINDS_HELPER="${SCRIPT_DIR}/lib/inchworm_finds.rb"
REVIEW_HELPER="${SCRIPT_DIR}/lib/inchworm_review.rb"
readonly YAML_HELPER
readonly FINDS_HELPER
readonly REVIEW_HELPER

CONFIG_DIR="${INCHWORM_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/inchworm}"
CONFIG_FILE="${CONFIG_DIR}/config.yml"
DATA_DIR="${INCHWORM_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/inchworm}"
GH_BIN="${INCHWORM_GH:-gh}"
WT_BIN="${INCHWORM_WT:-wt}"
GITIGNORE_GLOBAL="${INCHWORM_GITIGNORE_GLOBAL:-$HOME/.gitignore_global}"
CURSOR_PROJECTS_DIR="${INCHWORM_CURSOR_PROJECTS_DIR:-${CURSOR_DATA_DIR:-$HOME/.cursor}/projects}"

die() {
  printf '%s: error: %s\n' "$SCRIPT_NAME" "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: inchworm <init|run|status|review|launchd-setup>

  init           Write repo .inchworm.yml, register cwd in global config, ensure gitignore
  run            Eligible repos: stamp + discover + implement + draft PR + review/fix/ping
  status         Show registered repos, last_run_date, create window, draft gate
  review         List open drafts, switch Worktrunk, launch a discuss agent
  launchd-setup  Install FDA-scoped runner + generate user-local LaunchAgent plist

New machine:
  1. Ensure ~/bin/inchworm is on PATH (e.g. dots update_symlinks)
  2. inchworm launchd-setup
  3. Grant Full Disk Access to the printed runner path only
  4. inchworm status   # confirm create window / registered repos

New repo:
  1. cd /path/to/repo
  2. inchworm init
  3. Optional: edit .inchworm.yml
       guidance      repo notes for agents
       branch_prefix branch namespace (defaults to git user.name)
EOF
}

# Prefer mise Ruby even under LaunchAgent (minimal PATH, no shell init).
resolve_mise() {
  local candidate
  if command -v mise >/dev/null 2>&1; then
    command -v mise
    return 0
  fi
  for candidate in \
    "${HOME}/.local/bin/mise" \
    /opt/homebrew/bin/mise \
    /usr/local/bin/mise
  do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

ruby_helper() {
  local helper=$1
  shift
  local mise_bin
  if mise_bin=$(resolve_mise); then
    "$mise_bin" exec -- ruby "$helper" "$@"
  else
    ruby "$helper" "$@"
  fi
}

ruby_yaml() { ruby_helper "$YAML_HELPER" "$@"; }
ruby_finds() { ruby_helper "$FINDS_HELPER" "$@"; }
ruby_review() { ruby_helper "$REVIEW_HELPER" "$@"; }

# One field of a stored find (title, summary, evidence); empty when unknown.
find_field() {
  local repo_path=$1
  local find_id=$2
  local field=$3
  ruby_finds field "$repo_path" "$DATA_DIR" "$find_id" "$field" 2>/dev/null || printf ''
}

# Default Standard pr-review launcher: INCHWORM_PR_REVIEW, else sibling bin/pr-review, else PATH.
resolve_pr_review_bin() {
  if [[ -n "${INCHWORM_PR_REVIEW:-}" ]]; then
    printf '%s\n' "$INCHWORM_PR_REVIEW"
    return
  fi
  if [[ -x "${SCRIPT_DIR}/pr-review" ]]; then
    printf '%s\n' "${SCRIPT_DIR}/pr-review"
    return
  fi
  if command -v pr-review >/dev/null 2>&1; then
    command -v pr-review
    return
  fi
  printf '%s\n' "${SCRIPT_DIR}/pr-review"
}

# Read optional .inchworm.yml `guidance` (plain text for agents). Empty/missing → "".
load_repo_guidance() {
  local repo_yml=$1
  local raw

  if [[ ! -f "$repo_yml" ]]; then
    return 0
  fi
  raw=$(ruby_yaml get "$repo_yml" "guidance")
  if [[ "$raw" == "null" || -z "${raw//[[:space:]]/}" ]]; then
    return 0
  fi
  printf '%s' "$raw"
}

# Append a "## Repo guidance" block when guidance is non-empty.
append_repo_guidance_block() {
  local guidance=$1
  if [[ -z "${guidance//[[:space:]]/}" ]]; then
    return 0
  fi
  printf '\n## Repo guidance\n\n%s\n' "$guidance"
}

# Shared scout contract: JSON array per candidate-schema (id, source, title, summary, rank, status).
scout_prompt_for() {
  local source=$1
  local out_file=$2
  local guidance=${3:-}
  local role_blurb
  local evidence_blurb="Put a link or file path in evidence — whatever a reviewer would open to see why this is worth doing."
  case "$source" in
    smell)
      role_blurb="Scan for small, high-value cleanup finds: unused helpers, dead branches, obvious duplication that fits a thin PR."
      ;;
    lint)
      role_blurb="Surface actionable lint / static-analysis debt that is safe to fix in isolation."
      ;;
    errors)
      role_blurb="Surface recurring runtime or CI errors that look fixable without product redesign."
      evidence_blurb="Put the error's URL in evidence — the Honeybadger fault or CI run a reviewer would open. Include the fault id when you have one."
      ;;
    backlog)
      role_blurb="Pull small, already-agreed backlog items that are ready to implement as a thin PR."
      evidence_blurb="Put the issue's URL or key in evidence, e.g. the Linear ticket the work came from."
      ;;
    *)
      role_blurb="Propose small, concrete, rankable finds."
      ;;
  esac

  cat <<EOF
You are the ${source} scout for inchworm.

${role_blurb}

Emit source: "${source}". Prefer few concrete finds. If none, write an empty array.

Write your answer as a JSON array to the file ${out_file} — nothing else belongs in that file. Each object must include:
id (slug without F- prefix), source ("${source}"), title, summary, rank (integer, lower is better), status ("open" or "new"); optional evidence (string).

Write title and summary for a person, not a machine: the title reads like a commit subject, and the summary says why the change is worth making. ${evidence_blurb}
EOF
  append_repo_guidance_block "$guidance"
}

# Run one live scout. Candidates come from the scout's output file; stdout is a
# fallback for agents that print the array instead of writing it.
run_live_scout() {
  local repo_path=$1
  local source=$2
  local out_file=$3
  local guidance=${4:-}
  local agent_bin="${INCHWORM_AGENT:-agent}"
  local prompt raw status=0 extracted

  prompt=$(scout_prompt_for "$source" "$out_file" "$guidance")
  raw=$(
    cd "$repo_path" || exit 1
    "$agent_bin" -p "$prompt"
  ) || status=$?

  if [[ "$status" -ne 0 ]]; then
    printf 'inchworm: %s scout failed (exit %s) — treating as no candidates\n' \
      "$source" "$status" >&2
  fi

  if [[ -s "$out_file" ]] && extracted=$(ruby_finds extract_json_array <"$out_file" 2>/dev/null); then
    printf '%s\n' "$extracted" >"$out_file"
    return 0
  fi

  if extracted=$(printf '%s\n' "$raw" | ruby_finds extract_json_array 2>/dev/null); then
    printf '%s\n' "$extracted" >"$out_file"
    return 0
  fi

  printf '[]\n' >"$out_file"
  if [[ "$status" -eq 0 ]]; then
    printf 'inchworm: %s scout returned no usable candidates\n' "$source" >&2
  fi
}

# Discover: scouts (fixtures or live smell/lint/errors/backlog) → curator merge → pick.
discover_pipeline() {
  local repo_path=$1
  local scout_dir
  local cleanup_scout_dir=0
  local source
  local guidance

  if [[ -n "${INCHWORM_SCOUT_FIXTURE_DIR:-}" ]]; then
    scout_dir="$INCHWORM_SCOUT_FIXTURE_DIR"
  else
    scout_dir=$(mktemp -d "${TMPDIR:-/tmp}/inchworm-scouts.XXXXXX")
    cleanup_scout_dir=1
    guidance=$(load_repo_guidance "${repo_path}/.inchworm.yml")
    for source in smell lint errors backlog; do
      run_live_scout "$repo_path" "$source" "${scout_dir}/${source}.json" "$guidance"
    done
  fi

  ruby_finds discover "$repo_path" "$DATA_DIR" "$scout_dir"
  if [[ "$cleanup_scout_dir" -eq 1 ]]; then
    rm -rf "$scout_dir"
  fi
}

# Resolve injectable clock: INCHWORM_NOW=YYYY-MM-DDTHH:MM:SS or real local now.
current_now() {
  if [[ -n "${INCHWORM_NOW:-}" ]]; then
    printf '%s\n' "$INCHWORM_NOW"
  else
    date '+%Y-%m-%dT%H:%M:%S'
  fi
}

# Print: date weekday hour minute from INCHWORM_NOW / real now (weekday: 1=Mon..7=Sun).
parse_clock() {
  ruby_yaml parse_now "$(current_now)"
}

yyyymmdd_from_today() {
  local today=$1
  printf '%s' "$today" | tr -d '-'
}

# Lowercase alnum/hyphen slug for one branch-name component.
slugify() {
  local raw=$1
  local fallback=$2
  local max=$3
  local slug
  slug=$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g; s/--*/-/g; s/^-//; s/-$//')
  if [[ -z "$slug" ]]; then
    slug="$fallback"
  fi
  printf '%s\n' "${slug:0:$max}"
}

# Short slug for branch: keep alnum/hyphen from find id.
branch_slug_from_id() {
  local find_id=$1
  slugify "${find_id#[Ff]-}" "find" 48
}

# Branch prefix: repo config, else the git identity of whoever owns the repo.
# The prefix is the first thing a reviewer sees, so it names a person.
resolve_branch_prefix() {
  local repo_path=$1
  local repo_yml=$2
  local raw=""

  if [[ -n "${INCHWORM_BRANCH_PREFIX:-}" ]]; then
    raw="$INCHWORM_BRANCH_PREFIX"
  else
    raw=$(ruby_yaml get "$repo_yml" "branch_prefix" 2>/dev/null || printf '')
    if [[ "$raw" == "null" ]]; then
      raw=""
    fi
    if [[ -z "${raw//[[:space:]]/}" ]]; then
      raw=$(git -C "$repo_path" config user.name 2>/dev/null || printf '')
    fi
    if [[ -z "${raw//[[:space:]]/}" ]]; then
      raw=$(git -C "$repo_path" config user.email 2>/dev/null | cut -d '@' -f1)
    fi
  fi

  slugify "$raw" "dev" 32
}

# Hardcoded implement base: always freshly fetched origin/develop (not HEAD / origin/HEAD).
IMPLEMENT_BASE_REMOTE_REF="origin/develop"
IMPLEMENT_BASE_BRANCH="develop"

# Fetch origin and resolve origin/develop for implement worktrees / commit checks.
# Prints origin/develop on success. On failure prints nothing and returns non-zero
# (caller soft-defers). Fixture mode may fall back to local HEAD so harness repos
# without a remote keep working.
resolve_implement_base() {
  local repo_path=$1
  local fixture=${2:-}
  local reason_file=${3:-}

  if ! git -C "$repo_path" remote get-url origin >/dev/null 2>&1; then
    if [[ -n "$fixture" ]]; then
      git -C "$repo_path" rev-parse --abbrev-ref HEAD 2>/dev/null || printf 'HEAD\n'
      return 0
    fi
    [[ -n "$reason_file" ]] && printf 'no origin — cannot base implement on origin/develop\n' >"$reason_file"
    return 1
  fi

  if ! git -C "$repo_path" fetch origin; then
    if [[ -n "$fixture" ]]; then
      git -C "$repo_path" rev-parse --abbrev-ref HEAD 2>/dev/null || printf 'HEAD\n'
      return 0
    fi
    [[ -n "$reason_file" ]] && printf 'git fetch origin failed — cannot refresh origin/develop\n' >"$reason_file"
    return 1
  fi

  if git -C "$repo_path" rev-parse --verify --quiet "$IMPLEMENT_BASE_REMOTE_REF" >/dev/null; then
    printf '%s\n' "$IMPLEMENT_BASE_REMOTE_REF"
    return 0
  fi

  if [[ -n "$fixture" ]]; then
    git -C "$repo_path" rev-parse --abbrev-ref HEAD 2>/dev/null || printf 'HEAD\n'
    return 0
  fi

  [[ -n "$reason_file" ]] && printf 'origin/develop missing after fetch — cannot create implement worktree\n' >"$reason_file"
  return 1
}

ensure_gitignore_entries() {
  local file=$1
  local line
  touch "$file"
  for line in ".inchworm.yml" ".inchworm/"; do
    if ! grep -Fxq -- "$line" "$file"; then
      printf '%s\n' "$line" >>"$file"
    fi
  done
}

list_registered_repos() {
  if [[ -n "${INCHWORM_REPO:-}" ]]; then
    printf '%s\n' "$INCHWORM_REPO"
    return
  fi
  if [[ ! -f "$CONFIG_FILE" ]]; then
    return
  fi
  ruby_yaml list_repos "$CONFIG_FILE"
}

gh_pr_list_json() {
  local repo_path=$1
  (
    cd "$repo_path" || exit 1
    "$GH_BIN" pr list --author @me --state open --json number,url,isDraft,headRefName
  )
}

# Blocking = an open draft of ours: the PR we recorded, or a branch we would have
# created. Both are confirmed against the live PR list, never trusted on their own.
find_blocking_draft() {
  local repo_path=$1
  local repo_yml=$2
  local json branch_prefix recorded_url
  branch_prefix=$(resolve_branch_prefix "$repo_path" "$repo_yml")
  recorded_url=$(ruby_yaml get "$repo_yml" "state.active_draft_pr")
  json=$(gh_pr_list_json "$repo_path") || json='[]'
  printf '%s' "$json" | ruby_yaml find_blocking_draft "$branch_prefix" "$recorded_url"
}

# All gate-shaped open drafts across registered repos: repo, number, url, head.
collect_open_review_drafts() {
  local repo_path repo_yml json branch_prefix recorded_url
  while IFS= read -r repo_path || [[ -n "$repo_path" ]]; do
    [[ -z "$repo_path" ]] && continue
    repo_yml="${repo_path}/.inchworm.yml"
    [[ -f "$repo_yml" ]] || continue
    branch_prefix=$(resolve_branch_prefix "$repo_path" "$repo_yml")
    recorded_url=$(ruby_yaml get "$repo_yml" "state.active_draft_pr")
    json=$(gh_pr_list_json "$repo_path") || json='[]'
    printf '%s' "$json" | ruby_yaml list_matching_drafts "$branch_prefix" "$recorded_url" \
      | while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" ]] && continue
        printf '%s\t%s\n' "$repo_path" "$line"
      done
  done < <(list_registered_repos)
}

print_review_draft_list() {
  local index=1 line repo_path number url head
  printf 'inchworm: open drafts:\n'
  for line in "${REVIEW_DRAFTS[@]}"; do
    IFS=$'\t' read -r repo_path number url head <<<"$line"
    printf '  %d. %s  %s  %s\n' "$index" "$repo_path" "$head" "$url"
    index=$((index + 1))
  done
}

# Pick one collected draft line from a PR URL, PR number, or repo path.
match_review_selector() {
  local selector=$1
  local line repo_path number url head repo_abs selector_path
  local matches=()

  if [[ "$selector" == http://* || "$selector" == https://* ]]; then
    for line in "${REVIEW_DRAFTS[@]}"; do
      IFS=$'\t' read -r repo_path number url head <<<"$line"
      if [[ "$url" == "$selector" ]]; then
        matches+=("$line")
      fi
    done
  elif [[ -d "$selector" ]]; then
    selector_path=$(CDPATH= cd "$selector" && pwd)
    for line in "${REVIEW_DRAFTS[@]}"; do
      IFS=$'\t' read -r repo_path number url head <<<"$line"
      repo_abs=$(CDPATH= cd "$repo_path" 2>/dev/null && pwd) || repo_abs=$repo_path
      if [[ "$repo_abs" == "$selector_path" ]]; then
        matches+=("$line")
      fi
    done
  elif [[ "$selector" =~ ^[0-9]+$ ]]; then
    for line in "${REVIEW_DRAFTS[@]}"; do
      IFS=$'\t' read -r repo_path number url head <<<"$line"
      if [[ "$number" == "$selector" ]]; then
        matches+=("$line")
      fi
    done
  else
    die "unknown review selector: $selector"
  fi

  if [[ ${#matches[@]} -eq 0 ]]; then
    die "no open draft matches $selector"
  fi
  if [[ ${#matches[@]} -gt 1 ]]; then
    die "selector $selector matches ${#matches[@]} drafts; pass a PR URL or number"
  fi
  printf '%s\n' "${matches[0]}"
}

review_agent_prompt() {
  cat <<'EOF'
Review the PR for this branch and be prepared to discuss it. Before discussing, check for odd agent-like relics left by the agent that worked on it: unnecessary or overly verbose comments, "tombstone" comments or specs, and similar leftovers. If you find any, address them and fold them into the existing commits on this branch only (amend or squash; do not add a stack of cleanup commits named after tooling). Then git push --force-with-lease. Briefly summarize those changes. If there are no relics, say so and discuss the PR. Do not name the daily runner in commit messages or PR copy; path-shaped mentions are fine. Never force-push develop or main.
EOF
}

# Attach or create a Worktrunk checkout of an existing draft branch (not origin/develop).
attach_review_worktree() {
  local repo_path=$1
  local branch_name=$2
  local switch_output worktree_path
  local -a switch_args

  if ! command -v "$WT_BIN" >/dev/null 2>&1; then
    printf 'inchworm: Worktrunk (wt) is required but not found\n' >&2
    return 1
  fi

  git -C "$repo_path" fetch origin --prune >/dev/null 2>&1 || true

  switch_args=(switch --no-cd --format json --clobber)
  if git -C "$repo_path" show-ref --verify --quiet "refs/heads/${branch_name}"; then
    switch_args+=("$branch_name")
  elif git -C "$repo_path" show-ref --verify --quiet "refs/remotes/origin/${branch_name}"; then
    switch_args+=(--create --base="origin/${branch_name}" "$branch_name")
  else
    printf 'inchworm: branch %s not found locally or on origin\n' "$branch_name" >&2
    return 1
  fi

  if ! switch_output=$("$WT_BIN" -C "$repo_path" -y "${switch_args[@]}"); then
    return 1
  fi
  worktree_path=$(printf '%s\n' "$switch_output" | worktree_path_from_wt_json) || return 1
  ensure_workspace_trusted "$worktree_path" "$repo_path"
  printf '%s\n' "$worktree_path"
}

# Create-window label for status: open | closed (weekend|before 08:00|at/after 15:00)
window_label_for() {
  local weekday=$1 hour=$2 minute=$3
  local mins=$((10#$hour * 60 + 10#$minute))
  if [[ "$weekday" -gt 5 ]]; then
    printf 'closed (weekend)\n'
  elif [[ "$mins" -lt $((8 * 60)) ]]; then
    printf 'closed (before 08:00)\n'
  elif [[ "$mins" -ge $((15 * 60)) ]]; then
    printf 'closed (at/after 15:00)\n'
  else
    printf 'open\n'
  fi
}

# First JSON object on wt --format json stdout (progress text may follow).
worktree_path_from_wt_json() {
  ruby -rjson -e '
    line = STDIN.read.each_line.find { |row| row.lstrip.start_with?("{") }
    abort "wt json: no object" if line.nil?
    path = JSON.parse(line)["path"]
    abort "wt json: missing path" if path.nil? || path.to_s.empty?
    puts path
  '
}

# Worktrunk checkout on <prefix>/<slug>-<YYYYMMDD> from origin/develop (after fetch).
# Prints the absolute checkout path. Reuses an existing branch without --create.
# Returns non-zero when base cannot be resolved (unless fixture fallback applies).
create_implement_worktree() {
  local repo_path=$1
  local branch_name=$2
  local fixture=${3:-}
  local base_ref reason_file switch_output worktree_path
  local -a switch_args

  if ! command -v "$WT_BIN" >/dev/null 2>&1; then
    printf 'inchworm: Worktrunk (wt) is required but not found\n' >&2
    return 1
  fi

  reason_file=$(mktemp)
  if ! base_ref=$(resolve_implement_base "$repo_path" "$fixture" "$reason_file"); then
    printf 'inchworm: %s' "$(cat "$reason_file")" >&2
    printf '\n' >&2
    rm -f "$reason_file"
    return 1
  fi
  rm -f "$reason_file"

  cleanup_implement_worktree "$repo_path" "" "$branch_name"

  switch_args=(switch --no-cd --format json --clobber)
  if git -C "$repo_path" show-ref --verify --quiet "refs/heads/${branch_name}"; then
    switch_args+=("$branch_name")
  else
    switch_args+=(--create --base="$base_ref" "$branch_name")
  fi

  if ! switch_output=$("$WT_BIN" -C "$repo_path" -y "${switch_args[@]}"); then
    return 1
  fi
  worktree_path=$(printf '%s\n' "$switch_output" | worktree_path_from_wt_json) || return 1

  ensure_workspace_trusted "$worktree_path" "$repo_path"
  printf '%s\n' "$worktree_path"
}

# The agent CLI refuses to start in an untrusted directory, and a fresh worktree is
# never trusted — fatal here because the run is non-interactive and --trust is
# forbidden. Trust is a marker file keyed by a slug of the workspace's *physical*
# path (the agent resolves symlinks), so resolve before slugifying.
workspace_trust_slug() {
  printf '%s' "$1" | sed 's/[^a-zA-Z0-9]/-/g; s/--*/-/g; s/^-*//; s/-*$//'
}

# Mirrors the marker the CLI writes itself when a workspace inherits trust from a
# parent, so a worktree we created from an already-trusted repo starts unattended.
ensure_workspace_trusted() {
  local worktree_path=$1
  local repo_path=$2
  local physical slug marker_dir marker

  physical=$(CDPATH= cd "$worktree_path" 2>/dev/null && pwd -P) || return 0
  slug=$(workspace_trust_slug "$physical")
  [[ -n "$slug" ]] || return 0

  marker_dir="${CURSOR_PROJECTS_DIR}/${slug}"
  marker="${marker_dir}/.workspace-trusted"
  [[ -f "$marker" ]] && return 0

  if ! mkdir -p "$marker_dir" 2>/dev/null; then
    printf 'inchworm: warning: could not create %s (agent may refuse the worktree)\n' \
      "$marker_dir" >&2
    return 0
  fi
  printf '{\n  "trustedAt": "%s",\n  "workspacePath": "%s",\n  "trustMethod": "inherited",\n  "sourceWorkspacePath": "%s"\n}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%S.000Z)" "$physical" "$repo_path" >"$marker" || {
    printf 'inchworm: warning: could not write %s (agent may refuse the worktree)\n' \
      "$marker" >&2
  }
}

# Remove the implement Worktrunk checkout; keep the implement branch.
# Never deletes develop / main / master. Prefers branch name; path is fallback.
cleanup_implement_worktree() {
  local repo_path=$1
  local worktree_path=${2:-}
  local branch_name=${3:-}
  local target=""
  local repo_physical=""
  local target_physical=""

  case "$branch_name" in
    develop|main|master)
      printf 'inchworm: refusing to remove protected branch %s\n' "$branch_name" >&2
      return 0
      ;;
  esac

  if [[ -n "$branch_name" ]]; then
    target=$branch_name
  elif [[ -n "$worktree_path" ]]; then
    repo_physical=$(CDPATH= cd "$repo_path" 2>/dev/null && pwd -P) || repo_physical=$repo_path
    target_physical=$(CDPATH= cd "$worktree_path" 2>/dev/null && pwd -P) || target_physical=$worktree_path
    if [[ "$target_physical" == "$repo_physical" ]]; then
      printf 'inchworm: refusing to remove the primary checkout\n' >&2
      return 0
    fi
    target=$worktree_path
  else
    return 0
  fi

  if ! command -v "$WT_BIN" >/dev/null 2>&1; then
    return 0
  fi
  "$WT_BIN" -C "$repo_path" -y remove --no-delete-branch --force --foreground "$target" >/dev/null 2>&1 || true
}

# Scratch dir for agent-written PR copy. Sits under the already-gitignored
# .inchworm/ path so the draft never becomes part of the commit.
PR_DRAFT_DIR=".inchworm/pr"

# Anything a human sees — branch, commit, PR — is written as the author's own
# work. This is the guard against the runner naming itself in that copy.
# The name only leaks when it reads as a word. Path components are exempt: a
# leading `.` or `/` does not count (`.inchworm/pr`, `bin/inchworm`). A name
# that *starts* the string still counts (`inchworm/…` as a branch). Plain
# `grep -w` would still match those paths.
TOOL_NAME_RE='(^|[^[:alnum:]_./])inchworm([^[:alnum:]_]|$)'

mentions_tool_name() {
  printf '%s' "$1" | grep -qiE "$TOOL_NAME_RE"
}

# Trim, drop a leading markdown heading marker, cap at a reviewable length.
clean_pr_title() {
  local raw=$1
  raw=${raw//$'\r'/}
  raw=$(printf '%s' "$raw" | sed 's/^#\{1,6\}[[:space:]]*//; s/^[[:space:]]*//; s/[[:space:]]*$//')
  printf '%s' "${raw:0:100}"
}

# Sentence-case subject without a trailing period, Tim Pope length.
subject_from_title() {
  local raw=$1
  raw=$(printf '%s' "$raw" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/\.$//')
  if [[ -z "$raw" ]]; then
    printf 'Apply small fix'
    return
  fi
  printf '%s%s' "$(printf '%s' "${raw:0:1}" | tr '[:lower:]' '[:upper:]')" "${raw:1:71}"
}

# Why the change was made, in the words the find already used.
context_body_for() {
  local summary=$1
  local evidence=$2
  local body=""

  if [[ -n "${summary//[[:space:]]/}" ]]; then
    body="$summary"
  fi
  if [[ -n "${evidence//[[:space:]]/}" ]]; then
    if [[ -n "$body" ]]; then
      body+=$'\n\n'
    fi
    body+="Context: ${evidence}"
  fi
  printf '%s' "$body"
}

commit_with_message() {
  local worktree_path=$1
  local subject=$2
  local body=$3

  if [[ -n "${body//[[:space:]]/}" ]]; then
    git -C "$worktree_path" commit -q -m "$subject" -m "$body"
  else
    git -C "$worktree_path" commit -q -m "$subject"
  fi
}

# Fixture success: tiny commit in worktree so the branch exists for draft PR.
# File must not live under gitignored `.inchworm/` or `git add` fails.
implement_fixture_success() {
  local worktree_path=$1
  local subject=$2
  printf 'implement fixture\n' >"${worktree_path}/implement-fixture.txt"
  git -C "$worktree_path" add implement-fixture.txt
  commit_with_message "$worktree_path" "$subject" ""
}

# Real implementer (Done-when): agent in worktree, never --yolo/--force/--trust.
implement_with_agent() {
  local worktree_path=$1
  local find_title=$2
  local find_summary=$3
  local find_evidence=$4
  local guidance=${5:-}
  local agent_bin="${INCHWORM_AGENT:-agent}"
  local prompt

  prompt="Work item: ${find_title}"
  if [[ -n "${find_summary//[[:space:]]/}" ]]; then
    prompt+=$'\n\n'"Why it matters: ${find_summary}"
  fi
  if [[ -n "${find_evidence//[[:space:]]/}" ]]; then
    prompt+=$'\n'"Context: ${find_evidence}"
  fi
  prompt+=$'\n\n'"Make the smallest change that addresses this. Stop when it is done, or when it turns out to be too large for one sitting."
  prompt+=$'\n\n'"Commit on the current branch. Write the message with the writing-git-commits skill: an imperative subject under 72 characters, and a body only when a reader needs context the diff cannot give them."
  prompt+=$'\n\n'"Then write two files for the pull request:"
  prompt+=$'\n'"- ${PR_DRAFT_DIR}/title.txt — one line, plain English, no ticket ids or prefixes"
  prompt+=$'\n'"- ${PR_DRAFT_DIR}/body.md — why this change was made, including any issue or error links from the context above. Follow the repository's pull request template when it has one."
  prompt+=$'\n\n'"Both files are ignored by git, so they stay out of the commit. Review them with the writing-for-humans skill: short sentences, plain words, no filler. Say why the change was made and leave the technical detail to the code."
  prompt+=$'\n\n'"Write as the engineer making the change. Never mention this prompt, the tooling that started it, automation, or agents in the commit message, the title, or the body."
  prompt+=$'\n\n'"Do not push and do not open a pull request."
  prompt+=$(append_repo_guidance_block "$guidance")

  (
    cd "$worktree_path" || exit 1
    "$agent_bin" -p "$prompt"
  )
}

# Agents often leave edits uncommitted; capture them so the branch carries the work.
commit_leftover_changes() {
  local worktree_path=$1
  local subject=$2
  local body=$3

  if [[ -z "$(git -C "$worktree_path" status --porcelain)" ]]; then
    return 0
  fi

  git -C "$worktree_path" add -A
  commit_with_message "$worktree_path" "$subject" "$body"
}

# Collapse everything ahead of the base onto one commit we wrote ourselves.
# Failure to produce a clean history is a hard failure — the caller must not
# publish what is left behind.
squash_onto_authored_commit() {
  local worktree_path=$1
  local base_ref=$2
  local subject=$3
  local body=$4
  local messages

  if ! git -C "$worktree_path" reset -q --soft "$base_ref"; then
    printf 'inchworm: could not reset onto %s to rewrite the history\n' "$base_ref" >&2
    return 1
  fi
  if git -C "$worktree_path" diff --cached --quiet; then
    return 0
  fi
  if ! commit_with_message "$worktree_path" "$subject" "$body"; then
    printf 'inchworm: could not write the replacement commit\n' >&2
    return 1
  fi

  messages=$(git -C "$worktree_path" log --format='%B' "${base_ref}..HEAD" 2>/dev/null || printf '')
  if mentions_tool_name "$messages"; then
    printf 'inchworm: replacement commit message still names the runner\n' >&2
    return 1
  fi
}

# Last line of defence for the reviewer-facing history: if the agent named the
# runner in a message, collapse the branch onto one commit we wrote ourselves.
# Rewriting is safe here because nothing has been pushed yet.
sanitize_branch_commits() {
  local worktree_path=$1
  local base_ref=$2
  local subject=$3
  local body=$4
  local messages

  messages=$(git -C "$worktree_path" log --format='%B' "${base_ref}..HEAD" 2>/dev/null || printf '')
  if ! mentions_tool_name "$messages"; then
    return 0
  fi

  printf 'inchworm: commit message named the runner — rewriting as a single commit\n' >&2
  squash_onto_authored_commit "$worktree_path" "$base_ref" "$subject" "$body"
}

# First non-empty line of the agent's title file, or nothing we can use.
read_agent_pr_title() {
  local worktree_path=$1
  local file="${worktree_path}/${PR_DRAFT_DIR}/title.txt"
  local title

  [[ -f "$file" ]] || return 1
  title=$(clean_pr_title "$(sed -n '/[^[:space:]]/{p;q;}' "$file")")
  [[ -n "$title" ]] || return 1
  if mentions_tool_name "$title"; then
    return 1
  fi
  printf '%s' "$title"
}

# Agent body with any self-naming lines dropped; empty when nothing usable is left.
read_agent_pr_body() {
  local worktree_path=$1
  local file="${worktree_path}/${PR_DRAFT_DIR}/body.md"
  local body

  [[ -f "$file" ]] || return 1
  body=$(grep -viE "$TOOL_NAME_RE" "$file" || true)
  [[ -n "${body//[[:space:]]/}" ]] || return 1
  if mentions_tool_name "$body"; then
    return 1
  fi
  printf '%s' "$body"
}

# A branch with no commits ahead of its base cannot become a PR.
branch_has_commits() {
  local worktree_path=$1
  local base_branch=$2
  local count

  count=$(git -C "$worktree_path" rev-list --count "${base_branch}..HEAD" 2>/dev/null || printf '0')
  [[ "$count" -gt 0 ]]
}

# Base for a rewrite once the worktree exists: origin/develop was already
# refreshed to create it, so no second fetch. Fixture repos with no remote fall
# back to the local branch the worktree was cut from.
rewrite_base_ref() {
  local repo_path=$1

  if git -C "$repo_path" rev-parse --verify --quiet "$IMPLEMENT_BASE_REMOTE_REF" >/dev/null; then
    printf '%s\n' "$IMPLEMENT_BASE_REMOTE_REF"
    return 0
  fi
  printf '%s\n' "$IMPLEMENT_BASE_BRANCH"
}

# Push the implement branch before `gh pr create`, and again after the fixer has
# rewritten it. `create` sets the upstream for a branch the remote has never
# seen; `update` replaces the branch the draft PR already points at, so it needs
# --force-with-lease — which is also why it refuses to run on a shared branch.
# Fixture/tests: never touch the network, but say which push was skipped.
# Live: require origin + successful push, else soft-fail (caller defers/fails).
push_implement_branch() {
  local worktree_path=$1
  local fixture=$2
  local mode=${3:-create}
  local branch

  if [[ -n "$fixture" ]]; then
    if [[ "$mode" == "update" ]]; then
      printf 'inchworm: fixture mode — skipping the post-fix push (git push --force-with-lease origin HEAD)\n' >&2
    else
      printf 'inchworm: fixture mode — skipping the first push (git push -u origin HEAD)\n' >&2
    fi
    return 0
  fi

  if ! git -C "$worktree_path" remote get-url origin >/dev/null 2>&1; then
    printf 'inchworm: no origin — cannot push implement branch\n' >&2
    return 1
  fi

  if [[ "$mode" == "update" ]]; then
    branch=$(git -C "$worktree_path" rev-parse --abbrev-ref HEAD 2>/dev/null || printf '')
    case "$branch" in
      "$IMPLEMENT_BASE_BRANCH"|main|master|HEAD|"")
        printf 'inchworm: refusing to force-push %s — only an implement branch may be rewritten\n' \
          "${branch:-an unknown branch}" >&2
        return 1
        ;;
    esac
    if git -C "$worktree_path" push --force-with-lease origin HEAD; then
      return 0
    fi
    printf 'inchworm: post-fix push failed — the remote draft branch still has the pre-fix history\n' >&2
    return 1
  fi

  if git -C "$worktree_path" push -u origin HEAD; then
    return 0
  fi

  printf 'inchworm: push failed — deferring draft PR\n' >&2
  return 1
}

open_draft_pr() {
  local worktree_path=$1
  local title=$2
  local body_file=$3
  local pr_out pr_url
  pr_out=$(
    cd "$worktree_path" || exit 1
    "$GH_BIN" pr create --draft \
      --base "$IMPLEMENT_BASE_BRANCH" \
      --title "$title" \
      --body-file "$body_file"
  ) || return 1
  pr_url=$(printf '%s\n' "$pr_out" | grep -Eo 'https://[^[:space:]]+' | head -n1)
  if [[ -z "$pr_url" ]]; then
    pr_url=$(printf '%s\n' "$pr_out" | sed -n '/./p' | head -n1)
  fi
  printf '%s\n' "$pr_url"
}

mark_find_deferred() {
  local repo_path=$1
  local find_id=$2
  local reason=$3
  ruby_finds set_status "$repo_path" "$DATA_DIR" "$find_id" deferred
  printf 'inchworm: implement failed — %s for F-%s (deferred; stamp burned, no second pick)\n' \
    "$reason" "$find_id"
}

# Mark deferred and drop any implement checkout created for this attempt.
defer_implement_with_cleanup() {
  local repo_path=$1
  local worktree_path=$2
  local find_id=$3
  local reason=$4
  local branch_name=${5:-}
  mark_find_deferred "$repo_path" "$find_id" "$reason"
  cleanup_implement_worktree "$repo_path" "$worktree_path" "$branch_name"
}

# Standard pr-review once after successful draft PR.
# Sets INCHWORM_REVIEW_ARTIFACT_DIR; fixtures via INCHWORM_REVIEW_FIXTURE or live launcher.
# Review launcher failure is soft: draft already opened; still continue to fix/ping.
run_standard_pr_review() {
  local repo_path=$1
  local pr_url=$2
  local review_dir
  local fixture="${INCHWORM_REVIEW_FIXTURE:-}"
  local review_bin
  local review_status=0

  review_dir=$(ruby_review review_dir "$repo_path" "$DATA_DIR")
  mkdir -p "$review_dir"
  export INCHWORM_REVIEW_ARTIFACT_DIR="$review_dir"

  if [[ -n "$fixture" ]]; then
    if [[ -n "${INCHWORM_PR_REVIEW:-}" ]]; then
      # Tests inject a mock that honors INCHWORM_REVIEW_FIXTURE + ARTIFACT_DIR.
      INCHWORM_REVIEW_ARTIFACT_DIR="$review_dir" \
        "${INCHWORM_PR_REVIEW}" --mode standard "$pr_url" || review_status=$?
    else
      ruby_review write_fixture "$fixture" "$review_dir"
      printf 'inchworm: review fixture %s → %s\n' "$fixture" "$review_dir"
    fi
  else
    review_bin=$(resolve_pr_review_bin)
    INCHWORM_REVIEW_ARTIFACT_DIR="$review_dir" \
      "$review_bin" --mode standard "$pr_url" || review_status=$?
  fi

  if [[ "$review_status" -ne 0 ]]; then
    printf 'inchworm: Standard pr-review exited %s — continuing (draft already open)\n' \
      "$review_status" >&2
  fi

  if [[ ! -f "${review_dir}/findings-ledger.md" ]]; then
    # Soft stub (same shape as fixture `none`) so blocker mapping / ping can proceed.
    ruby_review write_empty_ledger "$review_dir"
    printf 'inchworm: wrote stub findings-ledger.md (review artifacts missing)\n' >&2
  fi
  printf 'inchworm: Standard pr-review complete → %s\n' "$review_dir"
}

# Fixture success: leave real work in the worktree, uncommitted, the way a fixer
# that edited files but never committed does. File must not live under gitignored
# `.inchworm/` or `git add` skips it.
fixer_fixture_success() {
  local worktree_path=$1
  printf 'fix fixture\n' >"${worktree_path}/fix-fixture.txt"
}

# Real fixer: agent in the worktree, never --yolo/--force/--trust. The
# coordinator owns the history and the push, so the agent does neither.
fix_with_agent() {
  local repo_path=$1
  local worktree_path=$2
  local pr_url=$3
  local blocker_count=$4
  local agent_bin="${INCHWORM_AGENT:-agent}"
  local prompt

  prompt="Fix only verified Class: blocking findings for draft PR ${pr_url} (${blocker_count} blocker(s)). Do not re-review. Never use --yolo, --force, or --trust."
  prompt+=$'\n\n'"Commit with the writing-git-commits skill. Write as the engineer making the change: never mention this prompt, tooling, automation, or agents in the message."
  prompt+=$'\n\n'"Do not push and do not open a pull request."
  prompt+=$(append_repo_guidance_block "$(load_repo_guidance "${repo_path}/.inchworm.yml")")
  (
    cd "$worktree_path" || exit 1
    "$agent_bin" -p "$prompt"
  )
}

# Fixture runs keep the network out of it. The first push was skipped too, so
# there is no remote branch for the post-fix push to update.
fixer_push_fixture() {
  if [[ -n "${INCHWORM_IMPLEMENT_FIXTURE:-}" || -n "${INCHWORM_FIX_FIXTURE:-}" ]]; then
    printf 'fixture'
  fi
}

# Put the worktree back on the SHA the fixer started at so local HEAD matches
# the already-pushed implement history. The fix stays off the branch.
restore_fixer_head() {
  local worktree_path=$1
  local head_before=$2

  if [[ -n "$head_before" ]]; then
    if ! git -C "$worktree_path" reset -q --hard "$head_before"; then
      printf 'inchworm: could not restore the checkout to the pre-fix commit\n' >&2
      return 1
    fi
  fi
  printf 'inchworm: the fix stayed local; this checkout matches the pre-fix history\n' >&2
}

pre_fix_commit_is_clean() {
  local worktree_path=$1
  local head_before=$2
  local implement_full

  [[ -n "$head_before" ]] || return 1
  implement_full=$(git -C "$worktree_path" log -1 --format='%B' "$head_before" 2>/dev/null || printf '')
  [[ -n "${implement_full//[[:space:]]/}" ]] || return 1
  ! mentions_tool_name "$implement_full"
}

find_fallback_is_clean() {
  local fallback_subject=$1
  local fallback_body=$2

  [[ -n "${fallback_subject//[[:space:]]/}" ]] || return 1
  ! mentions_tool_name "$fallback_subject" && ! mentions_tool_name "$fallback_body"
}

refuse_unpublished_fix() {
  local worktree_path=$1
  local head_before=$2

  restore_fixer_head "$worktree_path" "$head_before" || true
  printf 'inchworm: history after the fix still names the runner — refusing to push it\n' >&2
}

# The human is pinged next, so by then the fix has to be on the remote draft
# branch and the history has to read like one authored change. The fixer's own
# commits plus any leftovers are runner bookkeeping no reviewer asked for, so
# implement and fix collapse into a single commit before the branch is updated.
land_fixer_work() {
  local repo_path=$1
  local worktree_path=$2
  local head_before=$3
  local subject=$4
  local body=$5
  local base_ref head_after squash_subject squash_body

  base_ref=$(rewrite_base_ref "$repo_path")
  commit_leftover_changes "$worktree_path" "$subject" "$body"
  head_after=$(git -C "$worktree_path" rev-parse HEAD 2>/dev/null || printf '')
  if [[ -n "$head_before" && "$head_after" == "$head_before" ]]; then
    printf 'inchworm: fixer left no changes — the pushed branch already matches\n'
    return 0
  fi

  if pre_fix_commit_is_clean "$worktree_path" "$head_before"; then
    squash_subject=$(git -C "$worktree_path" log -1 --format='%s' "$head_before")
    squash_body=$(git -C "$worktree_path" log -1 --format='%b' "$head_before")
  elif find_fallback_is_clean "$subject" "$body"; then
    squash_subject=$subject
    squash_body=$body
  else
    refuse_unpublished_fix "$worktree_path" "$head_before"
    return 1
  fi

  printf 'inchworm: squashing the fixed branch into one authored commit\n' >&2
  if ! squash_onto_authored_commit "$worktree_path" "$base_ref" "$squash_subject" "$squash_body"; then
    refuse_unpublished_fix "$worktree_path" "$head_before"
    return 1
  fi

  push_implement_branch "$worktree_path" "$(fixer_push_fixture)" update
}

# One fixer pass when verified blockers exist. Never --yolo/--force/--trust.
# At most one pass; no second review. A pass that cannot be landed on the remote
# draft branch is a fixer failure — the caller still pings, but the reviewer is
# never shown a history we would not publish.
run_blocking_fixer() {
  local repo_path=$1
  local worktree_path=$2
  local pr_url=$3
  local blocker_count=$4
  local subject=$5
  local body=$6
  local fix_fixture="${INCHWORM_FIX_FIXTURE:-}"
  local fix_dir marker head_before pass_note=""

  fix_dir=$(ruby_review fix_dir "$repo_path" "$DATA_DIR")
  mkdir -p "$fix_dir"
  marker="${fix_dir}/fixture-ran"
  head_before=$(git -C "$worktree_path" rev-parse HEAD 2>/dev/null || printf '')

  if [[ -n "$fix_fixture" ]]; then
    case "$fix_fixture" in
      success)
        printf 'success\n' >"$marker"
        fixer_fixture_success "$worktree_path"
        pass_note=" (fixture success)"
        ;;
      fail)
        printf 'fail\n' >"$marker"
        printf 'inchworm: fixer fail — residual blocking findings remain (could not address all blockers)\n'
        return 1
        ;;
      *)
        printf 'inchworm: unknown INCHWORM_FIX_FIXTURE=%s — treating as fail\n' "$fix_fixture" >&2
        printf 'fail\n' >"$marker"
        printf 'inchworm: fixer fail — residual blocking findings remain\n'
        return 1
        ;;
    esac
  elif ! fix_with_agent "$repo_path" "$worktree_path" "$pr_url" "$blocker_count"; then
    printf 'inchworm: fixer fail — residual blocking findings remain (agent exited non-zero)\n'
    return 1
  fi

  if ! land_fixer_work "$repo_path" "$worktree_path" "$head_before" "$subject" "$body"; then
    printf 'inchworm: fixer fail — the fix stayed local; the draft PR still shows the pre-fix history\n'
    return 1
  fi

  printf 'inchworm: fixer pass — addressed blocking findings%s\n' "$pass_note"
  return 0
}

# Ping after review (+ optional fix). Prefer INCHWORM_NOTIFY; else osascript + always log URL.
# Always print the ping line. On notify/osascript failure (or missing), print notify fallback.
ping_draft_pr() {
  local pr_url=$1
  local notified=0

  printf 'inchworm: ping — draft PR %s\n' "$pr_url"

  if [[ -n "${INCHWORM_NOTIFY:-}" ]]; then
    if "${INCHWORM_NOTIFY}" "$pr_url"; then
      notified=1
    fi
  elif command -v osascript >/dev/null 2>&1; then
    if osascript -e "display notification \"Inchworm draft ready\" with title \"inchworm\" subtitle \"${pr_url}\"" 2>/dev/null; then
      notified=1
    fi
  fi

  if [[ "$notified" -eq 0 ]]; then
    printf 'inchworm: notify fallback — logged PR URL\n'
  fi
}

# After successful draft PR: review once → optional one fix pass (rewritten and
# pushed onto the draft branch) → ping. No second review. The find's subject and
# body are the fallback when the pre-fix implement commit cannot be reused.
run_review_fix_ping() {
  local repo_path=$1
  local worktree_path=$2
  local pr_url=$3
  local commit_subject=$4
  local commit_body=$5
  local branch_name=${6:-}
  local review_dir ledger_path blocker_count

  run_standard_pr_review "$repo_path" "$pr_url"
  # Same path as run_standard_pr_review (DATA_DIR/<path-hash>/review/).
  review_dir="${INCHWORM_REVIEW_ARTIFACT_DIR:-$(ruby_review review_dir "$repo_path" "$DATA_DIR")}"
  ledger_path="${review_dir}/findings-ledger.md"
  blocker_count=0
  if [[ -f "$ledger_path" ]]; then
    blocker_count=$(ruby_review blocking_count "$ledger_path")
  fi

  if [[ "$blocker_count" -gt 0 ]]; then
    printf 'inchworm: %s verified blocking finding(s) — running one fixer pass\n' "$blocker_count"
    run_blocking_fixer "$repo_path" "$worktree_path" "$pr_url" "$blocker_count" \
      "$commit_subject" "$commit_body" || true
  else
    printf 'inchworm: no verified blockers — skipping fixer\n'
  fi

  ping_draft_pr "$pr_url"
  cleanup_implement_worktree "$repo_path" "$worktree_path" "$branch_name"
}

# After discover selected a find: implement → push → draft PR or mark deferred/too_large.
# On draft success: Standard review → optional fix → ping. Never picks a second find.
run_implement_and_pr() {
  local repo_path=$1
  local repo_yml=$2
  local find_id=$3
  local find_title=$4
  local today=$5
  local fixture="${INCHWORM_IMPLEMENT_FIXTURE:-}"
  local ymd branch_name branch_prefix worktree_path pr_url base_ref guidance
  local find_summary find_evidence commit_subject commit_body
  local pr_title="" pr_body="" pr_body_file

  ymd=$(yyyymmdd_from_today "$today")
  branch_prefix=$(resolve_branch_prefix "$repo_path" "$repo_yml")
  branch_name="${branch_prefix}/$(branch_slug_from_id "$find_id")-${ymd}"
  worktree_path=""
  guidance=$(load_repo_guidance "$repo_yml")
  find_summary=$(find_field "$repo_path" "$find_id" summary)
  find_evidence=$(find_field "$repo_path" "$find_id" evidence)
  commit_subject=$(subject_from_title "$find_title")
  commit_body=$(context_body_for "$find_summary" "$find_evidence")

  case "$fixture" in
    too_large)
      ruby_finds set_status "$repo_path" "$DATA_DIR" "$find_id" too_large
      printf 'inchworm: implement too_large — find F-%s marked too_large (no PR)\n' "$find_id"
      return 0
      ;;
    success)
      if ! worktree_path=$(create_implement_worktree "$repo_path" "$branch_name" "$fixture"); then
        defer_implement_with_cleanup "$repo_path" "$worktree_path" "$find_id" \
          "could not base worktree on origin/develop" "$branch_name"
        return 0
      fi
      implement_fixture_success "$worktree_path" "$commit_subject"
      ;;
    "")
      if ! worktree_path=$(create_implement_worktree "$repo_path" "$branch_name" ""); then
        defer_implement_with_cleanup "$repo_path" "$worktree_path" "$find_id" \
          "could not base worktree on origin/develop" "$branch_name"
        return 0
      fi
      if ! implement_with_agent "$worktree_path" "$find_title" "$find_summary" \
        "$find_evidence" "$guidance"; then
        defer_implement_with_cleanup "$repo_path" "$worktree_path" "$find_id" \
          "agent exited non-zero" "$branch_name"
        return 0
      fi
      pr_title=$(read_agent_pr_title "$worktree_path" || printf '')
      pr_body=$(read_agent_pr_body "$worktree_path" || printf '')
      rm -rf "${worktree_path:?}/${PR_DRAFT_DIR}"
      commit_leftover_changes "$worktree_path" "$commit_subject" "$commit_body"
      base_ref="$IMPLEMENT_BASE_REMOTE_REF"
      if ! sanitize_branch_commits "$worktree_path" "$base_ref" "$commit_subject" "$commit_body"; then
        defer_implement_with_cleanup "$repo_path" "$worktree_path" "$find_id" \
          "could not rewrite commits that name the runner" "$branch_name"
        return 0
      fi
      if ! branch_has_commits "$worktree_path" "$base_ref"; then
        defer_implement_with_cleanup "$repo_path" "$worktree_path" "$find_id" \
          "no commits produced (nothing to open a PR from)" "$branch_name"
        return 0
      fi
      ;;
    fail|*)
      if [[ "$fixture" != "fail" ]]; then
        printf 'inchworm: unknown INCHWORM_IMPLEMENT_FIXTURE=%s — treating as fail\n' "$fixture" >&2
      fi
      mark_find_deferred "$repo_path" "$find_id" "fixture fail"
      return 0
      ;;
  esac

  # Resolve the reviewer-facing copy before anything leaves the machine: a find
  # whose own words name the runner is deferred rather than opened as a draft.
  if [[ -z "$pr_title" ]]; then
    pr_title=$(subject_from_title "$find_title")
  fi
  if [[ -z "$pr_body" ]]; then
    pr_body=$(context_body_for "$find_summary" "$find_evidence")
  fi
  if mentions_tool_name "$pr_title" || mentions_tool_name "$pr_body"; then
    defer_implement_with_cleanup "$repo_path" "$worktree_path" "$find_id" \
      "PR title or body would name the runner" "$branch_name"
    return 0
  fi

  if ! push_implement_branch "$worktree_path" "$fixture"; then
    defer_implement_with_cleanup "$repo_path" "$worktree_path" "$find_id" \
      "push failed" "$branch_name"
    return 0
  fi

  pr_body_file=$(mktemp "${TMPDIR:-/tmp}/inchworm-pr-body.XXXXXX")
  printf '%s\n' "$pr_body" >"$pr_body_file"

  pr_url=$(open_draft_pr "$worktree_path" "$pr_title" "$pr_body_file") || {
    rm -f "$pr_body_file"
    defer_implement_with_cleanup "$repo_path" "$worktree_path" "$find_id" \
      "draft PR create failed" "$branch_name"
    return 0
  }
  rm -f "$pr_body_file"
  if [[ -z "$pr_url" ]]; then
    defer_implement_with_cleanup "$repo_path" "$worktree_path" "$find_id" \
      "no PR URL" "$branch_name"
    return 0
  fi

  ruby_yaml set_state "$repo_yml" "active_draft_pr" "$pr_url"
  ruby_finds set_status "$repo_path" "$DATA_DIR" "$find_id" in_pr
  printf 'inchworm: opened draft PR %s\n' "$pr_url"

  run_review_fix_ping "$repo_path" "$worktree_path" "$pr_url" "$commit_subject" \
    "$commit_body" "$branch_name"
}

# FDA-scoped LaunchAgent executable: a private copy of bash (not /bin/bash).
# TCC attributes Full Disk Access to this binary only — not every bash script.
LAUNCHD_RUNNER="${INCHWORM_LAUNCHD_RUNNER:-${XDG_DATA_HOME:-$HOME/.local/share}/inchworm/inchworm-launchd}"
LAUNCHD_PLIST="${INCHWORM_LAUNCHD_PLIST:-$HOME/Library/LaunchAgents/com.inchworm.plist}"
LAUNCHD_LABEL="com.inchworm"
# Apple Silicon: do not copy /bin/bash. It is x86_64+arm64e; keeping the
# platform signature hits a launch constraint, and re-signing it hits the
# preview arm64e ABI check. Homebrew bash is thin arm64. Ad-hoc re-signing as
# com.inchworm.launchd gives the copy a cdhash distinct from its source so the
# FDA grant covers only this runner.
LAUNCHD_RUNNER_IDENTIFIER="com.inchworm.launchd"
LAUNCHD_RUNNER_SOURCE="/opt/homebrew/bin/bash"

resolve_launchd_template() {
  local candidate dir
  if [[ -n "${INCHWORM_LAUNCHD_TEMPLATE:-}" && -f "${INCHWORM_LAUNCHD_TEMPLATE}" ]]; then
    printf '%s\n' "$INCHWORM_LAUNCHD_TEMPLATE"
    return 0
  fi
  for candidate in \
    "${SCRIPT_DIR}/../launchd/com.inchworm.plist.template" \
    "${HOME}/dots/launchd/com.inchworm.plist.template"
  do
    if [[ -f "$candidate" ]]; then
      dir=$(CDPATH= cd "$(dirname "$candidate")" && pwd)
      printf '%s/%s\n' "$dir" "$(basename "$candidate")"
      return 0
    fi
  done
  return 1
}

launchd_agent_path() {
  # Prefer mise ruby latest, Homebrew, user bins, then system.
  local data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
  printf '%s' \
    "${data_home}/mise/installs/ruby/latest/bin:/opt/homebrew/bin:/opt/homebrew/sbin:${HOME}/.local/bin:${HOME}/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
}

write_launchd_plist() {
  local template=$1
  local dest=$2
  local runner=$3
  local inchworm_bin=$4
  local agent_path
  local tmp

  agent_path=$(launchd_agent_path)
  mkdir -p "$(dirname "$dest")"
  tmp=$(mktemp "${TMPDIR:-/tmp}/inchworm-plist.XXXXXX")
  # Portable placeholders — no machine-specific paths in the repo template.
  sed \
    -e "s|@HOME@|${HOME}|g" \
    -e "s|@PATH@|${agent_path}|g" \
    -e "s|@LAUNCHD_RUNNER@|${runner}|g" \
    -e "s|@INCHWORM_BIN@|${inchworm_bin}|g" \
    "$template" >"$tmp"
  mv "$tmp" "$dest"
}

launchd_runner_identifier() {
  local runner=$1
  [[ -x "$runner" ]] || return 1
  # --verbose is required; plain --display omits the Identifier line.
  codesign --display --verbose=2 "$runner" 2>&1 | sed -n 's/^Identifier=//p'
}

build_launchd_runner() {
  local runner=$1
  local bash_src=$2

  mkdir -p "$(dirname "$runner")"
  cp "$bash_src" "$runner"
  chmod 755 "$runner"

  codesign --remove-signature "$runner" >/dev/null 2>&1 || true
  if ! codesign --force --sign - --identifier "$LAUNCHD_RUNNER_IDENTIFIER" "$runner" >/dev/null 2>&1; then
    die "could not ad-hoc sign $runner (is codesign available?)"
  fi
  if ! codesign --verify "$runner" >/dev/null 2>&1; then
    die "ad-hoc signature on $runner did not verify"
  fi
  # Catch an unrunnable runner here rather than at the next 8am tick.
  if ! "$runner" -c 'exit 0' >/dev/null 2>&1; then
    die "runner $runner (from $bash_src) cannot execute after signing"
  fi
}

reload_launchd_agent() {
  local plist=$1
  local uid
  uid=$(id -u)
  launchctl bootout "gui/${uid}/${LAUNCHD_LABEL}" 2>/dev/null || true
  # Replace a stale symlink to the old repo plist with the generated file.
  if [[ -L "$plist" ]]; then
    rm -f "$plist"
  fi
  launchctl bootstrap "gui/${uid}" "$plist"
}

cmd_launchd_setup() {
  local runner_dir
  local bash_src
  local open_settings=1
  local do_reload=1
  local runner_rebuilt=0
  local template inchworm_bin

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-open)
        open_settings=0
        shift
        ;;
      --no-reload)
        do_reload=0
        shift
        ;;
      -h|--help)
        printf '%s\n' "Usage: inchworm launchd-setup [--no-open] [--no-reload]"
        return 0
        ;;
      *)
        die "unknown launchd-setup option: $1"
        ;;
    esac
  done

  bash_src="$LAUNCHD_RUNNER_SOURCE"
  if [[ ! -x "$bash_src" ]]; then
    die "missing $bash_src (try: brew install bash)"
  fi
  if ! lipo -archs "$bash_src" 2>/dev/null | tr ' ' '\n' | grep -qx arm64; then
    die "$bash_src must include an arm64 slice (Apple Silicon only)"
  fi

  if ! template=$(resolve_launchd_template); then
    die "missing launchd plist template (expected launchd/com.inchworm.plist.template)"
  fi

  runner_dir=$(dirname "$LAUNCHD_RUNNER")
  mkdir -p "$runner_dir"
  # Rebuilding changes the cdhash and revokes the Full Disk Access grant, so
  # reuse an already correctly signed runner across repeat setup runs.
  if [[ "$(launchd_runner_identifier "$LAUNCHD_RUNNER" 2>/dev/null)" == "$LAUNCHD_RUNNER_IDENTIFIER" ]]; then
    runner_rebuilt=0
  else
    build_launchd_runner "$LAUNCHD_RUNNER" "$bash_src"
    runner_rebuilt=1
  fi

  inchworm_bin="${SCRIPT_DIR}/inchworm"
  if [[ -L "$LAUNCHD_PLIST" ]]; then
    rm -f "$LAUNCHD_PLIST"
  fi
  write_launchd_plist "$template" "$LAUNCHD_PLIST" "$LAUNCHD_RUNNER" "$inchworm_bin"

  if [[ "$runner_rebuilt" -eq 1 ]]; then
    printf 'inchworm: launchd runner → %s (rebuilt, ad-hoc signed as %s)\n' \
      "$LAUNCHD_RUNNER" "$LAUNCHD_RUNNER_IDENTIFIER"
  else
    printf 'inchworm: launchd runner → %s (reused; Full Disk Access grant intact)\n' \
      "$LAUNCHD_RUNNER"
  fi
  printf 'inchworm: launchd plist  → %s\n' "$LAUNCHD_PLIST"
  printf 'inchworm: ProgramArguments:\n'
  printf '  %s\n' "$LAUNCHD_RUNNER"
  printf '  %s\n' "$inchworm_bin"
  printf '  run\n'
  printf '\n'
  printf 'Grant Full Disk Access to ONLY this binary (not /bin/bash):\n'
  printf '  %s\n' "$LAUNCHD_RUNNER"
  printf 'System Settings → Privacy & Security → Full Disk Access → +\n'
  printf 'Then ⌘⇧G and paste the path above.\n'
  if [[ "$runner_rebuilt" -eq 1 ]]; then
    printf 'The runner was re-signed, so any previous grant no longer applies —\n'
    printf 'remove the stale entry and re-add the path above.\n'
  fi

  if [[ "$do_reload" -eq 1 ]]; then
    if reload_launchd_agent "$LAUNCHD_PLIST"; then
      printf 'inchworm: LaunchAgent %s reloaded\n' "$LAUNCHD_LABEL"
    else
      printf 'inchworm: warning: could not bootstrap %s (load manually)\n' "$LAUNCHD_LABEL" >&2
    fi
  fi

  if [[ "$open_settings" -eq 1 ]]; then
    open "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles" 2>/dev/null \
      || open "x-apple.systempreferences:com.apple.settings.PrivacySecurity.extension" 2>/dev/null \
      || true
  fi
}

cmd_init() {
  local repo_root="$PWD"

  ruby_yaml ensure_repo_yml "${PWD}/.inchworm.yml"
  mkdir -p "$CONFIG_DIR"
  ruby_yaml ensure_global "$CONFIG_FILE"
  ruby_yaml register_repo "$CONFIG_FILE" "$repo_root"
  ensure_gitignore_entries "$GITIGNORE_GLOBAL"

  printf 'inchworm: initialized %s\n' "$repo_root"
  printf 'inchworm: registered in %s\n' "$CONFIG_FILE"
}

cmd_run() {
  local today weekday hour minute
  local repo_path repo_yml last_run blocking
  local mins draft_url draft_head
  local discover_out selected_line find_id find_title

  read -r today weekday hour minute <<<"$(parse_clock)"

  while IFS= read -r repo_path || [[ -n "$repo_path" ]]; do
    [[ -z "$repo_path" ]] && continue
    repo_yml="${repo_path}/.inchworm.yml"

    if [[ "$weekday" -gt 5 ]]; then
      printf 'inchworm: skip %s — weekend (not a weekday; sat/sun)\n' "$repo_path"
      continue
    fi

    mins=$((10#$hour * 60 + 10#$minute))
    if [[ "$mins" -ge $((15 * 60)) ]]; then
      printf 'inchworm: skip %s — outside create window (at/after 15:00)\n' "$repo_path"
      continue
    fi
    if [[ "$mins" -lt $((8 * 60)) ]]; then
      printf 'inchworm: skip %s — outside create window (before 08:00)\n' "$repo_path"
      continue
    fi

    if [[ ! -f "$repo_yml" ]]; then
      printf 'inchworm: skip %s — missing .inchworm.yml\n' "$repo_path"
      continue
    fi

    last_run=$(ruby_yaml get "$repo_yml" "state.last_run_date")
    if [[ "$last_run" == "$today" ]]; then
      printf 'inchworm: skip %s — already launched today (same-day; last_run_date=%s)\n' \
        "$repo_path" "$last_run"
      continue
    fi

    blocking=$(find_blocking_draft "$repo_path" "$repo_yml" || true)
    if [[ -n "$blocking" ]]; then
      draft_url=${blocking%%$'\t'*}
      draft_head=${blocking#*$'\t'}
      if [[ -n "$draft_url" && "$draft_url" != "null" ]]; then
        ruby_yaml set_state "$repo_yml" "active_draft_pr" "$draft_url"
      fi
      printf 'inchworm: skip %s — blocking draft %s (%s)\n' \
        "$repo_path" "${draft_head:-unknown branch}" "${draft_url:-unknown}"
      continue
    fi

    # Eligible: clear stale draft cache, stamp, then discover → implement.
    ruby_yaml set_state "$repo_yml" "active_draft_pr" "null"
    ruby_yaml set_state "$repo_yml" "last_run_date" "$today"
    printf 'inchworm: eligible %s — discover\n' "$repo_path"
    discover_out=$(discover_pipeline "$repo_path")
    printf '%s\n' "$discover_out"

    selected_line=$(printf '%s\n' "$discover_out" | grep -E 'inchworm: selected F-' | head -n1 || true)
    if [[ -z "$selected_line" ]]; then
      # none selected — stop (no implement, no worktree, no gh pr create)
      continue
    fi

    # Parse: inchworm: selected F-<id> — <title>
    find_id=$(printf '%s\n' "$selected_line" | sed -n 's/^inchworm: selected F-\([^ ]*\).*/\1/p')
    find_title=$(printf '%s\n' "$selected_line" | sed -n 's/^inchworm: selected F-[^ ]* — //p')
    if [[ -z "$find_id" ]]; then
      continue
    fi
    [[ -n "$find_title" ]] || find_title="$find_id"

    run_implement_and_pr "$repo_path" "$repo_yml" "$find_id" "$find_title" "$today"
  done < <(list_registered_repos)
}

cmd_review() {
  local selector="" selected repo_path number url head worktree_path
  local agent_bin prompt choice line
  local -a REVIEW_DRAFTS

  if [[ $# -gt 1 ]]; then
    die "usage: inchworm review [pr-url|number|repo-path]"
  fi
  if [[ $# -eq 1 ]]; then
    selector=$1
  fi

  REVIEW_DRAFTS=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" ]] && continue
    REVIEW_DRAFTS+=("$line")
  done < <(collect_open_review_drafts)

  if [[ ${#REVIEW_DRAFTS[@]} -eq 0 ]]; then
    printf 'inchworm: no open drafts\n'
    return 0
  fi

  selected=""
  if [[ -n "$selector" ]]; then
    selected=$(match_review_selector "$selector") || exit 1
  elif [[ ${#REVIEW_DRAFTS[@]} -eq 1 ]]; then
    selected=${REVIEW_DRAFTS[0]}
  elif [[ -t 0 && -t 1 ]]; then
    print_review_draft_list
    printf 'inchworm: select a draft [1-%d]: ' "${#REVIEW_DRAFTS[@]}"
    read -r choice
    if ! [[ "$choice" =~ ^[0-9]+$ ]] || ((choice < 1 || choice > ${#REVIEW_DRAFTS[@]})); then
      die "invalid selection"
    fi
    selected=${REVIEW_DRAFTS[choice - 1]}
  else
    print_review_draft_list
    die "select a draft with a PR URL, number, or repo path"
  fi

  IFS=$'\t' read -r repo_path number url head <<<"$selected"
  [[ -n "$repo_path" && -n "$head" ]] || die "could not parse selected draft"

  worktree_path=$(attach_review_worktree "$repo_path" "$head") \
    || die "could not switch Worktrunk for $head"
  agent_bin="${INCHWORM_AGENT:-agent}"
  if ! command -v "$agent_bin" >/dev/null 2>&1; then
    die "agent is required but not found"
  fi
  prompt=$(review_agent_prompt)
  printf 'inchworm: review %s (%s) in %s\n' "$url" "$head" "$worktree_path"
  cd "$worktree_path" || die "could not enter $worktree_path"
  exec "$agent_bin" "$prompt"
}

cmd_status() {
  local weekday hour minute
  local repo_path repo_yml last_run blocking window_label
  local draft_url draft_head

  read -r _ weekday hour minute <<<"$(parse_clock)"
  window_label="$(window_label_for "$weekday" "$hour" "$minute")"

  while IFS= read -r repo_path || [[ -n "$repo_path" ]]; do
    [[ -z "$repo_path" ]] && continue
    repo_yml="${repo_path}/.inchworm.yml"
    last_run="null"
    if [[ -f "$repo_yml" ]]; then
      last_run=$(ruby_yaml get "$repo_yml" "state.last_run_date")
    fi

    blocking=$(find_blocking_draft "$repo_path" "$repo_yml" || true)
    printf 'repo: %s\n' "$repo_path"
    printf '  last_run_date: %s\n' "$last_run"
    printf '  create_window: %s\n' "$window_label"
    if [[ -n "$blocking" ]]; then
      draft_url=${blocking%%$'\t'*}
      draft_head=${blocking#*$'\t'}
      printf '  draft: blocking %s (%s)\n' "${draft_head:-unknown branch}" "${draft_url:-unknown}"
    else
      printf '  draft: none blocking\n'
    fi
  done < <(list_registered_repos)
}

main() {
  if [[ $# -lt 1 ]]; then
    usage >&2
    exit 1
  fi

  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    init)
      shift
      cmd_init "$@"
      ;;
    run)
      shift
      cmd_run "$@"
      ;;
    status)
      shift
      cmd_status "$@"
      ;;
    review)
      shift
      cmd_review "$@"
      ;;
    launchd-setup)
      shift
      cmd_launchd_setup "$@"
      ;;
    *)
      usage >&2
      die "unknown command: $1"
      ;;
  esac
}

main "$@"
