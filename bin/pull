#!/bin/bash
set -euo pipefail

assignee="notnotdrew"
draft=false
base_branch=""
body_file=""

cleanup() {
  if [[ -n "$body_file" ]]; then
    rm -f "$body_file"
  fi
}
trap cleanup EXIT

resolve_stack_line() {
  local branch="$1"
  local base_pr_number

  base_pr_number="$(
    gh pr list --head "$branch" --json number --jq '.[0].number // empty' --limit 1 2>/dev/null || true
  )"

  if [[ -n "$base_pr_number" ]]; then
    printf 'Stacks on #%s\n' "$base_pr_number"
  fi
}

# gh only prefills the body from a PR template when --template is passed, and
# --template cannot be combined with --body-file, so read the template directly.
resolve_template_file() {
  local top_level
  local candidate

  top_level="$(git rev-parse --show-toplevel 2>/dev/null || true)"

  if [[ -z "$top_level" ]]; then
    return 0
  fi

  for candidate in \
    ".github/PULL_REQUEST_TEMPLATE.md" \
    ".github/pull_request_template.md" \
    "PULL_REQUEST_TEMPLATE.md" \
    "pull_request_template.md" \
    "docs/PULL_REQUEST_TEMPLATE.md" \
    "docs/pull_request_template.md"; do
    if [[ -f "$top_level/$candidate" ]]; then
      printf '%s\n' "$top_level/$candidate"
      return 0
    fi
  done
}

build_body_file() {
  local stack_line="$1"
  local template_file="$2"

  body_file="$(mktemp "${TMPDIR:-/tmp}/pull-body.XXXXXX")"

  if [[ -n "$stack_line" ]]; then
    printf '%s\n\n' "$stack_line" >> "$body_file"
  fi

  if [[ -n "$template_file" ]]; then
    cat "$template_file" >> "$body_file"
  fi
}

if [[ "${1:-}" == "-d" ]]; then
  draft=true
  shift
elif [[ "${1:-}" == "-no" ]]; then
  shift
fi

if [[ $# -gt 0 ]]; then
  base_branch="$1"
fi

gh_args=(pr create --assignee "$assignee" --editor)

if [[ "$draft" == true ]]; then
  gh_args+=(--draft)
fi

stack_line=""

if [[ -n "$base_branch" ]]; then
  gh_args+=(--base "$base_branch")
  stack_line="$(resolve_stack_line "$base_branch")"
fi

template_file="$(resolve_template_file)"

if [[ -n "$stack_line" || -n "$template_file" ]]; then
  build_body_file "$stack_line" "$template_file"
  gh_args+=(--body-file "$body_file")
fi

git push -u origin HEAD
gh "${gh_args[@]}"
gh pr view --web
