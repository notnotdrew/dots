#!/usr/bin/env bash
# Fixture tests for wt-clean-roots: checkout discovery and the Herdr lock guard.
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLEAN="${SCRIPT_DIR}/wt-clean-roots"
failures=0

assert_eq() {
  local name=$1 expected=$2 actual=$3
  if [[ "$actual" == "$expected" ]]; then
    printf 'ok  %s\n' "$name"
  else
    printf 'not ok  %s\nexpected:\n%s\nactual:\n%s\n' "$name" "$expected" "$actual"
    failures=1
  fi
}

# Resolved path: git reports worktrees under /private/var, not the /var symlink.
tmpdir="$(CDPATH= cd "$(mktemp -d "${TMPDIR:-/tmp}/test-wt-clean-roots.XXXXXX")" && pwd -P)"
trap 'rm -rf "$tmpdir"' EXIT

mkdir -p \
  "$tmpdir/dots/.git" \
  "$tmpdir/dots/vim/plugged/ale/.git" \
  "$tmpdir/dots-private/.git" \
  "$tmpdir/dev/screensteps/live/.git" \
  "$tmpdir/dev/screensteps/live.linked" \
  "$tmpdir/dev/nested/proj/.git" \
  "$tmpdir/dev/not-a-repo"

printf 'gitdir: %s\n' "$tmpdir/dev/screensteps/live/.git" \
  >"$tmpdir/dev/screensteps/live.linked/.git"

actual="$("$CLEAN" --list -- "$tmpdir/dots" "$tmpdir/dots-private" "$tmpdir/dev")"
expected="$tmpdir/dots
$tmpdir/dots-private
$tmpdir/dev/nested/proj
$tmpdir/dev/screensteps/live"

assert_eq 'lists main checkouts, skips worktrees and nested clones' "$expected" "$actual"

missing="$("$CLEAN" --list -- "$tmpdir/missing" || true)"
assert_eq 'skips missing roots' "" "$missing"

# Real repo with two worktrees, one of them "open in Herdr". Stubs for herdr
# and wt stand in for the server and the prune; the stub wt records which
# worktrees are locked at the moment prune would run.
guard="$tmpdir/guard"
mkdir -p "$guard/bin"
git init --quiet "$guard/repo"
git -C "$guard/repo" -c user.email=test@example.com -c user.name=test \
  commit --quiet --allow-empty -m init
git -C "$guard/repo" worktree add --quiet -b open-branch "$guard/repo.open"
git -C "$guard/repo" worktree add --quiet -b idle-branch "$guard/repo.idle"

cat >"$guard/bin/herdr" <<EOF
#!/usr/bin/env bash
printf '%s\n' '{"result":{"workspaces":[{"worktree":{"checkout_path":"$guard/repo.open"}}]}}'
EOF

cat >"$guard/bin/wt" <<EOF
#!/usr/bin/env bash
git -C "$guard/repo" worktree list --porcelain >"$guard/locks-during-run"
EOF

cat >"$guard/bin/prrr" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$*" >>"$guard/prrr-args"
git -C "$guard/repo" worktree list --porcelain >"$guard/locks-during-prrr"
EOF

chmod +x "$guard/bin/herdr" "$guard/bin/wt" "$guard/bin/prrr"

locked_paths() {
  awk '/^worktree /{worktree=$2} /^locked/{print worktree}' "$1"
}

PATH="$guard/bin:$PATH" HERDR_BIN_PATH="$guard/bin/herdr" "$CLEAN" -- "$guard" >/dev/null

assert_eq 'locks the checkout Herdr has open while prune runs' \
  "$guard/repo.open" "$(locked_paths "$guard/locks-during-run")"

git -C "$guard/repo" worktree list --porcelain >"$guard/locks-after-run"
assert_eq 'unlocks it again afterwards' "" "$(locked_paths "$guard/locks-after-run")"

assert_eq 'runs prrr --clean after prune' "--clean" "$(cat "$guard/prrr-args")"
assert_eq 'holds the Herdr lock while prrr --clean runs' \
  "$guard/repo.open" "$(locked_paths "$guard/locks-during-prrr")"

rm -f "$guard/prrr-args" "$guard/locks-during-prrr"

if PATH="$guard/bin:$PATH" HERDR_BIN_PATH="$guard/bin/missing-herdr" \
  "$CLEAN" -- "$guard" >/dev/null 2>&1; then
  prune_ran=yes
else
  prune_ran=no
fi
assert_eq 'prunes when herdr is not installed' yes "$prune_ran"
assert_eq 'and still runs prrr --clean' "--clean" "$(cat "$guard/prrr-args" 2>/dev/null || true)"

printf '#!/usr/bin/env bash\nexit 1\n' >"$guard/bin/herdr-down"
chmod +x "$guard/bin/herdr-down"
rm -f "$guard/locks-during-run" "$guard/prrr-args"

if PATH="$guard/bin:$PATH" HERDR_BIN_PATH="$guard/bin/herdr-down" \
  "$CLEAN" -- "$guard" >/dev/null 2>&1; then
  prune_ran=yes
else
  prune_ran=no
fi
assert_eq 'refuses to prune when herdr is installed but not answering' no "$prune_ran"
assert_eq 'and runs no prune in that case' 'absent' \
  "$([[ -e "$guard/locks-during-run" ]] && echo present || echo absent)"
assert_eq 'and runs no prrr --clean in that case' 'absent' \
  "$([[ -e "$guard/prrr-args" ]] && echo present || echo absent)"

# A killed run leaves its own lock behind on a worktree nobody has open, while
# a lock Drew set by hand means hands off.
git -C "$guard/repo" worktree lock \
  --reason 'wt-clean-roots: open in Herdr' "$guard/repo.idle"
git -C "$guard/repo" worktree lock --reason 'mine, leave it' "$guard/repo.open"

PATH="$guard/bin:$PATH" HERDR_BIN_PATH="$guard/bin/herdr" "$CLEAN" -- "$guard" >/dev/null

assert_eq 'releases a stale lock from a killed run' \
  "$guard/repo.open" "$(locked_paths "$guard/locks-during-run")"

git -C "$guard/repo" worktree list --porcelain >"$guard/locks-after-stale"
assert_eq 'leaves a lock set by hand alone' \
  "$guard/repo.open" "$(locked_paths "$guard/locks-after-stale")"

rm -f "$guard/prrr-args"
PATH="$guard/bin:$PATH" HERDR_BIN_PATH="$guard/bin/herdr" \
  "$CLEAN" --dry-run -- "$guard" >/dev/null
assert_eq 'skips prrr --clean on --dry-run' 'absent' \
  "$([[ -e "$guard/prrr-args" ]] && echo present || echo absent)"

# Squash-merged PRs stay after prune: worktrunk cannot prove they are
# integrated, and a dirty tree is refused. GitHub's merged state is the
# signal, except for a checkout this run locked because Herdr has it open.
git -C "$guard/repo" remote add origin git@github.com:example/repo.git

cat >"$guard/bin/wt" <<EOF
#!/usr/bin/env bash
if [[ "\$*" == *list* ]]; then
  printf '%s\n' '[
    {"branch":"merged-one","path":"${guard}/repo.merged","is_main":false},
    {"branch":"open-one","path":"${guard}/repo.open-pr","is_main":false},
    {"branch":"merged-locked","path":"${guard}/repo.open","is_main":false},
    {"branch":"pr-9-R1","path":"${guard}/repo.epoch","is_main":false},
    {"branch":"main","path":"${guard}/repo","is_main":true}
  ]'
  exit 0
fi
if [[ "\$*" == *remove* ]]; then
  printf '%s\n' "\$*" >>"${guard}/remove-args"
  exit 0
fi
exit 0
EOF

cat >"$guard/bin/gh" <<EOF
#!/usr/bin/env bash
case "\$*" in
  *"pr view 9"*) printf '%s\n' CLOSED ;;
  *"--head merged-one"*) printf '%s\n' MERGED ;;
  *"--head open-one"*) printf '%s\n' OPEN ;;
  *"--head merged-locked"*) printf '%s\n' MERGED ;;
esac
exit 0
EOF
chmod +x "$guard/bin/gh"

rm -f "$guard/remove-args"
PATH="$guard/bin:$PATH" HERDR_BIN_PATH="$guard/bin/herdr" \
  "$CLEAN" -- "$guard" >/dev/null

assert_eq 'force-removes a worktree whose PR is merged' \
  "-C ${guard}/repo remove --yes --foreground --force -D merged-one" \
  "$(grep -F 'merged-one' "$guard/remove-args")"
assert_eq 'force-removes an epoch checkout for a closed PR' \
  "-C ${guard}/repo remove --yes --foreground --force -D pr-9-R1" \
  "$(grep -F 'pr-9-R1' "$guard/remove-args")"
assert_eq 'leaves a worktree whose PR is still open' 'absent' \
  "$(grep -F 'open-one' "$guard/remove-args" >/dev/null && echo present || echo absent)"
assert_eq 'leaves a merged worktree Herdr has open' 'absent' \
  "$(grep -F 'merged-locked' "$guard/remove-args" >/dev/null && echo present || echo absent)"

rm -f "$guard/remove-args"
dry="$(PATH="$guard/bin:$PATH" HERDR_BIN_PATH="$guard/bin/herdr" \
  "$CLEAN" --dry-run -- "$guard" 2>/dev/null)"
assert_eq 'previews a merged worktree on --dry-run' \
  "would remove merged-one (merged PR)" \
  "$(printf '%s\n' "$dry" | grep -F 'merged-one')"
assert_eq 'does not remove it during --dry-run' 'absent' \
  "$([[ -e "$guard/remove-args" ]] && echo present || echo absent)"

if [[ "$failures" -ne 0 ]]; then
  exit 1
fi
printf 'all tests passed\n'
