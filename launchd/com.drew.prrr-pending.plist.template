<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.drew.prrr-pending</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>@PATH@</string>
		<key>HOME</key>
		<string>@HOME@</string>
		<key>LANG</key>
		<string>en_US.UTF-8</string>
		<key>LC_ALL</key>
		<string>en_US.UTF-8</string>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>@SCRIPT@</string>
	</array>
	<!-- Every 5 minutes (300s). Starts a PR only when it has no local review yet, and not while a review of that PR is already running. -->
	<key>StartInterval</key>
	<integer>300</integer>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/prrr-pending.out.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/prrr-pending.err.log</string>
</dict>
</plist>
