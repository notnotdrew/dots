<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.drew.prrr-pending</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>@PATH@</string>
		<key>HOME</key>
		<string>@HOME@</string>
		<key>LANG</key>
		<string>en_US.UTF-8</string>
		<key>LC_ALL</key>
		<string>en_US.UTF-8</string>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>@SCRIPT@</string>
	</array>
	<!-- Every 30 minutes (1800s). Leaves a PR alone while a review of its current head is already running, and no-ops when that head is already reviewed. -->
	<key>StartInterval</key>
	<integer>1800</integer>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/prrr-pending.out.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/prrr-pending.err.log</string>
</dict>
</plist>
